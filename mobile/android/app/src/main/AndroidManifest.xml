<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Needed for the API/sync calls, the in-app loopback tile server, and
         online basemap providers (OSM/Carto). Auto-added in debug builds, but
         declared here so release builds have it too. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- GPS placement for offline features (Phase 21 Slice 5b). Fine location for
         an accurate on-the-pole fix; coarse as the graceful fallback. No
         background access: the app only reads a fix while the user is placing
         or recentering in the foreground. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Image attachment capture (Phase 22 Slice 5): the camera for taking a photo
         of a feature in the field. Gallery pick needs no permission on modern
         Android (image_picker uses the system photo picker). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- External Bluetooth GNSS receiver (Phase gnss-quality Slice 4). We only
         connect to devices already bonded in the OS Bluetooth settings (no
         discovery/scan), so on Android 12+ we need only BLUETOOTH_CONNECT; the
         legacy BLUETOOTH permission covers API <= 30 (normal, granted at install).
         No neverForLocation / SCAN, because we never scan. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <application
        android:label="Voltedge field"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Field SSO hand-off (migration 0191): flutter_web_auth_2's CallbackActivity
             catches the voltedge:// redirect the system browser returns at the end of
             the server-mediated OIDC flow (carrying the one-time code). The scheme is
             OURS (app-local); it is NOT registered with the IdP, which only ever
             redirects to cmd/server's own registered web callback. -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true">
            <intent-filter android:label="flutter_web_auth_2">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="voltedge" />
            </intent-filter>
        </activity>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>

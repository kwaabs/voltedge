###  http://www.iec.ch/TC57/CIM#CRRSegment
cim:CRRSegment rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:CRRSegment.amount ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:Money
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:CRRSegment.clearingPrice ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:Money
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:CRRSegment.endDateTime ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:dateTime
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:CRRSegment.quantity ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:CRRSegment.startDateTime ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:dateTime
                                   ] ;
               rdfs:subClassOf cim:IdentifiedObject ;
               rdfs:comment """CRRSegment represents a segment of a CRR in a particular time frame. 

The segment class contains CRR kind, type, quantity, hedger type, time of use flag, and segment period.""" .


###  http://www.iec.ch/TC57/CIM#CRRSegmentType
cim:CRRSegmentType rdf:type owl:Class ;

#################################################################
#    Classes
#################################################################

###  http://www.iec.ch/TC57/CIM#ACDCConverter
cim:ACDCConverter rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACDCConverter.baseS ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:ApparentPower
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACDCConverter.idc ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:CurrentFlow
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACDCConverter.idleLoss ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:ActivePower
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACDCConverter.maxUdc ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Voltage
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACDCConverter.minUdc ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Voltage
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACDCConverter.p ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:ActivePower
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACDCConverter.poleLossP ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:ActivePower
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACDCConverter.q ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:ReactivePower
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACDCConverter.ratedUdc ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Voltage
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACDCConverter.resistiveLoss ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Resistance
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACDCConverter.switchingLoss ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:ActivePowerPerCurrentFlow
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACDCConverter.targetPpcc ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:ActivePower
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACDCConverter.targetUdc ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Voltage
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACDCConverter.uc ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Voltage
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACDCConverter.udc ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Voltage
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACDCConverter.valveU0 ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Voltage
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACDCConverter.numberOfValves ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ;
                  rdfs:subClassOf cim:ConductingEquipment ;
                  rdfs:comment "A unit with valves for three phases, together with unit control equipment, essential protective and switching devices, DC storage capacitors, phase reactors and auxiliaries, if any, used for conversion." .


###  http://www.iec.ch/TC57/CIM#ACDCConverterDCTerminal
cim:ACDCConverterDCTerminal rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ACDCConverterDCTerminal.polarity ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass cim:DCPolarityKind
                                                ] ;
                            rdfs:subClassOf cim:DCBaseTerminal ;
                            rdfs:comment "A DC electrical connection point at the AC/DC converter. The AC/DC converter is electrically connected also to the AC side. The AC connection is inherited from the AC conducting equipment in the same way as any other AC equipment. The AC/DC converter DC terminal is separate from generic DC terminal to restrict the connection with the AC side to AC/DC converter and so that no other DC conducting equipment can be connected to the AC side." .


###  http://www.iec.ch/TC57/CIM#ACDCTerminal
cim:ACDCTerminal rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:ACDCTerminal.connected ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:boolean
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:ACDCTerminal.sequenceNumber ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:nonNegativeInteger
                                     ] ;
                 rdfs:subClassOf cim:IdentifiedObject ;
                 rdfs:comment "An electrical connection point (AC or DC) to a piece of conducting equipment. Terminals are connected at physical connection points called connectivity nodes." .


###  http://www.iec.ch/TC57/CIM#ACLineSegment
cim:ACLineSegment rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACLineSegment.b0ch ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Susceptance
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACLineSegment.bch ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Susceptance
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACLineSegment.g0ch ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Conductance
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACLineSegment.gch ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Conductance
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACLineSegment.r ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Resistance
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACLineSegment.r0 ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Resistance
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACLineSegment.shortCircuitEndTemperature ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Temperature
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACLineSegment.x ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Reactance
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ACLineSegment.x0 ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Reactance
                                      ] ;
                  rdfs:subClassOf cim:Conductor ;
                  rdfs:comment """A wire or combination of wires, with consistent electrical characteristics, building a single electrical system, used to carry alternating current between points in the power system.
For symmetrical, transposed 3ph lines, it is sufficient to use  attributes of the line segment, which describe impedances and admittances for the entire length of the segment.  Additionally impedances can be computed by using length and associated per length impedances.
The BaseVoltage at the two ends of ACLineSegments in a Line shall have the same BaseVoltage.nominalVoltage. However, boundary lines  may have slightly different BaseVoltage.nominalVoltages and  variation is allowed. Larger voltage difference in general requires use of an equivalent branch.""" .


###  http://www.iec.ch/TC57/CIM#ACLineSegmentPhase
cim:ACLineSegmentPhase rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ACLineSegmentPhase.phase ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:SinglePhaseKind
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ACLineSegmentPhase.sequenceNumber ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:nonNegativeInteger
                                           ] ;
                       rdfs:subClassOf cim:PowerSystemResource ;
                       rdfs:comment "Represents a single wire of an alternating current line segment." .


###  http://www.iec.ch/TC57/CIM#ADSInstructionTypeCommitment
cim:ADSInstructionTypeCommitment rdf:type owl:Class ;
                                 owl:equivalentClass [ rdf:type owl:Class ;
                                                       owl:oneOf ( cim:SHUT_DOWN
                                                                   cim:START_UP
                                                                 )
                                                     ] .


###  http://www.iec.ch/TC57/CIM#ADSInstructionTypeOOS
cim:ADSInstructionTypeOOS rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Class ;
                                                owl:oneOf ( cim:FIXED_CONSTRAINT
                                                            cim:MAX_CONSTRAINT
                                                            cim:MIN_CONSTRAINT
                                                          )
                                              ] .


###  http://www.iec.ch/TC57/CIM#ASRequirements
cim:ASRequirements rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ASRequirements.intervalStartTime ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;

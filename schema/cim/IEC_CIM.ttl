                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:PU
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ExcIEEEDC2A.vrmin ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:PU
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ExcIEEEDC2A.seefd1 ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:float
                                    ] ,

###  http://www.iec.ch/TC57/CIM#ProtectionEquipment
cim:ProtectionEquipment rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:ProtectionEquipment.relayDelayTime ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Seconds
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:ProtectionEquipment.unitMultiplier ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:UnitMultiplier
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:ProtectionEquipment.unitSymbol ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:UnitSymbol
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:ProtectionEquipment.highLimit ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:ProtectionEquipment.lowLimit ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:ProtectionEquipment.powerDirectionFlag ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ;
                        rdfs:subClassOf cim:Equipment ;
                        rdfs:comment "An electrical device designed to respond to input conditions in a prescribed manner and after specified conditions are met to cause contact operation or similar abrupt change in associated electric control circuits, or simply to display the detected condition. Protection equipment are associated with conducting equipment and usually operate circuit breakers." .



###  http://www.iec.ch/TC57/CIM#ICCPInformationMessage
cim:ICCPInformationMessage rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:ICCPInformationMessage.scope ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;

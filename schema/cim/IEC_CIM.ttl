###  http://www.iec.ch/TC57/CIM#GrossToNetActivePowerCurve
cim:GrossToNetActivePowerCurve rdf:type owl:Class ;
                               rdfs:subClassOf cim:Curve ;
                               rdfs:comment "Relationship between the generating unit's gross active power output on the X-axis (measured at the terminals of the machine(s)) and the generating unit's net active power output on the Y-axis (based on utility-defined measurements at the power station). Station service loads, when modeled, should be treated as non-conforming bus loads. There may be more than one curve, depending on the auxiliary equipment that is in service." .


###  http://www.iec.ch/TC57/CIM#Ground
cim:Ground rdf:type owl:Class ;
           rdfs:subClassOf cim:ConductingEquipment ;
           rdfs:comment "A point where the system is grounded used for connecting conducting equipment to ground. The power system model can have any number of grounds." .


###  http://www.iec.ch/TC57/CIM#GroundAction
cim:GroundAction rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:GroundAction.kind ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:TempEquipActionKind
                                     ] ;
                 rdfs:subClassOf cim:SwitchingStep ;
                 rdfs:comment "Action on ground as a switching step." .


###  http://www.iec.ch/TC57/CIM#GroundDisconnector
cim:GroundDisconnector rdf:type owl:Class ;
                       rdfs:subClassOf cim:Switch ;
                       rdfs:comment "A manually operated or motor operated mechanical switching device used for isolating a circuit or equipment from ground." .


###  http://www.iec.ch/TC57/CIM#GroundingImpedance
cim:GroundingImpedance rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:GroundingImpedance.x ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Reactance
                                           ] ;
                       rdfs:subClassOf cim:EarthFaultCompensator ;
                       rdfs:comment "A fixed impedance device used for grounding." .


###  http://www.iec.ch/TC57/CIM#Hazard
cim:Hazard rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Hazard.status ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:Status
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Hazard.type ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ;
           rdfs:subClassOf cim:IdentifiedObject ;
           rdfs:comment "An object or a condition that is a danger for causing loss or perils to an asset and/or people." .


###  http://www.iec.ch/TC57/CIM#HeatInputCurve
cim:HeatInputCurve rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:HeatInputCurve.auxPowerMult ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:PU
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:HeatInputCurve.auxPowerOffset ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePower
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:HeatInputCurve.heatInputEff ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:PU
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:HeatInputCurve.heatInputOffset ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:HeatRate
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:HeatInputCurve.isNetGrossP ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:boolean
                                       ] ;
                   rdfs:subClassOf cim:Curve ;
                   rdfs:comment "Relationship between unit heat input in energy per time for main fuel (Y1-axis) and supplemental fuel (Y2-axis) versus unit output in active power (X-axis). The quantity of main fuel used to sustain generation at this output level is prorated for throttling between definition points. The quantity of supplemental fuel used at this output level is fixed and not prorated." .


###  http://www.iec.ch/TC57/CIM#HeatRate
cim:HeatRate rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:HeatRate.multiplier ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:UnitMultiplier
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:HeatRate.unit ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:UnitSymbol
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:HeatRate.value ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:float
                                 ] ;
             rdfs:comment "Heat generated, in energy pertime unit of elapsed time." .


###  http://www.iec.ch/TC57/CIM#HeatRateCurve
cim:HeatRateCurve rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:HeatRateCurve.isNetGrossP ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:boolean
                                      ] ;
                  rdfs:subClassOf cim:Curve ;
                  rdfs:comment "Relationship between unit heat rate per active power (Y-axis) and  unit output (X-axis). The heat input is from all fuels." .


###  http://www.iec.ch/TC57/CIM#HeatRecoveryBoiler
cim:HeatRecoveryBoiler rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:HeatRecoveryBoiler.steamSupplyRating2 ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:float
                                           ] ;
                       rdfs:subClassOf cim:FossilSteamSupply ;
                       rdfs:comment "The heat recovery system associated with combustion turbines in order to produce steam for combined cycle plants." .


###  http://www.iec.ch/TC57/CIM#HostControlArea
cim:HostControlArea rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:HostControlArea.areaControlMode ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:AreaControlMode
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:HostControlArea.freqSetPoint ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Frequency
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:HostControlArea.endEffectiveDate ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:HostControlArea.frequencyBiasFactor ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:float
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:HostControlArea.startEffectiveDate ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ;
                    rdfs:subClassOf cim:PowerSystemResource ;
                    rdfs:comment "A HostControlArea has a set of tie points and a set of generator controls (i.e., AGC). It also has a total load, including transmission and distribution losses." .


###  http://www.iec.ch/TC57/CIM#HourlyPreDispatchSchedule
cim:HourlyPreDispatchSchedule rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Restriction ;
                                                    owl:onProperty cim:HourlyPreDispatchSchedule.value ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onDataRange xsd:boolean
                                                  ] ;
                              rdfs:subClassOf cim:BidHourlySchedule ;
                              rdfs:comment """An indicator specifying that a resource shall have an Hourly Pre-Dispatch. The resource could be a RegisteredGenerator or a RegisteredInterTie.

This schedule is assocated with the hourly parameters in a resource bid.""" .


###  http://www.iec.ch/TC57/CIM#Hours
cim:Hours rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Hours.multiplier ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:UnitMultiplier
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Hours.unit ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:UnitSymbol
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Hours.value ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:float
                              ] ;
          rdfs:comment "Time specified in hours." .


###  http://www.iec.ch/TC57/CIM#HydroEnergyConversionKind
cim:HydroEnergyConversionKind rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Class ;
                                                    owl:oneOf ( cim:generator
                                                                cim:pumpAndGenerator
                                                              )
                                                  ] .


###  http://www.iec.ch/TC57/CIM#HydroGeneratingEfficiencyCurve
cim:HydroGeneratingEfficiencyCurve rdf:type owl:Class ;
                                   rdfs:subClassOf cim:Curve ;
                                   rdfs:comment """Relationship between unit efficiency in percent and unit output active power for a given net head in meters. The relationship between efficiency, discharge, head, and power output is expressed as follows:   E =KP/HQ
Where:  (E=percentage)  (P=active power)  (H=height)  (Q=volume/time unit)  (K=constant)
For example, a curve instance for a given net head could relate efficiency (Y-axis) versus active power output (X-axis) or versus discharge on the X-axis.""" .


###  http://www.iec.ch/TC57/CIM#HydroGeneratingUnit
cim:HydroGeneratingUnit rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:HydroGeneratingUnit.energyConversionCapability ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:HydroEnergyConversionKind
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:HydroGeneratingUnit.hydroUnitWaterCost ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:CostPerVolume
                                            ] ;
                        rdfs:subClassOf cim:GeneratingUnit ;
                        rdfs:comment "A generating unit whose prime mover is a hydraulic turbine (e.g., Francis, Pelton, Kaplan)." .


###  http://www.iec.ch/TC57/CIM#HydroPlantStorageKind
cim:HydroPlantStorageKind rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Class ;
                                                owl:oneOf ( cim:pumpedStorage
                                                            cim:runOfRiver
                                                            cim:storage
                                                          )
                                              ] .


###  http://www.iec.ch/TC57/CIM#HydroPowerPlant
cim:HydroPowerPlant rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:HydroPowerPlant.dischargeTravelDelay ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Seconds
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:HydroPowerPlant.genRatedP ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:ActivePower
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:HydroPowerPlant.hydroPlantStorageType ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:HydroPlantStorageKind
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:HydroPowerPlant.plantDischargeCapacity ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:VolumeFlowRate
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:HydroPowerPlant.plantRatedHead ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Length
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:HydroPowerPlant.pumpRatedP ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:ActivePower
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:HydroPowerPlant.surgeTankCrestLevel ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:WaterLevel
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:HydroPowerPlant.penstockType ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:HydroPowerPlant.surgeTankCode ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ;
                    rdfs:subClassOf cim:PowerSystemResource ;
                    rdfs:comment "A hydro power station which can generate or pump. When generating, the generator turbines receive water from an upper reservoir. When pumping, the pumps receive their water from a lower reservoir." .


###  http://www.iec.ch/TC57/CIM#HydroPump
cim:HydroPump rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:HydroPump.pumpDischAtMaxHead ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:VolumeFlowRate
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:HydroPump.pumpDischAtMinHead ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:VolumeFlowRate
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:HydroPump.pumpPowerAtMaxHead ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:ActivePower
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:HydroPump.pumpPowerAtMinHead ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:ActivePower
                                  ] ;
              rdfs:subClassOf cim:Equipment ;
              rdfs:comment "A synchronous motor-driven pump, typically associated with a pumped storage plant." .


###  http://www.iec.ch/TC57/CIM#HydroPumpOpSchedule
cim:HydroPumpOpSchedule rdf:type owl:Class ;
                        rdfs:subClassOf cim:RegularIntervalSchedule ;
                        rdfs:comment "The hydro pump's Operator-approved current operating schedule (or plan), typically produced with the aid of unit commitment type analyses.The unit's operating schedule status is typically given as: (0=unavailable) (1=avilable to startup or shutdown)  (2=must pump)." .


###  http://www.iec.ch/TC57/CIM#HydroTurbine
cim:HydroTurbine rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:HydroTurbine.gateUpperLimit ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:PU
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:HydroTurbine.maxHeadMaxP ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:ActivePower
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:HydroTurbine.minHeadMaxP ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:ActivePower
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:HydroTurbine.speedRating ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:RotationSpeed
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:HydroTurbine.speedRegulation ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:PU
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:HydroTurbine.transientDroopTime ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Seconds
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:HydroTurbine.transientRegulation ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:PU
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:HydroTurbine.turbineRating ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:ActivePower
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:HydroTurbine.turbineType ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:TurbineType
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:HydroTurbine.waterStartingTime ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Seconds
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:HydroTurbine.gateRateLimit ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:float
                                     ] ;
                 rdfs:subClassOf cim:PrimeMover ;
                 rdfs:comment "A water driven prime mover. Typical turbine types are: Francis, Kaplan, and Pelton." .



cim:TargetLevelSchedule rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:TargetLevelSchedule.highLevelLimit ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:WaterLevel
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:TargetLevelSchedule.lowLevelLimit ;

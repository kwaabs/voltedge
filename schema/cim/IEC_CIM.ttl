###  http://www.iec.ch/TC57/CIM#Usage
cim:Usage rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Usage.status ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:Status
                              ] ;
          rdfs:subClassOf cim:WorkIdentifiedObject ;
          rdfs:comment "The way material and assets are used to perform a certain type of work task. The way is described in text in the inheritied description attribute." .


###  http://www.iec.ch/TC57/CIM#UsagePoint
cim:UsagePoint rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:UsagePoint.amiBillingReady ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:AmiBillingReadyKind
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:UsagePoint.connectionState ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:UsagePointConnectedKind
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:UsagePoint.estimatedLoad ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:CurrentFlow
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:UsagePoint.nominalServiceVoltage ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:Voltage
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:UsagePoint.phaseCode ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:PhaseCode
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:UsagePoint.ratedCurrent ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:CurrentFlow
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:UsagePoint.ratedPower ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:ActivePower
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:UsagePoint.checkBilling ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:boolean
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:UsagePoint.grounded ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:boolean
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:UsagePoint.isSdp ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:boolean
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:UsagePoint.isVirtual ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:boolean
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:UsagePoint.minimalUsageExpected ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:boolean
                                   ] ,

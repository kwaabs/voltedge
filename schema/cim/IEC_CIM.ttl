###  http://www.iec.ch/TC57/CIM#AggregatedPnode
cim:AggregatedPnode rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:AggregatedPnode.apnodeType ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:ApnodeType
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:AggregatedPnode.participationCategory ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:ParticipationCategoryMPM
                                        ] ;
                    rdfs:subClassOf cim:Pnode ;
                    rdfs:comment "An aggregated pricing node is a specialized type of pricing node used to model items such as System Zone, Default Price Zone, Custom Price Zone, Control Area, Aggregated Generation, Aggregated Particpating Load, Aggregated Non-Participating Load, Trading Hub, Designated Control Area(DCA) Zone" .


###  http://www.iec.ch/TC57/CIM#Agreement
cim:Agreement rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Agreement.validityInterval ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:DateTimeInterval
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Agreement.signDate ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:date
                                  ] ;
              rdfs:subClassOf cim:Document ;
              rdfs:comment "Formal agreement between two parties defining the terms and conditions for a set of services. The specifics of the services are, in turn, defined via one or more service agreements." .


###  http://www.iec.ch/TC57/CIM#AirCompressor
cim:AirCompressor rdf:type owl:Class ;

###  http://www.iec.ch/TC57/CIM#BaseCaseConstraintLimit
cim:BaseCaseConstraintLimit rdf:type owl:Class ;
                            rdfs:subClassOf cim:Curve ;
                            rdfs:comment "Possibly time-varying max MW or MVA and optionally Min MW limit or MVA limit (Y1 and Y2, respectively) assigned to a contingency analysis base case. Use CurveSchedule XAxisUnits to specify MW or MVA. To be used only if the BaseCaseConstraintLimit differs from the DefaultConstraintLimit." .


###  http://www.iec.ch/TC57/CIM#BaseFrequency
cim:BaseFrequency rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:BaseFrequency.frequency ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Frequency
                                      ] ;
                  rdfs:subClassOf cim:IdentifiedObject ;
                  rdfs:comment "The class describe a base frequency for a power system network. In case of multiple power networks with different frequencies, e.g. 50 or 60 Hertz each network will have it's own base frequency class. Hence it is assumed that power system objects having different base frequencies appear in separate documents where each document has a single base frequency instance." .


###  http://www.iec.ch/TC57/CIM#BasePower
cim:BasePower rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:BasePower.basePower ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:ApparentPower
                                  ] ;
              rdfs:subClassOf cim:IdentifiedObject ;
              rdfs:comment "The BasePower class defines the base power used in the per unit calculations." .


###  http://www.iec.ch/TC57/CIM#BaseReading
cim:BaseReading rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:BaseReading.timePeriod ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:DateTimeInterval
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:BaseReading.reportedDateTime ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:dateTime
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:BaseReading.source ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:BaseReading.value ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ;
                rdfs:subClassOf cim:MeasurementValue ;
                rdfs:comment "Common representation for reading values. Note that a reading value may have multiple qualities, as produced by various systems ('ReadingQuality.source')." .


###  http://www.iec.ch/TC57/CIM#BaseVoltage
cim:BaseVoltage rdf:type owl:Class ;

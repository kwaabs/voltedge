###  http://www.iec.ch/TC57/CIM#RUCAwardInstruction
cim:RUCAwardInstruction rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:RUCAwardInstruction.marketProductType ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;

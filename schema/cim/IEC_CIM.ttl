                                 owl:onProperty cim:Season.endDate ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:MonthDay
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Season.startDate ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:MonthDay
                               ] ;
           rdfs:subClassOf cim:IdentifiedObject ;
           rdfs:comment "A specified time period of the year." .


###  http://www.iec.ch/TC57/CIM#SeasonDayTypeSchedule
cim:SeasonDayTypeSchedule rdf:type owl:Class ;
                          rdfs:subClassOf cim:RegularIntervalSchedule ;
                          rdfs:comment "A time schedule covering a 24 hour period, with curve data for a specific type of season and day." .


###  http://www.iec.ch/TC57/CIM#Seconds
cim:Seconds rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Seconds.multiplier ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:UnitMultiplier
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Seconds.unit ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:UnitSymbol
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Seconds.value ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;

###  http://www.iec.ch/TC57/CIM#OASISErrCode
cim:OASISErrCode rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:oneOf ( <http://www.iec.ch/TC57/CIM#1000>
                                                   <http://www.iec.ch/TC57/CIM#1001>
                                                   <http://www.iec.ch/TC57/CIM#1002>
                                                   <http://www.iec.ch/TC57/CIM#1003>
                                                   <http://www.iec.ch/TC57/CIM#1004>
                                                   <http://www.iec.ch/TC57/CIM#1005>
                                                   <http://www.iec.ch/TC57/CIM#1006>
                                                   <http://www.iec.ch/TC57/CIM#1007>

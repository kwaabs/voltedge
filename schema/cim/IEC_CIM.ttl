cim:AcceptanceTest.type rdf:type owl:DatatypeProperty ;
                        rdfs:domain cim:AcceptanceTest ;
                        rdfs:range xsd:string ;
                        rdfs:comment "Type of test or group of tests that was conducted on 'dateTime'." .



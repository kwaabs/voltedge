###  http://www.iec.ch/TC57/CIM#CurrentTransformer
cim:CurrentTransformer rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:CurrentTransformer.accuracyLimit ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:PerCent
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:CurrentTransformer.coreBurden ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:ActivePower
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:CurrentTransformer.accuracyClass ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:CurrentTransformer.ctClass ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:CurrentTransformer.usage ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ;
                       rdfs:subClassOf cim:Sensor ;
                       rdfs:comment "Instrument transformer used to measure electrical qualities of the circuit that is being protected and/or monitored. Typically used as current transducer for the purpose of metering or protection. A typical secondary current rating would be 5A." .


###  http://www.iec.ch/TC57/CIM#CurrentTransformerInfo
cim:CurrentTransformerInfo rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:CurrentTransformerInfo.accuracyLimit ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:CurrentFlow
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:CurrentTransformerInfo.kneePointCurrent ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:CurrentFlow
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:CurrentTransformerInfo.kneePointVoltage ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:Voltage
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:CurrentTransformerInfo.maxRatio ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:Ratio
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:CurrentTransformerInfo.nominalRatio ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:Ratio
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:CurrentTransformerInfo.primaryFlsRating ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:CurrentFlow
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:CurrentTransformerInfo.primaryRatio ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:Ratio
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:CurrentTransformerInfo.ratedCurrent ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:CurrentFlow
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:CurrentTransformerInfo.secondaryFlsRating ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:CurrentFlow
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:CurrentTransformerInfo.secondaryRatio ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:Ratio
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:CurrentTransformerInfo.tertiaryFlsRating ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:CurrentFlow
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:CurrentTransformerInfo.tertiaryRatio ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:Ratio
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:CurrentTransformerInfo.accuracyClass ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:CurrentTransformerInfo.coreCount ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:nonNegativeInteger
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:CurrentTransformerInfo.ctClass ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:CurrentTransformerInfo.usage ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ;
                           rdfs:subClassOf cim:AssetInfo ;
                           rdfs:comment "Properties of current transformer asset." .


###  http://www.iec.ch/TC57/CIM#CurtailmentProfile
cim:CurtailmentProfile rdf:type owl:Class ;
                       rdfs:subClassOf cim:Profile ;
                       rdfs:comment "Curtailing entity must be providing at least one service to the EnergyTransaction. The CurtailmentProfile must be completely contained within the EnergyProfile timeframe for this EnergyTransaction." .


###  http://www.iec.ch/TC57/CIM#Curve
cim:Curve rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Curve.curveStyle ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:CurveStyle
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Curve.xMultiplier ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:UnitMultiplier
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Curve.xUnit ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:UnitSymbol
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Curve.y1Multiplier ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:UnitMultiplier
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Curve.y1Unit ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:UnitSymbol
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Curve.y2Multiplier ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:UnitMultiplier
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Curve.y2Unit ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:UnitSymbol
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Curve.y3Multiplier ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:UnitMultiplier
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Curve.y3Unit ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:UnitSymbol
                              ] ;
          rdfs:subClassOf cim:IdentifiedObject ;
          rdfs:comment "A multi-purpose curve or functional relationship between an independent variable (X-axis) and dependent (Y-axis) variables." .


###  http://www.iec.ch/TC57/CIM#CurveData
cim:CurveData rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:CurveData.xvalue ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:float
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:CurveData.y1value ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:float
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:CurveData.y2value ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:float
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:CurveData.y3value ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:float
                                  ] ;
              rdfs:comment "Multi-purpose data points for defining a curve.  The use of this generic class is discouraged if a more specific class  can be used to specify the x and y axis values along with their specific data types." .


###  http://www.iec.ch/TC57/CIM#CurveStyle
cim:CurveStyle rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:oneOf ( cim:constantYValue
                                                 cim:straightLineYValues
                                               )
                                   ] .


###  http://www.iec.ch/TC57/CIM#Customer
cim:Customer rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Customer.kind ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:CustomerKind
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Customer.priority ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:Priority
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Customer.status ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:Status
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Customer.locale ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Customer.pucNumber ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Customer.specialNeed ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Customer.vip ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:boolean
                                 ] ;
             rdfs:subClassOf cim:OrganisationRole ;
             rdfs:comment "Organisation receiving services from service supplier." .


###  http://www.iec.ch/TC57/CIM#CustomerAccount
cim:CustomerAccount rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:CustomerAccount.lastBillAmount ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Money
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:CustomerAccount.billingCycle ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:CustomerAccount.budgetBill ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ;
                    rdfs:subClassOf cim:Document ;
                    rdfs:comment "Assignment of a group of products and services purchased by the customer through a customer agreement, used as a mechanism for customer billing and payment. It contains common information from the various types of customer agreements to create billings (invoices) for a customer and receive payment." .


###  http://www.iec.ch/TC57/CIM#CustomerAgreement
cim:CustomerAgreement rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:CustomerAgreement.isPrePay ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:boolean
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:CustomerAgreement.loadMgmt ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:CustomerAgreement.shutOffDateTime ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:dateTime
                                          ] ;
                      rdfs:subClassOf cim:Agreement ;
                      rdfs:comment "Agreement between the customer and the service supplier to pay for service at a specific service location. It records certain billing information about the type of service provided at the service location and is used during charge creation to determine the type of service." .


###  http://www.iec.ch/TC57/CIM#CustomerBillingInfo
cim:CustomerBillingInfo rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:CustomerBillingInfo.kind ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:CustomerBillingKind
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:CustomerBillingInfo.lastPaymentAmt ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Money
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:CustomerBillingInfo.outBalance ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Money
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:CustomerBillingInfo.pymtPlanAmt ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Money
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:CustomerBillingInfo.billingDate ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:date
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:CustomerBillingInfo.dueDate ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:date
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:CustomerBillingInfo.lastPaymentDate ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:date
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:CustomerBillingInfo.pymtPlanType ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:string
                                            ] ;
                        rdfs:subClassOf cim:Document ;
                        rdfs:comment """The creation of the monthly customer billing statements is the method employed to notify Customers of charges, adjustments and credits applied to their account for Services and Products. The actuall billing occurs through an ErpInvoice. The CustomerBillingInfo includes information from the payment, collection, meter reading, installed meter, service, site, customer, customer account, customer agreement, services and pricing subject areas. Each component price shows up as a separate line item on the ErpInvoice.
The Customer Billing Statement may include collection and account messages, marketing/civic event messages and bill inserts.
One Customer Billing Statement is produced for all Agreements under a CustomerAccount per billing cycle date defined in 'CustomerAccount.billingCycle'.
The history of CustomerBillingInfo, Invoices and Payments is to be maintained in associated ActivityRecords.""" .


###  http://www.iec.ch/TC57/CIM#CustomerBillingKind
cim:CustomerBillingKind rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Class ;
                                              owl:oneOf ( cim:consolidatedEss
                                                          cim:consolidatedUdc
                                                          cim:other
                                                          cim:separateEssUdc
                                                        )
                                            ] .


###  http://www.iec.ch/TC57/CIM#CustomerConsumer
cim:CustomerConsumer rdf:type owl:Class ;
                     rdfs:subClassOf cim:Organisation ;
                     rdfs:comment "The energy buyer in the energy marketplace." .


###  http://www.iec.ch/TC57/CIM#CustomerKind
cim:CustomerKind rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:oneOf ( cim:commercialIndustrial
                                                   cim:energyServiceScheduler
                                                   cim:energyServiceSupplier
                                                   cim:internalUse
                                                   cim:other
                                                   cim:pumpingLoad
                                                   cim:residential
                                                   cim:residentialAndCommercial
                                                   cim:residentialAndStreetlight
                                                   cim:residentialFarmService
                                                   cim:residentialStreetlightOthers
                                                   cim:windMachine
                                                 )
                                     ] .


###  http://www.iec.ch/TC57/CIM#CustomerNotification
cim:CustomerNotification rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:CustomerNotification.trigger ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:NotificationTriggerKind
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:CustomerNotification.contactType ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:CustomerNotification.contactValue ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:CustomerNotification.earliestDateTimeToCall ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:dateTime
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:CustomerNotification.latestDateTimeToCall ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:dateTime
                                             ] ;
                         rdfs:comment "Conditions for notifying the customer about the changes in the status of their service (e.g., outage restore, estimated restoration time, tariff or service level change, etc.)" .


###  http://www.iec.ch/TC57/CIM#Cut
cim:Cut rdf:type owl:Class ;
        owl:equivalentClass [ rdf:type owl:Restriction ;
                              owl:onProperty cim:Cut.lengthFromTerminal1 ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass cim:Length
                            ] ;
        rdfs:subClassOf cim:Switch ;
        rdfs:comment """A cut separates a line segment into two parts. The cut appears as a switch inserted between these two parts and connects them together. As the cut is normally open there is no galvanic connection between the two line segment parts. But it is possible to close the cut to get galvanic connection.
The cut terminals are oriented towards the line segment terminals with the same sequence number. Hence the cut terminal with sequence number equal to 1 is oriented to the line segment's terminal with sequence number equal to 1.
The cut terminals also act as connection points for jumpers and other equipment, e.g. a mobile generator. To enable this, connectivity nodes are placed at the cut terminals. Once the connectivity nodes are in place any conducting equipment can be connected at them.""" .


###  http://www.iec.ch/TC57/CIM#CutAction
cim:CutAction rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:CutAction.kind ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:TempEquipActionKind
                                  ] ;
              rdfs:subClassOf cim:SwitchingStep ;
              rdfs:comment "Action on cut as a switching step." .


###  http://www.iec.ch/TC57/CIM#DAMMarketType
cim:DAMMarketType rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:oneOf ( cim:DAM
                                                  )
                                      ] .


###  http://www.iec.ch/TC57/CIM#DCBaseTerminal
cim:DCBaseTerminal rdf:type owl:Class ;
                   rdfs:subClassOf cim:ACDCTerminal ;
                   rdfs:comment "An electrical connection point at a piece of DC conducting equipment. DC terminals are connected at one physical DC node that may have multiple DC terminals connected. A DC node is similar to an AC connectivity node. The model enforces that DC connections are distinct from AC connections." .


###  http://www.iec.ch/TC57/CIM#DCBreaker
cim:DCBreaker rdf:type owl:Class ;
              rdfs:subClassOf cim:DCSwitch ;
              rdfs:comment "A breaker within a DC system." .


###  http://www.iec.ch/TC57/CIM#DCBusbar
cim:DCBusbar rdf:type owl:Class ;
             rdfs:subClassOf cim:DCConductingEquipment ;
             rdfs:comment "A busbar within a DC system." .


###  http://www.iec.ch/TC57/CIM#DCChopper
cim:DCChopper rdf:type owl:Class ;
              rdfs:subClassOf cim:DCConductingEquipment ;
              rdfs:comment "Low resistance equipment used in the internal DC circuit to balance voltages. It has typically positive and negative pole terminals and a ground." .


###  http://www.iec.ch/TC57/CIM#DCConductingEquipment
cim:DCConductingEquipment rdf:type owl:Class ;
                          rdfs:subClassOf cim:Equipment ;
                          rdfs:comment "The parts of the DC power system that are designed to carry current or that are conductively connected through DC terminals." .


###  http://www.iec.ch/TC57/CIM#DCConverterOperatingModeKind
cim:DCConverterOperatingModeKind rdf:type owl:Class ;
                                 owl:equivalentClass [ rdf:type owl:Class ;
                                                       owl:oneOf ( cim:bipolar
                                                                   cim:monopolarGroundReturn
                                                                   cim:monopolarMetallicReturn
                                                                 )
                                                     ] .


###  http://www.iec.ch/TC57/CIM#DCConverterUnit
cim:DCConverterUnit rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:DCConverterUnit.operationMode ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:DCConverterOperatingModeKind
                                        ] ;
                    rdfs:subClassOf cim:DCEquipmentContainer ;
                    rdfs:comment "Indivisible operative unit comprising all equipment between the point of common coupling on the AC side and the point of common coupling  DC side, essentially one or more converters, together with one or more converter transformers, converter control equipment, essential protective and switching devices and auxiliaries, if any, used for conversion." .


###  http://www.iec.ch/TC57/CIM#DCDisconnector
cim:DCDisconnector rdf:type owl:Class ;
                   rdfs:subClassOf cim:DCSwitch ;
                   rdfs:comment "A disconnector within a DC system." .


###  http://www.iec.ch/TC57/CIM#DCEquipmentContainer
cim:DCEquipmentContainer rdf:type owl:Class ;
                         rdfs:subClassOf cim:EquipmentContainer ;
                         rdfs:comment "A modeling construct to provide a root class for containment of DC as well as AC equipment. The class differ from the EquipmentContaner for AC in that it may also contain DCNodes. Hence it can contain both AC and DC equipment." .


###  http://www.iec.ch/TC57/CIM#DCGround
cim:DCGround rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:DCGround.inductance ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:Inductance
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:DCGround.r ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:Resistance
                                 ] ;
             rdfs:subClassOf cim:DCConductingEquipment ;
             rdfs:comment "A ground within a DC system." .


###  http://www.iec.ch/TC57/CIM#DCLine
cim:DCLine rdf:type owl:Class ;
           rdfs:subClassOf cim:DCEquipmentContainer ;
           rdfs:comment "Overhead lines and/or cables connecting two or more HVDC substations." .


###  http://www.iec.ch/TC57/CIM#DCLineSegment
cim:DCLineSegment rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:DCLineSegment.capacitance ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Capacitance
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:DCLineSegment.inductance ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Inductance
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:DCLineSegment.length ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Length
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:DCLineSegment.resistance ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Resistance
                                      ] ;
                  rdfs:subClassOf cim:DCConductingEquipment ;
                  rdfs:comment "A wire or combination of wires not insulated from one another, with consistent electrical characteristics, used to carry direct current between points in the DC region of the power system." .


###  http://www.iec.ch/TC57/CIM#DCNode
cim:DCNode rdf:type owl:Class ;
           rdfs:subClassOf cim:IdentifiedObject ;
           rdfs:comment "DC nodes are points where terminals of DC conducting equipment are connected together with zero impedance." .


###  http://www.iec.ch/TC57/CIM#DCPolarityKind
cim:DCPolarityKind rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Class ;
                                         owl:oneOf ( cim:middle
                                                     cim:negative
                                                     cim:positive
                                                   )
                                       ] .


###  http://www.iec.ch/TC57/CIM#DCSeriesDevice
cim:DCSeriesDevice rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DCSeriesDevice.inductance ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Inductance
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DCSeriesDevice.ratedUdc ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Voltage
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DCSeriesDevice.resistance ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Resistance
                                       ] ;
                   rdfs:subClassOf cim:DCConductingEquipment ;
                   rdfs:comment "A series device within the DC system, typically a reactor used for filtering or smoothing.  Needed for transient and short circuit studies." .


###  http://www.iec.ch/TC57/CIM#DCShunt
cim:DCShunt rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:DCShunt.capacitance ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:Capacitance
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:DCShunt.ratedUdc ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:Voltage
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:DCShunt.resistance ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:Resistance
                                ] ;
            rdfs:subClassOf cim:DCConductingEquipment ;
            rdfs:comment "A shunt device within the DC system, typically used for filtering.  Needed for transient and short circuit studies." .


###  http://www.iec.ch/TC57/CIM#DCSwitch
cim:DCSwitch rdf:type owl:Class ;
             rdfs:subClassOf cim:DCConductingEquipment ;
             rdfs:comment "A switch within the DC system." .


###  http://www.iec.ch/TC57/CIM#DCTerminal
cim:DCTerminal rdf:type owl:Class ;
               rdfs:subClassOf cim:DCBaseTerminal ;
               rdfs:comment "An electrical connection point to generic DC conducting equipment." .


###  http://www.iec.ch/TC57/CIM#DCTopologicalIsland
cim:DCTopologicalIsland rdf:type owl:Class ;
                        rdfs:subClassOf cim:IdentifiedObject ;
                        rdfs:comment """An electrically connected subset of the network. DC topological islands can change as the current network state changes: e.g. due to 
- disconnect switches or breakers change state in a SCADA/EMS
- manual creation, change or deletion of topological nodes in a planning tool.""" .


###  http://www.iec.ch/TC57/CIM#DCTopologicalNode
cim:DCTopologicalNode rdf:type owl:Class ;
                      rdfs:subClassOf cim:IdentifiedObject ;
                      rdfs:comment "DC bus." .


###  http://www.iec.ch/TC57/CIM#Damping
cim:Damping rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Damping.multiplier ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:UnitMultiplier
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Damping.unit ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:UnitSymbol
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Damping.value ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:float
                                ] ;
            rdfs:comment "Per-unit active power variation with frequency referenced on the system apparent power base. Typical values are in range 1.0 - 2.0." .


###  http://www.iec.ch/TC57/CIM#Dataset
cim:Dataset rdf:type owl:Class ;
            rdfs:subClassOf cim:IdentifiedObject ;
            rdfs:comment """Versioned instance of a model part.   This would correspond to a payload of instance data without a header.   The MRID would be used in audit trail, not in reusable script intended to work with new versions of data.
A dataset could be serialized multiple times and in multiple technologies, yet retain the same identity.""" .


###  http://www.iec.ch/TC57/CIM#DatasetArg
cim:DatasetArg rdf:type owl:Class ;
               rdfs:subClassOf cim:ModelOperationArg ;
               rdfs:comment "A model operation argument referencing a dataset instance." .


###  http://www.iec.ch/TC57/CIM#DatasetArgDescription
cim:DatasetArgDescription rdf:type owl:Class ;
                          rdfs:subClassOf cim:ModelOperationArgDescription .


###  http://www.iec.ch/TC57/CIM#DateAndOrTime
cim:DateAndOrTime rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:DateAndOrTime.time ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Time
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:DateAndOrTime.date ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:date
                                      ] ;
                  rdfs:comment "The date and or the time." .


###  http://www.iec.ch/TC57/CIM#DateInterval
cim:DateInterval rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:DateInterval.end ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:date
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:DateInterval.start ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:date
                                     ] ;
                 rdfs:comment "Interval between two dates." .


###  http://www.iec.ch/TC57/CIM#DateTimeInterval
cim:DateTimeInterval rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:DateTimeInterval.end ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:dateTime
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:DateTimeInterval.start ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:dateTime
                                         ] ;
                     rdfs:comment "Interval between two date and time points." .


###  http://www.iec.ch/TC57/CIM#DayType
cim:DayType rdf:type owl:Class ;
            rdfs:subClassOf cim:IdentifiedObject ;
            rdfs:comment "Group of similar days.   For example it could be used to represent weekdays, weekend, or holidays." .


###  http://www.iec.ch/TC57/CIM#Decimal
cim:Decimal rdf:type owl:Class ;
            rdfs:comment "Decimal is the base-10 notational system for representing real numbers." .


###  http://www.iec.ch/TC57/CIM#DecimalQuantity
cim:DecimalQuantity rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:DecimalQuantity.currency ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Currency
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:DecimalQuantity.multiplier ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:UnitMultiplier
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:DecimalQuantity.unit ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:UnitSymbol
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:DecimalQuantity.value ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Decimal
                                        ] .


###  http://www.iec.ch/TC57/CIM#DefaultBid
cim:DefaultBid rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:DefaultBid.bidType ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:BidType
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:DefaultBid.minLoadCost ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:CostRate
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:DefaultBid.peakFlag ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:OnOff
                                   ] ;
               rdfs:subClassOf cim:Bid ;
               rdfs:comment """DefaultBid is a generic class to hold Default Energy Bid, Default Startup Bid, and Default Minimum Load Bid:

Default Energy Bid
A Default Energy Bid is a monotonically increasing staircase function consisting at maximum 10 economic bid segments, or 10 ($/MW, MW) pairs. There are three methods for determining the Default Energy Bid:
<ul>
 <li>Cost Based: derived from the Heat Rate or Average Cost multiplied by the Gas Price Index plus 10%. </li>
 <li>LMP Based: a weighted average of LMPs in the preceding 90 days</li>
 <li>Negotiated: an amount negotiated with the designated Independent Entity.</li>
</ul>

Default Startup Bid
A Default Startup Bid (DSUB) shall be calculated for each RMR unit based on the Startup Cost stored in the Master File and the applicable GPI and EPI

Default Minimum Load Bid
A Default Minimum Load Bid (DMLB) shall be calculated for each RMR unit based on the Minimum Load Cost stored in the Master File and the applicable GPI.""" .


###  http://www.iec.ch/TC57/CIM#DefaultBidCurve
cim:DefaultBidCurve rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:DefaultBidCurve.debAdderFlag ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:YesNo
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:DefaultBidCurve.curveType ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ;
                    rdfs:subClassOf cim:Curve ;
                    rdfs:comment "Default bid curve for default energy bid curve and default startup curves (cost and time)" .


###  http://www.iec.ch/TC57/CIM#DefaultBidCurveData
cim:DefaultBidCurveData rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:DefaultBidCurveData.bidSegmentCalcType ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:BidCalculationBasis
                                            ] ;
                        rdfs:subClassOf cim:CurveData ;
                        rdfs:comment "Curve data for default bid curve and startup cost curve." .


###  http://www.iec.ch/TC57/CIM#DefaultConstraintLimit
cim:DefaultConstraintLimit rdf:type owl:Class ;
                           rdfs:subClassOf cim:Curve ;
                           rdfs:comment "Possibly time-varying max MW or MVA and optionally Min MW limit or MVA limit (Y1 and Y2, respectively) applied as a default value if no specific constraint limits are specified for a contingency analysis. Use CurveSchedule XAxisUnits to specify MW or MVA." .


###  http://www.iec.ch/TC57/CIM#DeleteCIMDataObject
cim:DeleteCIMDataObject rdf:type owl:Class ;
                        rdfs:subClassOf cim:IncrementalCIMDataObject .


###  http://www.iec.ch/TC57/CIM#DemandResponseProgram
cim:DemandResponseProgram rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:DemandResponseProgram.validityInterval ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:DateTimeInterval
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:DemandResponseProgram.type ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:string
                                              ] ;
                          rdfs:subClassOf cim:IdentifiedObject ;
                          rdfs:comment "Demand response program." .


###  http://www.iec.ch/TC57/CIM#DemographicKind
cim:DemographicKind rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:oneOf ( cim:other
                                                      cim:rural
                                                      cim:urban
                                                    )
                                        ] .


###  http://www.iec.ch/TC57/CIM#Design
cim:Design rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Design.costEstimate ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:Money
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Design.kind ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:DesignKind
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Design.price ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:Money
                               ] ;
           rdfs:subClassOf cim:WorkDocument ;
           rdfs:comment """A design for consideration by customers, potential customers, or internal work.
Note that the Version of design is the revision attribute that is inherited from Document.""" .


###  http://www.iec.ch/TC57/CIM#DesignKind
cim:DesignKind rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:oneOf ( cim:asBuilt
                                                 cim:estimated
                                                 cim:other
                                               )
                                   ] .


###  http://www.iec.ch/TC57/CIM#DesignLocation
cim:DesignLocation rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DesignLocation.spanLength ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Length
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DesignLocation.status ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Status
                                       ] ;
                   rdfs:subClassOf cim:WorkIdentifiedObject ;
                   rdfs:comment "A logical part of the design (e.g., pole and all equipment on a pole). This includes points and spans." .


###  http://www.iec.ch/TC57/CIM#DesignLocationCU
cim:DesignLocationCU rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:DesignLocationCU.cuAction ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:WorkActionKind
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:DesignLocationCU.cuQuantity ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:IntegerQuantity
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:DesignLocationCU.status ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Status
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:DesignLocationCU.cuAccount ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:DesignLocationCU.cuUsage ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:DesignLocationCU.removalDate ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:date
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:DesignLocationCU.toBeEnergised ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:boolean
                                         ] ;
                     rdfs:subClassOf cim:WorkIdentifiedObject ;
                     rdfs:comment "Compatible unit at a given design location." .


###  http://www.iec.ch/TC57/CIM#DiagnosisDataSet
cim:DiagnosisDataSet rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:DiagnosisDataSet.phaseCode ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:PhaseCode
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:DiagnosisDataSet.effect ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:DiagnosisDataSet.failureMode ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:DiagnosisDataSet.finalCause ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:DiagnosisDataSet.finalCode ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:DiagnosisDataSet.finalOrigin ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:DiagnosisDataSet.finalRemark ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:DiagnosisDataSet.preliminaryCode ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:DiagnosisDataSet.preliminaryDateTime ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:dateTime
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:DiagnosisDataSet.preliminaryRemark ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:DiagnosisDataSet.rootCause ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:DiagnosisDataSet.rootOrigin ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:DiagnosisDataSet.rootRemark ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ;
                     rdfs:subClassOf cim:ProcedureDataSet ;
                     rdfs:comment "The result of a problem (typically an asset failure) diagnosis." .


###  http://www.iec.ch/TC57/CIM#Diagram
cim:Diagram rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Diagram.orientation ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:OrientationKind
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Diagram.x1InitialView ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:float
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Diagram.x2InitialView ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:float
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Diagram.y1InitialView ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:float
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Diagram.y2InitialView ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:float
                                ] ;
            rdfs:subClassOf cim:IdentifiedObject ;
            rdfs:comment "The diagram being exchanged.  The coordinate system is a standard Cartesian coordinate system and the orientation attribute defines the orientation." .


###  http://www.iec.ch/TC57/CIM#DiagramObject
cim:DiagramObject rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:DiagramObject.rotation ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:AngleDegrees
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:DiagramObject.drawingOrder ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:DiagramObject.isPolygon ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:boolean
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:DiagramObject.offsetX ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:DiagramObject.offsetY ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ;
                  rdfs:subClassOf cim:IdentifiedObject ;
                  rdfs:comment "An object that defines one or more points in a given space. This object can be associated with anything that specializes IdentifiedObject. For single line diagrams such objects typically include such items as analog values, breakers, disconnectors, power transformers, and transmission lines." .


###  http://www.iec.ch/TC57/CIM#DiagramObjectGluePoint
cim:DiagramObjectGluePoint rdf:type owl:Class ;
                           rdfs:comment "This is used for grouping diagram object points from different diagram objects that are considered to be glued together in a diagram even if they are not at the exact same coordinates." .


###  http://www.iec.ch/TC57/CIM#DiagramObjectPoint
cim:DiagramObjectPoint rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:DiagramObjectPoint.sequenceNumber ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:nonNegativeInteger
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:DiagramObjectPoint.xPosition ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:float
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:DiagramObjectPoint.yPosition ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:float
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:DiagramObjectPoint.zPosition ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:float
                                           ] ;
                       rdfs:comment "A point in a given space defined by 3 coordinates and associated to a diagram object.  The coordinates may be positive or negative as the origin does not have to be in the corner of a diagram." .


###  http://www.iec.ch/TC57/CIM#DiagramObjectStyle
cim:DiagramObjectStyle rdf:type owl:Class ;
                       rdfs:subClassOf cim:IdentifiedObject ;
                       rdfs:comment "A reference to a style used by the originating system for a diagram object.  A diagram object style describes information such as line thickness, shape such as circle or rectangle etc, and color." .


###  http://www.iec.ch/TC57/CIM#DiagramStyle
cim:DiagramStyle rdf:type owl:Class ;
                 rdfs:subClassOf cim:IdentifiedObject ;
                 rdfs:comment "The diagram style refer to a style used by the originating system for a diagram.  A diagram style describes information such as schematic, geographic, bus-branch etc." .


###  http://www.iec.ch/TC57/CIM#DifferentialModel
cim:DifferentialModel rdf:type owl:Class ;
                      rdfs:comment "A set of statements describing the changes in the network model. The statement is defined in the incremental model." .


###  http://www.iec.ch/TC57/CIM#DimensionsInfo
cim:DimensionsInfo rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DimensionsInfo.sizeDepth ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Length
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DimensionsInfo.sizeDiameter ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Length
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DimensionsInfo.sizeLength ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Length
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DimensionsInfo.sizeWidth ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Length
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DimensionsInfo.orientation ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ;
                   rdfs:subClassOf cim:IdentifiedObject ;
                   rdfs:comment "As applicable, the basic linear, area, or volume dimensions of an asset, asset type (AssetModel) or other type of object (such as land area). Units and multipliers are specified per dimension." .


###  http://www.iec.ch/TC57/CIM#DiscExcContIEEEDEC1A
cim:DiscExcContIEEEDEC1A rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC1A.esc ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:PU
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC1A.kan ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:PU
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC1A.ketl ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:PU
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC1A.tan ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:Seconds
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC1A.td ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:Seconds
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC1A.tl1 ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:Seconds
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC1A.tl2 ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:Seconds
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC1A.tw5 ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:Seconds
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC1A.val ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:PU
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC1A.vanmax ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:PU
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC1A.vomax ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:PU
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC1A.vomin ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:PU
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC1A.vsmax ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:PU
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC1A.vsmin ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:PU
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC1A.vtc ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:PU
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC1A.vtlmt ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:PU
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC1A.vtm ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:PU
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC1A.vtn ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:PU
                                             ] ;
                         rdfs:subClassOf cim:DiscontinuousExcitationControlDynamics ;
                         rdfs:comment """The class represents IEEE Type DEC1A discontinuous excitation control model that boosts generator excitation to a level higher than that demanded by the voltage regulator and stabilizer immediately following a system fault.

Reference: IEEE Standard 421.5-2005 Section 12.2.""" .


###  http://www.iec.ch/TC57/CIM#DiscExcContIEEEDEC2A
cim:DiscExcContIEEEDEC2A rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC2A.td1 ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:Seconds
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC2A.td2 ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:Seconds
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC2A.vdmax ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:PU
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC2A.vdmin ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:PU
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC2A.vk ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:PU
                                             ] ;
                         rdfs:subClassOf cim:DiscontinuousExcitationControlDynamics ;
                         rdfs:comment """The class represents IEEE Type DEC2A model for the discontinuous excitation control. This system provides transient excitation boosting via an open-loop control as initiated by a trigger signal generated remotely.

Reference: IEEE Standard 421.5-2005 Section 12.3.""" .


###  http://www.iec.ch/TC57/CIM#DiscExcContIEEEDEC3A
cim:DiscExcContIEEEDEC3A rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC3A.tdr ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:Seconds
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:DiscExcContIEEEDEC3A.vtmin ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:PU
                                             ] ;
                         rdfs:subClassOf cim:DiscontinuousExcitationControlDynamics ;
                         rdfs:comment """The class represents IEEE Type DEC3A model. In some systems, the stabilizer output is disconnected from the regulator immediately following a severe fault to prevent the stabilizer from competing with action of voltage regulator during the first swing.

Reference: IEEE Standard 421.5-2005 Section 12.4.""" .


###  http://www.iec.ch/TC57/CIM#Disconnector
cim:Disconnector rdf:type owl:Class ;
                 rdfs:subClassOf cim:Switch ;
                 rdfs:comment "A manually operated or motor operated mechanical switching device used for changing the connections in a circuit, or for isolating a circuit or equipment from a source of power. It is required to open or close circuits when negligible current is broken or made." .


###  http://www.iec.ch/TC57/CIM#DiscontinuousExcitationControlDynamics
cim:DiscontinuousExcitationControlDynamics rdf:type owl:Class ;
                                           rdfs:subClassOf cim:DynamicsFunctionBlock ;
                                           rdfs:comment "Discontinuous excitation control function block whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model</font>." .


###  http://www.iec.ch/TC57/CIM#DiscontinuousExcitationControlUserDefined
cim:DiscontinuousExcitationControlUserDefined rdf:type owl:Class ;
                                              owl:equivalentClass [ rdf:type owl:Restriction ;
                                                                    owl:onProperty cim:DiscontinuousExcitationControlUserDefined.proprietary ;
                                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                    owl:onDataRange xsd:boolean
                                                                  ] ;
                                              rdfs:subClassOf cim:DiscontinuousExcitationControlDynamics ;
                                              rdfs:comment "Discontinuous excitation control function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" .


###  http://www.iec.ch/TC57/CIM#Discrete
cim:Discrete rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Discrete.maxValue ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:nonNegativeInteger
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Discrete.minValue ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:nonNegativeInteger
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Discrete.normalValue ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:nonNegativeInteger
                                 ] ;
             rdfs:subClassOf cim:Measure ;
             rdfs:comment "Discrete represents a discrete Measurement, i.e. a Measurement representing discrete values, e.g. a Breaker position." .


###  http://www.iec.ch/TC57/CIM#DiscreteCommand
cim:DiscreteCommand rdf:type owl:Class ;
                    rdfs:subClassOf cim:Command .


###  http://www.iec.ch/TC57/CIM#DiscreteMeasurementValueQuality
cim:DiscreteMeasurementValueQuality rdf:type owl:Class ;
                                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                                          owl:onProperty cim:DiscreteMeasurementValueQuality.manualReplaceIndicator ;
                                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onDataRange xsd:boolean
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty cim:DiscreteMeasurementValueQuality.removeFromOperationIndicator ;
                                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onDataRange xsd:boolean
                                                        ] ;
                                    rdfs:subClassOf cim:MeasurementValueQuality ;
                                    rdfs:comment "Measurement quality flags for Discrete Values." .


###  http://www.iec.ch/TC57/CIM#DiscreteValue
cim:DiscreteValue rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:DiscreteValue.value ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ;
                  rdfs:subClassOf cim:MeasurementValue ;
                  rdfs:comment "DiscreteValue represents a discrete MeasurementValue." .


###  http://www.iec.ch/TC57/CIM#DispatchAcceptStatus
cim:DispatchAcceptStatus rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Class ;
                                               owl:oneOf ( cim:ACCEPT
                                                           cim:CANNOT
                                                           cim:DECLINE
                                                           cim:NON_RESPONSE
                                                           cim:OK
                                                           cim:PARTIAL
                                                         )
                                             ] .


###  http://www.iec.ch/TC57/CIM#DispatchInstReply
cim:DispatchInstReply rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:DispatchInstReply.acceptMW ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:ActivePower
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:DispatchInstReply.acceptStatus ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:DispatchResponseType
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:DispatchInstReply.clearedMW ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:ActivePower
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:DispatchInstReply.passIndicator ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:PassIndicatorType
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:DispatchInstReply.certificationName ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:DispatchInstReply.instructionTime ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:dateTime
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:DispatchInstReply.instructionType ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:DispatchInstReply.receivedTime ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:dateTime
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:DispatchInstReply.startTime ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:dateTime
                                          ] ;
                      rdfs:subClassOf cim:IdentifiedObject ;
                      rdfs:comment "Response from registered resource acknowleging receipt of dispatch instructions" .


###  http://www.iec.ch/TC57/CIM#DispatchResponseType
cim:DispatchResponseType rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Class ;
                                               owl:oneOf ( cim:ACCEPT
                                                           cim:DECLINE
                                                           cim:NON_RESPONSE
                                                           cim:PARTIAL
                                                         )
                                             ] .


###  http://www.iec.ch/TC57/CIM#DispatchTransactionType
cim:DispatchTransactionType rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Class ;
                                                  owl:oneOf ( cim:Purchase
                                                              cim:Sale
                                                            )
                                                ] .


###  http://www.iec.ch/TC57/CIM#Displacement
cim:Displacement rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Displacement.multiplier ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:UnitMultiplier
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Displacement.unit ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:UnitSymbol
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Displacement.value ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:float
                                     ] ;
                 rdfs:comment "Unit of displacement relative a reference position, hence can be negative." .


###  http://www.iec.ch/TC57/CIM#DistributionFactorSet
cim:DistributionFactorSet rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:DistributionFactorSet.marketType ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:MarketType
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:DistributionFactorSet.intervalEndTime ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:dateTime
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:DistributionFactorSet.intervalStartTime ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:dateTime
                                              ] ;
                          rdfs:comment """A containing class that groups all the distribution factors within a market.   
This is calculated daily for DA factors and hourly for RT factors.""" .


###  http://www.iec.ch/TC57/CIM#Document
cim:Document rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Document.docStatus ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:Status
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Document.electronicAddress ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:ElectronicAddress
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Document.status ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:Status
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Document.authorName ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Document.comment ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Document.createdDateTime ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:dateTime
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Document.lastModifiedDateTime ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:dateTime
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Document.revisionNumber ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Document.subject ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Document.title ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Document.type ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ;
             rdfs:subClassOf cim:IdentifiedObject ;
             rdfs:comment "Parent class for different groupings of information collected and managed as a part of a business process. It will frequently contain references to other objects, such as assets, people and power system resources." .


###  http://www.iec.ch/TC57/CIM#DocumentOrganisationRole
cim:DocumentOrganisationRole rdf:type owl:Class ;
                             rdfs:subClassOf cim:OrganisationRole ;
                             rdfs:comment "Role an organisation plays with respect to documents." .


###  http://www.iec.ch/TC57/CIM#DocumentPersonRole
cim:DocumentPersonRole rdf:type owl:Class ;
                       rdfs:subClassOf cim:PersonRole ;
                       rdfs:comment "Person role with respect to documents." .


###  http://www.iec.ch/TC57/CIM#Domain
cim:Domain rdf:type owl:Class ;
           rdfs:subClassOf cim:IdentifiedObject ;
           rdfs:comment "An area of activity defined within the energy market." .


###  http://www.iec.ch/TC57/CIM#DopInstruction
cim:DopInstruction rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DopInstruction.mwDOP ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePower
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DopInstruction.runIndicatorDOP ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:YesNo
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DopInstruction.updateType ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:MQSCHGType
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DopInstruction.plotPriority ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:nonNegativeInteger
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DopInstruction.timestampDOP ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:dateTime
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DopInstruction.updateTimeStamp ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:dateTime
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DopInstruction.updateUser ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ;
                   rdfs:comment "Provides the necessary information (on a resource basis) to capture the Dispatch Operating Point (DOP) results on a Dispatch interval. This information is only relevant to the RT interval market." .


###  http://www.iec.ch/TC57/CIM#DotInstruction
cim:DotInstruction rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DotInstruction.compliantIndicator ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:YesNo
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DotInstruction.regulationStatus ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:YesNo
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DotInstruction.DOT ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DotInstruction.actualRampRate ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DotInstruction.economicMaxOverride ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DotInstruction.expectedEnergy ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DotInstruction.generatorPerformanceDegree ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DotInstruction.hourAheadSchedEnergy ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DotInstruction.hourlySchedule ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DotInstruction.instructionTime ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:dateTime
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DotInstruction.maximumEmergencyInd ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:boolean
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DotInstruction.meterLoadFollowing ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DotInstruction.nonRampRestrictedMW ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DotInstruction.nonSpinReserve ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DotInstruction.previousDOTTimeStamp ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:dateTime
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DotInstruction.rampRateLimit ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DotInstruction.spinReserve ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DotInstruction.standardRampEnergy ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DotInstruction.supplementalEnergy ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:DotInstruction.unitStatus ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:nonNegativeInteger
                                       ] ;
                   rdfs:comment "Provides the necessary information (on a resource basis) to capture the Dispatch Operating Target (DOT) results on a Dispatch interval. This information is only relevant to the RT interval market." .


###  http://www.iec.ch/TC57/CIM#DroopSignalFeedbackKind
cim:DroopSignalFeedbackKind rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Class ;
                                                  owl:oneOf ( cim:electricalPower
                                                              cim:fuelValveStroke
                                                              cim:governorOutput
                                                              cim:none
                                                            )
                                                ] .


###  http://www.iec.ch/TC57/CIM#DrumBoiler
cim:DrumBoiler rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:DrumBoiler.drumBoilerRating ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ;
               rdfs:subClassOf cim:FossilSteamSupply ;
               rdfs:comment "Drum boiler." .


###  http://www.iec.ch/TC57/CIM#DuctBank
cim:DuctBank rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:DuctBank.circuitCount ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:nonNegativeInteger
                                 ] ;
             rdfs:subClassOf cim:AssetContainer ;
             rdfs:comment "A duct contains individual wires in the layout as specified with associated wire spacing instances; number of them gives the number of conductors in this duct." .


###  http://www.iec.ch/TC57/CIM#Due
cim:Due rdf:type owl:Class ;
        owl:equivalentClass [ rdf:type owl:Restriction ;
                              owl:onProperty cim:Due.arrears ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass cim:Money
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty cim:Due.charges ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass cim:Money
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty cim:Due.current ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass cim:Money
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty cim:Due.interest ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass cim:Money
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty cim:Due.principle ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass cim:Money
                            ] ;
        rdfs:comment "Details on amounts due for an account." .


###  http://www.iec.ch/TC57/CIM#Duration
cim:Duration rdf:type owl:Class ;
             rdfs:comment "Duration as \"PnYnMnDTnHnMnS\" which conforms to ISO 8601, where nY expresses a number of years, nM a number of months, nD a number of days. The letter T separates the date expression from the time expression and, after it, nH identifies a number of hours, nM a number of minutes and nS a number of seconds. The number of seconds could be expressed as a decimal number, but all other numbers are integers." .


###  http://www.iec.ch/TC57/CIM#DynamicSchedule
cim:DynamicSchedule rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:DynamicSchedule.dynSchedSignRev ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:boolean
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:DynamicSchedule.dynSchedStatus ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ;
                    rdfs:subClassOf cim:BasicIntervalSchedule ;
                    rdfs:comment "A continuously variable component of a control area's MW net interchange schedule. Dynamic schedules are sent and received by control areas." .


###  http://www.iec.ch/TC57/CIM#DynamicsFunctionBlock
cim:DynamicsFunctionBlock rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:DynamicsFunctionBlock.enabled ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:boolean
                                              ] ;
                          rdfs:subClassOf cim:IdentifiedObject ;
                          rdfs:comment "Abstract parent class for all Dynamics function blocks." .


###  http://www.iec.ch/TC57/CIM#EarthFaultCompensator
cim:EarthFaultCompensator rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:EarthFaultCompensator.r ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:Resistance
                                              ] ;
                          rdfs:subClassOf cim:ConductingEquipment ;
                          rdfs:comment "A conducting equipment used to represent a connection to ground which is typically used to compensate earth faults..   An earth fault compensator device modeled with a single terminal implies a second terminal solidly connected to ground.  If two terminals are modeled, the ground is not assumed and normal connection rules apply." .


###  http://www.iec.ch/TC57/CIM#Editor
cim:Editor rdf:type owl:Class ;
           rdfs:subClassOf cim:DocumentPersonRole ;
           rdfs:comment "Person who modified the document." .


###  http://www.iec.ch/TC57/CIM#ElectronicAddress
cim:ElectronicAddress rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ElectronicAddress.email1 ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ElectronicAddress.email2 ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ElectronicAddress.lan ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ElectronicAddress.mac ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ElectronicAddress.password ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ElectronicAddress.radio ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ElectronicAddress.userID ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ElectronicAddress.web ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ;
                      rdfs:comment "Electronic address information." .


###  http://www.iec.ch/TC57/CIM#Emission
cim:Emission rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Emission.multiplier ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:UnitMultiplier
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Emission.unit ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:UnitSymbol
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Emission.value ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:float
                                 ] ;
             rdfs:comment "Quantity of emission per fuel heat content." .


###  http://www.iec.ch/TC57/CIM#EmissionAccount
cim:EmissionAccount rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:EmissionAccount.emissionType ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:EmissionType
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:EmissionAccount.emissionValueSource ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:EmissionValueSource
                                        ] ;
                    rdfs:subClassOf cim:Curve ;
                    rdfs:comment "Accounts for tracking emissions usage and credits for thermal generating units. A unit may have zero or more emission accounts, and will typically have one for tracking usage and one for tracking credits." .


###  http://www.iec.ch/TC57/CIM#EmissionCurve
cim:EmissionCurve rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:EmissionCurve.emissionContent ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Emission
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:EmissionCurve.emissionType ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:EmissionType
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:EmissionCurve.isNetGrossP ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:boolean
                                      ] ;
                  rdfs:subClassOf cim:Curve ;
                  rdfs:comment "Relationship between the unit's emission rate in units of mass per hour (Y-axis) and output active power (X-axis) for a given type of emission. This curve applies when only one type of fuel is being burned." .


###  http://www.iec.ch/TC57/CIM#EmissionType
cim:EmissionType rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:oneOf ( cim:carbonDioxide
                                                   cim:carbonDisulfide
                                                   cim:chlorine
                                                   cim:hydrogenSulfide
                                                   cim:nitrogenOxide
                                                 )
                                     ] .


###  http://www.iec.ch/TC57/CIM#EmissionValueSource
cim:EmissionValueSource rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Class ;
                                              owl:oneOf ( cim:calculated
                                                          cim:measured
                                                        )
                                            ] .


###  http://www.iec.ch/TC57/CIM#EndDevice
cim:EndDevice rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:EndDevice.timeZoneOffset ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:Minutes
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:EndDevice.amrSystem ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:EndDevice.installCode ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:EndDevice.isPan ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:boolean
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:EndDevice.isVirtual ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:boolean
                                  ] ;
              rdfs:subClassOf cim:AssetContainer ;
              rdfs:comment """Asset container that performs one or more end device functions. One type of end device is a meter which can perform metering, load management, connect/disconnect, accounting functions, etc. Some end devices, such as ones monitoring and controlling air conditioners, refrigerators, pool pumps may be connected to a meter. All end devices may have communication capability defined by the associated communication function(s). An end device may be owned by a consumer, a service provider, utility or otherwise.
There may be a related end device function that identifies a sensor or control point within a metering application or communications systems (e.g., water, gas, electricity).
Some devices may use an optical port that conforms to the ANSI C12.18 standard for communications.""" .


###  http://www.iec.ch/TC57/CIM#EndDeviceAction
cim:EndDeviceAction rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:EndDeviceAction.duration ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Minutes
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:EndDeviceAction.command ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:EndDeviceAction.durationIndefinite ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:boolean
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:EndDeviceAction.startDateTime ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ;
                    rdfs:comment "Action/command performed by an end device on a device other than the end device." .


###  http://www.iec.ch/TC57/CIM#EndDeviceCapability
cim:EndDeviceCapability rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EndDeviceCapability.autonomousDst ;

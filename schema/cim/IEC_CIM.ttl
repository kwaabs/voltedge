                                          owl:onDataRange xsd:float
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:AuxiliaryValues.incrementalORAvail ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:float
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:AuxiliaryValues.maxExpostCapacity ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:float
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:AuxiliaryValues.minExpostCapacity ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:float
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:AuxiliaryValues.noLoadCost ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:float
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:AuxiliaryValues.startUpCost ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:float
                                        ] ;
                    rdfs:subClassOf cim:AuxiliaryObject ;
                    rdfs:comment "Models Auxillary Values" .



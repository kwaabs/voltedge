                                     owl:onClass cim:StaticLoadModelKind
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:LoadStatic.ep1 ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:LoadStatic.ep2 ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:LoadStatic.ep3 ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:LoadStatic.eq1 ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:LoadStatic.eq2 ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:LoadStatic.eq3 ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:LoadStatic.kp1 ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:LoadStatic.kp2 ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:LoadStatic.kp3 ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:LoadStatic.kp4 ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:LoadStatic.kpf ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:LoadStatic.kq1 ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:LoadStatic.kq2 ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:LoadStatic.kq3 ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:LoadStatic.kq4 ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:LoadStatic.kqf ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ;
               rdfs:subClassOf cim:IdentifiedObject ;
               rdfs:comment "General static load model representing the sensitivity of the real and reactive power consumed by the load to the amplitude and frequency of the bus voltage." .


###  http://www.iec.ch/TC57/CIM#LoadUserDefined
cim:LoadUserDefined rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:LoadUserDefined.proprietary ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:boolean
                                        ] ;
                    rdfs:subClassOf cim:LoadDynamics ;
                    rdfs:comment "Load whose dynamic behaviour is described by a user-defined model." .


###  http://www.iec.ch/TC57/CIM#LocalReliabilityArea
cim:LocalReliabilityArea rdf:type owl:Class ;
                         rdfs:subClassOf cim:IdentifiedObject ;
                         rdfs:comment "Allows definition of reliablity areas (eg load pockets) within the ISO/RTO" .


###  http://www.iec.ch/TC57/CIM#Location
cim:Location rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Location.electronicAddress ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:ElectronicAddress
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Location.mainAddress ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:StreetAddress
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Location.phone1 ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:TelephoneNumber
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Location.phone2 ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:TelephoneNumber
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Location.secondaryAddress ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:StreetAddress
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Location.status ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:Status
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Location.type ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ;
             rdfs:subClassOf cim:IdentifiedObject ;
             rdfs:comment "The place, scene, or point of something where someone or something has been, is, and/or will be at a given moment in time. It can be defined with one or more postition points (coordinates) in a given coordinate system." .


###  http://www.iec.ch/TC57/CIM#LocationGrant
cim:LocationGrant rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:LocationGrant.propertyData ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ;
                  rdfs:subClassOf cim:Agreement ;
                  rdfs:comment "A grant provides a right, as defined by type, for a parcel of land. Note that the association to Location, Asset, Organisation, etc. for the Grant is inherited from Agreement, a type of Document." .


###  http://www.iec.ch/TC57/CIM#LossClearing
cim:LossClearing rdf:type owl:Class ;
                 rdfs:subClassOf cim:MarketFactors ;
                 rdfs:comment "RT only and is published on 5 minute intervals for the previous RT time interval results." .


###  http://www.iec.ch/TC57/CIM#LossClearingResults
cim:LossClearingResults rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:LossClearingResults.lossMW ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ;
                        rdfs:comment "Provides the MW loss for RUC Zones, subcontrol areas, and the total loss." .


###  http://www.iec.ch/TC57/CIM#LossProfile
cim:LossProfile rdf:type owl:Class ;
                rdfs:subClassOf cim:Profile ;
                rdfs:comment "LossProfile is associated with an EnerrgyTransaction and must be completely contained within the time frame of the EnergyProfile associated with this EnergyTransaction." .


###  http://www.iec.ch/TC57/CIM#LossSensitivity
cim:LossSensitivity rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:LossSensitivity.lossFactor ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:float
                                        ] ;
                    rdfs:subClassOf cim:MarketFactors ;
                    rdfs:comment "Loss sensitivity applied to a ConnectivityNode for a given time interval." .


###  http://www.iec.ch/TC57/CIM#MPMClearing
cim:MPMClearing rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:MPMClearing.LMPMFinalFlag ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:YesNo
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:MPMClearing.SMPMFinalFlag ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:YesNo
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:MPMClearing.mitigationOccuredFlag ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:YesNo
                                    ] ;
                rdfs:subClassOf cim:MarketFactors ;
                rdfs:comment "Model of results of Market Power tests, and possible mitigation. Interval based" .


###  http://www.iec.ch/TC57/CIM#MPMResourceStatus
cim:MPMResourceStatus rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:MPMResourceStatus.resourceStatus ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ;
                      rdfs:comment "Model of results of Market Power tests, gives status of resource for the associated interval" .


###  http://www.iec.ch/TC57/CIM#MPMTestCategory
cim:MPMTestCategory rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:MPMTestCategory.purposeFlag ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:PurposeFlagType
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:MPMTestCategory.testIdentifier ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:MPMTestIdentifierType
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:MPMTestCategory.testMethod ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:MPMTestMethodType
                                        ] ;
                    rdfs:subClassOf cim:IdentifiedObject ;
                    rdfs:comment "Provides a reference to the Market Power Mitigation test identifiers and methods for the results of the DA or RT markets. Specific data is the test identifier (Price, Conduct, or Impact) and the test method (System MPM, Local MPM, Alternate System MPM, or Alternate Local MPM)." .


###  http://www.iec.ch/TC57/CIM#MPMTestIdentifierType
cim:MPMTestIdentifierType rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Class ;
                                                owl:oneOf ( <http://www.iec.ch/TC57/CIM#1>
                                                            <http://www.iec.ch/TC57/CIM#2>
                                                            <http://www.iec.ch/TC57/CIM#3>
                                                            <http://www.iec.ch/TC57/CIM#4>
                                                            <http://www.iec.ch/TC57/CIM#5>
                                                            <http://www.iec.ch/TC57/CIM#6>
                                                          )
                                              ] .


###  http://www.iec.ch/TC57/CIM#MPMTestMethodType
cim:MPMTestMethodType rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Class ;
                                            owl:oneOf ( cim:ALTERNATE
                                                        cim:NORMAL
                                                      )
                                          ] .


###  http://www.iec.ch/TC57/CIM#MPMTestOutcome
cim:MPMTestOutcome rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Class ;
                                         owl:oneOf ( cim:D
                                                     cim:F
                                                     cim:P
                                                     cim:S
                                                   )
                                       ] .


###  http://www.iec.ch/TC57/CIM#MPMTestResults
cim:MPMTestResults rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:MPMTestResults.marginPercent ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:PerCent
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:MPMTestResults.outcome ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:MPMTestOutcome
                                       ] ;
                   rdfs:comment "Provides the outcome and margin percent (as appropriate) result data for the MPM tests.  There are relationships to Zone for Designated Congestion Area Tests, CurveSchedData for bid segment tests, to the SubControlArea for the system wide level tests, and Pnodes for the LMPM impact tests." .


###  http://www.iec.ch/TC57/CIM#MPMTestThreshold
cim:MPMTestThreshold rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:MPMTestThreshold.marketType ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:MarketType
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:MPMTestThreshold.percent ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:PerCent
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:MPMTestThreshold.price ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:CostPerEnergyUnit
                                         ] ;
                     rdfs:comment "Market Power Mitigation (MPM) test thresholds for resource as well as designated congestion areas (DCAs)" .


###  http://www.iec.ch/TC57/CIM#MQSCHGType
cim:MQSCHGType rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:oneOf ( cim:ADD
                                                 cim:CHG
                                               )
                                   ] .


###  http://www.iec.ch/TC57/CIM#MQSDELType
cim:MQSDELType rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:oneOf ( cim:ADD
                                                 cim:CHG
                                                 cim:DEL
                                               )
                                   ] .


###  http://www.iec.ch/TC57/CIM#MQSInstructionSource
cim:MQSInstructionSource rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Class ;
                                               owl:oneOf ( cim:ACT
                                                           cim:INS
                                                         )
                                             ] .


###  http://www.iec.ch/TC57/CIM#MSSAggregation
cim:MSSAggregation rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:MSSAggregation.costRecovery ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:YesNo
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:MSSAggregation.grossSettlement ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:YesNo
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:MSSAggregation.ignoreLosses ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:YesNo
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:MSSAggregation.ignoreMarginalLosses ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:YesNo
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:MSSAggregation.loadFollowing ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:YesNo
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:MSSAggregation.rucProcurement ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:YesNo
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:MSSAggregation.endEffectiveDate ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:dateTime
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:MSSAggregation.startEffectiveDate ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:dateTime
                                       ] ;
                   rdfs:subClassOf cim:IdentifiedObject ;
                   rdfs:comment "Metered Sub-System aggregation of MSS Zones." .


###  http://www.iec.ch/TC57/CIM#MSSZone
cim:MSSZone rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:MSSZone.ignoreLosses ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:YesNo
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:MSSZone.rucGrossSettlement ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:YesNo
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:MSSZone.lossFactor ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:float
                                ] ;
            rdfs:subClassOf cim:AggregateNode ;
            rdfs:comment "Model to define a zone within a Metered Sub System" .


###  http://www.iec.ch/TC57/CIM#MWLimitSchedule
cim:MWLimitSchedule rdf:type owl:Class ;
                    rdfs:comment "Maximum MW and optionally Minimum MW (Y1 and Y2, respectively)" .


###  http://www.iec.ch/TC57/CIM#MacroPeriodKind
cim:MacroPeriodKind rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:oneOf ( cim:billingPeriod
                                                      cim:daily
                                                      cim:monthly
                                                      cim:none
                                                      cim:seasonal
                                                      cim:specifiedPeriod
                                                      cim:weekly
                                                    )
                                        ] .


###  http://www.iec.ch/TC57/CIM#Maintainer
cim:Maintainer rdf:type owl:Class ;
               rdfs:subClassOf cim:AssetOrganisationRole ;
               rdfs:comment "Organisation that maintains assets." .


###  http://www.iec.ch/TC57/CIM#MaintenanceDataSet
cim:MaintenanceDataSet rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:MaintenanceDataSet.conditionAfter ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:MaintenanceDataSet.conditionBefore ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:MaintenanceDataSet.maintCode ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ;
                       rdfs:subClassOf cim:ProcedureDataSet ;
                       rdfs:comment "The result of a maintenance activity, a type of Procedure, for a given attribute of an asset." .


###  http://www.iec.ch/TC57/CIM#MaintenanceLocation
cim:MaintenanceLocation rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:MaintenanceLocation.block ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:string
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:MaintenanceLocation.lot ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:string
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:MaintenanceLocation.nearestIntersection ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:string
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:MaintenanceLocation.subdivision ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:string
                                            ] ;
                        rdfs:subClassOf cim:WorkLocation ;
                        rdfs:comment "Location where to perform maintenance work." .


###  http://www.iec.ch/TC57/CIM#MajorChargeGroup
cim:MajorChargeGroup rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:MajorChargeGroup.effectiveDate ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:dateTime
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:MajorChargeGroup.frequencyType ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:MajorChargeGroup.invoiceType ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:MajorChargeGroup.requireAutorun ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:MajorChargeGroup.revisionNumber ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:MajorChargeGroup.runType ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:MajorChargeGroup.runVersion ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:MajorChargeGroup.terminationDate ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:dateTime
                                         ] ;
                     rdfs:subClassOf cim:IdentifiedObject ;
                     rdfs:comment "A Major Charge Group is the same as Invocie Type which provides the highest level of grouping for charge types configration. Examples as Market, FERC, RMR," .


###  http://www.iec.ch/TC57/CIM#Manufacturer
cim:Manufacturer rdf:type owl:Class ;
                 rdfs:subClassOf cim:OrganisationRole ;
                 rdfs:comment "Organisation that manufactures asset products." .


###  http://www.iec.ch/TC57/CIM#Market
cim:Market rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Market.actualEnd ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:dateTime
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Market.actualStart ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:dateTime
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Market.dst ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:boolean
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Market.end ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:dateTime
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Market.localTimeZone ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Market.start ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:dateTime
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Market.status ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Market.timeIntervalLength ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:float
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Market.tradingDay ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:dateTime
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Market.tradingPeriod ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ;
           rdfs:subClassOf cim:IdentifiedObject ;
           rdfs:comment "Market (e.g. Day Ahead Market, RealTime Market) with a description of the the Market operation control parameters." .


###  http://www.iec.ch/TC57/CIM#MarketActualEvent
cim:MarketActualEvent rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:MarketActualEvent.eventStatus ;
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:MarketEventStatusKind
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:MarketActualEvent.eventComments ;
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:MarketActualEvent.eventType ;
                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:MarketActualEvent.eventEndTime ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:dateTime
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:MarketActualEvent.eventStartTime ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:dateTime
                                          ] ;
                      rdfs:subClassOf cim:IdentifiedObject ;
                      rdfs:comment "This class represent the actual instance of an event." .


###  http://www.iec.ch/TC57/CIM#MarketAgreement
cim:MarketAgreement rdf:type owl:Class ;
                    rdfs:subClassOf cim:MarketDocument ;
                    rdfs:comment "An identification  or eventually the contents of an agreement between two or more parties." .


###  http://www.iec.ch/TC57/CIM#MarketCaseClearing
cim:MarketCaseClearing rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:MarketCaseClearing.caseType ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:MarketCaseClearing.modifiedDate ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:dateTime
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:MarketCaseClearing.postedDate ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:dateTime
                                           ] ;
                       rdfs:subClassOf cim:MarketFactors ;
                       rdfs:comment "Market case clearing results are posted for a given settlement period." .


###  http://www.iec.ch/TC57/CIM#MarketDocument
cim:MarketDocument rdf:type owl:Class ;
                   rdfs:subClassOf cim:Document ;
                   rdfs:comment "Electronic document containing the information necessary to satisfy a given business process set of requirements." .


###  http://www.iec.ch/TC57/CIM#MarketEvaluationPoint
cim:MarketEvaluationPoint rdf:type owl:Class ;
                          rdfs:subClassOf cim:IdentifiedObject ;
                          rdfs:comment "The identification of an entity where energy products are measured or computed." .


###  http://www.iec.ch/TC57/CIM#MarketEventStatusKind
cim:MarketEventStatusKind rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Class ;
                                                owl:oneOf ( cim:active
                                                            cim:cancelled
                                                            cim:completed
                                                            cim:planned
                                                          )
                                              ] .


###  http://www.iec.ch/TC57/CIM#MarketFactors
cim:MarketFactors rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:MarketFactors.intervalEndTime ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTime
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:MarketFactors.intervalStartTime ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTime
                                      ] ;
                  rdfs:subClassOf cim:Document ;
                  rdfs:comment "Aggregation of market information relative for a specific time interval." .


###  http://www.iec.ch/TC57/CIM#MarketInvoice
cim:MarketInvoice rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:MarketInvoice.amount ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Money
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:MarketInvoice.billMediaKind ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:MktBillMediaKind
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:MarketInvoice.kind ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:MktAccountKind
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:MarketInvoice.dueDate ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:date
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:MarketInvoice.mailedDate ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:date
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:MarketInvoice.proForma ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:boolean
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:MarketInvoice.referenceNumber ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:MarketInvoice.transactionDateTime ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTime
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:MarketInvoice.transferType ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ;
                  rdfs:comment "A roll up of invoice line items. The whole invoice has a due date and amount to be paid, with information such as customer, banks etc. being obtained through associations. The invoice roll up is based on individual line items that each contain amounts and descriptions for specific services or products." .



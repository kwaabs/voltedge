                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:AccountingUnit.value ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ;
                   rdfs:comment "Unit for accounting; use either 'energyUnit' or 'currencyUnit' to specify the unit for 'value'." .


###  http://www.iec.ch/TC57/CIM#AccumulationKind
cim:AccumulationKind rdf:type owl:Class ;

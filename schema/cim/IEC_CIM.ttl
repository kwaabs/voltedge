                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Tender.kind ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:TenderKind
                               ] ;
           rdfs:subClassOf cim:IdentifiedObject ;
           rdfs:comment """Tender is what is \"offered\" by the customer towards making a payment and is often more than the required payment (hence the need for 'change'). The payment is thus that part of the Tender that goes towards settlement of a particular transaction.
Tender is modelled as an aggregation of Cheque and Card. Both these tender types can exist in a single tender bid thus 'accountHolderName' has to exist separately in each of Cheque and Card as each could have a different account holder name.""" .


###  http://www.iec.ch/TC57/CIM#TenderKind
cim:TenderKind rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:oneOf ( cim:card
                                                 cim:cash
                                                 cim:cheque
                                                 cim:other
                                                 cim:unspecified
                                               )
                                   ] .


###  http://www.iec.ch/TC57/CIM#Terminal
cim:Terminal rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Terminal.phases ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:PhaseCode
                                 ] ;
             rdfs:subClassOf cim:ACDCTerminal ;
             rdfs:comment "An AC electrical connection point to a piece of conducting equipment. Terminals are connected at physical connection points called connectivity nodes." .


###  http://www.iec.ch/TC57/CIM#TerminalConstraintTerm
cim:TerminalConstraintTerm rdf:type owl:Class ;
                           rdfs:subClassOf cim:ConstraintTerm ;
                           rdfs:comment "A constraint term associated with a specific terminal on a physical piece of equipment." .


###  http://www.iec.ch/TC57/CIM#TestDataSet
cim:TestDataSet rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:TestDataSet.conclusion ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:TestDataSet.specimenID ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:TestDataSet.specimenToLabDateTime ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:dateTime
                                    ] ;
                rdfs:subClassOf cim:ProcedureDataSet ;
                rdfs:comment "Test results, usually obtained by a lab or other independent organisation." .


###  http://www.iec.ch/TC57/CIM#Text
cim:Text rdf:type owl:Class .


###  http://www.iec.ch/TC57/CIM#TextDiagramObject
cim:TextDiagramObject rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:TextDiagramObject.text ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ;
                      rdfs:subClassOf cim:DiagramObject ;
                      rdfs:comment "A diagram object for placing free-text or text derived from an associated domain object." .


###  http://www.iec.ch/TC57/CIM#ThermalGeneratingUnit
cim:ThermalGeneratingUnit rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ThermalGeneratingUnit.oMCost ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:CostPerHeatUnit
                                              ] ;
                          rdfs:subClassOf cim:GeneratingUnit ;
                          rdfs:comment "A generating unit whose prime mover could be a steam turbine, combustion turbine, or diesel engine." .


###  http://www.iec.ch/TC57/CIM#TieFlow
cim:TieFlow rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:TieFlow.positiveFlowIn ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:boolean
                                ] ;
            rdfs:comment "A flow specification in terms of location and direction for a control area." .


###  http://www.iec.ch/TC57/CIM#TieLine
cim:TieLine rdf:type owl:Class ;
            rdfs:subClassOf cim:IdentifiedObject .


###  http://www.iec.ch/TC57/CIM#TiePoint
cim:TiePoint rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:TiePoint.tiePointMWRating ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:ActivePower
                                 ] ;
             rdfs:subClassOf cim:IdentifiedObject ;
             rdfs:comment "Site of an interface between interchange areas. The tie point can be a network branch (e.g., transmission line or transformer) or a switching device. For transmission lines, the interchange area boundary is usually at a designated point such as the middle of the line. Line end metering is then corrected for line losses." .


###  http://www.iec.ch/TC57/CIM#Time
cim:Time rdf:type owl:Class ;
         rdfs:comment "Time as \"hh:mm:ss.sss\", which conforms with ISO 8601. UTC time zone is specified as \"hh:mm:ss.sssZ\". A local timezone relative UTC is specified as \"hh:mm:ss.sss±hh:mm\". The second component (shown here as \"ss.sss\") could have any number of digits in its fractional part to allow any kind of precision beyond seconds." .


###  http://www.iec.ch/TC57/CIM#TimeInterval
cim:TimeInterval rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:TimeInterval.end ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Time
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:TimeInterval.start ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Time
                                     ] ;
                 rdfs:comment "Interval between two times." .


###  http://www.iec.ch/TC57/CIM#TimeOfUse
cim:TimeOfUse rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Class ;
                                    owl:oneOf ( cim:OFF
                                                cim:ON
                                                <http://www.iec.ch/TC57/CIM#24HR>
                                              )
                                  ] .


###  http://www.iec.ch/TC57/CIM#TimePoint
cim:TimePoint rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:TimePoint.relativeTimeInterval ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:Seconds
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:TimePoint.status ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:Status
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:TimePoint.window ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:DateTimeInterval
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:TimePoint.dateTime ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:dateTime
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:TimePoint.sequenceNumber ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:nonNegativeInteger
                                  ] ;
              rdfs:subClassOf cim:IdentifiedObject ;
              rdfs:comment "A point in time within a sequence of points in time relative to a time schedule." .


###  http://www.iec.ch/TC57/CIM#TimeSchedule
cim:TimeSchedule rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:TimeSchedule.offset ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Seconds
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:TimeSchedule.recurrencePeriod ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Seconds
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:TimeSchedule.scheduleInterval ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:DateTimeInterval
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:TimeSchedule.disabled ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:boolean
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:TimeSchedule.recurrencePattern ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ;
                 rdfs:subClassOf cim:Document ;
                 rdfs:comment "Description of anything that changes through time. Time schedule is used to perform a single-valued function of time. Use inherited 'type' attribute to give additional information on this schedule, such as: periodic (hourly, daily, weekly, monthly, etc.), day of the month, by date, calendar (specific times and dates)." .


###  http://www.iec.ch/TC57/CIM#TimeSeries
cim:TimeSeries rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TimeSeries.businessType ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TimeSeries.cancelledTS ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TimeSeries.curveType ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TimeSeries.objectAggregation ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TimeSeries.product ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TimeSeries.version ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ;
               rdfs:subClassOf cim:IdentifiedObject ;
               rdfs:comment "A set of regular time-ordered measurements or values of quantitative nature of an individual or collective phenomenon taken at successive, in most cases equidistant, periods / points of time." .


###  http://www.iec.ch/TC57/CIM#TimeTariffInterval
cim:TimeTariffInterval rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:TimeTariffInterval.startTime ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Time
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:TimeTariffInterval.sequenceNumber ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:nonNegativeInteger
                                           ] ;
                       rdfs:comment "One of a sequence of time intervals defined in terms of real time. It is typically used in association with TariffProfile to define the intervals in a time of use tariff structure, where startDateTime simultaneously determines the starting point of this interval and the ending point of the previous interval." .


###  http://www.iec.ch/TC57/CIM#TimeZoneType
cim:TimeZoneType rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:oneOf ( cim:PPT
                                                 )
                                     ] .


###  http://www.iec.ch/TC57/CIM#Tool
cim:Tool rdf:type owl:Class ;
         owl:equivalentClass [ rdf:type owl:Restriction ;
                               owl:onProperty cim:Tool.lastCalibrationDate ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:date
                             ] ;
         rdfs:subClassOf cim:WorkAsset ;
         rdfs:comment "Tool asset." .


###  http://www.iec.ch/TC57/CIM#TopologicalIsland
cim:TopologicalIsland rdf:type owl:Class ;
                      rdfs:subClassOf cim:IdentifiedObject ;
                      rdfs:comment """An electrically connected subset of the network. Topological islands can change as the current network state changes: e.g. due to 
- disconnect switches or breakers change state in a SCADA/EMS
- manual creation, change or deletion of topological nodes in a planning tool.""" .


###  http://www.iec.ch/TC57/CIM#TopologicalNode
cim:TopologicalNode rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:TopologicalNode.pInjection ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:ActivePower
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:TopologicalNode.qInjection ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:ReactivePower
                                        ] ;
                    rdfs:subClassOf cim:IdentifiedObject ;
                    rdfs:comment """For a detailed substation model a topological node is a set of connectivity nodes that, in the current network state, are connected together through any type of closed switches, including  jumpers. Topological nodes change as the current network state changes (i.e., switches, breakers, etc. change state).
For a planning model, switch statuses are not used to form topological nodes. Instead they are manually created or deleted in a model builder tool. Topological nodes maintained this way are also called \"busses\".""" .


###  http://www.iec.ch/TC57/CIM#Tower
cim:Tower rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Tower.constructionKind ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:TowerConstructionKind
                              ] ;
          rdfs:subClassOf cim:Structure ;
          rdfs:comment """Tower asset. Dimensions of the Tower are specified in associated DimensionsInfo class.
When used for planning purposes, a transmission tower carrying two 3-phase circuits will have 2 instances of Connection, each of which will have 3 MountingPoint instances, one for each phase all with coordinates relative to a common origin on the tower. (It may also have a 3rd Connection with a single MountingPoint for the Neutral line).""" .


###  http://www.iec.ch/TC57/CIM#TowerConstructionKind
cim:TowerConstructionKind rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Class ;
                                                owl:oneOf ( cim:suspension
                                                            cim:tension
                                                          )
                                              ] .


###  http://www.iec.ch/TC57/CIM#TownDetail
cim:TownDetail rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TownDetail.code ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TownDetail.country ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TownDetail.name ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TownDetail.section ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TownDetail.stateOrProvince ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ;
               rdfs:comment "Town details, in the context of address." .


###  http://www.iec.ch/TC57/CIM#Trade
cim:Trade rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Trade.marketType ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:MarketType
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Trade.adjustedTradeQuantity ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:float
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Trade.counterTradeQuantity ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:float
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Trade.dependOnTradeName ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:string
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Trade.lastModified ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:dateTime
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Trade.startTime ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:dateTime
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Trade.stopTime ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:dateTime
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Trade.submitFromTimeStamp ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:dateTime
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Trade.submitFromUser ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:string
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Trade.submitToTimeStamp ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:dateTime
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Trade.submitToUser_ ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:string
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Trade.tradeQuantity ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:float
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Trade.tradeStatus ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:string
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Trade.updateTimeStamp ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:dateTime
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Trade.updateUser ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:string
                              ] ;
          rdfs:subClassOf cim:IdentifiedObject ;
          rdfs:comment "Inter Scheduling Coordinator Trades to model financial trades which may impact settlement" .


###  http://www.iec.ch/TC57/CIM#TradeError
cim:TradeError rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TradeError.endTime ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:dateTime
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TradeError.errMessage ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TradeError.errPriority ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:nonNegativeInteger
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TradeError.logTimeStamp ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:dateTime
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TradeError.ruleID ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:nonNegativeInteger
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TradeError.startTime ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:dateTime
                                   ] ;
               rdfs:subClassOf cim:IdentifiedObject ;
               rdfs:comment "Trade error and warning messages associated with the rule engine processing of the submitted trade." .


###  http://www.iec.ch/TC57/CIM#TradeProduct
cim:TradeProduct rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:TradeProduct.tradeType ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:TradeType
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:TradeProduct.tradeProductType ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ;
                 rdfs:comment """<b>TradeType</b>                                        <b>TradeProduct</b>
IST  (InterSC Trade)                          PHY (Physical Energy Trade)
IST                                                  APN (Energy Trades at Aggregated Pricing Nodes)
IST                                                  CPT (Converted Physical Energy Trade)
AST (Ancilliary Services Trade)             RUT (Regulation Up Trade)
AST                                                 RDT (Regulation Down Trade)
AST                                                 SRT (Spinning Reserve Trade)
AST                                                 NRT (Non-Spinning Reserve Trade)
UCT (Unit Commitment Trade)            null""" .


###  http://www.iec.ch/TC57/CIM#TradeProductType
cim:TradeProductType rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:oneOf ( cim:APN
                                                       cim:CAP
                                                       cim:NRT
                                                       cim:PHY
                                                       cim:RDT
                                                       cim:RUT
                                                       cim:SRT
                                                     )
                                         ] .


###  http://www.iec.ch/TC57/CIM#TradeStatusType
cim:TradeStatusType rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:oneOf ( cim:CI
                                                      cim:CM
                                                      cim:CV
                                                      cim:CX
                                                      cim:I
                                                      cim:M
                                                      cim:MT
                                                      cim:O
                                                      cim:RJ
                                                      cim:U
                                                      cim:V
                                                    )
                                        ] .


###  http://www.iec.ch/TC57/CIM#TradeType
cim:TradeType rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Class ;
                                    owl:oneOf ( cim:AST
                                                cim:IST
                                                cim:UCT
                                              )
                                  ] .


###  http://www.iec.ch/TC57/CIM#TradingHubPrice
cim:TradingHubPrice rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:TradingHubPrice.marketType ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:MarketType
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:TradingHubPrice.intervalStartTime ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:TradingHubPrice.updateTimeStamp ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:TradingHubPrice.updateUser ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ;
                    rdfs:comment "Models prices at Trading Hubs, interval based" .


###  http://www.iec.ch/TC57/CIM#TradingHubValues
cim:TradingHubValues rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:TradingHubValues.price ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:float
                                         ] ;
                     rdfs:comment "Models prices at Trading Hubs" .


###  http://www.iec.ch/TC57/CIM#Transaction
cim:Transaction rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Transaction.kind ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:TransactionKind
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Transaction.line ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:LineDetail
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Transaction.serviceUnitsEnergy ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:RealEnergy
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Transaction.serviceUnitsError ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:RealEnergy
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Transaction.diverseReference ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Transaction.donorReference ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Transaction.receiverReference ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Transaction.reversedId ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ;
                rdfs:subClassOf cim:IdentifiedObject ;
                rdfs:comment "The record of details of payment for service or token sale." .


###  http://www.iec.ch/TC57/CIM#TransactionBid
cim:TransactionBid rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:TransactionBid.demandTransaction ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:boolean
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:TransactionBid.dispatchable ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:boolean
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:TransactionBid.payCongestion ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:boolean
                                       ] ;
                   rdfs:subClassOf cim:Bid ;
                   rdfs:comment "Bilateral or scheduled transactions for energy and ancillary services considered by market clearing process" .


###  http://www.iec.ch/TC57/CIM#TransactionBidClearing
cim:TransactionBidClearing rdf:type owl:Class ;
                           rdfs:subClassOf cim:MarketFactors ;
                           rdfs:comment "Contains the intervals relavent for the associated TransactionBidResults. For example, Day Ahead cleared results for the transaction bids for each interval of the market day." .


###  http://www.iec.ch/TC57/CIM#TransactionBidResults
cim:TransactionBidResults rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:TransactionBidResults.clearedMW ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:float
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:TransactionBidResults.clearedPrice ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:float
                                              ] ;
                          rdfs:subClassOf cim:IdentifiedObject ;
                          rdfs:comment "Contains the cleared results for each TransactionBid submitted to and accepted by the market." .


###  http://www.iec.ch/TC57/CIM#TransactionKind
cim:TransactionKind rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:oneOf ( cim:accountPayment
                                                      cim:auxiliaryChargePayment
                                                      cim:diversePayment
                                                      cim:meterConfigurationToken
                                                      cim:other
                                                      cim:serviceChargePayment
                                                      cim:taxChargePayment
                                                      cim:tokenCancellation
                                                      cim:tokenExchange
                                                      cim:tokenFreeIssue
                                                      cim:tokenGrant
                                                      cim:tokenSalePayment
                                                      cim:transactionReversal
                                                    )
                                        ] .


###  http://www.iec.ch/TC57/CIM#Transactor
cim:Transactor rdf:type owl:Class ;
               rdfs:subClassOf cim:IdentifiedObject ;
               rdfs:comment "The entity that ultimately executes the transaction and which is in control of the process; typically this is embodied in secure software running on a server that may employ secure hardware encryption devices for secure transaction processing." .


###  http://www.iec.ch/TC57/CIM#TransferInterface
cim:TransferInterface rdf:type owl:Class ;
                      rdfs:subClassOf cim:IdentifiedObject ;
                      rdfs:comment "A Transfer Interface is made up of branches such as transmission lines and transformers." .


###  http://www.iec.ch/TC57/CIM#TransferInterfaceSolution
cim:TransferInterfaceSolution rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Restriction ;
                                                    owl:onProperty cim:TransferInterfaceSolution.interfaceMargin ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onDataRange xsd:float
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty cim:TransferInterfaceSolution.postTransferMW ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onDataRange xsd:float
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty cim:TransferInterfaceSolution.transferLimit ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onDataRange xsd:float
                                                  ] ;
                              rdfs:comment "TNA Interface Definitions from OPF for VSA" .


###  http://www.iec.ch/TC57/CIM#TransformerConstructionKind
cim:TransformerConstructionKind rdf:type owl:Class ;
                                owl:equivalentClass [ rdf:type owl:Class ;
                                                      owl:oneOf ( cim:aerial
                                                                  cim:dryType
                                                                  cim:network
                                                                  cim:onePhase
                                                                  cim:overhead
                                                                  cim:padmountDeadFront
                                                                  cim:padmountFeedThrough
                                                                  cim:padmountLiveFront
                                                                  cim:padmountLoopThrough
                                                                  cim:padmounted
                                                                  cim:subway
                                                                  cim:threePhase
                                                                  cim:underground
                                                                  cim:unknown
                                                                  cim:vault
                                                                  cim:vaultThreePhase
                                                                )
                                                    ] .


###  http://www.iec.ch/TC57/CIM#TransformerControlMode
cim:TransformerControlMode rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Class ;
                                                 owl:oneOf ( cim:reactive
                                                             cim:volt
                                                           )
                                               ] .


###  http://www.iec.ch/TC57/CIM#TransformerCoreAdmittance
cim:TransformerCoreAdmittance rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Restriction ;
                                                    owl:onProperty cim:TransformerCoreAdmittance.b ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onClass cim:Susceptance
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty cim:TransformerCoreAdmittance.b0 ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onClass cim:Susceptance
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty cim:TransformerCoreAdmittance.g ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onClass cim:Conductance
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty cim:TransformerCoreAdmittance.g0 ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onClass cim:Conductance
                                                  ] ;
                              rdfs:subClassOf cim:IdentifiedObject ;
                              rdfs:comment "The transformer core admittance.  Used to specify the core admittance of a transformer in a manner that can be shared among power transformers." .


###  http://www.iec.ch/TC57/CIM#TransformerCoreKind
cim:TransformerCoreKind rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Class ;
                                              owl:oneOf ( cim:core
                                                          cim:shell
                                                        )
                                            ] .


###  http://www.iec.ch/TC57/CIM#TransformerEnd
cim:TransformerEnd rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:TransformerEnd.bmagSat ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:PerCent
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:TransformerEnd.magBaseU ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Voltage
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:TransformerEnd.magSatFlux ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:PerCent
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:TransformerEnd.rground ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Resistance
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:TransformerEnd.xground ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Reactance
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:TransformerEnd.endNumber ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:nonNegativeInteger
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:TransformerEnd.grounded ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:boolean
                                       ] ;
                   rdfs:subClassOf cim:IdentifiedObject ;
                   rdfs:comment "A conducting connection point of a power transformer. It corresponds to a physical transformer winding terminal.  In earlier CIM versions, the TransformerWinding class served a similar purpose, but this class is more flexible because it associates to terminal but is not a specialization of ConductingEquipment." .


###  http://www.iec.ch/TC57/CIM#TransformerEndInfo
cim:TransformerEndInfo rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:TransformerEndInfo.connectionKind ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:WindingConnection
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:TransformerEndInfo.emergencyS ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:ApparentPower
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:TransformerEndInfo.insulationU ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Voltage
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:TransformerEndInfo.r ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Resistance
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:TransformerEndInfo.ratedS ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:ApparentPower
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:TransformerEndInfo.ratedU ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Voltage
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:TransformerEndInfo.shortTermS ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:ApparentPower
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:TransformerEndInfo.endNumber ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:nonNegativeInteger
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:TransformerEndInfo.phaseAngleClock ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:nonNegativeInteger
                                           ] ;
                       rdfs:subClassOf cim:AssetInfo ;
                       rdfs:comment "Transformer end data." .


###  http://www.iec.ch/TC57/CIM#TransformerFunctionKind
cim:TransformerFunctionKind rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Class ;
                                                  owl:oneOf ( cim:autotransformer
                                                              cim:other
                                                              cim:powerTransformer
                                                              cim:secondaryTransformer
                                                              cim:voltageRegulator
                                                            )
                                                ] .


###  http://www.iec.ch/TC57/CIM#TransformerMeshImpedance
cim:TransformerMeshImpedance rdf:type owl:Class ;
                             owl:equivalentClass [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:TransformerMeshImpedance.r ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:Resistance
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:TransformerMeshImpedance.r0 ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:Resistance
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:TransformerMeshImpedance.x ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:Reactance
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:TransformerMeshImpedance.x0 ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:Reactance
                                                 ] ;
                             rdfs:subClassOf cim:IdentifiedObject ;
                             rdfs:comment """Transformer mesh impedance (Delta-model) between transformer ends.
The typical case is that this class describes the impedance between two transformer ends pair-wise, i.e. the cardinalities at both tranformer end associations are 1. But in cases where two or more transformer ends are modeled the cardinalities are larger than 1.""" .


###  http://www.iec.ch/TC57/CIM#TransformerObservation
cim:TransformerObservation rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:TransformerObservation.bushingTemp ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:Temperature
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:TransformerObservation.hotSpotTemp ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:Temperature
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:TransformerObservation.oilDielectricStrength ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:Voltage
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:TransformerObservation.status ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:Status
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:TransformerObservation.topOilTemp ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:Temperature
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:TransformerObservation.dga ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:TransformerObservation.freqResp ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:TransformerObservation.furfuralDP ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:TransformerObservation.oilColor ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:TransformerObservation.oilIFT ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:TransformerObservation.oilLevel ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:TransformerObservation.oilNeutralizationNumber ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:TransformerObservation.pumpVibration ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:TransformerObservation.waterContent ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ;
                           rdfs:subClassOf cim:IdentifiedObject ;
                           rdfs:comment "Common information captured during transformer inspections and/or diagnostics. Note that some properties may be measured through other means and therefore have measurement values in addition to the observed values recorded here." .


###  http://www.iec.ch/TC57/CIM#TransformerStarImpedance
cim:TransformerStarImpedance rdf:type owl:Class ;
                             owl:equivalentClass [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:TransformerStarImpedance.r ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:Resistance
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:TransformerStarImpedance.r0 ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:Resistance
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:TransformerStarImpedance.x ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:Reactance
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:TransformerStarImpedance.x0 ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:Reactance
                                                 ] ;
                             rdfs:subClassOf cim:IdentifiedObject ;
                             rdfs:comment """Transformer star impedance (Pi-model) that accurately reflects impedance for transformers with 2 or 3 windings. For transformers with 4 or more windings, you must use TransformerMeshImpedance class.
For transmission networks use PowerTransformerEnd impedances (r, r0, x, x0, b, b0, g and g0).""" .


###  http://www.iec.ch/TC57/CIM#TransformerTank
cim:TransformerTank rdf:type owl:Class ;
                    rdfs:subClassOf cim:Equipment ;
                    rdfs:comment "An assembly of two or more coupled windings that transform electrical power between voltage levels. These windings are bound on a common core and place in the same tank. Transformer tank can be used to model both single-phase and 3-phase transformers." .


###  http://www.iec.ch/TC57/CIM#TransformerTankEnd
cim:TransformerTankEnd rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:TransformerTankEnd.phases ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:PhaseCode
                                           ] ;
                       rdfs:subClassOf cim:TransformerEnd ;
                       rdfs:comment "Transformer tank end represents an individual winding for unbalanced models or for transformer tanks connected into a bank (and bank is modelled with the PowerTransformer)." .


###  http://www.iec.ch/TC57/CIM#TransformerTankInfo
cim:TransformerTankInfo rdf:type owl:Class ;
                        rdfs:subClassOf cim:AssetInfo ;
                        rdfs:comment "Set of transformer tank data, from an equipment library." .


###  http://www.iec.ch/TC57/CIM#TransformerTest
cim:TransformerTest rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:TransformerTest.basePower ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:ApparentPower
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:TransformerTest.temperature ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Temperature
                                        ] ;
                    rdfs:subClassOf cim:IdentifiedObject ;
                    rdfs:comment "Test result for transformer ends, such as short-circuit, open-circuit (excitation) or no-load test." .


###  http://www.iec.ch/TC57/CIM#TransmissionCapacity
cim:TransmissionCapacity rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:TransmissionCapacity.OTC15min_emergency ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:TransmissionCapacity.OTCemergency ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:TransmissionCapacity.POD ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:TransmissionCapacity.POR ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:TransmissionCapacity.capacityBenefitMargin ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:TransmissionCapacity.operationalTransmissionCapacity ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:TransmissionCapacity.startOperatingDate ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:dateTime
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:TransmissionCapacity.totalTransmissionCapacity ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ;
                         rdfs:comment "This class models the transmission (either a transmission interface or a POR/POD pair) capacity including Total Transfer Capacity (TTC), Operating Transfer Capacity (OTC), and Capacity Benefit Margin (CBM)" .


###  http://www.iec.ch/TC57/CIM#TransmissionCorridor
cim:TransmissionCorridor rdf:type owl:Class ;
                         rdfs:subClassOf cim:PowerSystemResource ;
                         rdfs:comment "A corridor containing one or more rights of way" .


###  http://www.iec.ch/TC57/CIM#TransmissionInterfaceRightEntitlement
cim:TransmissionInterfaceRightEntitlement rdf:type owl:Class ;
                                          owl:equivalentClass [ rdf:type owl:Restriction ;
                                                                owl:onProperty cim:TransmissionInterfaceRightEntitlement.POD ;
                                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                owl:onDataRange xsd:string
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty cim:TransmissionInterfaceRightEntitlement.POR ;
                                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                owl:onDataRange xsd:string
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty cim:TransmissionInterfaceRightEntitlement.entitlement ;
                                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                owl:onDataRange xsd:float
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty cim:TransmissionInterfaceRightEntitlement.startOperatingDate ;
                                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                owl:onDataRange xsd:dateTime
                                                              ] ;
                                          rdfs:comment "This is formally called the branch group ETC/TOR entitlement with the inclusion of CVR as ETC. Is used to represent the entitlements. This could be also used to represent the TR entitlement on a POR/POD." .


###  http://www.iec.ch/TC57/CIM#TransmissionModeKind
cim:TransmissionModeKind rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Class ;
                                               owl:oneOf ( cim:anonymous
                                                           cim:both
                                                           cim:normal
                                                         )
                                             ] .


###  http://www.iec.ch/TC57/CIM#TransmissionPath
cim:TransmissionPath rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:TransmissionPath.availTransferCapability ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:ActivePower
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:TransmissionPath.totalTransferCapability ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:ActivePower
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:TransmissionPath.parallelPathFlag ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:boolean
                                         ] ;
                     rdfs:subClassOf cim:IdentifiedObject ;
                     rdfs:comment "An electrical connection, link, or line consisting of one or more parallel transmission elements between two areas of the interconnected electric systems, or portions thereof. TransmissionCorridor and TransmissionRightOfWay refer to legal aspects. The TransmissionPath refers to the segments between a TransmissionProvider's ServicePoints." .


###  http://www.iec.ch/TC57/CIM#TransmissionProduct
cim:TransmissionProduct rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:TransmissionProduct.transmissionProductType ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:string
                                            ] ;
                        rdfs:subClassOf cim:IdentifiedObject .


###  http://www.iec.ch/TC57/CIM#TransmissionProvider
cim:TransmissionProvider rdf:type owl:Class ;
                         rdfs:subClassOf cim:Organisation ;
                         rdfs:comment "Provider of  the transmission capacity (interconnecting wires between Generation and Consumption) required  to fulfill and Energy Transaction's energy exchange. Posts information for transmission paths and AvailableTransmissionCapacities  on a reservation node.  Buys and sells its products and services on the same reservation node." .


###  http://www.iec.ch/TC57/CIM#TransmissionReservation
cim:TransmissionReservation rdf:type owl:Class ;
                            rdfs:comment "A transmission reservation is obtained from the OASIS system to reserve transmission for a specified time period, transmission path and transmission product." .


###  http://www.iec.ch/TC57/CIM#TransmissionRightChain
cim:TransmissionRightChain rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:TransmissionRightChain.endEffectiveDate ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:dateTime
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:TransmissionRightChain.startEffectiveDate ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:dateTime
                                               ] ;
                           rdfs:subClassOf cim:IdentifiedObject ;
                           rdfs:comment "Allows chaining of TransmissionContractRights. Many individual contract rights can be included in the definition of a TransmissionRightChain. A TransmissionRightChain is also defined as a TransmissionContractRight itself." .


###  http://www.iec.ch/TC57/CIM#TransmissionRightOfWay
cim:TransmissionRightOfWay rdf:type owl:Class ;
                           rdfs:subClassOf cim:PowerSystemResource ;
                           rdfs:comment "A collection of transmission lines that are close proximity to each other." .


###  http://www.iec.ch/TC57/CIM#TriggerCondition
cim:TriggerCondition rdf:type owl:Class ;
                     rdfs:subClassOf cim:IdentifiedObject ;
                     rdfs:comment "A conditions that can trigger remedial actions." .


###  http://www.iec.ch/TC57/CIM#TroubleReportingKind
cim:TroubleReportingKind rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Class ;
                                               owl:oneOf ( cim:call
                                                           cim:email
                                                           cim:ivr
                                                           cim:letter
                                                           cim:other
                                                         )
                                             ] .


###  http://www.iec.ch/TC57/CIM#TroubleTicket
cim:TroubleTicket rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:TroubleTicket.reportingKind ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:TroubleReportingKind
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:TroubleTicket.dateTimeOfReport ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTime
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:TroubleTicket.firstResponder ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:TroubleTicket.resolvedDateTime ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTime
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:TroubleTicket.troubleCode ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ;
                  rdfs:subClassOf cim:Document .


###  http://www.iec.ch/TC57/CIM#TurbLCFB1
cim:TurbLCFB1 rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:TurbLCFB1.db ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:PU
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:TurbLCFB1.emax ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:PU
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:TurbLCFB1.fb ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:PU
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:TurbLCFB1.irmax ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:PU
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:TurbLCFB1.ki ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:PU
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:TurbLCFB1.kp ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:PU
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:TurbLCFB1.mwbase ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:ActivePower
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:TurbLCFB1.pmwset ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:ActivePower
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:TurbLCFB1.tpelec ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:Seconds
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:TurbLCFB1.fbf ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:boolean
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:TurbLCFB1.pbf ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:boolean
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:TurbLCFB1.speedReferenceGovernor ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:boolean
                                  ] ;
              rdfs:subClassOf cim:TurbineLoadControllerDynamics ;
              rdfs:comment "Turbine Load Controller model developed in the WECC.  This model represents a supervisory turbine load controller that acts to maintain turbine power at a set value by continuous adjustment of the turbine governor speed-load reference. This model is intended to represent slow reset 'outer loop' controllers managing the action of the turbine governor." .


###  http://www.iec.ch/TC57/CIM#TurbineGovernorDynamics
cim:TurbineGovernorDynamics rdf:type owl:Class ;
                            rdfs:subClassOf cim:DynamicsFunctionBlock ;
                            rdfs:comment "Turbine-governor function block whose behavior is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>" .


###  http://www.iec.ch/TC57/CIM#TurbineGovernorUserDefined
cim:TurbineGovernorUserDefined rdf:type owl:Class ;
                               owl:equivalentClass [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:TurbineGovernorUserDefined.proprietary ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:boolean
                                                   ] ;
                               rdfs:subClassOf cim:TurbineGovernorDynamics ;
                               rdfs:comment "Turbine-governor function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" .


###  http://www.iec.ch/TC57/CIM#TurbineLoadControllerDynamics
cim:TurbineLoadControllerDynamics rdf:type owl:Class ;
                                  rdfs:subClassOf cim:DynamicsFunctionBlock ;
                                  rdfs:comment "Turbine load controller function block whose behavior is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>" .


###  http://www.iec.ch/TC57/CIM#TurbineLoadControllerUserDefined
cim:TurbineLoadControllerUserDefined rdf:type owl:Class ;
                                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                                           owl:onProperty cim:TurbineLoadControllerUserDefined.proprietary ;
                                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                           owl:onDataRange xsd:boolean
                                                         ] ;
                                     rdfs:subClassOf cim:TurbineLoadControllerDynamics ;
                                     rdfs:comment "Turbine load controller function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" .


###  http://www.iec.ch/TC57/CIM#TurbineType
cim:TurbineType rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Class ;
                                      owl:oneOf ( cim:kaplan
                                                  cim:pelton
                                                )
                                    ] .


###  http://www.iec.ch/TC57/CIM#Turbine_Governor
cim:Turbine_Governor rdf:type owl:Class .


###  http://www.iec.ch/TC57/CIM#TypeAssetCatalogue
cim:TypeAssetCatalogue rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:TypeAssetCatalogue.status ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Status
                                           ] ;
                       rdfs:subClassOf cim:IdentifiedObject ;
                       rdfs:comment "Catalogue of generic types of assets (TypeAsset) that may be used for design purposes. It is not associated with a particular manufacturer." .


###  http://www.iec.ch/TC57/CIM#TypeMaterial
cim:TypeMaterial rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:TypeMaterial.estUnitCost ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Money
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:TypeMaterial.costType ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:TypeMaterial.quantity ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:TypeMaterial.stockItem ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:boolean
                                     ] ;
                 rdfs:subClassOf cim:WorkDocument ;
                 rdfs:comment """Documentation for a generic material item that may be used for design, work and other purposes. Any number of MaterialItems manufactured by various vendors may be used to perform this TypeMaterial.
Note that class analagous to \"AssetModel\" is not used for material items. This is because in some cases, for example, a utility sets up a Master material record for a 3 inch long half inch diameter steel bolt and they do not necessarily care what specific supplier is providing the material item. As different vendors are used to supply the part, the Stock Code of the material item can stay the same. In other cases, each time the vendor changes, a new stock code is set up so they can track material used by vendor. Therefore a Material Item \"Model\" is not typically needed.""" .


###  http://www.iec.ch/TC57/CIM#UOMType
cim:UOMType rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Class ;
                                  owl:oneOf ( cim:FACTOR
                                              cim:FLAG
                                              cim:INTEGER
                                              cim:MW
                                              cim:MWh
                                              <http://www.iec.ch/TC57/CIM#$/lb>
                                              <http://www.iec.ch/TC57/CIM#$/mmBTU>
                                              <http://www.iec.ch/TC57/CIM#%>
                                              <http://www.iec.ch/TC57/CIM#US$>
                                              <http://www.iec.ch/TC57/CIM#US$/MW>
                                              <http://www.iec.ch/TC57/CIM#US$/MWh>
                                            )
                                ] .


###  http://www.iec.ch/TC57/CIM#UnderexcLim2Simplified
cim:UnderexcLim2Simplified rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:UnderexcLim2Simplified.kui ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:PU
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:UnderexcLim2Simplified.p0 ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:PU
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:UnderexcLim2Simplified.p1 ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:PU
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:UnderexcLim2Simplified.q0 ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:PU
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:UnderexcLim2Simplified.q1 ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:PU
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:UnderexcLim2Simplified.vuimax ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:PU
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:UnderexcLim2Simplified.vuimin ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:PU
                                               ] ;
                           rdfs:subClassOf cim:UnderexcitationLimiterDynamics ;
                           rdfs:comment """This model can be derived from UnderexcLimIEEE2.
The limit characteristic (look up table) is a single straight-line, the same as UnderexcLimIEEE2 (see Figure 10.4 (p 32), IEEE 421.5-2005 Section 10.2).""" .


###  http://www.iec.ch/TC57/CIM#UnderexcLimIEEE1
cim:UnderexcLimIEEE1 rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:UnderexcLimIEEE1.kuc ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:PU
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:UnderexcLimIEEE1.kuf ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:PU
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:UnderexcLimIEEE1.kui ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:PU
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:UnderexcLimIEEE1.kul ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:PU
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:UnderexcLimIEEE1.kur ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:PU
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:UnderexcLimIEEE1.tu1 ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Seconds
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:UnderexcLimIEEE1.tu2 ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Seconds
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:UnderexcLimIEEE1.tu3 ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Seconds
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:UnderexcLimIEEE1.tu4 ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Seconds
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:UnderexcLimIEEE1.vucmax ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:PU
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:UnderexcLimIEEE1.vuimax ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:PU
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:UnderexcLimIEEE1.vuimin ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:PU
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:UnderexcLimIEEE1.vulmax ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:PU
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:UnderexcLimIEEE1.vulmin ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:PU
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:UnderexcLimIEEE1.vurmax ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:PU
                                         ] ;
                     rdfs:subClassOf cim:UnderexcitationLimiterDynamics ;
                     rdfs:comment """The class represents the Type UEL1 model which has a circular limit boundary when plotted in terms of machine reactive power vs. real power output.

Reference: IEEE UEL1 421.5-2005 Section 10.1.""" .



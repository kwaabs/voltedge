                              rdfs:comment "Mechanical load function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" .


###  http://www.iec.ch/TC57/CIM#Medium
cim:Medium rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Medium.kind ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:MediumKind
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Medium.volumeSpec ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:Volume
                               ] ;
           rdfs:subClassOf cim:IdentifiedObject ;
           rdfs:comment "A substance that either (1) provides the means of transmission of a force or effect, such as hydraulic fluid, or (2) is used for a surrounding or enveloping substance, such as oil in a transformer or circuit breaker." .


###  http://www.iec.ch/TC57/CIM#MediumKind
cim:MediumKind rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:oneOf ( cim:gas
                                                 cim:liquid
                                                 cim:solid
                                               )
                                   ] .


###  http://www.iec.ch/TC57/CIM#MerchantAccount
cim:MerchantAccount rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:MerchantAccount.currentBalance ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Money
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:MerchantAccount.provisionalBalance ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Money
                                        ] ;
                    rdfs:subClassOf cim:Document ;
                    rdfs:comment "The operating account controlled by merchant agreement, against which the vendor may vend tokens or receipt payments. Transactions via vendor shift debit the account and bank deposits via bank statement credit the account." .


###  http://www.iec.ch/TC57/CIM#MerchantAgreement
cim:MerchantAgreement rdf:type owl:Class ;
                      rdfs:subClassOf cim:Agreement ;
                      rdfs:comment "A formal controlling contractual agreement between supplier and merchant, in terms of which the merchant is authorised to vend tokens and receipt payments on behalf of the supplier. The merchant is accountable to the supplier for revenue collected at point of sale." .


###  http://www.iec.ch/TC57/CIM#Meter
cim:Meter rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Meter.formNumber ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:string
                              ] ;
          rdfs:subClassOf cim:EndDevice ;
          rdfs:comment "Physical asset that performs the metering role of the usage point. Used for measuring consumption and detection of events." .


###  http://www.iec.ch/TC57/CIM#MeterMultiplier
cim:MeterMultiplier rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:MeterMultiplier.kind ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:MeterMultiplierKind
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:MeterMultiplier.value ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:float
                                        ] ;
                    rdfs:subClassOf cim:IdentifiedObject ;
                    rdfs:comment "Multiplier applied at the meter." .


###  http://www.iec.ch/TC57/CIM#MeterMultiplierKind
cim:MeterMultiplierKind rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Class ;
                                              owl:oneOf ( cim:ctRatio
                                                          cim:kE
                                                          cim:kH
                                                          cim:kR
                                                          cim:ptRatio
                                                          cim:transformerRatio
                                                        )
                                            ] .


###  http://www.iec.ch/TC57/CIM#MeterReading
cim:MeterReading rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:MeterReading.valuesInterval ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:DateTimeInterval
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:MeterReading.isCoincidentTrigger ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:boolean
                                     ] ;
                 rdfs:subClassOf cim:IdentifiedObject ;
                 rdfs:comment "Set of values obtained from the meter." .


###  http://www.iec.ch/TC57/CIM#MeterWorkTask
cim:MeterWorkTask rdf:type owl:Class ;
                  rdfs:subClassOf cim:WorkTask ;
                  rdfs:comment "Work task involving meters." .


###  http://www.iec.ch/TC57/CIM#MeteredSubSystem
cim:MeteredSubSystem rdf:type owl:Class ;
                     rdfs:subClassOf cim:IdentifiedObject ;
                     rdfs:comment "A metered subsystem" .


###  http://www.iec.ch/TC57/CIM#MetrologyRequirement
cim:MetrologyRequirement rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:MetrologyRequirement.reason ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:ReadingReasonKind
                                             ] ;
                         rdfs:subClassOf cim:IdentifiedObject ;
                         rdfs:comment "A specification of the metering requirements for a particular point within a network." .


###  http://www.iec.ch/TC57/CIM#Minutes
cim:Minutes rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Minutes.multiplier ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:UnitMultiplier
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Minutes.unit ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:UnitSymbol
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Minutes.value ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:float
                                ] ;
            rdfs:comment "Time in minutes." .


###  http://www.iec.ch/TC57/CIM#MiscCostItem
cim:MiscCostItem rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:MiscCostItem.costPerUnit ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Money
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:MiscCostItem.quantity ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:IntegerQuantity
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:MiscCostItem.status ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Status
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:MiscCostItem.account ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:MiscCostItem.costType ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:MiscCostItem.externalRefID ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ;
                 rdfs:subClassOf cim:WorkIdentifiedObject ;
                 rdfs:comment "Various cost items that are not associated with compatible units. Examples include rental equipment, labor, materials, contractor costs, permits - anything not covered in a CU." .


###  http://www.iec.ch/TC57/CIM#MitigatedBid
cim:MitigatedBid rdf:type owl:Class ;
                 rdfs:subClassOf cim:IdentifiedObject ;
                 rdfs:comment "Mitigated bid results posted for a given settlement period." .


###  http://www.iec.ch/TC57/CIM#MitigatedBidClearing
cim:MitigatedBidClearing rdf:type owl:Class ;
                         rdfs:subClassOf cim:MarketFactors ;
                         rdfs:comment "Model of market power mitigation through reference or mitigated bids. Interval based." .


###  http://www.iec.ch/TC57/CIM#MitigatedBidSegment
cim:MitigatedBidSegment rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:MitigatedBidSegment.intervalStartTime ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:dateTime
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:MitigatedBidSegment.segmentMW ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:MitigatedBidSegment.segmentNumber ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:nonNegativeInteger
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:MitigatedBidSegment.thresholdType ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:string
                                            ] ;
                        rdfs:comment "Model of mitigated bid. Indicates segment of piece-wise linear bid, that has been mitigated" .



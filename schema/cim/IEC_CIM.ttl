###  http://www.iec.ch/TC57/CIM#ProtectiveActionCollection
cim:ProtectiveActionCollection rdf:type owl:Class ;
                               rdfs:subClassOf cim:IdentifiedObject ;
                               rdfs:comment "A collection of protective actions to protect the integrity of the power system." .


###  http://www.iec.ch/TC57/CIM#ProtectiveActionEquipment
cim:ProtectiveActionEquipment rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Restriction ;
                                                    owl:onProperty cim:ProtectiveActionEquipment.inService ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onDataRange xsd:boolean
                                                  ] ;
                              rdfs:subClassOf cim:ProtectiveAction ;
                              rdfs:comment "Protective action to put an Equipment in-service/out-of-service." .


###  http://www.iec.ch/TC57/CIM#ProtectiveActionRegulation
cim:ProtectiveActionRegulation rdf:type owl:Class ;
                               owl:equivalentClass [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:ProtectiveActionRegulation.isRegulating ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:boolean
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:ProtectiveActionRegulation.targetValue ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:float
                                                   ] ;
                               rdfs:subClassOf cim:ProtectiveAction ;
                               rdfs:comment "Protective action to change regulation to Equipment." .



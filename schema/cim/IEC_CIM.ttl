###  http://www.iec.ch/TC57/CIM#ExcSK
cim:ExcSK rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty cim:ExcSK.efdmax ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:PU

                                                                    cim:RC
                                                                    cim:RTM
                                                                  )
                                                      ] .


###  http://www.iec.ch/TC57/CIM#ResourceCertificationType
cim:ResourceCertificationType rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Class ;
                                                    owl:oneOf ( cim:GT
                                                                cim:IR
                                                                cim:NR
                                                                cim:RG
                                                                cim:SR
                                                              )
                                                  ] .


###  http://www.iec.ch/TC57/CIM#ResourceClearing
cim:ResourceClearing rdf:type owl:Class ;
                     rdfs:subClassOf cim:MarketFactors ;
                     rdfs:comment "Model of market results, including cleaing result of resources. Associated with ResourceDispatchResults." .


###  http://www.iec.ch/TC57/CIM#ResourceDispatchResults
cim:ResourceDispatchResults rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ResourceDispatchResults.contingencyFlag ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass cim:YesNo
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ResourceDispatchResults.penaltyDispatchIndicator ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass cim:YesNo
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ResourceDispatchResults.updateType ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass cim:MQSCHGType
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ResourceDispatchResults.blockedDispatch ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:string
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ResourceDispatchResults.blockedPublishDOP ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:string
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ResourceDispatchResults.limitIndicator ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:string
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ResourceDispatchResults.lowerLimit ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:float
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ResourceDispatchResults.maxRampRate ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:float
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ResourceDispatchResults.operatingLimitHigh ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:float
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ResourceDispatchResults.operatingLimitLow ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:float
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ResourceDispatchResults.regulatingLimitHigh ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:float
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ResourceDispatchResults.regulatingLimitLow ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:float
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ResourceDispatchResults.resourceStatus ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:string
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ResourceDispatchResults.totalSchedule ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:float
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ResourceDispatchResults.updateTimeStamp ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:dateTime
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ResourceDispatchResults.updateUser ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:string
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ResourceDispatchResults.upperLimit ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:float
                                                ] ;
                            rdfs:comment "The ResourceDispatchResults class provides market results that can be provided to a SC. The specific data provided consists of several indicators such as contingency flags, blocked start up, and RMR dispatch. It also provides the projected overall and the regulating status of the resource." .


###  http://www.iec.ch/TC57/CIM#ResourceGroup
cim:ResourceGroup rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ResourceGroup.status ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Status
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ResourceGroup.type ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ;
                  rdfs:subClassOf cim:IdentifiedObject ;
                  rdfs:comment "A logical grouping of resources that are used to model location of types of requirements for ancillary services such as spinning reserve zones, regulation zones, etc." .


###  http://www.iec.ch/TC57/CIM#ResourceGroupReq
cim:ResourceGroupReq rdf:type owl:Class ;
                     rdfs:subClassOf cim:IdentifiedObject ;
                     rdfs:comment "Ancillary service requirements for a market." .



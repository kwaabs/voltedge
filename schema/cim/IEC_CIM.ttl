                                     rdfs:domain cim:Shift ;
                                     rdfs:range cim:Money ;
                                     rdfs:comment """Cumulative amount in error due to process rounding not reflected in receiptsGrandTotal. Values are obtained from Receipt attributes:
=sum(Receipt.receiptRounding).""" .



                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:FossilFuel.fuelHandlingCost ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:CostPerHeatUnit
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:FossilFuel.fuelMixture ;

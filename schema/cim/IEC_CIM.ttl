                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:RegulatingCondEq.controlEnabled ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:boolean
                                         ] ;
                     rdfs:subClassOf cim:ConductingEquipment ;
                     rdfs:comment "A type of conducting equipment that can regulate a quantity (i.e. voltage or flow) at a specific point in the network." .


###  http://www.iec.ch/TC57/CIM#RegulatingControl
cim:RegulatingControl rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:RegulatingControl.mode ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:RegulatingControlModeKind
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:RegulatingControl.monitoredPhase ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:PhaseCode
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:RegulatingControl.targetValueUnitMultiplier ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:UnitMultiplier
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:RegulatingControl.discrete ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:boolean
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:RegulatingControl.enabled ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:boolean
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:RegulatingControl.targetDeadband ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:float
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:RegulatingControl.targetValue ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:float
                                          ] ;
                      rdfs:subClassOf cim:PowerSystemResource ;
                      rdfs:comment """Specifies a set of equipment that works together to control a power system quantity such as voltage or flow. 
Remote bus voltage control is possible by specifying the controlled terminal located at some place remote from the controlling equipment.
In case multiple equipment, possibly of different types, control same terminal there must be only one RegulatingControl at that terminal. The most specific subtype of RegulatingControl shall be used in case such equipment participate in the control, e.g. TapChangerControl for tap changers.
For flow control  load sign convention is used, i.e. positive sign means flow out from a TopologicalNode (bus) into the conducting equipment.""" .


###  http://www.iec.ch/TC57/CIM#RegulatingControlModeKind
cim:RegulatingControlModeKind rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Class ;
                                                    owl:oneOf ( cim:activePower
                                                                cim:admittance
                                                                cim:currentFlow
                                                                cim:powerFactor
                                                                cim:reactivePower
                                                                cim:temperature
                                                                cim:timeScheduled
                                                                cim:voltage
                                                              )
                                                  ] .


###  http://www.iec.ch/TC57/CIM#RegulatingLimit
cim:RegulatingLimit rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:RegulatingLimit.highLimit ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:ActivePower
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:RegulatingLimit.lowLimit ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:ActivePower
                                        ] ;
                    rdfs:subClassOf cim:IdentifiedObject ;
                    rdfs:comment "This class represents the physical characteristc of a generator regarding the regulating limit" .


###  http://www.iec.ch/TC57/CIM#Regulation
cim:Regulation rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:Regulation.referenceNumber ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ;
               rdfs:subClassOf cim:WorkDocument ;
               rdfs:comment "Special requirements and/or regulations may pertain to certain types of assets or work. For example, fire protection and scaffolding." .


###  http://www.iec.ch/TC57/CIM#RegulationBranchKind
cim:RegulationBranchKind rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Class ;
                                               owl:oneOf ( cim:breaker
                                                           cim:fuse
                                                           cim:line
                                                           cim:other
                                                           cim:recloser
                                                           cim:sectionner
                                                           cim:switch
                                                           cim:transformer
                                                         )
                                             ] .


###  http://www.iec.ch/TC57/CIM#RegulationSchedule
cim:RegulationSchedule rdf:type owl:Class ;
                       rdfs:subClassOf cim:SeasonDayTypeSchedule ;
                       rdfs:comment "A pre-established pattern over time for a controlled variable, e.g., busbar voltage." .


###  http://www.iec.ch/TC57/CIM#ReliabilityInfo
cim:ReliabilityInfo rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ReliabilityInfo.mTTR ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Hours
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ReliabilityInfo.momFailureRate ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:PerCent
                                        ] ;
                    rdfs:subClassOf cim:IdentifiedObject ;
                    rdfs:comment "Information regarding the experienced and expected reliability of a specific asset, type of asset, or asset model." .


###  http://www.iec.ch/TC57/CIM#RemedialActionScheme
cim:RemedialActionScheme rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:RemedialActionScheme.kind ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:RemedialActionSchemeKind
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:RemedialActionScheme.armed ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:boolean
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:RemedialActionScheme.normalArmed ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:boolean
                                             ] ;
                         rdfs:subClassOf cim:PowerSystemResource ;
                         rdfs:comment "Remedial Action Scheme (RAS), Special Protection Schemes (SPS), System Protection Schemes (SPS) or System Integrity Protection Schemes (SIPS)." .


###  http://www.iec.ch/TC57/CIM#RemedialActionSchemeKind
cim:RemedialActionSchemeKind rdf:type owl:Class ;
                             owl:equivalentClass [ rdf:type owl:Class ;
                                                   owl:oneOf ( cim:rAP
                                                               cim:rAS
                                                             )
                                                 ] .


###  http://www.iec.ch/TC57/CIM#RemoteConnectDisconnectInfo
cim:RemoteConnectDisconnectInfo rdf:type owl:Class ;
                                owl:equivalentClass [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:RemoteConnectDisconnectInfo.armedTimeout ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onClass cim:Seconds
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:RemoteConnectDisconnectInfo.customerVoltageLimit ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onClass cim:Voltage
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:RemoteConnectDisconnectInfo.energyLimit ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onClass cim:RealEnergy
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:RemoteConnectDisconnectInfo.energyUsageWarning ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onClass cim:RealEnergy
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:RemoteConnectDisconnectInfo.powerLimit ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onClass cim:ActivePower
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:RemoteConnectDisconnectInfo.energyUsageStartDateTime ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:dateTime
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:RemoteConnectDisconnectInfo.isArmConnect ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:boolean
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:RemoteConnectDisconnectInfo.isArmDisconnect ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:boolean
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:RemoteConnectDisconnectInfo.isEnergyLimiting ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:boolean
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:RemoteConnectDisconnectInfo.needsPowerLimitCheck ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:boolean
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:RemoteConnectDisconnectInfo.needsVoltageLimitCheck ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:boolean
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:RemoteConnectDisconnectInfo.usePushbutton ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:boolean
                                                    ] ;
                                rdfs:comment "Details of remote connect and disconnect function." .


###  http://www.iec.ch/TC57/CIM#RemoteControl
cim:RemoteControl rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:RemoteControl.actuatorMaximum ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:RemoteControl.actuatorMinimum ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:RemoteControl.remoteControlled ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:boolean
                                      ] ;
                  rdfs:subClassOf cim:RemotePoint ;
                  rdfs:comment "Remote controls are ouputs that are sent by the remote unit to actuators in the process." .


###  http://www.iec.ch/TC57/CIM#RemoteInputSignal
cim:RemoteInputSignal rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:RemoteInputSignal.remoteSignalType ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:RemoteSignalKind
                                          ] ;
                      rdfs:subClassOf cim:IdentifiedObject ;
                      rdfs:comment "Supports connection to a terminal associated with a remote bus from which an input signal of a specific type is coming." .


###  http://www.iec.ch/TC57/CIM#RemotePoint
cim:RemotePoint rdf:type owl:Class ;
                rdfs:subClassOf cim:IdentifiedObject ;
                rdfs:comment "For a RTU remote points correspond to telemetered values or control outputs. Other units (e.g. control centers) usually also contain calculated values." .


###  http://www.iec.ch/TC57/CIM#RemoteSignalKind
cim:RemoteSignalKind rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:oneOf ( cim:remoteBranchCurrentAmplitude
                                                       cim:remoteBusFrequency
                                                       cim:remoteBusFrequencyDeviation
                                                       cim:remoteBusVoltage
                                                       cim:remoteBusVoltageAmplitude
                                                       cim:remoteBusVoltageAmplitudeDerivative
                                                       cim:remoteBusVoltageFrequency
                                                       cim:remoteBusVoltageFrequencyDeviation
                                                       cim:remotePuBusVoltageDerivative
                                                     )
                                         ] .


###  http://www.iec.ch/TC57/CIM#RemoteSource
cim:RemoteSource rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:RemoteSource.scanInterval ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Seconds
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:RemoteSource.deadband ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:float
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:RemoteSource.sensorMaximum ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:float
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:RemoteSource.sensorMinimum ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:float
                                     ] ;
                 rdfs:subClassOf cim:RemotePoint ;
                 rdfs:comment "Remote sources are state variables that are telemetered or calculated within the remote unit." .


###  http://www.iec.ch/TC57/CIM#RemoteUnit
cim:RemoteUnit rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:RemoteUnit.remoteUnitType ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:RemoteUnitType
                                   ] ;
               rdfs:subClassOf cim:PowerSystemResource ;
               rdfs:comment "A remote unit can be a RTU, IED, substation control system, control center etc. The communication with the remote unit can be through various standard protocols (e.g. IEC 61870, IEC 61850) or non standard protocols (e.g. DNP, RP570 etc.). A remote unit contain remote data points that might be telemetered, collected or calculated. The RemoteUnit class inherit PowerSystemResource. The intention is to allow RemotUnits to have Measurements. These Measurements can be used to model unit status as operational, out of service, unit failure etc." .


###  http://www.iec.ch/TC57/CIM#RemoteUnitType
cim:RemoteUnitType rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Class ;
                                         owl:oneOf ( cim:ControlCenter
                                                     cim:IED
                                                     cim:RTU
                                                     cim:SubstationControlSystem
                                                   )
                                       ] .


###  http://www.iec.ch/TC57/CIM#ReportingGroup
cim:ReportingGroup rdf:type owl:Class ;
                   rdfs:subClassOf cim:IdentifiedObject ;
                   rdfs:comment "A reporting group is used for various ad-hoc groupings used for reporting." .


###  http://www.iec.ch/TC57/CIM#ReportingSuperGroup
cim:ReportingSuperGroup rdf:type owl:Class ;
                        rdfs:subClassOf cim:IdentifiedObject ;
                        rdfs:comment "A reporting super group, groups reporting groups for a higher level report." .


###  http://www.iec.ch/TC57/CIM#RequestorRmrTest
cim:RequestorRmrTest rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:oneOf ( cim:ISO
                                                       cim:MP
                                                     )
                                         ] .


###  http://www.iec.ch/TC57/CIM#ReserveDemandCurve
cim:ReserveDemandCurve rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ReserveDemandCurve.reserveRequirementType ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:ReserveRequirementType
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ReserveDemandCurve.reqMaxMW ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:float
                                           ] ;
                       rdfs:subClassOf cim:Curve ;
                       rdfs:comment "Reserve demand curve.  Models maximum quantities of reserve required per Market Region and models a reserve demand curve for the minimum quantities of reserve. The ReserveDemandCurve is a relationship between unit operating reserve price in $/MWhr (Y-axis) and unit reserves in MW (X-axis)." .


###  http://www.iec.ch/TC57/CIM#ReserveReq
cim:ReserveReq rdf:type owl:Class ;
               rdfs:subClassOf cim:ResourceGroupReq ;
               rdfs:comment "Requirements for minimum amount of reserve and/or regulation to be supplied by a set of qualified resources." .


###  http://www.iec.ch/TC57/CIM#ReserveReqCurve
cim:ReserveReqCurve rdf:type owl:Class ;
                    rdfs:subClassOf cim:Curve ;
                    rdfs:comment """A curve relating  reserve requirement versus time, showing the values of a specific reserve requirement for each unit of the period covered. The  curve can be based on \"absolute\" time or on \"normalized' time. 
X is time, typically expressed in absolute time
Y1 is reserve requirement, typically expressed in MW""" .


###  http://www.iec.ch/TC57/CIM#ReserveRequirementType
cim:ReserveRequirementType rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Class ;
                                                 owl:oneOf ( cim:CONT
                                                             cim:OPRSV
                                                             cim:REG
                                                           )
                                               ] .


###  http://www.iec.ch/TC57/CIM#Reservoir
cim:Reservoir rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Reservoir.activeStorageCapacity ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:Volume
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Reservoir.fullSupplyLevel ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:WaterLevel
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Reservoir.grossCapacity ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:Volume
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Reservoir.normalMinOperateLevel ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:WaterLevel
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Reservoir.spillTravelDelay ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:Seconds
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Reservoir.spillwayCrestLength ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:Length
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Reservoir.spillwayCrestLevel ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:WaterLevel
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Reservoir.energyStorageRating ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:float
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Reservoir.riverOutletWorks ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Reservoir.spillWayGateType ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Reservoir.spillwayCapacity ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:float
                                  ] ;
              rdfs:subClassOf cim:PowerSystemResource ;
              rdfs:comment "A water storage facility within a hydro system, including: ponds, lakes, lagoons, and rivers. The storage is usually behind some type of dam." .


###  http://www.iec.ch/TC57/CIM#Resistance
cim:Resistance rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:Resistance.multiplier ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:UnitMultiplier
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:Resistance.unit ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:UnitSymbol
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:Resistance.value ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ;
               rdfs:comment "Resistance (real part of impedance)." .


###  http://www.iec.ch/TC57/CIM#ResistancePerLength
cim:ResistancePerLength rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:ResistancePerLength.multiplier ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:UnitMultiplier
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:ResistancePerLength.unit ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:UnitSymbol
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:ResistancePerLength.value ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ;
                        rdfs:comment "Resistance (real part of impedance) per unit of length." .


###  http://www.iec.ch/TC57/CIM#ResourceAncillaryServiceQualification
cim:ResourceAncillaryServiceQualification rdf:type owl:Class ;
                                          owl:equivalentClass [ rdf:type owl:Restriction ;
                                                                owl:onProperty cim:ResourceAncillaryServiceQualification.market ;
                                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                owl:onClass cim:MarketType
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty cim:ResourceAncillaryServiceQualification.qualificationFlag ;
                                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                owl:onClass cim:YesNo
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty cim:ResourceAncillaryServiceQualification.type ;
                                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                owl:onClass cim:ResourceAncillaryServiceType
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty cim:ResourceAncillaryServiceQualification.certifiedCapacity ;
                                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                owl:onDataRange xsd:float
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty cim:ResourceAncillaryServiceQualification.endEffectiveDate ;
                                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                owl:onDataRange xsd:dateTime
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty cim:ResourceAncillaryServiceQualification.startEffectiveDate ;
                                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                owl:onDataRange xsd:dateTime
                                                              ] ;
                                          rdfs:comment "Ancillary Services that a resource is qualified to provide." .


###  http://www.iec.ch/TC57/CIM#ResourceAncillaryServiceType
cim:ResourceAncillaryServiceType rdf:type owl:Class ;
                                 owl:equivalentClass [ rdf:type owl:Class ;
                                                       owl:oneOf ( cim:BLACKSTART
                                                                   cim:DSR
                                                                   cim:NONSPIN
                                                                   cim:PIRP
                                                                   cim:REGDN
                                                                   cim:REGUP
                                                                   cim:RMR
                                                                   cim:RRSPIN
                                                                   cim:RUC
                                                                   cim:SYNCCOND
                                                                 )
                                                     ] .


###  http://www.iec.ch/TC57/CIM#ResourceAssnType
cim:ResourceAssnType rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:oneOf ( cim:CSNK
                                                       cim:CSRC
                                                       cim:LSE
                                                       cim:RMR
                                                       cim:SC
                                                     )
                                         ] .


###  http://www.iec.ch/TC57/CIM#ResourceAwardClearing
cim:ResourceAwardClearing rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ResourceAwardClearing.contingencyActive ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:YesNo
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ResourceAwardClearing.dispatchMode ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:AutomaticDispatchMode
                                              ] ;
                          rdfs:subClassOf cim:MarketFactors ;
                          rdfs:comment "Models details of bid and offer market clearing. Class indicates whether a contingency is active and whether the automatic dispatching system is active for this interval of the market solution" .



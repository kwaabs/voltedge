###  http://www.iec.ch/TC57/CIM#MarketScheduledEvent
cim:MarketScheduledEvent rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:MarketScheduledEvent.duration ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:Seconds
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:MarketScheduledEvent.status ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:Status
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:MarketScheduledEvent.category ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;

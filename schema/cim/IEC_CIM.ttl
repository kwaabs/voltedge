                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:UnderexcLimX1.km ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:PU
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:UnderexcLimX1.melmax ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;

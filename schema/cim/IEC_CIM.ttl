###  http://www.iec.ch/TC57/CIM#Frame
cim:Frame rdf:type owl:Class ;
          rdfs:subClassOf cim:FrameworkPart ;
          rdfs:comment "A region isolated by boundaries." .


###  http://www.iec.ch/TC57/CIM#FrameworkPart
cim:FrameworkPart rdf:type owl:Class ;
                  rdfs:subClassOf cim:IdentifiedObject ;
                  rdfs:comment "The type of alternate model frame.  For example, it could be generator group used to represent generators in state estimator, planning, planning dynamics, short circuit, or real-time dynamics etc., but does not specifically represent any one alternative model. This need to know what objects to be removed in the realization of any one alternate model." .


###  http://www.iec.ch/TC57/CIM#FrancisGovernorControlKind
cim:FrancisGovernorControlKind rdf:type owl:Class ;
                               owl:equivalentClass [ rdf:type owl:Class ;
                                                     owl:oneOf ( cim:electromechanicalElectrohydraulic
                                                                 cim:mechanicHydraulicTransientFeedback
                                                                 cim:mechanicHydrolicTachoAccelerator
                                                               )
                                                   ] .


###  http://www.iec.ch/TC57/CIM#Frequency
cim:Frequency rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Frequency.multiplier ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:UnitMultiplier
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Frequency.unit ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:UnitSymbol
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Frequency.value ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:float
                                  ] ;
              rdfs:comment "Cycles per second." .


###  http://www.iec.ch/TC57/CIM#FrequencyConverter
cim:FrequencyConverter rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:FrequencyConverter.frequency ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Frequency
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:FrequencyConverter.maxP ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:ActivePower
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:FrequencyConverter.maxU ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Voltage
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:FrequencyConverter.minP ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:ActivePower
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:FrequencyConverter.minU ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Voltage
                                           ] ;
                       rdfs:subClassOf cim:RegulatingCondEq ;
                       rdfs:comment "A device to convert from one frequency to another (e.g., frequency F1 to F2) comprises a pair of FrequencyConverter instances. One converts from F1 to DC, the other converts the DC to F2." .


###  http://www.iec.ch/TC57/CIM#FuelAllocationSchedule
cim:FuelAllocationSchedule rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:FuelAllocationSchedule.fuelType ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:FuelType
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:FuelAllocationSchedule.fuelAllocationEndDate ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:dateTime
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:FuelAllocationSchedule.fuelAllocationStartDate ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:dateTime
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:FuelAllocationSchedule.maxFuelAllocation ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:float
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:FuelAllocationSchedule.minFuelAllocation ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:float
                                               ] ;
                           rdfs:subClassOf cim:Curve ;
                           rdfs:comment "The amount of fuel of a given type which is allocated for consumption over a specified period of time." .


###  http://www.iec.ch/TC57/CIM#FuelCostCurve
cim:FuelCostCurve rdf:type owl:Class ;
                  rdfs:subClassOf cim:Curve ;
                  rdfs:comment "Relationship between unit fuel cost in $/kWh(Y-axis) and  unit output in MW (X-axis)." .


###  http://www.iec.ch/TC57/CIM#FuelRegion
cim:FuelRegion rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:FuelRegion.endEffectiveDate ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:dateTime
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:FuelRegion.fuelRegionType ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:FuelRegion.lastModified ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:dateTime
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:FuelRegion.startEffectiveDate ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:dateTime
                                   ] ;
               rdfs:subClassOf cim:IdentifiedObject ;
               rdfs:comment "Indication of region for fuel inventory purposes" .


###  http://www.iec.ch/TC57/CIM#FuelSource
cim:FuelSource rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:oneOf ( cim:BGAS
                                                 cim:BIOM
                                                 cim:COAL
                                                 cim:DIST
                                                 cim:GAS
                                                 cim:GEOT
                                                 cim:HRCV
                                                 cim:NG
                                                 cim:NNG
                                                 cim:NONE
                                                 cim:NUCL
                                                 cim:OIL
                                                 cim:OTHR
                                                 cim:SOLR
                                                 cim:WAST
                                                 cim:WATR
                                                 cim:WIND
                                               )
                                   ] .


###  http://www.iec.ch/TC57/CIM#FuelType
cim:FuelType rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Class ;
                                   owl:oneOf ( cim:coal
                                               cim:gas
                                               cim:hardCoal
                                               cim:lignite
                                               cim:oil
                                               cim:oilShale
                                             )
                                 ] .


###  http://www.iec.ch/TC57/CIM#Fuse
cim:Fuse rdf:type owl:Class ;
         rdfs:subClassOf cim:Switch ;
         rdfs:comment "An overcurrent protective device with a circuit opening fusible part that is heated and severed by the passage of overcurrent through it. A fuse is considered a switching device because it breaks current." .


###  http://www.iec.ch/TC57/CIM#GasPrice
cim:GasPrice rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:GasPrice.gasPriceIndex ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:float
                                 ] ;
             rdfs:comment "Price of gas in monetary units" .


###  http://www.iec.ch/TC57/CIM#Gate
cim:Gate rdf:type owl:Class ;
         owl:equivalentClass [ rdf:type owl:Restriction ;
                               owl:onProperty cim:Gate.kind ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass cim:GateLogicKind
                             ] ;
         rdfs:subClassOf cim:IdentifiedObject ;
         rdfs:comment "Logical gate than support logical operation based on the input." .


###  http://www.iec.ch/TC57/CIM#GateInputPin
cim:GateInputPin rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:GateInputPin.aDLogicKind ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:AnalogToDigitalLogicKind
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:GateInputPin.duration ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Seconds
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:GateInputPin.thresholdPercentage ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:PerCent
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:GateInputPin.absoluteValue ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:boolean
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:GateInputPin.negate ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:boolean
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:GateInputPin.thresholdValue ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:float
                                     ] ;
                 rdfs:subClassOf cim:IdentifiedObject ;
                 rdfs:comment "Input pin for a logical gate. The condition described in the input pin will give a logical true or false. Result from measurement and calculation are converted to a true or false." .


###  http://www.iec.ch/TC57/CIM#GateLogicKind
cim:GateLogicKind rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:oneOf ( cim:and
                                                    cim:nand
                                                    cim:nor
                                                    cim:not
                                                    cim:or
                                                    cim:xnor
                                                    cim:xor
                                                  )
                                      ] .


###  http://www.iec.ch/TC57/CIM#GenDistributionFactor
cim:GenDistributionFactor rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:GenDistributionFactor.factor ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:float
                                              ] ;
                          rdfs:comment "This class models the generation distribution factors. This class needs to be used along with the AggregatedPnode and the IndividualPnode to show the distriubtion of each individual party." .


###  http://www.iec.ch/TC57/CIM#GenICompensationForGenJ
cim:GenICompensationForGenJ rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:GenICompensationForGenJ.rcij ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass cim:PU
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:GenICompensationForGenJ.xcij ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass cim:PU
                                                ] ;
                            rdfs:subClassOf cim:IdentifiedObject ;
                            rdfs:comment "This class provides the resistive and reactive components of compensation for the generator associated with the IEEE Type 2 voltage compensator for current flow out of one of the other generators in the interconnection." .


###  http://www.iec.ch/TC57/CIM#GenUnitOpCostCurve
cim:GenUnitOpCostCurve rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:GenUnitOpCostCurve.isNetGrossP ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:boolean
                                           ] ;
                       rdfs:subClassOf cim:Curve ;
                       rdfs:comment "Relationship between unit operating cost (Y-axis) and unit output active power (X-axis). The operating cost curve for thermal units is derived from heat input and fuel costs. The operating cost curve for hydro units is derived from water flow rates and equivalent water costs." .


###  http://www.iec.ch/TC57/CIM#GenUnitOpSchedule
cim:GenUnitOpSchedule rdf:type owl:Class ;
                      rdfs:subClassOf cim:RegularIntervalSchedule ;
                      rdfs:comment "The generating unit's Operator-approved current operating schedule (or plan), typically produced with the aid of unit commitment type analyses. The X-axis represents absolute time. The Y1-axis represents the status (0=off-line and unavailable: 1=available: 2=must run: 3=must run at fixed power value: etc.). The Y2-axis represents the must run fixed power value where required." .


###  http://www.iec.ch/TC57/CIM#GeneralClearing
cim:GeneralClearing rdf:type owl:Class ;
                    rdfs:subClassOf cim:MarketFactors ;
                    rdfs:comment "Model of clearing result of the market run at the market level.  Identifies interval" .


###  http://www.iec.ch/TC57/CIM#GeneralClearingResults
cim:GeneralClearingResults rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:GeneralClearingResults.loadForecast ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:ActivePower
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:GeneralClearingResults.totalLoad ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:float
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:GeneralClearingResults.totalNetInterchange ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:float
                                               ] ;
                           rdfs:comment "Provides the adjusted load forecast value on a load forecast zone basis." .


###  http://www.iec.ch/TC57/CIM#GeneratingBid
cim:GeneratingBid rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:GeneratingBid.lowerRampRate ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:ActivePowerChangeRate
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:GeneratingBid.maxEmergencyMW ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:ActivePower
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:GeneratingBid.minEmergencyMW ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:ActivePower
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:GeneratingBid.raiseRampRate ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:ActivePowerChangeRate
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:GeneratingBid.startUpRampRate ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:ActivePowerChangeRate
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:GeneratingBid.combinedCycleUnitOffer ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:GeneratingBid.downTimeMax ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:GeneratingBid.installedCapacity ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:GeneratingBid.maximumEconomicMW ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:GeneratingBid.minimumEconomicMW ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:GeneratingBid.noLoadCost ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:GeneratingBid.notificationTime ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:GeneratingBid.operatingMode ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:GeneratingBid.rampCurveType ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:GeneratingBid.startUpType ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:GeneratingBid.startupCost ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:GeneratingBid.upTimeMax ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ;
                  rdfs:subClassOf cim:ResourceBid ;
                  rdfs:comment "Offer to supply energy/ancillary services from a generating unit or resource" .


###  http://www.iec.ch/TC57/CIM#GeneratingUnit
cim:GeneratingUnit rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.allocSpinResP ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePower
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.autoCntrlMarginP ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePower
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.baseP ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePower
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.controlDeadband ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePower
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.controlPulseHigh ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Seconds
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.controlPulseLow ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Seconds
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.controlResponseRate ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePowerChangeRate
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.efficiency ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:PerCent
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.genControlMode ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:GeneratorControlMode
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.genControlSource ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:GeneratorControlSource
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.governorMPL ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:PU
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.governorSCD ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:PerCent
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.highControlLimit ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePower
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.initialP ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePower
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.lowControlLimit ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePower
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.lowerRampRate ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePowerChangeRate
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.maxEconomicP ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePower
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.maxOperatingP ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePower
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.maximumAllowableSpinningReserve ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePower
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.minEconomicP ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePower
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.minOperatingP ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePower
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.minimumOffTime ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Seconds
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.modelDetail ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Classification
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.nominalP ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePower
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.raiseRampRate ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePowerChangeRate
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.ratedGrossMaxP ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePower
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.ratedGrossMinP ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePower
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.ratedNetMaxP ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePower
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.startupCost ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Money
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.startupTime ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Seconds
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.totalEfficiency ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:PerCent
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.variableCost ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Money
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.longPF ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.normalPF ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.penaltyFactor ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.shortPF ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:GeneratingUnit.tieLinePF ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ;
                   rdfs:subClassOf cim:Equipment ;
                   rdfs:comment "A single or set of synchronous machines for converting mechanical power into alternating-current power. For example, individual machines within a set may be defined for scheduling purposes while a single control signal is derived for the set. In this case there would be a GeneratingUnit for each member of the set and an additional GeneratingUnit corresponding to the set." .



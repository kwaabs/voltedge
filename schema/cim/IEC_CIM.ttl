                                                         cim:other
                                                         cim:ozoneResistantRubber
                                                         cim:rubber
                                                         cim:siliconRubber
                                                         cim:treeResistantHighMolecularWeightPolyethylene
                                                         cim:treeRetardantCrosslinkedPolyethylene
                                                         cim:unbeltedPilc
                                                         cim:varnishedCambricCloth
                                                         cim:varnishedDacronGlass

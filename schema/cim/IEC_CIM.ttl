                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:BranchGroup.minimumActivePower ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:ActivePower
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:BranchGroup.minimumReactivePower ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:ReactivePower
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:BranchGroup.monitorActivePower ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:boolean
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:BranchGroup.monitorReactivePower ;

cim:GovGAST1.t4 rdf:type owl:ObjectProperty ;
                rdfs:domain cim:GovGAST1 ;
                rdfs:range cim:Seconds ;
                rdfs:comment "Governor lead time constant (T4).  Typical Value = 0." .



###  http://www.iec.ch/TC57/CIM#WorkBillingInfo
cim:WorkBillingInfo rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:WorkBillingInfo.costEstimate ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Money
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:WorkBillingInfo.deposit ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Money
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:WorkBillingInfo.workPrice ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Money
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:WorkBillingInfo.discount ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:float
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:WorkBillingInfo.dueDateTime ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:WorkBillingInfo.issueDateTime ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:WorkBillingInfo.receivedDateTime ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ;
                    rdfs:subClassOf cim:Document ;
                    rdfs:comment "Billing information for work performed for the customer. The history of Work Billing Info, Invoices, and Payments is to be maintained in associated ActivityRecords." .


###  http://www.iec.ch/TC57/CIM#WorkCostDetail
cim:WorkCostDetail rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:WorkCostDetail.amount ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Money
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:WorkCostDetail.isDebit ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:boolean
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:WorkCostDetail.transactionDateTime ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:dateTime
                                       ] ;

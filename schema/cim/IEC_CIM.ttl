###  http://www.iec.ch/TC57/CIM#ProtectiveActionAdjustmentKind
cim:ProtectiveActionAdjustmentKind rdf:type owl:Class ;
                                   owl:equivalentClass [ rdf:type owl:Class ;
                                                         owl:oneOf ( cim:byPercentage
                                                                     cim:byValue
                                                                     cim:measurement
                                                                     cim:setValue

cim:TransformerEnd.endNumber rdf:type owl:DatatypeProperty ;
                             rdfs:domain cim:TransformerEnd ;
                             rdfs:range xsd:nonNegativeInteger ;
                             rdfs:comment "Number for this transformer end, corresponding to the end's order in the power transformer vector group or phase angle clock number.  Highest voltage winding should be 1.  Each end within a power transformer should have a unique subsequent end number.   Note the transformer end number need not match the terminal sequence number." .


###  http://www.iec.ch/TC57/CIM#TransformerEnd.grounded
cim:TransformerEnd.grounded rdf:type owl:DatatypeProperty ;
                            rdfs:domain cim:TransformerEnd ;
                            rdfs:range xsd:boolean ;
                            rdfs:comment "(for Yn and Zn connections) True if the neutral is solidly grounded." .


###  http://www.iec.ch/TC57/CIM#TransformerEndInfo.endNumber
cim:TransformerEndInfo.endNumber rdf:type owl:DatatypeProperty ;
                                 rdfs:domain cim:TransformerEndInfo ;
                                 rdfs:range xsd:nonNegativeInteger ;
                                 rdfs:comment "Number for this transformer end, corresponding to the end's order in the PowerTransformer.vectorGroup attribute. Highest voltage winding should be 1." .


###  http://www.iec.ch/TC57/CIM#TransformerEndInfo.phaseAngleClock
cim:TransformerEndInfo.phaseAngleClock rdf:type owl:DatatypeProperty ;
                                       rdfs:domain cim:TransformerEndInfo ;
                                       rdfs:range xsd:nonNegativeInteger ;
                                       rdfs:comment "Winding phase angle where 360 degrees are represented with clock hours, so the valid values are {0, ..., 11}. For example, to express the second winding in code 'Dyn11', set attributes as follows: 'endNumber'=2, 'connectionKind' = Yn and 'phaseAngleClock' = 11." .


###  http://www.iec.ch/TC57/CIM#TransformerObservation.dga

cim:ACLineSegment.ACLineSegmentPhase rdf:type owl:ObjectProperty ;
                                     rdfs:domain cim:ACLineSegmentPhase ;
                                     rdfs:range cim:ACLineSegment ;
                                     rdfs:comment "The line segment phases which belong to the line segment.The line segment to which the phase belongs." .


###  http://www.iec.ch/TC57/CIM#ACLineSegment.Cut
cim:ACLineSegment.Cut rdf:type owl:ObjectProperty ;
                      rdfs:domain cim:Cut ;
                      rdfs:range cim:ACLineSegment ;
                      rdfs:comment "Cuts applied to the line segment.The line segment to which the cut is applied." .


###  http://www.iec.ch/TC57/CIM#ACLineSegment.GroundAction
cim:ACLineSegment.GroundAction rdf:type owl:ObjectProperty ;
                               rdfs:domain cim:GroundAction ;
                               rdfs:range cim:ACLineSegment ;
                               rdfs:comment "Ground action involving clamp usage (for the case when the ground is applied along the line segment instead of at its terminals).The line segment that this ground action will affect. This is the only way to access relationship to clamp in case the ground needs to be placed along the line segment." .


###  http://www.iec.ch/TC57/CIM#ACLineSegment.JumperAction
cim:ACLineSegment.JumperAction rdf:type owl:ObjectProperty ;
                               rdfs:domain cim:JumperAction ;
                               rdfs:range cim:ACLineSegment ;
                               rdfs:comment "Jumper action involving clamp usage (for the case when the jumper is applied along the line segment instead of at its terminals).The line segment that this jumper action will affect. This is the only way to access relationship to clamp in case the jumper needs to connect along the line segment." .


###  http://www.iec.ch/TC57/CIM#ACLineSegment.LineFault
cim:ACLineSegment.LineFault rdf:type owl:ObjectProperty ;
                            rdfs:domain cim:LineFault ;
                            rdfs:range cim:ACLineSegment ;
                            rdfs:comment "The line faults of the line segment.The line segment of this line fault." .



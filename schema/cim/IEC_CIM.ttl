                                                      owl:onClass cim:PU
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:PFVArType2IEEEVArController.exlon ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:boolean
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:PFVArType2IEEEVArController.vs ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:float
                                                    ] ;
                                rdfs:subClassOf cim:PFVArControllerType2Dynamics ;
                                rdfs:comment """The class represents IEEE VAR Controller Type 2 which is a summing point type controller. It makes up the outside loop of a two-loop system. This controller is implemented as a slow PI type controller, and the voltage regulator forms the inner loop and is implemented as a fast controller.

Reference: IEEE Standard 421.5-2005 Section 11.5.""" .


###  http://www.iec.ch/TC57/CIM#PSREvent
cim:PSREvent rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:PSREvent.kind ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:PSREventKind
                                 ] ;
             rdfs:subClassOf cim:ActivityRecord ;
             rdfs:comment "Event recording the change in operational status of a power system resource; may be for an event that has already occurred or for a planned activity." .


###  http://www.iec.ch/TC57/CIM#PSREventKind
cim:PSREventKind rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:oneOf ( cim:inService
                                                   cim:other
                                                   cim:outOfService
                                                   cim:pendingAdd
                                                   cim:pendingRemove
                                                   cim:pendingReplace
                                                   cim:unknown
                                                 )
                                     ] .


###  http://www.iec.ch/TC57/CIM#PSRType
cim:PSRType rdf:type owl:Class ;
            rdfs:subClassOf cim:IdentifiedObject ;
            rdfs:comment "Classifying instances of the same class, e.g. overhead and underground ACLineSegments. This classification mechanism is intended to provide flexibility outside the scope of this standard, i.e. provide customisation that is non standard." .


###  http://www.iec.ch/TC57/CIM#PU
cim:PU rdf:type owl:Class ;
       owl:equivalentClass [ rdf:type owl:Restriction ;
                             owl:onProperty cim:PU.multiplier ;
                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass cim:UnitMultiplier
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty cim:PU.unit ;
                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass cim:UnitSymbol
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty cim:PU.value ;
                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:float
                           ] ;
       rdfs:comment "Per Unit - a positive or negative value referred to a defined base. Values typically range from -10 to +10." .



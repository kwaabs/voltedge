###  http://www.iec.ch/TC57/CIM#ReadingType.accumulation
cim:ReadingType.accumulation rdf:type owl:ObjectProperty ;
                             rdfs:domain cim:ReadingType ;
                             rdfs:range cim:AccumulationKind ;
                             rdfs:comment "Accumulation behaviour of a reading over time, usually 'measuringPeriod', to be used with individual endpoints (as opposed to 'macroPeriod' and 'aggregate' that are used to describe aggregations of data from individual endpoints)." .


###  http://www.iec.ch/TC57/CIM#ReadingType.aggregate
cim:ReadingType.aggregate rdf:type owl:ObjectProperty ;
                          rdfs:domain cim:ReadingType ;
                          rdfs:range cim:AggregateKind ;
                          rdfs:comment "Salient attribute of the reading data aggregated from individual endpoints. This is mainly used to define a mathematical operation carried out over 'macroPeriod', but may also be used to describe an attribute of the data when the 'macroPeriod' is not defined." .


###  http://www.iec.ch/TC57/CIM#ReadingType.argument
cim:ReadingType.argument rdf:type owl:ObjectProperty ;
                         rdfs:domain cim:ReadingType ;
                         rdfs:range cim:RationalNumber ;
                         rdfs:comment """Argument used to introduce numbers into the unit of measure description where they are needed (e.g., 4 where the measure needs an argument such as CEMI(n=4)). Most arguments used in practice however will be integers (i.e., 'denominator'=1).
Value 0 in 'numerator' and 'denominator' means not applicable.""" .


###  http://www.iec.ch/TC57/CIM#ReadingType.commodity
cim:ReadingType.commodity rdf:type owl:ObjectProperty ;
                          rdfs:domain cim:ReadingType ;
                          rdfs:range cim:CommodityKind ;
                          rdfs:comment "Commodity being measured." .



cim:ACLineSegment.b0ch rdf:type owl:ObjectProperty ;
                       rdfs:domain cim:ACLineSegment ;
                       rdfs:range cim:Susceptance ;
                       rdfs:comment "Zero sequence shunt (charging) susceptance, uniformly distributed, of the entire line section." .


###  http://www.iec.ch/TC57/CIM#ACLineSegment.bch
cim:ACLineSegment.bch rdf:type owl:ObjectProperty ;
                      rdfs:domain cim:ACLineSegment ;
                      rdfs:range cim:Susceptance ;
                      rdfs:comment "Positive sequence shunt (charging) susceptance, uniformly distributed, of the entire line section.  This value represents the full charging over the full length of the line." .


###  http://www.iec.ch/TC57/CIM#ACLineSegment.g0ch
cim:ACLineSegment.g0ch rdf:type owl:ObjectProperty ;
                       rdfs:domain cim:ACLineSegment ;
                       rdfs:range cim:Conductance ;

                                      rdfs:domain cim:PFVArType1IEEEPFController ;
                                      rdfs:range xsd:float ;
                                      rdfs:comment "PF controller dead band (<i>V</i><i><sub>PFC_BW</sub></i>).  Typical Value = 0.05." .



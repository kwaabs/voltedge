                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:RUCAwardInstruction.RUCCapacity ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:RUCAwardInstruction.RUCSchedule ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:RUCAwardInstruction.clearedPrice ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;

cim:PFVArType2IEEEVArController.vs rdf:type owl:DatatypeProperty ;
                                   rdfs:domain cim:PFVArType2IEEEVArController ;
                                   rdfs:range xsd:float ;
                                   rdfs:comment "Generator sensing voltage (<i>V</i><i><sub>S</sub></i>)." .



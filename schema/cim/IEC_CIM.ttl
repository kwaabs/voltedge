###  http://www.iec.ch/TC57/CIM#OASISMeasType
cim:OASISMeasType rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:oneOf ( cim:FACTOR
                                                    cim:FLAG
                                                    cim:INTEGER
                                                    cim:MW
                                                    cim:MWh
                                                    <http://www.iec.ch/TC57/CIM#%>
                                                    <http://www.iec.ch/TC57/CIM#US$>
                                                    <http://www.iec.ch/TC57/CIM#US$/MW>
                                                    <http://www.iec.ch/TC57/CIM#US$/MWh>
                                                  )
                                      ] .


###  http://www.iec.ch/TC57/CIM#OASISReportType
cim:OASISReportType rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:oneOf ( cim:AS_DA_RESULT
                                                      cim:AS_OP_RSRV
                                                      cim:AS_REQ
                                                      cim:AS_RTM_RESULT
                                                      cim:BIDS_PUBLIC
                                                      cim:CMMT_RA_MLC
                                                      cim:CMMT_RMR
                                                      cim:CRR_CLEARING
                                                      cim:CRR_INVENTORY
                                                      cim:ENE_EA
                                                      cim:ENE_HASP
                                                      cim:ENE_IFM
                                                      cim:ENE_MPM
                                                      cim:ENE_RTM
                                                      cim:ENE_RUC
                                                      cim:LOSS_DA_HASP
                                                      cim:LOSS_RTM
                                                      cim:PRC_AS
                                                      cim:PRC_CNSTR
                                                      cim:PRC_FUEL
                                                      cim:PRC_HRLY_LMP
                                                      cim:PRC_INTVL_LMP
                                                      cim:SLD_FCST
                                                      cim:SLD_FCST_PEAK
                                                      cim:SLD_MKTS
                                                      cim:TRNS_ATC
                                                      cim:TRNS_OUTAGE
                                                      cim:TRNS_USAGE
                                                    )
                                        ] .


###  http://www.iec.ch/TC57/CIM#OASISStatusType
cim:OASISStatusType rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:oneOf ( cim:Data_Transfer_Procedure_Initiated
                                                      cim:Data_Transfer_Succesful
                                                      cim:Forced_Termination
                                                      cim:Obsolete
                                                      cim:Push_Failed
                                                      cim:Valid
                                                    )
                                        ] .


###  http://www.iec.ch/TC57/CIM#OilPreservationKind
cim:OilPreservationKind rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Class ;
                                              owl:oneOf ( cim:conservator
                                                          cim:freeBreathing
                                                          cim:nitrogenBlanket
                                                          cim:other
                                                        )
                                            ] .


###  http://www.iec.ch/TC57/CIM#OilPrice
cim:OilPrice rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:OilPrice.oilPriceIndex ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:float
                                 ] ;
             rdfs:comment "Price of oil in monetary units" .


###  http://www.iec.ch/TC57/CIM#OldCrew
cim:OldCrew rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:OldCrew.type ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:string
                                ] ;
            rdfs:subClassOf cim:Crew ;
            rdfs:comment "A crew is a group of people with specific skills, tools, and vehicles." .


###  http://www.iec.ch/TC57/CIM#OldPerson
cim:OldPerson rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:OldPerson.status ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:Status
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:OldPerson.type ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:string
                                  ] ;
              rdfs:subClassOf cim:Person ;
              rdfs:comment "General purpose information for name and other information to contact people." .


###  http://www.iec.ch/TC57/CIM#OldSwitchInfo
cim:OldSwitchInfo rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:OldSwitchInfo.dielectricStrength ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Voltage
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:OldSwitchInfo.makingCapacity ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:CurrentFlow
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:OldSwitchInfo.minimumCurrent ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:CurrentFlow
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:OldSwitchInfo.withstandCurrent ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:CurrentFlow
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:OldSwitchInfo.loadBreak ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:boolean
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:OldSwitchInfo.poleCount ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:OldSwitchInfo.remote ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:boolean
                                      ] ;
                  rdfs:subClassOf cim:SwitchInfo ;
                  rdfs:comment "Properties of switch assets." .


###  http://www.iec.ch/TC57/CIM#OldTransformerEndInfo
cim:OldTransformerEndInfo rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:OldTransformerEndInfo.dayOverLoadRating ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:ApparentPower
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:OldTransformerEndInfo.hourOverLoadRating ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:ApparentPower
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:OldTransformerEndInfo.solidInsulationWeight ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:Weight
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:OldTransformerEndInfo.windingInsulationKind ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:WindingInsulationKind
                                              ] ;
                          rdfs:subClassOf cim:TransformerEndInfo .


###  http://www.iec.ch/TC57/CIM#OldTransformerTankInfo
cim:OldTransformerTankInfo rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:OldTransformerTankInfo.constructionKind ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:TransformerConstructionKind
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:OldTransformerTankInfo.coreCoilsWeight ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:Weight
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:OldTransformerTankInfo.coreKind ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:TransformerCoreKind
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:OldTransformerTankInfo.function ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:TransformerFunctionKind
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:OldTransformerTankInfo.neutralBIL ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:Voltage
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:OldTransformerTankInfo.oilPreservationKind ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:OilPreservationKind
                                               ] ;
                           rdfs:subClassOf cim:TransformerTankInfo .


###  http://www.iec.ch/TC57/CIM#OldWorkTask
cim:OldWorkTask rdf:type owl:Class ;
                rdfs:subClassOf cim:WorkTask ;
                rdfs:comment "A set of tasks is required to implement a design." .


###  http://www.iec.ch/TC57/CIM#OnOff
cim:OnOff rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Class ;
                                owl:oneOf ( cim:OFF
                                            cim:ON
                                          )
                              ] .


###  http://www.iec.ch/TC57/CIM#OneCallRequest
cim:OneCallRequest rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:OneCallRequest.explosivesUsed ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:boolean
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:OneCallRequest.markedIndicator ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:boolean
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:OneCallRequest.markingInstruction ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ;
                   rdfs:subClassOf cim:WorkDocument ;
                   rdfs:comment "A request for other utilities to mark their underground facilities prior to commencement of construction and/or maintenance." .


###  http://www.iec.ch/TC57/CIM#OpenAccessProduct
cim:OpenAccessProduct rdf:type owl:Class ;
                      rdfs:subClassOf cim:Agreement ;
                      rdfs:comment "Contracts for services offered commercially." .


###  http://www.iec.ch/TC57/CIM#OpenCircuitTest
cim:OpenCircuitTest rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:OpenCircuitTest.energisedEndVoltage ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Voltage
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:OpenCircuitTest.openEndVoltage ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Voltage
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:OpenCircuitTest.phaseShift ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:AngleDegrees
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:OpenCircuitTest.energisedEndStep ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:nonNegativeInteger
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:OpenCircuitTest.openEndStep ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:nonNegativeInteger
                                        ] ;
                    rdfs:subClassOf cim:TransformerTest ;
                    rdfs:comment "Open-circuit test results verify winding turn ratios and phase shifts. They include induced voltage and phase shift measurements on open-circuit windings, with voltage applied to the energised end. For three-phase windings, the excitation can be a positive sequence (the default) or a zero sequence." .


###  http://www.iec.ch/TC57/CIM#OpenTieSchedule
cim:OpenTieSchedule rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:OpenTieSchedule.value ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:boolean
                                        ] ;
                    rdfs:subClassOf cim:BidHourlySchedule ;
                    rdfs:comment """Result of bid validation against conditions that may exist on an interchange that becomes disconnected or is heavily discounted with respect the MW flow.

This schedule is assocated with the hourly parameters in a resource bid.""" .


###  http://www.iec.ch/TC57/CIM#OperatingParticipant
cim:OperatingParticipant rdf:type owl:Class ;
                         rdfs:subClassOf cim:IdentifiedObject ;
                         rdfs:comment "An operator of multiple power system resource objects. Note multple operating participants may operate the same power system resource object.   This can be used for modeling jointly owned units where each owner operates as a contractual share." .


###  http://www.iec.ch/TC57/CIM#OperatingShare
cim:OperatingShare rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:OperatingShare.percentage ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:PerCent
                                       ] ;
                   rdfs:comment "Specifies the operations contract relationship between a power system resource and a contract participant." .


###  http://www.iec.ch/TC57/CIM#OperationPersonRole
cim:OperationPersonRole rdf:type owl:Class ;
                        rdfs:subClassOf cim:PersonRole ;
                        rdfs:comment "Person role in the context of utility operations." .


###  http://www.iec.ch/TC57/CIM#OperationalLimit
cim:OperationalLimit rdf:type owl:Class ;
                     rdfs:subClassOf cim:IdentifiedObject ;
                     rdfs:comment """A value associated with a specific kind of limit. 
The sub class value attribute shall be positive. 
The sub class value attribute is inversely proportional to OperationalLimitType.acceptableDuration (acceptableDuration for short). A pair of value_x and acceptableDuration_x are related to each other as follows:
if value_1 &gt; value_2 &gt; value_3 &gt;... then
acceptableDuration_1 &lt; acceptableDuration_2 &lt; acceptableDuration_3 &lt; ...
A value_x with direction=\"high\" shall be greater than a value_y with direction=\"low\".""" .


###  http://www.iec.ch/TC57/CIM#OperationalLimitDirectionKind
cim:OperationalLimitDirectionKind rdf:type owl:Class ;
                                  owl:equivalentClass [ rdf:type owl:Class ;
                                                        owl:oneOf ( cim:absoluteValue
                                                                    cim:high
                                                                    cim:low
                                                                  )
                                                      ] .


###  http://www.iec.ch/TC57/CIM#OperationalLimitSet
cim:OperationalLimitSet rdf:type owl:Class ;
                        rdfs:subClassOf cim:IdentifiedObject ;
                        rdfs:comment "A set of limits associated with equipment.  Sets of limits might apply to a specific temperature, or season for example. A set of limits may contain different severities of limit levels that would apply to the same equipment. The set may contain limits of different types such as apparent power and current limits or high and low voltage limits  that are logically applied together as a set." .


###  http://www.iec.ch/TC57/CIM#OperationalLimitType
cim:OperationalLimitType rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:OperationalLimitType.acceptableDuration ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:Seconds
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:OperationalLimitType.direction ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:OperationalLimitDirectionKind
                                             ] ;
                         rdfs:subClassOf cim:IdentifiedObject ;
                         rdfs:comment "The operational meaning of a category of limits." .


###  http://www.iec.ch/TC57/CIM#OperationalRestriction
cim:OperationalRestriction rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:OperationalRestriction.activePeriod ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:DateTimeInterval
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:OperationalRestriction.restrictedValue ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:FloatQuantity
                                               ] ;
                           rdfs:subClassOf cim:Document ;
                           rdfs:comment """A document that can be associated with equipment to describe any sort of restrictions compared with the original manufacturer's specification or with the usual operational practice e.g. temporary maximum loadings, maximum switching current, do not operate if bus couplers are open, etc.
In the UK, for example, if a breaker or switch ever mal-operates, this is reported centrally and utilities use their asset systems to identify all the installed devices of the same manufacturer's type. They then apply operational restrictions in the operational systems to warn operators of potential problems. After appropriate inspection and maintenance, the operational restrictions may be removed.""" .


###  http://www.iec.ch/TC57/CIM#OperationalTag
cim:OperationalTag rdf:type owl:Class ;
                   rdfs:subClassOf cim:Document ;
                   rdfs:comment "Operational tag placed on a power system resource or asset in the context of switching plan execution or other work in the field." .


###  http://www.iec.ch/TC57/CIM#OperationalUpdatedRating
cim:OperationalUpdatedRating rdf:type owl:Class ;
                             owl:equivalentClass [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:OperationalUpdatedRating.changeType ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onDataRange xsd:string
                                                 ] ;
                             rdfs:subClassOf cim:OperationalRestriction ;
                             rdfs:comment "Lowered capability because of deterioration or inadequacy (sometimes referred to as derating or partial outage) or other kind of operational rating change." .


###  http://www.iec.ch/TC57/CIM#OperationsSafetySupervisor
cim:OperationsSafetySupervisor rdf:type owl:Class ;
                               rdfs:subClassOf cim:Operator ;
                               rdfs:comment "Operator with responsibility that the work in high voltage installation is executed in a safe manner and according to safety regulation." .


###  http://www.iec.ch/TC57/CIM#OperatonalLimitTypeScaling
cim:OperatonalLimitTypeScaling rdf:type owl:Class ;
                               owl:equivalentClass [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:OperatonalLimitTypeScaling.scalingPercent ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass cim:PerCent
                                                   ] ;
                               rdfs:comment "One operational limit type scales values of another operational limit type when under the same operational limit set.    This applies to any operational limit assigned to the target operational limit type and without other limit dependency models." .


###  http://www.iec.ch/TC57/CIM#Operator
cim:Operator rdf:type owl:Class ;
             rdfs:subClassOf cim:OperationPersonRole ;
             rdfs:comment "Control room operator." .


###  http://www.iec.ch/TC57/CIM#OrgOrgRole
cim:OrgOrgRole rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:OrgOrgRole.clientID ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ;
               rdfs:subClassOf cim:OrganisationRole ;
               rdfs:comment """Roles played between Organisations and other Organisations. This includes role ups for ogranisations, cost centers, profit centers, regulatory reporting, etc.
Note that the parent and child relationship is indicated by the name on each end of the association.""" .


###  http://www.iec.ch/TC57/CIM#OrgPnodeAllocation
cim:OrgPnodeAllocation rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:OrgPnodeAllocation.maxMWAllocation ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:ActivePower
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:OrgPnodeAllocation.endEffectiveDate ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:dateTime
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:OrgPnodeAllocation.startEffectiveDate ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:dateTime
                                           ] ;
                       rdfs:subClassOf cim:IdentifiedObject ;
                       rdfs:comment "This class models the allocation between asset owners and pricing nodes" .


###  http://www.iec.ch/TC57/CIM#OrgResOwnership
cim:OrgResOwnership rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:OrgResOwnership.asscType ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:ResourceAssnType
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:OrgResOwnership.masterSchedulingCoordinatorFlag ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:YesNo
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:OrgResOwnership.ownershipPercent ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:PerCent
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:OrgResOwnership.endEffectiveDate ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:OrgResOwnership.startEffectiveDate ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ;
                    rdfs:subClassOf cim:IdentifiedObject ;
                    rdfs:comment "This class model the ownership percent and type of ownership between resource and organisation" .


###  http://www.iec.ch/TC57/CIM#Organisation
cim:Organisation rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Organisation.electronicAddress ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:ElectronicAddress
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Organisation.phone1 ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:TelephoneNumber
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Organisation.phone2 ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:TelephoneNumber
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Organisation.postalAddress ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:StreetAddress
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Organisation.streetAddress ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:StreetAddress
                                     ] ;
                 rdfs:subClassOf cim:IdentifiedObject ;
                 rdfs:comment "Organisation that might have roles as utility, contractor, supplier, manufacturer, customer, etc." .


###  http://www.iec.ch/TC57/CIM#OrganisationCode
cim:OrganisationCode rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:oneOf ( cim:BILL_TO
                                                       cim:PAY_TO
                                                       cim:PROVIDED_BY
                                                       cim:SOLD_TO
                                                     )
                                         ] .


###  http://www.iec.ch/TC57/CIM#OrganisationRole
cim:OrganisationRole rdf:type owl:Class ;
                     rdfs:subClassOf cim:IdentifiedObject ;
                     rdfs:comment "Identifies a way in which an organisation may participate in the utility enterprise (e.g., customer, manufacturer, etc)." .


###  http://www.iec.ch/TC57/CIM#OrganisationType
cim:OrganisationType rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:oneOf ( cim:CUSTOMER
                                                       cim:RTO
                                                     )
                                         ] .


###  http://www.iec.ch/TC57/CIM#OrientationKind
cim:OrientationKind rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:oneOf ( cim:negative
                                                      cim:positive
                                                    )
                                        ] .


###  http://www.iec.ch/TC57/CIM#Outage
cim:Outage rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Outage.actualPeriod ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:DateTimeInterval
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Outage.estimatedPeriod ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:DateTimeInterval
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Outage.summary ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:ServicePointOutageSummary
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Outage.cancelledDateTime ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:dateTime
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Outage.cause ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Outage.isPlanned ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:boolean
                               ] ;
           rdfs:subClassOf cim:Document ;
           rdfs:comment """Document describing details of an active or planned outage in a part of the electrical network.
A non-planned outage may be created upon:
- a breaker trip,
- a fault indicator status change,
- a meter event indicating customer outage,
- a reception of one or more customer trouble calls, or
- an operator command, reflecting information obtained from the field crew.
Outage restoration may be performed using a switching plan which complements the outage information with detailed switching activities, including the relationship to the crew and work.
A planned outage may be created upon:
- a request for service, maintenance or construction work in the field, or
- an operator-defined outage for what-if/contingency network analysis.""" .


###  http://www.iec.ch/TC57/CIM#OutageSchedule
cim:OutageSchedule rdf:type owl:Class ;
                   rdfs:subClassOf cim:Document ;
                   rdfs:comment "Document containing the definition of planned outages of equipment and/or service (delivery) points (sometimes referred to as customers). It is used as specification for producing switching plans." .


###  http://www.iec.ch/TC57/CIM#OverexcLim2
cim:OverexcLim2 rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:OverexcLim2.ifdlim ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:PU
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:OverexcLim2.koi ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:PU
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:OverexcLim2.voimax ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:PU
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:OverexcLim2.voimin ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:PU
                                    ] ;
                rdfs:subClassOf cim:OverexcitationLimiterDynamics ;
                rdfs:comment """Different from LimIEEEOEL, LimOEL2 has a fixed pickup threshold and reduces the excitation set-point by mean of non-windup integral regulator.
Irated is the rated machine excitation current (calculated from nameplate conditions: V<sub>nom</sub>, P<sub>nom</sub>, CosPhi<sub>nom</sub>).""" .


###  http://www.iec.ch/TC57/CIM#OverexcLimIEEE
cim:OverexcLimIEEE rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:OverexcLimIEEE.hyst ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:PU
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:OverexcLimIEEE.ifdlim ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:PU
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:OverexcLimIEEE.ifdmax ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:PU
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:OverexcLimIEEE.itfpu ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:PU
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:OverexcLimIEEE.kcd ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:PU
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:OverexcLimIEEE.kramp ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ;
                   rdfs:subClassOf cim:OverexcitationLimiterDynamics ;
                   rdfs:comment """The over excitation limiter model is intended to represent the significant features of OELs necessary for some large-scale system studies. It is the result of a pragmatic approach to obtain a model that can be widely applied with attainable data from generator owners. An attempt to include all variations in the functionality of OELs and duplicate how they interact with the rest of the excitation systems would likely result in a level of application insufficient for the studies for which they are intended.

Reference: IEEE OEL 421.5-2005 Section 9.""" .



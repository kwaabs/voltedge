                                               owl:onProperty cim:ExpectedEnergyValues.expectedMwh ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ;
                         rdfs:comment "Model Expected Energy  from Market Clearing" .


###  http://www.iec.ch/TC57/CIM#ExternalCustomerAgreement
cim:ExternalCustomerAgreement rdf:type owl:Class ;
                              rdfs:subClassOf cim:Agreement ;
                              rdfs:comment "A type of customer agreement involving an external agency. For example, a customer may form a contracts with an Energy Service Supplier if Direct Access is permitted." .


###  http://www.iec.ch/TC57/CIM#ExternalNetworkInjection
cim:ExternalNetworkInjection rdf:type owl:Class ;

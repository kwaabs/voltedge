@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.iec.ch/TC57/CIM> .

<http://www.iec.ch/TC57/CIM> rdf:type owl:Ontology .

#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.iec.ch/TC57/CIM#ACDCConverter.ACDCConverterDCTerminal
cim:ACDCConverter.ACDCConverterDCTerminal rdf:type owl:ObjectProperty ;
                                          rdfs:domain cim:ACDCConverterDCTerminal ;
                                          rdfs:range cim:ACDCConverter ;
                                          rdfs:comment "" .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.baseS
cim:ACDCConverter.baseS rdf:type owl:ObjectProperty ;
                        rdfs:domain cim:ACDCConverter ;
                        rdfs:range cim:ApparentPower ;
                        rdfs:comment "Base apparent power of the converter pole." .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.idc
cim:ACDCConverter.idc rdf:type owl:ObjectProperty ;
                      rdfs:domain cim:ACDCConverter ;
                      rdfs:range cim:CurrentFlow ;
                      rdfs:comment "Converter DC current, also called Id. Converter state variable, result from power flow." .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.idleLoss
cim:ACDCConverter.idleLoss rdf:type owl:ObjectProperty ;
                           rdfs:domain cim:ACDCConverter ;
                           rdfs:range cim:ActivePower ;
                           rdfs:comment "Active power loss in pole at no power transfer. Converter configuration data used in power flow." .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.maxUdc
cim:ACDCConverter.maxUdc rdf:type owl:ObjectProperty ;
                         rdfs:domain cim:ACDCConverter ;
                         rdfs:range cim:Voltage ;
                         rdfs:comment "The maximum voltage on the DC side at which the converter should operate. Converter configuration data used in power flow." .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.minUdc
cim:ACDCConverter.minUdc rdf:type owl:ObjectProperty ;
                         rdfs:domain cim:ACDCConverter ;
                         rdfs:range cim:Voltage ;
                         rdfs:comment "Min allowed converter DC voltage. Converter configuration data used in power flow." .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.p
cim:ACDCConverter.p rdf:type owl:ObjectProperty ;
                    rdfs:domain cim:ACDCConverter ;
                    rdfs:range cim:ActivePower ;
                    rdfs:comment """Active power at the point of common coupling. Load sign convention is used, i.e. positive sign means flow out from a node.
Starting value for a steady state solution in the case a simplified power flow model is used.""" .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.poleLossP
cim:ACDCConverter.poleLossP rdf:type owl:ObjectProperty ;
                            rdfs:domain cim:ACDCConverter ;
                            rdfs:range cim:ActivePower ;
                            rdfs:comment """The active power loss at a DC Pole 
= idleLoss + switchingLoss*|Idc| + resitiveLoss*Idc^2
For lossless operation Pdc=Pac
For rectifier operation with losses Pdc=Pac-lossP
For inverter operation with losses Pdc=Pac+lossP
Converter state variable used in power flow.""" .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.q
cim:ACDCConverter.q rdf:type owl:ObjectProperty ;
                    rdfs:domain cim:ACDCConverter ;
                    rdfs:range cim:ReactivePower ;
                    rdfs:comment """Reactive power at the point of common coupling. Load sign convention is used, i.e. positive sign means flow out from a node.
Starting value for a steady state solution in the case a simplified power flow model is used.""" .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.ratedUdc
cim:ACDCConverter.ratedUdc rdf:type owl:ObjectProperty ;
                           rdfs:domain cim:ACDCConverter ;
                           rdfs:range cim:Voltage ;
                           rdfs:comment "Rated converter DC voltage, also called UdN. Converter configuration data used in power flow." .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.resistiveLoss
cim:ACDCConverter.resistiveLoss rdf:type owl:ObjectProperty ;
                                rdfs:domain cim:ACDCConverter ;
                                rdfs:range cim:Resistance ;
                                rdfs:comment "Converter configuration data used in power flow. Refer to poleLossP." .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.switchingLoss
cim:ACDCConverter.switchingLoss rdf:type owl:ObjectProperty ;
                                rdfs:domain cim:ACDCConverter ;
                                rdfs:range cim:ActivePowerPerCurrentFlow ;
                                rdfs:comment """Switching losses, relative to the base apparent power 'baseS'.
Refer to poleLossP.""" .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.targetPpcc
cim:ACDCConverter.targetPpcc rdf:type owl:ObjectProperty ;
                             rdfs:domain cim:ACDCConverter ;
                             rdfs:range cim:ActivePower ;
                             rdfs:comment "Real power injection target in AC grid, at point of common coupling." .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.targetUdc
cim:ACDCConverter.targetUdc rdf:type owl:ObjectProperty ;
                            rdfs:domain cim:ACDCConverter ;
                            rdfs:range cim:Voltage ;
                            rdfs:comment "Target value for DC voltage magnitude." .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.uc
cim:ACDCConverter.uc rdf:type owl:ObjectProperty ;
                     rdfs:domain cim:ACDCConverter ;
                     rdfs:range cim:Voltage ;
                     rdfs:comment "Line-to-line converter voltage, the voltage at the AC side of the valve. Converter state variable, result from power flow." .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.udc
cim:ACDCConverter.udc rdf:type owl:ObjectProperty ;
                      rdfs:domain cim:ACDCConverter ;
                      rdfs:range cim:Voltage ;
                      rdfs:comment "Converter voltage at the DC side, also called Ud. Converter state variable, result from power flow." .


###  http://www.iec.ch/TC57/CIM#ACDCConverter.valveU0
cim:ACDCConverter.valveU0 rdf:type owl:ObjectProperty ;
                          rdfs:domain cim:ACDCConverter ;
                          rdfs:range cim:Voltage ;
                          rdfs:comment "Valve threshold voltage, also called Uvalve. Forward voltage drop when the valve is conducting. Used in loss calculations, i.e. the switchLoss depend on numberOfValves * valveU0." .


###  http://www.iec.ch/TC57/CIM#ACDCConverterDCTerminal.polarity
cim:ACDCConverterDCTerminal.polarity rdf:type owl:ObjectProperty ;
                                     rdfs:domain cim:ACDCConverterDCTerminal ;
                                     rdfs:range cim:DCPolarityKind ;
                                     rdfs:comment "Represents the normal network polarity condition." .


###  http://www.iec.ch/TC57/CIM#ACDCTerminal.BusNameMarker
cim:ACDCTerminal.BusNameMarker rdf:type owl:ObjectProperty ;
                               rdfs:domain cim:BusNameMarker ;
                               rdfs:range cim:ACDCTerminal ;
                               rdfs:comment "The bus name marker used to name the bus (topological node).The terminals associated with this bus name marker." .


###  http://www.iec.ch/TC57/CIM#ACDCTerminal.Measure
cim:ACDCTerminal.Measure rdf:type owl:ObjectProperty ;
                         rdfs:domain cim:Measure ;
                         rdfs:range cim:ACDCTerminal ;
                         rdfs:comment "Measurements associated with this terminal defining  where the measurement is placed in the network topology.  It may be used, for instance, to capture the sensor position, such as a voltage transformer (PT) at a busbar or a current transformer (CT) at the bar between a breaker and an isolator.One or more measurements may be associated with a terminal in the network." .


###  http://www.iec.ch/TC57/CIM#ACDCTerminal.OperationalLimitSet
cim:ACDCTerminal.OperationalLimitSet rdf:type owl:ObjectProperty ;
                                     rdfs:domain cim:OperationalLimitSet ;
                                     rdfs:range cim:ACDCTerminal ;
                                     rdfs:comment "" .



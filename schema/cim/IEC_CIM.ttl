                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:TapChangerDynamicData.minimumAngle ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:float
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:TapChangerDynamicData.solvedAngle ;

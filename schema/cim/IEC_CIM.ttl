                                      owl:onProperty cim:ExcIEEEAC5A.te ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:Seconds
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ExcIEEEAC5A.tf1 ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:Seconds
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ExcIEEEAC5A.tf2 ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:Seconds
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ExcIEEEAC5A.tf3 ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:Seconds
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ExcIEEEAC5A.vrmax ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:PU
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ExcIEEEAC5A.vrmin ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:PU
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ExcIEEEAC5A.seefd1 ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:float
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ExcIEEEAC5A.seefd2 ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:float
                                    ] ;
                rdfs:subClassOf cim:ExcitationSystemDynamics ;
                rdfs:comment """The class represents IEEE Std 421.5-2005 type AC5A model. The model represents a simplified model for brushless excitation systems. The regulator is supplied from a source, such as a permanent magnet generator, which is not affected by system disturbances.  Unlike other ac models, this model uses loaded rather than open circuit exciter saturation data in the same way as it is used for the dc models.  Because the model has been widely implemented by the industry, it is sometimes used to represent other types of systems when either detailed data for them are not available or simplified models are required.


Reference: IEEE Standard 421.5-2005 Section 6.5.""" .



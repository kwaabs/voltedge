                                 owl:onProperty cim:GovCT1.tfload ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:Seconds
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:GovCT1.tpelec ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:Seconds
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:GovCT1.tsa ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:Seconds
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:GovCT1.tsb ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:Seconds
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:GovCT1.vmax ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:PU
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:GovCT1.vmin ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:PU
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:GovCT1.wfnl ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:PU
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:GovCT1.aset ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:float
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:GovCT1.rclose ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:float
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:GovCT1.ropen ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:float
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:GovCT1.wfspd ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:boolean
                               ] ;
           rdfs:subClassOf cim:TurbineGovernorDynamics ;
           rdfs:comment """General model for any prime mover with a PID governor, used primarily for combustion turbine and combined cycle units.
This model can be used to represent a variety of prime movers controlled by PID governors.  It is suitable, for example, for representation of 
<ul>
 <li>gas turbine and single shaft combined cycle turbines </li>
</ul>
<ul>
 <li>diesel engines with modern electronic or digital governors  </li>
</ul>
<ul>
 <li>steam turbines where steam is supplied from a large boiler drum or a large header whose pressure is substantially constant over the period under study </li>
 <li>simple hydro turbines in dam configurations where the water column length is short and water inertia effects are minimal. </li>
</ul>
Additional information on this model is available in the 2012 IEEE report, <i><u>Dynamic Models for Turbine-Governors in Power System Studies</u></i>, section 3.1.2.3 page 3-4 (GGOV1).""" .



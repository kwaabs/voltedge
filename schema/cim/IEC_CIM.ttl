                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EndDeviceCapability.communication ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EndDeviceCapability.connectDisconnect ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EndDeviceCapability.demandResponse ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EndDeviceCapability.electricMetering ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EndDeviceCapability.gasMetering ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EndDeviceCapability.metrology ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EndDeviceCapability.onRequestRead ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EndDeviceCapability.outageHistory ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EndDeviceCapability.pressureCompensation ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EndDeviceCapability.pricingInfo ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EndDeviceCapability.pulseOutput ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EndDeviceCapability.relaysProgramming ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EndDeviceCapability.reverseFlow ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EndDeviceCapability.superCompressibilityCompensation ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EndDeviceCapability.temperatureCompensation ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EndDeviceCapability.textMessage ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EndDeviceCapability.waterMetering ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ;
                        rdfs:comment "Inherent capabilities of an end device (i.e., the functions it supports)." .


###  http://www.iec.ch/TC57/CIM#EndDeviceControl
cim:EndDeviceControl rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EndDeviceControl.priceSignal ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:FloatQuantity
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EndDeviceControl.primaryDeviceTiming ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:EndDeviceTiming
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EndDeviceControl.scheduledInterval ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:DateTimeInterval
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EndDeviceControl.secondaryDeviceTiming ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:EndDeviceTiming
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EndDeviceControl.drProgramLevel ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:nonNegativeInteger
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EndDeviceControl.drProgramMandatory ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:boolean
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EndDeviceControl.issuerID ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EndDeviceControl.issuerTrackingID ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EndDeviceControl.reason ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ;
                     rdfs:subClassOf cim:IdentifiedObject ;
                     rdfs:comment "Instructs an end device (or an end device group) to perform a specified action." .


###  http://www.iec.ch/TC57/CIM#EndDeviceControlType
cim:EndDeviceControlType rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:EndDeviceControlType.domain ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:EndDeviceControlType.eventOrAction ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:EndDeviceControlType.subDomain ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:EndDeviceControlType.type ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:string
                                             ] ;
                         rdfs:subClassOf cim:IdentifiedObject ;
                         rdfs:comment "Detailed description for a control produced by an end device. Values in attributes allow for creation of recommended codes to be used for identifying end device controls as follows: &lt;type&gt;.&lt;domain&gt;.&lt;subDomain&gt;.&lt;eventOrAction&gt;." .


###  http://www.iec.ch/TC57/CIM#EndDeviceEvent
cim:EndDeviceEvent rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:EndDeviceEvent.issuerID ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:EndDeviceEvent.issuerTrackingID ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:EndDeviceEvent.userID ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ;
                   rdfs:subClassOf cim:ActivityRecord ;
                   rdfs:comment "Event detected by a device function associated with the end device." .


###  http://www.iec.ch/TC57/CIM#EndDeviceEventDetail
cim:EndDeviceEventDetail rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:EndDeviceEventDetail.value ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:StringQuantity
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:EndDeviceEventDetail.name ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:string
                                             ] ;
                         rdfs:comment "Name-value pair, specific to end device events." .


###  http://www.iec.ch/TC57/CIM#EndDeviceEventType
cim:EndDeviceEventType rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:EndDeviceEventType.domain ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:EndDeviceEventType.eventOrAction ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:EndDeviceEventType.subDomain ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:EndDeviceEventType.type ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ;
                       rdfs:subClassOf cim:IdentifiedObject ;
                       rdfs:comment "Detailed description for an event produced by an end device. Values in attributes allow for creation of recommended codes to be used for identifying end device events as follows: &lt;type&gt;.&lt;domain&gt;.&lt;subDomain&gt;.&lt;eventOrAction&gt;." .


###  http://www.iec.ch/TC57/CIM#EndDeviceFunction
cim:EndDeviceFunction rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:EndDeviceFunction.enabled ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:boolean
                                          ] ;
                      rdfs:subClassOf cim:AssetFunction ;
                      rdfs:comment "Function performed by an end device such as a meter, communication equipment, controllers, etc." .


###  http://www.iec.ch/TC57/CIM#EndDeviceFunctionKind
cim:EndDeviceFunctionKind rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Class ;
                                                owl:oneOf ( cim:autonomousDst
                                                            cim:demandResponse
                                                            cim:electricMetering
                                                            cim:gasMetering
                                                            cim:metrology
                                                            cim:onRequestRead
                                                            cim:outageHistory
                                                            cim:relaysProgramming
                                                            cim:reverseFlow
                                                            cim:waterMetering
                                                          )
                                              ] .


###  http://www.iec.ch/TC57/CIM#EndDeviceGroup
cim:EndDeviceGroup rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:EndDeviceGroup.type ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ;
                   rdfs:subClassOf cim:IdentifiedObject ;
                   rdfs:comment "Abstraction for management of group communications within a two-way AMR system or the data for a group of related end devices. Commands can be issued to all of the end devices that belong to the group using a defined group address and the underlying AMR communication infrastructure." .


###  http://www.iec.ch/TC57/CIM#EndDeviceInfo
cim:EndDeviceInfo rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:EndDeviceInfo.capability ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:EndDeviceCapability
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:EndDeviceInfo.ratedCurrent ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:CurrentFlow
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:EndDeviceInfo.ratedVoltage ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Voltage
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:EndDeviceInfo.isSolidState ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:boolean
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:EndDeviceInfo.phaseCount ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ;
                  rdfs:subClassOf cim:AssetInfo ;
                  rdfs:comment "End device data." .


###  http://www.iec.ch/TC57/CIM#EndDeviceTiming
cim:EndDeviceTiming rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:EndDeviceTiming.duration ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Minutes
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:EndDeviceTiming.interval ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:DateTimeInterval
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:EndDeviceTiming.randomisation ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:RandomisationKind
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:EndDeviceTiming.durationIndefinite ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:boolean
                                        ] ;
                    rdfs:comment "Timing for the control actions of end devices." .


###  http://www.iec.ch/TC57/CIM#EnergyArea
cim:EnergyArea rdf:type owl:Class ;
               rdfs:subClassOf cim:IdentifiedObject ;
               rdfs:comment "Describes an area having energy production or consumption.  Specializations are intended to support the load allocation function as typically required in energy management systems or planning studies to allocate hypothesized load levels to individual load points for power flow analysis.  Often the energy area can be linked to both measured and forecast load levels." .


###  http://www.iec.ch/TC57/CIM#EnergyConsumer
cim:EnergyConsumer rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:EnergyConsumer.p ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePower
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:EnergyConsumer.pfixed ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePower
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:EnergyConsumer.pfixedPct ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:PerCent
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:EnergyConsumer.phaseConnection ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:PhaseShuntConnectionKind
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:EnergyConsumer.q ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ReactivePower
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:EnergyConsumer.qfixed ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ReactivePower
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:EnergyConsumer.qfixedPct ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:PerCent
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:EnergyConsumer.customerCount ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:nonNegativeInteger
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:EnergyConsumer.grounded ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:boolean
                                       ] ;
                   rdfs:subClassOf cim:ConductingEquipment ;
                   rdfs:comment "Generic user of energy - a  point of consumption on the power system model." .


###  http://www.iec.ch/TC57/CIM#EnergyConsumerData
cim:EnergyConsumerData rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:EnergyConsumerData.loadMVAR ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:float
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:EnergyConsumerData.loadMW ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:float
                                           ] ;
                       rdfs:comment "Optimal Power Flow or State Estimator Load Data for OTS. This is used for RealTime, Study and Maintenance Users" .


###  http://www.iec.ch/TC57/CIM#EnergyConsumerPhase
cim:EnergyConsumerPhase rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EnergyConsumerPhase.pfixed ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:ActivePower
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EnergyConsumerPhase.pfixedPct ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:PerCent
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EnergyConsumerPhase.phase ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:SinglePhaseKind
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EnergyConsumerPhase.qfixed ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:ReactivePower
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EnergyConsumerPhase.qfixedPct ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:PerCent
                                            ] ;
                        rdfs:subClassOf cim:PowerSystemResource ;
                        rdfs:comment "A single phase of an energy consumer." .


###  http://www.iec.ch/TC57/CIM#EnergyMarket
cim:EnergyMarket rdf:type owl:Class ;
                 rdfs:subClassOf cim:Market ;
                 rdfs:comment "Energy and Ancillary Market (e.g. Energy, Spinning Reserve, Non-Spinning Reserve) with a description of the Market operation control parameters." .


###  http://www.iec.ch/TC57/CIM#EnergyPriceCurve
cim:EnergyPriceCurve rdf:type owl:Class ;
                     rdfs:comment "Relationship between a price in $(or other monetary unit) /hour (Y-axis) and a MW value (X-axis)." .


###  http://www.iec.ch/TC57/CIM#EnergyPriceIndex
cim:EnergyPriceIndex rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EnergyPriceIndex.energyPriceIndexType ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:EnergyPriceIndexType
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EnergyPriceIndex.endEffectiveDate ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:dateTime
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EnergyPriceIndex.energyPriceIndex ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:float
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EnergyPriceIndex.lastModified ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:dateTime
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EnergyPriceIndex.startEffectiveDate ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:dateTime
                                         ] ;
                     rdfs:subClassOf cim:IdentifiedObject ;
                     rdfs:comment "An Energy Price Index for each Resource is valid for a period (e.g. daily) that is identified by a Valid Period Start Time and a Valid Period End Time. An Energy Price Index is in $/MWh." .


###  http://www.iec.ch/TC57/CIM#EnergyPriceIndexType
cim:EnergyPriceIndexType rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Class ;
                                               owl:oneOf ( cim:BOTH
                                                           cim:RETAIL
                                                           cim:WHOLESALE
                                                         )
                                             ] .


###  http://www.iec.ch/TC57/CIM#EnergyProduct
cim:EnergyProduct rdf:type owl:Class ;
                  rdfs:subClassOf cim:Agreement ;
                  rdfs:comment "An EnergyProduct is offered commercially as a ContractOrTariff." .


###  http://www.iec.ch/TC57/CIM#EnergyProductType
cim:EnergyProductType rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Class ;
                                            owl:oneOf ( cim:DYN
                                                        cim:FIRM
                                                        cim:NFRM
                                                        cim:WHL
                                                      )
                                          ] .


###  http://www.iec.ch/TC57/CIM#EnergyProfile
cim:EnergyProfile rdf:type owl:Class ;
                  rdfs:subClassOf cim:Profile ;
                  rdfs:comment "Specifies the start time, stop time, level for an EnergyTransaction." .


###  http://www.iec.ch/TC57/CIM#EnergySchedulingType
cim:EnergySchedulingType rdf:type owl:Class ;
                         rdfs:subClassOf cim:IdentifiedObject ;
                         rdfs:comment "Used to define the type of generation for scheduling purposes." .


###  http://www.iec.ch/TC57/CIM#EnergySource
cim:EnergySource rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:EnergySource.activePower ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:ActivePower
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:EnergySource.nominalVoltage ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Voltage
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:EnergySource.r ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Resistance
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:EnergySource.r0 ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Resistance
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:EnergySource.reactivePower ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:ReactivePower
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:EnergySource.rn ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Resistance
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:EnergySource.voltageAngle ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:AngleRadians
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:EnergySource.voltageMagnitude ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Voltage
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:EnergySource.x ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Reactance
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:EnergySource.x0 ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Reactance
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:EnergySource.xn ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Reactance
                                     ] ;
                 rdfs:subClassOf cim:ConductingEquipment ;
                 rdfs:comment "A generic equivalent for an energy supplier on a transmission or distribution voltage level." .


###  http://www.iec.ch/TC57/CIM#EnergySourceAction
cim:EnergySourceAction rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:EnergySourceAction.kind ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:TempEquipActionKind
                                           ] ;
                       rdfs:subClassOf cim:SwitchingStep ;
                       rdfs:comment "Action on energy source as a switching step." .


###  http://www.iec.ch/TC57/CIM#EnergySourcePhase
cim:EnergySourcePhase rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:EnergySourcePhase.phase ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:SinglePhaseKind
                                          ] ;
                      rdfs:subClassOf cim:PowerSystemResource ;
                      rdfs:comment "Represents the single phase information of an unbalanced energy source." .


###  http://www.iec.ch/TC57/CIM#EnergyTransaction
cim:EnergyTransaction rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:EnergyTransaction.congestChargeMax ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Money
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:EnergyTransaction.deliveryPointP ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:ActivePower
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:EnergyTransaction.energyMin ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:ActivePower
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:EnergyTransaction.receiptPointP ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:ActivePower
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:EnergyTransaction.state ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:EnergyTransactionType
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:EnergyTransaction.capacityBacked ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:boolean
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:EnergyTransaction.firmInterchangeFlag ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:boolean
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:EnergyTransaction.payCongestion ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:boolean
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:EnergyTransaction.reason ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ;
                      rdfs:subClassOf cim:Document ;
                      rdfs:comment "Specifies the schedule for energy transfers between interchange areas that are necessary to satisfy the associated interchange transaction." .


###  http://www.iec.ch/TC57/CIM#EnergyTransactionType
cim:EnergyTransactionType rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Class ;
                                                owl:oneOf ( cim:approve
                                                            cim:deny
                                                            cim:study
                                                          )
                                              ] .


###  http://www.iec.ch/TC57/CIM#EnergyTypeCode
cim:EnergyTypeCode rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Class ;
                                         owl:oneOf ( cim:DABE
                                                     cim:DAPE
                                                     cim:DASE
                                                     cim:DMLE
                                                     cim:DSSE
                                                     cim:EDE
                                                     cim:HASE
                                                     cim:MLE
                                                     cim:MSSLFE
                                                     cim:OE
                                                     cim:PE
                                                     cim:RE
                                                     cim:RED
                                                     cim:RMRE
                                                     cim:RTSSE
                                                     cim:SE
                                                     cim:SRE
                                                     cim:TEE
                                                   )
                                       ] .


###  http://www.iec.ch/TC57/CIM#EnvironmentalDependentLimit
cim:EnvironmentalDependentLimit rdf:type owl:Class ;
                                rdfs:subClassOf cim:LimitDependency ;
                                rdfs:comment "This is a environmental based limit dependency model for calculating operational limits." .


###  http://www.iec.ch/TC57/CIM#Equipment
cim:Equipment rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Equipment.aggregate ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:boolean
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Equipment.inService ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:boolean
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Equipment.normallyInService ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:boolean
                                  ] ;
              rdfs:subClassOf cim:PowerSystemResource ;
              rdfs:comment "The parts of a power system that are physical devices, electronic or mechanical." .


###  http://www.iec.ch/TC57/CIM#EquipmentContainer
cim:EquipmentContainer rdf:type owl:Class ;
                       rdfs:subClassOf cim:ConnectivityNodeContainer ;
                       rdfs:comment "A modeling construct to provide a root class for containing equipment." .


###  http://www.iec.ch/TC57/CIM#EquipmentFault
cim:EquipmentFault rdf:type owl:Class ;
                   rdfs:subClassOf cim:Fault ;
                   rdfs:comment "A fault applied at the terminal, external to the equipment. This class is not used to specify faults internal to the equipment." .


###  http://www.iec.ch/TC57/CIM#EquipmentLimitSeriesComponent
cim:EquipmentLimitSeriesComponent rdf:type owl:Class ;
                                  rdfs:subClassOf cim:IdentifiedObject ;
                                  rdfs:comment "This represents one instance of an equipment that contributes to the calculation of an operational limit." .


###  http://www.iec.ch/TC57/CIM#EquipmentStatusType
cim:EquipmentStatusType rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Class ;
                                              owl:oneOf ( cim:In
                                                          cim:Out
                                                        )
                                            ] .


###  http://www.iec.ch/TC57/CIM#EquivalentBranch
cim:EquivalentBranch rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EquivalentBranch.negativeR12 ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Resistance
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EquivalentBranch.negativeR21 ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Resistance
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EquivalentBranch.negativeX12 ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Reactance
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EquivalentBranch.negativeX21 ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Reactance
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EquivalentBranch.positiveR12 ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Resistance
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EquivalentBranch.positiveR21 ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Resistance
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EquivalentBranch.positiveX12 ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Reactance
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EquivalentBranch.positiveX21 ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Reactance
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EquivalentBranch.r ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Resistance
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EquivalentBranch.r21 ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Resistance
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EquivalentBranch.x ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Reactance
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EquivalentBranch.x21 ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Reactance
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EquivalentBranch.zeroR12 ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Resistance
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EquivalentBranch.zeroR21 ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Resistance
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EquivalentBranch.zeroX12 ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Reactance
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:EquivalentBranch.zeroX21 ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Reactance
                                         ] ;
                     rdfs:subClassOf cim:EquivalentEquipment ;
                     rdfs:comment "The class represents equivalent branches." .


###  http://www.iec.ch/TC57/CIM#EquivalentEquipment
cim:EquivalentEquipment rdf:type owl:Class ;
                        rdfs:subClassOf cim:ConductingEquipment ;
                        rdfs:comment "The class represents equivalent objects that are the result of a network reduction. The class is the base for equivalent objects of different types." .


###  http://www.iec.ch/TC57/CIM#EquivalentInjection
cim:EquivalentInjection rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EquivalentInjection.maxP ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:ActivePower
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EquivalentInjection.maxQ ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:ReactivePower
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EquivalentInjection.minP ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:ActivePower
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EquivalentInjection.minQ ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:ReactivePower
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EquivalentInjection.p ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:ActivePower
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EquivalentInjection.q ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:ReactivePower
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EquivalentInjection.r ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Resistance
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EquivalentInjection.r0 ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Resistance
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EquivalentInjection.r2 ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Resistance
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EquivalentInjection.regulationTarget ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Voltage
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EquivalentInjection.x ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Reactance
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EquivalentInjection.x0 ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Reactance
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EquivalentInjection.x2 ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Reactance
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EquivalentInjection.regulationCapability ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:EquivalentInjection.regulationStatus ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ;
                        rdfs:subClassOf cim:EquivalentEquipment ;
                        rdfs:comment "This class represents equivalent injections (generation or load).  Voltage regulation is allowed only at the point of connection." .


###  http://www.iec.ch/TC57/CIM#EquivalentNetwork
cim:EquivalentNetwork rdf:type owl:Class ;
                      rdfs:subClassOf cim:ConnectivityNodeContainer ;
                      rdfs:comment "A class that represents an external meshed network that has been reduced to an electrically equivalent model. The ConnectivityNodes contained in the equivalent are intended to reflect internal nodes of the equivalent. The boundary Connectivity nodes where the equivalent connects outside itself are NOT contained by the equivalent." .


###  http://www.iec.ch/TC57/CIM#EquivalentShunt
cim:EquivalentShunt rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:EquivalentShunt.b ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Susceptance
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:EquivalentShunt.g ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Conductance
                                        ] ;
                    rdfs:subClassOf cim:EquivalentEquipment ;
                    rdfs:comment "The class represents equivalent shunts." .


###  http://www.iec.ch/TC57/CIM#ErpAccountKind
cim:ErpAccountKind rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Class ;
                                         owl:oneOf ( cim:estimate
                                                     cim:normal
                                                     cim:reversal
                                                     cim:statistical
                                                   )
                                       ] .


###  http://www.iec.ch/TC57/CIM#ErpBOM
cim:ErpBOM rdf:type owl:Class ;
           rdfs:subClassOf cim:ErpDocument ;
           rdfs:comment """Information that generally describes the Bill of Material Structure and its contents for a utility.

This is used by ERP systems to transfer Bill of Material information between two business applications.""" .


###  http://www.iec.ch/TC57/CIM#ErpBankAccount
cim:ErpBankAccount rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ErpBankAccount.bankABA ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ;
                   rdfs:subClassOf cim:BankAccount ;
                   rdfs:comment """Relationship under a particular name, usually evidenced by a deposit against which withdrawals can be made. Types of bank accounts include: demand, time, custodial, joint, trustee, corporate, special, and regular accounts.
A statement of transactions during a fiscal period and the resulting balance is maintained on each account.
For Payment metering, the account is associated with Bank and Supplier, reflecting details of the bank account used for depositing revenue collected by TokenVendor. The name of the account holder should be specified in 'name' attribute.""" .


###  http://www.iec.ch/TC57/CIM#ErpBomItemData
cim:ErpBomItemData rdf:type owl:Class ;
                   rdfs:subClassOf cim:ErpIdentifiedObject ;
                   rdfs:comment "An individual item on a bill of materials." .


###  http://www.iec.ch/TC57/CIM#ErpChartOfAccounts
cim:ErpChartOfAccounts rdf:type owl:Class ;
                       rdfs:subClassOf cim:ErpDocument ;
                       rdfs:comment "Accounting structure of a business. Each account represents a financial aspect of a business, such as its Accounts Payable, or the value of its inventory, or its office supply expenses." .


###  http://www.iec.ch/TC57/CIM#ErpCompetency
cim:ErpCompetency rdf:type owl:Class ;
                  rdfs:subClassOf cim:ErpIdentifiedObject ;
                  rdfs:comment "Information that describes aptitudes of a utility employee. Unlike Skills that an ErpPerson must be certified to perform before undertaking certain type of assignments (to be able to perfrom a Craft), ErpCompetency has more to do with typical Human Resource (HR) matters such as schooling, training, etc." .


###  http://www.iec.ch/TC57/CIM#ErpDocument
cim:ErpDocument rdf:type owl:Class ;
                rdfs:subClassOf cim:Document ;
                rdfs:comment "Shadow class for Document, to isolate subclassing from this package. If any subclass gets normative and needs inheritance, it will inherit directly from Document." .


###  http://www.iec.ch/TC57/CIM#ErpEngChangeOrder
cim:ErpEngChangeOrder rdf:type owl:Class ;
                      rdfs:subClassOf cim:ErpDocument ;
                      rdfs:comment "General Utility Engineering Change Order information." .


###  http://www.iec.ch/TC57/CIM#ErpIdentifiedObject
cim:ErpIdentifiedObject rdf:type owl:Class ;
                        rdfs:subClassOf cim:IdentifiedObject ;
                        rdfs:comment "Shadow class for IdentifiedObject, to isolate subclassing from this package. If any subclass gets normative and needs inheritance, it will inherit directly from IdentifiedObject." .


###  http://www.iec.ch/TC57/CIM#ErpInventory
cim:ErpInventory rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:ErpInventory.status ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Status
                                     ] ;
                 rdfs:subClassOf cim:ErpIdentifiedObject ;
                 rdfs:comment "Utility inventory-related information about an item or part (and not for description of the item and its attributes). It is used by ERP applications to enable the synchronization of Inventory data that exists on separate Item Master databases. This data is not the master data that describes the attributes of the item such as dimensions, weight, or unit of measure - it describes the item as it exists at a specific location." .


###  http://www.iec.ch/TC57/CIM#ErpInventoryCount
cim:ErpInventoryCount rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ErpInventoryCount.status ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Status
                                          ] ;
                      rdfs:subClassOf cim:ErpIdentifiedObject ;
                      rdfs:comment """This is related to Inventory physical counts organized by AssetModel. Note that a count of a type of asset can be accomplished by the association inherited by AssetModel (from Document) to Asset.
It enables ERP applications to transfer an inventory count between ERP and the actual physical inventory location. This count may be a cycle count or a physical count.""" .


###  http://www.iec.ch/TC57/CIM#ErpInvoice
cim:ErpInvoice rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:ErpInvoice.amount ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:Money
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:ErpInvoice.billMediaKind ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:BillMediaKind
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:ErpInvoice.kind ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:ErpInvoiceKind
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:ErpInvoice.dueDate ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:date
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:ErpInvoice.mailedDate ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:date
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:ErpInvoice.proForma ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:boolean
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:ErpInvoice.referenceNumber ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:ErpInvoice.transactionDateTime ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:dateTime
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:ErpInvoice.transferType ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ;
               rdfs:subClassOf cim:ErpDocument ;
               rdfs:comment "A roll up of invoice line items. The whole invoice has a due date and amount to be paid, with information such as customer, banks etc. being obtained through associations. The invoice roll up is based on individual line items that each contain amounts and descriptions for specific services or products." .


###  http://www.iec.ch/TC57/CIM#ErpInvoiceKind
cim:ErpInvoiceKind rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Class ;
                                         owl:oneOf ( cim:purchase
                                                     cim:sale
                                                   )
                                       ] .


###  http://www.iec.ch/TC57/CIM#ErpInvoiceLineItem
cim:ErpInvoiceLineItem rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ErpInvoiceLineItem.billPeriod ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:DateTimeInterval
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ErpInvoiceLineItem.kind ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:ErpInvoiceLineItemKind
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ErpInvoiceLineItem.glAccount ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ErpInvoiceLineItem.glDateTime ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:dateTime
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ErpInvoiceLineItem.lineAmount ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:float
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ErpInvoiceLineItem.lineNumber ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ErpInvoiceLineItem.lineVersion ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ErpInvoiceLineItem.netAmount ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:float
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ErpInvoiceLineItem.previousAmount ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:float
                                           ] ;
                       rdfs:subClassOf cim:ErpDocument ;
                       rdfs:comment "An individual line item on an invoice." .


###  http://www.iec.ch/TC57/CIM#ErpInvoiceLineItemKind
cim:ErpInvoiceLineItemKind rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Class ;
                                                 owl:oneOf ( cim:initial
                                                             cim:other
                                                             cim:recalculation
                                                           )
                                               ] .


###  http://www.iec.ch/TC57/CIM#ErpIssueInventory
cim:ErpIssueInventory rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ErpIssueInventory.status ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Status
                                          ] ;
                      rdfs:subClassOf cim:ErpIdentifiedObject ;
                      rdfs:comment "Can be used to request an application to process an issue or request information about an issue." .


###  http://www.iec.ch/TC57/CIM#ErpItemMaster
cim:ErpItemMaster rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ErpItemMaster.status ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Status
                                      ] ;
                  rdfs:subClassOf cim:ErpIdentifiedObject ;
                  rdfs:comment """Any unique purchased part for manufactured product tracked by ERP systems for a utility.
Item, as used by the OAG, refers to the basic information about an item, including its attributes, cost, and locations. It does not include item quantities. Compare to the Inventory, which includes all quantities and other location-specific information.""" .


###  http://www.iec.ch/TC57/CIM#ErpJournal
cim:ErpJournal rdf:type owl:Class ;
               rdfs:subClassOf cim:ErpDocument ;
               rdfs:comment """Book for recording accounting transactions as they occur. Transactions and adjustments are first recorded in a journal, which is like a diary of instructions, advising which account to be charged and by how much.
A journal represents a change in the balances of a business's financial accounts. Many tasks or transactions throughout an enterprise will result in the creation of a journal. Some examples are creating a customer invoice, paying a vendor, transferring inventory, or paying employees.""" .


###  http://www.iec.ch/TC57/CIM#ErpJournalEntry
cim:ErpJournalEntry rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ErpJournalEntry.amount ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Money
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ErpJournalEntry.status ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Status
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ErpJournalEntry.accountID ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ErpJournalEntry.postingDateTime ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ErpJournalEntry.sourceID ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ErpJournalEntry.transactionDateTime ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ;
                    rdfs:subClassOf cim:ErpIdentifiedObject ;
                    rdfs:comment "Details of an individual entry in a journal, which is to be posted to a ledger on the posting date." .


###  http://www.iec.ch/TC57/CIM#ErpLedBudLineItem
cim:ErpLedBudLineItem rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ErpLedBudLineItem.status ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Status
                                          ] ;
                      rdfs:subClassOf cim:ErpIdentifiedObject ;
                      rdfs:comment "Individual entry of a given Ledger Budget, typically containing information such as amount, accounting date, accounting period, and is associated with the applicable general ledger account." .


###  http://www.iec.ch/TC57/CIM#ErpLedger
cim:ErpLedger rdf:type owl:Class ;
              rdfs:subClassOf cim:ErpDocument ;
              rdfs:comment "In accounting transactions, a ledger is a book containing accounts to which debits and credits are posted from journals, where transactions are initially recorded. Journal entries are periodically posted to the ledger. Ledger Actual represents actual amounts by account within ledger within company or business area. Actual amounts may be generated in a source application and then loaded to a specific ledger within the enterprise general ledger or budget application." .


###  http://www.iec.ch/TC57/CIM#ErpLedgerBudget
cim:ErpLedgerBudget rdf:type owl:Class ;
                    rdfs:subClassOf cim:ErpDocument ;
                    rdfs:comment "Information for utility Ledger Budgets. They support the transfer budget amounts between all possible source applications throughout an enterprise and a general ledger or budget application." .


###  http://www.iec.ch/TC57/CIM#ErpLedgerEntry
cim:ErpLedgerEntry rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ErpLedgerEntry.accountKind ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ErpAccountKind
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ErpLedgerEntry.amount ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Money
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ErpLedgerEntry.status ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Status
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ErpLedgerEntry.accountID ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ErpLedgerEntry.postedDateTime ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:dateTime
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ErpLedgerEntry.transactionDateTime ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:dateTime
                                       ] ;
                   rdfs:subClassOf cim:ErpIdentifiedObject ;
                   rdfs:comment "Details of an individual entry in a ledger, which was posted from a journal on the posted date." .


###  http://www.iec.ch/TC57/CIM#ErpPOLineItem
cim:ErpPOLineItem rdf:type owl:Class ;
                  rdfs:subClassOf cim:ErpDocument ;
                  rdfs:comment "Of an ErpPurchaseOrder, this is an individually ordered item or product along with the quantity, price and other descriptive information." .


###  http://www.iec.ch/TC57/CIM#ErpPayable
cim:ErpPayable rdf:type owl:Class ;
               rdfs:subClassOf cim:ErpDocument ;
               rdfs:comment "A transaction that represents an invoice from a supplier. A payable (or voucher) is an open item, approved and ready for payment, in the Accounts Payable ledger." .


###  http://www.iec.ch/TC57/CIM#ErpPayableLineItem
cim:ErpPayableLineItem rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ErpPayableLineItem.status ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Status
                                           ] ;
                       rdfs:subClassOf cim:ErpIdentifiedObject ;
                       rdfs:comment "Of an ErpPayable, a line item references an ErpInvoiceLineitem or other source such as credit memos." .


###  http://www.iec.ch/TC57/CIM#ErpPayment
cim:ErpPayment rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:ErpPayment.termsPayment ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ;
               rdfs:subClassOf cim:ErpDocument ;
               rdfs:comment "Payment infromation and status for any individual line item of an ErpInvoice (e.g., when payment is from a customer). ErpPayable is also updated when payment is to a supplier and ErpReceivable is updated when payment is from a customer. Multiple payments can be made against a single line item and an individual payment can apply to more that one line item." .


###  http://www.iec.ch/TC57/CIM#ErpPersonnel
cim:ErpPersonnel rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:ErpPersonnel.status ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Status
                                     ] ;
                 rdfs:subClassOf cim:ErpIdentifiedObject ;
                 rdfs:comment "Information that applies to the basic data about a utility person, used by ERP applications to transfer Personnel data for a worker." .


###  http://www.iec.ch/TC57/CIM#ErpProjectAccounting
cim:ErpProjectAccounting rdf:type owl:Class ;
                         rdfs:subClassOf cim:ErpDocument ;
                         rdfs:comment "Utility Project Accounting information, used by ERP applications to enable all relevant sub-systems that submit single sided transactions to transfer information with a Project Accounting Application. This would include, but not necessarily be limited to: Accounts Payable, Accounts Receivable, Budget, Order Management, Purchasing, Time and Labor, Travel and Expense." .


###  http://www.iec.ch/TC57/CIM#ErpPurchaseOrder
cim:ErpPurchaseOrder rdf:type owl:Class ;
                     rdfs:subClassOf cim:ErpDocument ;
                     rdfs:comment "A document that communicates an order to purchase goods from a buyer to a supplier. The PurchaseOrder carries information to and from the buyer and supplier. It is a legally binding document once both Parties agree to the contents and the specified terms and conditions of the order." .


###  http://www.iec.ch/TC57/CIM#ErpQuote
cim:ErpQuote rdf:type owl:Class ;
             rdfs:subClassOf cim:ErpDocument ;
             rdfs:comment "Document describing the prices of goods or services provided by a supplier. It includes the terms of the purchase, delivery proposals, identification of goods or services ordered, as well as their quantities." .


###  http://www.iec.ch/TC57/CIM#ErpQuoteLineItem
cim:ErpQuoteLineItem rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ErpQuoteLineItem.status ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Status
                                         ] ;
                     rdfs:subClassOf cim:ErpIdentifiedObject ;
                     rdfs:comment "Of an ErpQuote, the item or product quoted along with quantity, price and other descriptive information." .


###  http://www.iec.ch/TC57/CIM#ErpRecDelvLineItem
cim:ErpRecDelvLineItem rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ErpRecDelvLineItem.status ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Status
                                           ] ;
                       rdfs:subClassOf cim:ErpIdentifiedObject ;
                       rdfs:comment "Of an ErpReceiveDelivery, this is an individually received good or service by the Organisation receiving goods or services. It may be used to indicate receipt of goods in conjunction with a purchase order line item." .


###  http://www.iec.ch/TC57/CIM#ErpRecLineItem
cim:ErpRecLineItem rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ErpRecLineItem.status ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Status
                                       ] ;
                   rdfs:subClassOf cim:ErpIdentifiedObject ;
                   rdfs:comment "Individual entry of an ErpReceivable, it is a particular transaction representing an invoice, credit memo or debit memo to a customer." .


###  http://www.iec.ch/TC57/CIM#ErpReceivable
cim:ErpReceivable rdf:type owl:Class ;
                  rdfs:subClassOf cim:ErpDocument ;
                  rdfs:comment "Transaction representing an invoice, credit memo or debit memo to a customer. It is an open (unpaid) item in the Accounts Receivable ledger." .


###  http://www.iec.ch/TC57/CIM#ErpReceiveDelivery
cim:ErpReceiveDelivery rdf:type owl:Class ;
                       rdfs:subClassOf cim:ErpDocument ;
                       rdfs:comment "Transaction for an Organisation receiving goods or services that may be used to indicate receipt of goods in conjunction with a purchase order. A receivable is an open (unpaid) item in the Accounts Receivable ledger." .


###  http://www.iec.ch/TC57/CIM#ErpReqLineItem
cim:ErpReqLineItem rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ErpReqLineItem.cost ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Money
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ErpReqLineItem.status ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Status
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ErpReqLineItem.code ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ErpReqLineItem.deliveryDate ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:date
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ErpReqLineItem.quantity ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:nonNegativeInteger
                                       ] ;
                   rdfs:subClassOf cim:ErpIdentifiedObject ;
                   rdfs:comment "Information that describes a requested item and its attributes." .


###  http://www.iec.ch/TC57/CIM#ErpRequisition
cim:ErpRequisition rdf:type owl:Class ;
                   rdfs:subClassOf cim:ErpDocument ;
                   rdfs:comment "General information that applies to a utility requisition that is a request for the purchase of goods or services. Typically, a requisition leads to the creation of a purchase order to a specific supplier." .


###  http://www.iec.ch/TC57/CIM#ErpSalesOrder
cim:ErpSalesOrder rdf:type owl:Class ;
                  rdfs:subClassOf cim:ErpDocument ;
                  rdfs:comment """General purpose Sales Order is used for utility service orders, etc.
As used by the OAG, the SalesOrder is a step beyond a PurchaseOrder in that the receiving entity of the order also communicates SalesInformoration about the Order along with the Order itself.""" .


###  http://www.iec.ch/TC57/CIM#ErpSiteLevelData
cim:ErpSiteLevelData rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ErpSiteLevelData.status ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Status
                                         ] ;
                     rdfs:subClassOf cim:ErpIdentifiedObject ;
                     rdfs:comment "For a utility, general information that describes physical locations of organizations or the location codes and their meanings. This enables ERP applications to ensure that the physical location identifiers are synchronized between the business applications." .


###  http://www.iec.ch/TC57/CIM#ErpTimeEntry
cim:ErpTimeEntry rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:ErpTimeEntry.status ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Status
                                     ] ;
                 rdfs:subClassOf cim:ErpIdentifiedObject ;
                 rdfs:comment "An individual entry on an ErpTimeSheet." .


###  http://www.iec.ch/TC57/CIM#ErpTimeSheet
cim:ErpTimeSheet rdf:type owl:Class ;
                 rdfs:subClassOf cim:ErpDocument ;
                 rdfs:comment "Time sheet for employees and contractors. Note that ErpTimeSheet inherits the relationship to ErpPerson from Document." .


###  http://www.iec.ch/TC57/CIM#ExPostLoss
cim:ExPostLoss rdf:type owl:Class ;
               rdfs:subClassOf cim:MarketFactors ;
               rdfs:comment "Model of ex-post calcultion of MW losses." .


###  http://www.iec.ch/TC57/CIM#ExPostLossResults
cim:ExPostLossResults rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ExPostLossResults.ehvLossMW ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:float
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ExPostLossResults.totalLossMW ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:float
                                          ] ;
                      rdfs:comment "Model results of ex-post calculation of MW losses. Summarizes loss in two categories losses on the the extra high voltage transmission and total losses. Calculated for each subcontrol area." .


###  http://www.iec.ch/TC57/CIM#ExPostMarketRegion
cim:ExPostMarketRegion rdf:type owl:Class ;
                       rdfs:subClassOf cim:MarketFactors ;
                       rdfs:comment "Model of ex-post calculation of cleared MW on a regional basis" .


###  http://www.iec.ch/TC57/CIM#ExPostMarketRegionResults
cim:ExPostMarketRegionResults rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Restriction ;
                                                    owl:onProperty cim:ExPostMarketRegionResults.exPostClearedPrice ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onDataRange xsd:float
                                                  ] ;
                              rdfs:comment "Model of expost calculation of cleared MW on a region basis.  Includes cleared price" .


###  http://www.iec.ch/TC57/CIM#ExPostPricing
cim:ExPostPricing rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ExPostPricing.energyPrice ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ;
                  rdfs:subClassOf cim:MarketFactors ;
                  rdfs:comment "Model of ex-post pricing of nodes" .


###  http://www.iec.ch/TC57/CIM#ExPostPricingResults
cim:ExPostPricingResults rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:ExPostPricingResults.congestLMP ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:ExPostPricingResults.lmp ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:ExPostPricingResults.lossLMP ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ;
                         rdfs:comment "Model of ex-post pricing of nodes.  Includes LMP information, pnode based." .


###  http://www.iec.ch/TC57/CIM#ExPostResource
cim:ExPostResource rdf:type owl:Class ;
                   rdfs:subClassOf cim:MarketFactors ;
                   rdfs:comment "Model of ex-post pricing of resources." .


###  http://www.iec.ch/TC57/CIM#ExPostResourceResults
cim:ExPostResourceResults rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ExPostResourceResults.status ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:EquipmentStatusType
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ExPostResourceResults.congestionLMP ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:float
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ExPostResourceResults.desiredMW ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:float
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ExPostResourceResults.dispatchRate ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:float
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ExPostResourceResults.lmp ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:float
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ExPostResourceResults.lossLMP ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:float
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ExPostResourceResults.maxEconomicMW ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:float
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ExPostResourceResults.minEconomicMW ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:float
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ExPostResourceResults.resourceMW ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:float
                                              ] ;
                          rdfs:comment "Model of ex-post pricing of resources contains components of LMPs: energy, congestion, loss. Resource based." .



                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Structure.materialKind ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:StructureMaterialKind
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Structure.ratedVoltage ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:Voltage
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Structure.fumigantAppliedDate ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:date
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Structure.fumigantName ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;

###  http://www.iec.ch/TC57/CIM#RatioTapChanger
cim:RatioTapChanger rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:RatioTapChanger.stepVoltageIncrement ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:PerCent
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:RatioTapChanger.tculControlMode ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:TransformerControlMode
                                        ] ;
                    rdfs:subClassOf cim:TapChanger ;
                    rdfs:comment "A tap changer that changes the voltage ratio impacting the voltage magnitude but not the phase angle across the transformer." .


###  http://www.iec.ch/TC57/CIM#RatioTapChangerTable
cim:RatioTapChangerTable rdf:type owl:Class ;
                         rdfs:subClassOf cim:IdentifiedObject ;
                         rdfs:comment "Describes a curve for how the voltage magnitude and impedance varies with the tap step." .


###  http://www.iec.ch/TC57/CIM#RatioTapChangerTablePoint
cim:RatioTapChangerTablePoint rdf:type owl:Class ;
                              rdfs:subClassOf cim:TapChangerTablePoint ;
                              rdfs:comment "Describes each tap step in the ratio tap changer tabular curve." .


###  http://www.iec.ch/TC57/CIM#RationalNumber
cim:RationalNumber rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:RationalNumber.denominator ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:nonNegativeInteger
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:RationalNumber.numerator ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:nonNegativeInteger
                                       ] ;
                   rdfs:comment "Rational number = 'numerator' / 'denominator'." .


###  http://www.iec.ch/TC57/CIM#Reactance
cim:Reactance rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Reactance.multiplier ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:UnitMultiplier
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Reactance.unit ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:UnitSymbol
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Reactance.value ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:float
                                  ] ;
              rdfs:comment "Reactance (imaginary part of impedance), at rated frequency." .


###  http://www.iec.ch/TC57/CIM#ReactancePerLength
cim:ReactancePerLength rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ReactancePerLength.multiplier ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:UnitMultiplier
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ReactancePerLength.unit ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:UnitSymbol
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ReactancePerLength.value ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:float
                                           ] ;
                       rdfs:comment "Reactance (imaginary part of impedance) per unit of length, at rated frequency." .


###  http://www.iec.ch/TC57/CIM#ReactiveCapabilityCurve
cim:ReactiveCapabilityCurve rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ReactiveCapabilityCurve.coolantTemperature ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass cim:Temperature
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ReactiveCapabilityCurve.hydrogenPressure ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass cim:Pressure
                                                ] ;
                            rdfs:subClassOf cim:Curve ;
                            rdfs:comment "Reactive power rating envelope versus the synchronous machine's active power, in both the generating and motoring modes. For each active power value there is a corresponding high and low reactive power limit  value. Typically there will be a separate curve for each coolant condition, such as hydrogen pressure.  The Y1 axis values represent reactive minimum and the Y2 axis values represent reactive maximum." .


###  http://www.iec.ch/TC57/CIM#ReactivePower
cim:ReactivePower rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ReactivePower.multiplier ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:UnitMultiplier
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ReactivePower.unit ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:UnitSymbol
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ReactivePower.value ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ;
                  rdfs:comment "Product of RMS value of the voltage and the RMS value of the quadrature component of the current." .


###  http://www.iec.ch/TC57/CIM#Reading
cim:Reading rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Reading.reason ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:ReadingReasonKind
                                ] ;
            rdfs:subClassOf cim:BaseReading ;
            rdfs:comment "Specific value measured by a meter or other asset, or calculated by a system. Each Reading is associated with a specific ReadingType." .


###  http://www.iec.ch/TC57/CIM#ReadingInterharmonic
cim:ReadingInterharmonic rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:ReadingInterharmonic.denominator ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:nonNegativeInteger
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:ReadingInterharmonic.numerator ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:nonNegativeInteger
                                             ] ;
                         rdfs:comment "Interharmonics are represented as a rational number 'numerator' / 'denominator', and harmonics are represented using the same mechanism and identified by 'denominator'=1." .


###  http://www.iec.ch/TC57/CIM#ReadingQuality
cim:ReadingQuality rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ReadingQuality.comment ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ReadingQuality.source ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ReadingQuality.timeStamp ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:dateTime
                                       ] ;
                   rdfs:comment "Quality of a specific reading value or interval reading value. Note that more than one quality may be applicable to a given reading. Typically not used unless problems or unusual conditions occur (i.e., quality for each reading is assumed to be good unless stated otherwise in associated reading quality type). It can also be used with the corresponding reading quality type to indicate that the validation has been performed and succeeded." .


###  http://www.iec.ch/TC57/CIM#ReadingQualityType
cim:ReadingQualityType rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ReadingQualityType.category ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ReadingQualityType.subCategory ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ReadingQualityType.systemId ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ;
                       rdfs:subClassOf cim:IdentifiedObject ;
                       rdfs:comment "Detailed description for a quality of a reading value, produced by an end device or a system. Values in attributes allow for creation of the recommended codes to be used for identifying reading value quality codes as follows: &lt;systemId&gt;.&lt;category&gt;.&lt;subCategory&gt;." .


###  http://www.iec.ch/TC57/CIM#ReadingReasonKind
cim:ReadingReasonKind rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Class ;
                                            owl:oneOf ( cim:billing
                                                        cim:demandReset
                                                        cim:inquiry
                                                        cim:installation
                                                        cim:loadManagement
                                                        cim:loadResearch
                                                        cim:moveIn
                                                        cim:moveOut
                                                        cim:other
                                                        cim:removal
                                                        cim:serviceConnect
                                                        cim:serviceDisconnect
                                                      )
                                          ] .


###  http://www.iec.ch/TC57/CIM#ReadingType
cim:ReadingType rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ReadingType.accumulation ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:AccumulationKind
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ReadingType.aggregate ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:AggregateKind
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ReadingType.argument ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:RationalNumber
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ReadingType.commodity ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:CommodityKind
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ReadingType.currency ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:Currency
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ReadingType.flowDirection ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:FlowDirectionKind
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ReadingType.interharmonic ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:ReadingInterharmonic
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ReadingType.macroPeriod ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:MacroPeriodKind
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ReadingType.measurementKind ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:MeasurementKind
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ReadingType.measuringPeriod ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:MeasuringPeriodKind
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ReadingType.multiplier ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:UnitMultiplier
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ReadingType.phases ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:PhaseCode
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ReadingType.unit ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:UnitSymbol
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ReadingType.consumptionTier ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ReadingType.cpp ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ReadingType.tou ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:nonNegativeInteger
                                    ] ;
                rdfs:subClassOf cim:IdentifiedObject ;
                rdfs:comment "Detailed description for a type of a reading value. Values in attributes allow for the creation of recommended codes to be used for identifying reading value types as follows: &lt;macroPeriod&gt;.&lt;aggregate&gt;.&lt;measuringPeriod&gt;.&lt;accumulation&gt;.&lt;flowDirection&gt;.&lt;commodity&gt;.&lt;measurementKind&gt;.&lt;interharmonic.numerator&gt;.&lt;interharmonic.denominator&gt;.&lt;argument.numerator&gt;.&lt;argument.denominator&gt;.&lt;tou&gt;.&lt;cpp&gt;.&lt;consumptionTier&gt;.&lt;phases&gt;.&lt;multiplier&gt;.&lt;unit&gt;.&lt;currency&gt;." .


###  http://www.iec.ch/TC57/CIM#RealEnergy
cim:RealEnergy rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:RealEnergy.multiplier ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:UnitMultiplier
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:RealEnergy.unit ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:UnitSymbol
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:RealEnergy.value ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ;
               rdfs:comment "Real electrical energy." .


###  http://www.iec.ch/TC57/CIM#Reason
cim:Reason rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Reason.code ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Reason.text ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ;
           rdfs:comment "The motivation of an act." .


###  http://www.iec.ch/TC57/CIM#Receipt
cim:Receipt rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Receipt.line ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:LineDetail
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Receipt.isBankable ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:boolean
                                ] ;
            rdfs:subClassOf cim:IdentifiedObject ;
            rdfs:comment "Record of total receipted payment from customer." .


###  http://www.iec.ch/TC57/CIM#RecloseSequence
cim:RecloseSequence rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:RecloseSequence.recloseDelay ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Seconds
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:RecloseSequence.recloseStep ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:nonNegativeInteger
                                        ] ;
                    rdfs:subClassOf cim:IdentifiedObject ;
                    rdfs:comment "A reclose sequence (open and close) is defined for each possible reclosure of a breaker." .


###  http://www.iec.ch/TC57/CIM#Recloser
cim:Recloser rdf:type owl:Class ;
             rdfs:subClassOf cim:ProtectedSwitch ;
             rdfs:comment "Pole-mounted fault interrupter with built-in phase and ground relays, current transformer (CT), and supplemental controls." .


###  http://www.iec.ch/TC57/CIM#RecloserInfo
cim:RecloserInfo rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:RecloserInfo.groundTripRating ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:CurrentFlow
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:RecloserInfo.phaseTripRating ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:CurrentFlow
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:RecloserInfo.groundTripCapable ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:boolean
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:RecloserInfo.groundTripNormalEnabled ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:boolean
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:RecloserInfo.recloseLockoutCount ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:nonNegativeInteger
                                     ] ;
                 rdfs:subClassOf cim:OldSwitchInfo ;
                 rdfs:comment "Properties of recloser assets." .


###  http://www.iec.ch/TC57/CIM#Reconditioning
cim:Reconditioning rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:Reconditioning.dateTime ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:dateTime
                                       ] ;
                   rdfs:subClassOf cim:IdentifiedObject ;
                   rdfs:comment "Reconditioning information for an asset." .


###  http://www.iec.ch/TC57/CIM#RedLine
cim:RedLine rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:RedLine.status ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:Status
                                ] ;
            rdfs:subClassOf cim:IdentifiedObject ;
            rdfs:comment "This class is used for handling the accompanying annotations, time stamp, author, etc. of designs, drawings and maps. A red line can be associated with any Location object." .


###  http://www.iec.ch/TC57/CIM#Register
cim:Register rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Register.touTier ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:TimeInterval
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Register.isVirtual ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:boolean
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Register.leftDigitCount ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:nonNegativeInteger
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Register.rightDigitCount ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:nonNegativeInteger
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Register.touTierName ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ;
             rdfs:subClassOf cim:IdentifiedObject ;
             rdfs:comment "A device that indicates or records units of the commodity or other quantity measured." .


###  http://www.iec.ch/TC57/CIM#RegisteredGenerator
cim:RegisteredGenerator rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:RegisteredGenerator.RMNRFlag ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:YesNo
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:RegisteredGenerator.RMRFlag ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:FlagTypeRMR
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:RegisteredGenerator.RMRManualIndicator ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:YesNo
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:RegisteredGenerator.RMTFlag ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:YesNo
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:RegisteredGenerator.capacityFactor ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:PerCent
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:RegisteredGenerator.constrainedOutputFlag ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:YesNo
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:RegisteredGenerator.costBasis ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:CostBasis
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:RegisteredGenerator.extremeLongStart ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:YesNo
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:RegisteredGenerator.fuelSource ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:FuelSource
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:RegisteredGenerator.highControlLimit ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:ActivePower
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:RegisteredGenerator.intendedPIRP ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:YesNo
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:RegisteredGenerator.loadFollowingDownMSS ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:YesNo
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:RegisteredGenerator.loadFollowingUpMSS ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:YesNo
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:RegisteredGenerator.lowControlLImit ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:ActivePower
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:RegisteredGenerator.lowerControlRate ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:ActivePowerChangeRate
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:RegisteredGenerator.lowerRampRate ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:ActivePowerChangeRate
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:RegisteredGenerator.maxDependableCap ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:ActivePower

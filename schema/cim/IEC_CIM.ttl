                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ISOUpperLayer.osiPsel ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ISOUpperLayer.osiSsel ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ISOUpperLayer.osiTsel ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ;
                  rdfs:subClassOf cim:TCPAcessPoint .


###  http://www.iec.ch/TC57/CIM#IdentifiedObject
cim:IdentifiedObject rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:IdentifiedObject.aliasName ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:IdentifiedObject.description ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:IdentifiedObject.mRID ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:IdentifiedObject.name ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ;
                     rdfs:comment "This is a root class to provide common identification for all classes needing identification and naming attributes." .


###  http://www.iec.ch/TC57/CIM#IfdBaseKind
cim:IfdBaseKind rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Class ;
                                      owl:oneOf ( cim:ifag
                                                  cim:iffl
                                                  cim:ifnl
                                                  cim:other
                                                )
                                    ] .


###  http://www.iec.ch/TC57/CIM#Impedance
cim:Impedance rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Impedance.multiplier ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:UnitMultiplier
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Impedance.unit ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:UnitSymbol
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Impedance.value ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:float
                                  ] ;
              rdfs:comment "Ratio of voltage to current." .


###  http://www.iec.ch/TC57/CIM#InadvertentAccount
cim:InadvertentAccount rdf:type owl:Class ;
                       rdfs:comment "An account for tracking inadvertent interchange versus time for each control area. A control area may have more than one inadvertent account in order to track inadvertent over one or more specific tie points in addition to the usual overall net inadvertent. Separate accounts would also be used to track designated time periods, such as on-peak and off-peak." .


###  http://www.iec.ch/TC57/CIM#Incident
cim:Incident rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Incident.cause ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ;
             rdfs:subClassOf cim:Document ;
             rdfs:comment "Description of a problem in the field that may be reported in a trouble ticket or come from another source. It may have to do with an outage." .


###  http://www.iec.ch/TC57/CIM#IncidentHazard
cim:IncidentHazard rdf:type owl:Class ;
                   rdfs:subClassOf cim:Hazard ;
                   rdfs:comment "Hazardous situation associated with an incident. Examples are line down, gas leak, fire, etc." .


###  http://www.iec.ch/TC57/CIM#IncrementalCIMDataObject
cim:IncrementalCIMDataObject rdf:type owl:Class ;
                             rdfs:subClassOf cim:CIMDataObject ;
                             rdfs:comment "A CRUD style CIM data object." .


###  http://www.iec.ch/TC57/CIM#IncrementalDataset
cim:IncrementalDataset rdf:type owl:Class ;
                       rdfs:subClassOf cim:IdentifiedObject ;
                       rdfs:comment "Describes a set of changes that can be applied in different situations.   A given registered MRID may only be referenced once by the contained data objects, except a precondition may also reference the same registered MRID." .


###  http://www.iec.ch/TC57/CIM#IncrementalDatasetArg
cim:IncrementalDatasetArg rdf:type owl:Class ;
                          rdfs:subClassOf cim:ModelOperationArg ;
                          rdfs:comment "A generic model operation argument referencing an incremental change description." .


###  http://www.iec.ch/TC57/CIM#IncrementalDatasetArgDescription
cim:IncrementalDatasetArgDescription rdf:type owl:Class ;
                                     rdfs:subClassOf cim:ModelOperationArgDescription .


###  http://www.iec.ch/TC57/CIM#IncrementalHeatRateCurve
cim:IncrementalHeatRateCurve rdf:type owl:Class ;
                             owl:equivalentClass [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:IncrementalHeatRateCurve.isNetGrossP ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onDataRange xsd:boolean
                                                 ] ;
                             rdfs:subClassOf cim:Curve ;
                             rdfs:comment "Relationship between unit incremental heat rate in (delta energy/time) per (delta active power) and unit output in active power. The IHR curve represents the slope of the HeatInputCurve. Note that the \"incremental heat rate\" and the \"heat rate\" have the same engineering units." .


###  http://www.iec.ch/TC57/CIM#IndividualPnode
cim:IndividualPnode rdf:type owl:Class ;
                    rdfs:subClassOf cim:Pnode ;
                    rdfs:comment "Individual pricing node based on Pnode" .


###  http://www.iec.ch/TC57/CIM#Inductance
cim:Inductance rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:Inductance.multiplier ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:UnitMultiplier
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:Inductance.unit ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:UnitSymbol
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:Inductance.value ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ;
               rdfs:comment "Inductive part of reactance (imaginary part of impedance), at rated frequency." .


###  http://www.iec.ch/TC57/CIM#InductancePerLength
cim:InductancePerLength rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:InductancePerLength.multiplier ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:UnitMultiplier
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:InductancePerLength.unit ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:UnitSymbol
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:InductancePerLength.value ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ;
                        rdfs:comment "Inductance per unit of length." .


###  http://www.iec.ch/TC57/CIM#InflowForecast
cim:InflowForecast rdf:type owl:Class ;
                   rdfs:subClassOf cim:RegularIntervalSchedule ;
                   rdfs:comment "Natural water inflow to a reservoir, usually forecasted from predicted rain and snowmelt. Typically in one hour increments for up to 10 days. The forecast is given in average cubic meters per second over the time increment." .


###  http://www.iec.ch/TC57/CIM#InfoQuestion
cim:InfoQuestion rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:InfoQuestion.answer ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:InfoQuestion.answerDateTime ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:dateTime
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:InfoQuestion.answerRemark ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:InfoQuestion.questionCode ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:InfoQuestion.questionRemark ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:InfoQuestion.questionText ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:InfoQuestion.questionType ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ;
                 rdfs:subClassOf cim:WorkDocument ;
                 rdfs:comment "Questions and answers associated with a type of document for purposes of clarification. Questions may be predefined or ad hoc." .


###  http://www.iec.ch/TC57/CIM#InputSignalKind
cim:InputSignalKind rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:oneOf ( cim:branchCurrent
                                                      cim:busFrequency
                                                      cim:busFrequencyDeviation
                                                      cim:busVoltage
                                                      cim:busVoltageDerivative
                                                      cim:fieldCurrent
                                                      cim:generatorAcceleratingPower
                                                      cim:generatorElectricalPower
                                                      cim:rotorAngularFrequencyDeviation
                                                      cim:rotorSpeed
                                                    )
                                        ] .


###  http://www.iec.ch/TC57/CIM#InspectionDataSet
cim:InspectionDataSet rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:InspectionDataSet.locationCondition ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ;
                      rdfs:subClassOf cim:ProcedureDataSet ;
                      rdfs:comment "Documents the result of one inspection, for a given attribute of an asset." .


###  http://www.iec.ch/TC57/CIM#InstructionClearing
cim:InstructionClearing rdf:type owl:Class ;
                        rdfs:subClassOf cim:MarketFactors ;
                        rdfs:comment "Model of market clearing, relating to commitment instructions. Identifies interval" .


###  http://www.iec.ch/TC57/CIM#InstructionClearingDOP
cim:InstructionClearingDOP rdf:type owl:Class ;
                           rdfs:subClassOf cim:MarketFactors ;
                           rdfs:comment "Model of market clearing, related to Dispatch Operating Point. Identifies interval" .


###  http://www.iec.ch/TC57/CIM#InstructionClearingDOT
cim:InstructionClearingDOT rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:InstructionClearingDOT.contingencyActive ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:YesNo
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:InstructionClearingDOT.dispatchMode ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:AutomaticDispatchMode
                                               ] ;
                           rdfs:subClassOf cim:MarketFactors ;
                           rdfs:comment "Model of market clearing, related to Dispatch Operating Target (model of anticipatory dispatch). Identifies interval" .


###  http://www.iec.ch/TC57/CIM#Instructions
cim:Instructions rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Instructions.bindingInstruction ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:YesNo
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Instructions.instructionSource ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:MQSInstructionSource
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Instructions.instructionType ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:AutomaticDispInstTypeCommitment
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Instructions.manuallyBlocked ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:YesNo
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Instructions.updateType ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:MQSCHGType
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Instructions.bindingDOT ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:float
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Instructions.instructionCost ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:float
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Instructions.instructionStartTime ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:dateTime
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Instructions.minStatusChangeTime ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:nonNegativeInteger
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Instructions.updateTimeStamp ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:dateTime
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Instructions.updateUser ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ;
                 rdfs:comment "Provides the necessary information (on a resource basis) to capture the Startup/Shutdown instruction results. This information is relevant to the DA Market (RUC only) as well as the RT Market (HASP, Pre-dispatch, and Interval)." .


###  http://www.iec.ch/TC57/CIM#IntSchedAgreement
cim:IntSchedAgreement rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:IntSchedAgreement.defaultIntegrationMethod ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ;
                      rdfs:subClassOf cim:Agreement ;
                      rdfs:comment "A type of agreement that provides the default method by which interchange schedules are to be integrated to obtain hourly MWh schedules for accounting." .


###  http://www.iec.ch/TC57/CIM#IntegerQuantity
cim:IntegerQuantity rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:IntegerQuantity.multiplier ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:UnitMultiplier
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:IntegerQuantity.unit ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:UnitSymbol
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:IntegerQuantity.value ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:nonNegativeInteger
                                        ] ;
                    rdfs:comment "Quantity with integer value and associated unit information." .


###  http://www.iec.ch/TC57/CIM#InterTieBid
cim:InterTieBid rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:InterTieBid.minHourlyBlock_ ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:nonNegativeInteger
                                    ] ;
                rdfs:subClassOf cim:ResourceBid ;
                rdfs:comment "This class represents the inter tie bid" .


###  http://www.iec.ch/TC57/CIM#InterTieClearing
cim:InterTieClearing rdf:type owl:Class ;
                     rdfs:subClassOf cim:MarketFactors ;
                     rdfs:comment "Model of market clearing related to results at the inter-ties. Identifies interval" .


###  http://www.iec.ch/TC57/CIM#InterTieDirection
cim:InterTieDirection rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Class ;
                                            owl:oneOf ( cim:E
                                                        cim:I
                                                      )
                                          ] .


###  http://www.iec.ch/TC57/CIM#InterTieDispatchResponse
cim:InterTieDispatchResponse rdf:type owl:Class ;
                             owl:equivalentClass [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:InterTieDispatchResponse.acceptStatus ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:DispatchResponseType
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:InterTieDispatchResponse.passIndicator ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:PassIndicatorType
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:InterTieDispatchResponse.acceptMW ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onDataRange xsd:float
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:InterTieDispatchResponse.clearedMW ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onDataRange xsd:float
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:InterTieDispatchResponse.startTime ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onDataRange xsd:dateTime
                                                 ] ;
                             rdfs:comment "Response from an intertie resource acknowleging receipt of dispatch instructions" .


###  http://www.iec.ch/TC57/CIM#InterTieResults
cim:InterTieResults rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:InterTieResults.baseMW ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:float
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:InterTieResults.clearedValue ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:float
                                        ] ;
                    rdfs:comment "Provides the tie point specific output from the market applications. Currently, this is defined as the loop flow compensation MW value." .


###  http://www.iec.ch/TC57/CIM#InterchangeETCData
cim:InterchangeETCData rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:InterchangeETCData.contractNumber ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:InterchangeETCData.usageMW ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:float
                                           ] ;
                       rdfs:comment "Existing Transmission Contract data for an interchange schedule" .


###  http://www.iec.ch/TC57/CIM#InterchangeSchedule
cim:InterchangeSchedule rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:InterchangeSchedule.checkOutType ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:CheckOutType
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:InterchangeSchedule.directionType ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:InterTieDirection
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:InterchangeSchedule.energyType ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:MarketProductType
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:InterchangeSchedule.marketType ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:MarketType
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:InterchangeSchedule.scheduleType ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:EnergyProductType
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:InterchangeSchedule.intervalLength ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:nonNegativeInteger
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:InterchangeSchedule.operatingDate ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:dateTime
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:InterchangeSchedule.outOfMarketType ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:InterchangeSchedule.wcrID ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:string
                                            ] ;
                        rdfs:subClassOf cim:Curve ;
                        rdfs:comment "Interchange schedule class to hold information for interchange schedules such as import export type, energy type, and etc." .


###  http://www.iec.ch/TC57/CIM#IntermittentResourceEligibility
cim:IntermittentResourceEligibility rdf:type owl:Class ;
                                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                                          owl:onProperty cim:IntermittentResourceEligibility.eligibilityStatus ;
                                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onDataRange xsd:string
                                                        ] ;
                                    rdfs:subClassOf cim:MarketFactors ;
                                    rdfs:comment "Indicates whether unit is eligible for treatment as a intermittent variable renewable resource" .


###  http://www.iec.ch/TC57/CIM#InternalControlArea
cim:InternalControlArea rdf:type owl:Class ;
                        rdfs:subClassOf cim:IdentifiedObject ;
                        rdfs:comment "There is one internal control area in the system, which is the single control area in the primary network company. Real time generation control affects only the internal control area." .


###  http://www.iec.ch/TC57/CIM#IntervalBlock
cim:IntervalBlock rdf:type owl:Class ;
                  rdfs:comment "Time sequence of readings of the same reading type. Contained interval readings may need conversion through the application of an offset and a scalar defined in associated pending." .


###  http://www.iec.ch/TC57/CIM#IntervalReading
cim:IntervalReading rdf:type owl:Class ;
                    rdfs:subClassOf cim:BaseReading ;
                    rdfs:comment """Data captured at regular intervals of time. Interval data could be captured as incremental data, absolute data, or relative data. The source for the data is usually a tariff quantity or an engineering quantity. Data is typically captured in time-tagged, uniform, fixed-length intervals of 5 min, 10 min, 15 min, 30 min, or 60 min.
Note: Interval Data is sometimes also called \"Interval Data Readings\" (IDR).""" .


###  http://www.iec.ch/TC57/CIM#IrregularIntervalSchedule
cim:IrregularIntervalSchedule rdf:type owl:Class ;
                              rdfs:subClassOf cim:BasicIntervalSchedule ;
                              rdfs:comment "The schedule has time points where the time between them varies." .


###  http://www.iec.ch/TC57/CIM#IrregularTimePoint
cim:IrregularTimePoint rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:IrregularTimePoint.time ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Seconds
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:IrregularTimePoint.value1 ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:float
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:IrregularTimePoint.value2 ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:float
                                           ] ;
                       rdfs:comment "TimePoints for a schedule where the time between the points varies." .


###  http://www.iec.ch/TC57/CIM#Issuer
cim:Issuer rdf:type owl:Class ;
           rdfs:subClassOf cim:DocumentPersonRole ;
           rdfs:comment "Person who issued the document and is responsible for its content." .


###  http://www.iec.ch/TC57/CIM#JobFlagType
cim:JobFlagType rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Class ;
                                      owl:oneOf ( cim:CREATED
                                                  cim:DELETED
                                                  cim:MODIFIED
                                                )
                                    ] .


###  http://www.iec.ch/TC57/CIM#JobScheduleType
cim:JobScheduleType rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:oneOf ( cim:CRITICAL
                                                      cim:NONCRITICAL
                                                    )
                                        ] .


###  http://www.iec.ch/TC57/CIM#JobStartEndType
cim:JobStartEndType rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:oneOf ( cim:END
                                                      cim:NA
                                                      cim:START
                                                    )
                                        ] .


###  http://www.iec.ch/TC57/CIM#Joint
cim:Joint rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Joint.configurationKind ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:JointConfigurationKind
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Joint.fillKind ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:JointFillKind
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Joint.insulation ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:string
                              ] ;
          rdfs:subClassOf cim:Asset ;
          rdfs:comment "Joint connects two or more cables. It includes the portion of cable under wipes, welds, or other seals." .


###  http://www.iec.ch/TC57/CIM#JointConfigurationKind
cim:JointConfigurationKind rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Class ;
                                                 owl:oneOf ( cim:other
                                                             cim:wires1to1
                                                             cim:wires2to1
                                                             cim:wires3to1
                                                           )
                                               ] .


###  http://www.iec.ch/TC57/CIM#JointFillKind
cim:JointFillKind rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:oneOf ( cim:airNoFilling
                                                    cim:asphaltic
                                                    cim:bluefill254
                                                    cim:epoxy
                                                    cim:insoluseal
                                                    cim:noFillPrefab
                                                    cim:noVoid
                                                    cim:oil
                                                    cim:other
                                                    cim:petrolatum
                                                  )
                                      ] .


###  http://www.iec.ch/TC57/CIM#Jumper
cim:Jumper rdf:type owl:Class ;
           rdfs:subClassOf cim:Switch ;
           rdfs:comment "A short section of conductor with negligible impedance which can be manually removed and replaced if the circuit is de-energized. Note that zero-impedance branches can potentially be modeled by other equipment types." .


###  http://www.iec.ch/TC57/CIM#JumperAction
cim:JumperAction rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:JumperAction.kind ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:TempEquipActionKind
                                     ] ;
                 rdfs:subClassOf cim:SwitchingStep ;
                 rdfs:comment "Action on jumper as a switching step." .


###  http://www.iec.ch/TC57/CIM#Junction
cim:Junction rdf:type owl:Class ;
             rdfs:subClassOf cim:Connector ;
             rdfs:comment "A point where one or more conducting equipments are connected with zero resistance." .


###  http://www.iec.ch/TC57/CIM#KiloActivePower
cim:KiloActivePower rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:KiloActivePower.multiplier ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:UnitMultiplier
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:KiloActivePower.unit ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:UnitSymbol
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:KiloActivePower.value ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:float
                                        ] ;
                    rdfs:comment "Active power in kilowatts." .


###  http://www.iec.ch/TC57/CIM#LFCResourceType
cim:LFCResourceType rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:oneOf ( cim:GEN
                                                      cim:PUMP
                                                    )
                                        ] .


###  http://www.iec.ch/TC57/CIM#LaborItem
cim:LaborItem rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:LaborItem.cost ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:Money
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:LaborItem.laborDuration ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:Hours
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:LaborItem.laborRate ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:CostRate
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:LaborItem.status ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:Status
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:LaborItem.activityCode ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:string
                                  ] ;
              rdfs:subClassOf cim:WorkIdentifiedObject ;
              rdfs:comment "Labor used for work order." .


###  http://www.iec.ch/TC57/CIM#LandProperty
cim:LandProperty rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:LandProperty.demographicKind ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:DemographicKind
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:LandProperty.kind ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:LandPropertyKind
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:LandProperty.status ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Status
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:LandProperty.externalRecordReference ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ;
                 rdfs:subClassOf cim:IdentifiedObject ;
                 rdfs:comment "Information about a particular piece of (land) property such as its use. Ownership of the property may be determined through associations to Organisations and/or ErpPersons." .


###  http://www.iec.ch/TC57/CIM#LandPropertyKind
cim:LandPropertyKind rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:oneOf ( cim:building
                                                       cim:customerPremise
                                                       cim:depot
                                                       cim:external
                                                       cim:gridSupplyPoint
                                                       cim:store
                                                       cim:substation
                                                     )
                                         ] .


###  http://www.iec.ch/TC57/CIM#Legend
cim:Legend rdf:type owl:Class .


###  http://www.iec.ch/TC57/CIM#Length
cim:Length rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Length.multiplier ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:UnitMultiplier
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Length.unit ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:UnitSymbol
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Length.value ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:float
                               ] ;
           rdfs:comment "Unit of length. Never negative." .


###  http://www.iec.ch/TC57/CIM#LevelVsVolumeCurve
cim:LevelVsVolumeCurve rdf:type owl:Class ;
                       rdfs:subClassOf cim:Curve ;
                       rdfs:comment "Relationship between reservoir volume and reservoir level. The  volume is at the y-axis and the reservoir level at the x-axis." .


###  http://www.iec.ch/TC57/CIM#LifecycleDate
cim:LifecycleDate rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:LifecycleDate.installationDate ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:date
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:LifecycleDate.manufacturedDate ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:date
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:LifecycleDate.purchaseDate ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:date
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:LifecycleDate.receivedDate ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:date
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:LifecycleDate.removalDate ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:date
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:LifecycleDate.retiredDate ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:date
                                      ] ;
                  rdfs:comment "Dates for lifecycle events of an asset." .


###  http://www.iec.ch/TC57/CIM#Limit
cim:Limit rdf:type owl:Class ;
          rdfs:subClassOf cim:IdentifiedObject ;
          rdfs:comment "Specifies one limit value for a Measurement. A Measurement typically has several limits that are kept together by the LimitSet class. The actual meaning and use of a Limit instance (i.e., if it is an alarm or warning limit or if it is a high or low limit) is not captured in the Limit class. However the name of a Limit instance may indicate both meaning and use." .


###  http://www.iec.ch/TC57/CIM#LimitDependency
cim:LimitDependency rdf:type owl:Class ;
                    rdfs:subClassOf cim:IdentifiedObject ;
                    rdfs:comment "A limit calculation model used to compute an operational limit based on external input such as temperature. These are intended to be shared among operational limits with the same calculation form that apply to a piece of equipment.." .


###  http://www.iec.ch/TC57/CIM#LimitScalingLimit
cim:LimitScalingLimit rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:LimitScalingLimit.limitScalingPercent ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:PerCent
                                          ] ;
                      rdfs:subClassOf cim:LimitDependency ;
                      rdfs:comment "Specifies an operational  limit is calculated by scaling another operational limit." .


###  http://www.iec.ch/TC57/CIM#LimitSet
cim:LimitSet rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:LimitSet.isPercentageLimits ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:boolean
                                 ] ;
             rdfs:subClassOf cim:IdentifiedObject ;
             rdfs:comment "Specifies a set of Limits that are associated with a Measurement. A Measurement may have several LimitSets corresponding to seasonal or other changing conditions. The condition is captured in the name and description attributes. The same LimitSet may be used for several Measurements. In particular percentage limits are used this way." .


###  http://www.iec.ch/TC57/CIM#Line
cim:Line rdf:type owl:Class ;
         rdfs:subClassOf cim:EquipmentContainer ;
         rdfs:comment "Contains equipment beyond a substation belonging to a power transmission line." .


###  http://www.iec.ch/TC57/CIM#LineDetail
cim:LineDetail rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:LineDetail.amount ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:Money
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:LineDetail.rounding ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:Money
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:LineDetail.dateTime ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:dateTime
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:LineDetail.note ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ;
               rdfs:comment "Details on an amount line, with rounding, date and note." .


###  http://www.iec.ch/TC57/CIM#LineFault
cim:LineFault rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:LineFault.lengthFromTerminal1 ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:Length
                                  ] ;
              rdfs:subClassOf cim:Fault ;
              rdfs:comment "A fault that occurs on an AC line segment at some point along the length." .


###  http://www.iec.ch/TC57/CIM#LinearShuntCompensator
cim:LinearShuntCompensator rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:LinearShuntCompensator.b0PerSection ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:Susceptance
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:LinearShuntCompensator.bPerSection ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:Susceptance
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:LinearShuntCompensator.g0PerSection ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:Conductance
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:LinearShuntCompensator.gPerSection ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:Conductance
                                               ] ;
                           rdfs:subClassOf cim:ShuntCompensator ;
                           rdfs:comment "A linear shunt compensator has banks or sections with equal admittance values." .


###  http://www.iec.ch/TC57/CIM#LinearShuntCompensatorPhase
cim:LinearShuntCompensatorPhase rdf:type owl:Class ;
                                owl:equivalentClass [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:LinearShuntCompensatorPhase.bPerSection ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onClass cim:Susceptance
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:LinearShuntCompensatorPhase.gPerSection ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onClass cim:Conductance
                                                    ] ;
                                rdfs:subClassOf cim:ShuntCompensatorPhase ;
                                rdfs:comment "A per phase linear shunt compensator has banks or sections with equal admittance values." .


###  http://www.iec.ch/TC57/CIM#LoadAggregate
cim:LoadAggregate rdf:type owl:Class ;
                  rdfs:subClassOf cim:LoadDynamics ;
                  rdfs:comment "Standard aggregate load model comprised of static and/or dynamic components.  A static load model represents the sensitivity of the real and reactive power consumed by the load to the amplitude and frequency of the bus voltage. A dynamic load model can used to represent the aggregate response of the motor components of the load." .


###  http://www.iec.ch/TC57/CIM#LoadAggregationPoint
cim:LoadAggregationPoint rdf:type owl:Class ;
                         rdfs:subClassOf cim:AggregateNode ;
                         rdfs:comment "A specialized class of type AggregatedNode type. Defines Load Aggregation Points." .


###  http://www.iec.ch/TC57/CIM#LoadArea
cim:LoadArea rdf:type owl:Class ;
             rdfs:subClassOf cim:EnergyArea ;
             rdfs:comment "The class is the root or first level in a hierarchical structure for grouping of loads for the purpose of load flow load scaling." .


###  http://www.iec.ch/TC57/CIM#LoadBid
cim:LoadBid rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:LoadBid.dropRampRate ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:ActivePowerChangeRate
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:LoadBid.loadRedInitiationCost ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:Money
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:LoadBid.minLoad ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:ActivePower
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:LoadBid.minLoadReduction ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:ActivePower
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:LoadBid.minLoadReductionCost ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:Money
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:LoadBid.pickUpRampRate ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:ActivePowerChangeRate
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:LoadBid.shutdownCost ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:Money
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:LoadBid.loadRedInitiationTime ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:float
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:LoadBid.marketDate ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:dateTime
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:LoadBid.meteredValue ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:boolean
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:LoadBid.minLoadReductionInterval ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:float
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:LoadBid.minTimeBetLoadRed ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:float
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:LoadBid.priceSetting ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:boolean
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:LoadBid.reqNoticeTime ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:float
                                ] ;
            rdfs:subClassOf cim:ResourceBid ;
            rdfs:comment "Offer to supply energy/ancillary services from a load resource (participating load reduces consumption)" .


###  http://www.iec.ch/TC57/CIM#LoadBreakSwitch
cim:LoadBreakSwitch rdf:type owl:Class ;
                    rdfs:subClassOf cim:ProtectedSwitch ;
                    rdfs:comment "A mechanical switching device capable of making, carrying, and breaking currents under normal operating conditions." .


###  http://www.iec.ch/TC57/CIM#LoadComposite
cim:LoadComposite rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:LoadComposite.h ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Seconds
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:LoadComposite.epfd ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:LoadComposite.epfs ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:LoadComposite.epvd ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:LoadComposite.epvs ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:LoadComposite.eqfd ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:LoadComposite.eqfs ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:LoadComposite.eqvd ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:LoadComposite.eqvs ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:LoadComposite.lfrac ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:LoadComposite.pfrac ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ;
                  rdfs:subClassOf cim:LoadDynamics ;
                  rdfs:comment """This models combines static load and induction motor load effects.
The dynamics of the motor are simplified by linearizing the induction machine equations.""" .


###  http://www.iec.ch/TC57/CIM#LoadDistributionFactor
cim:LoadDistributionFactor rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:LoadDistributionFactor.pDistFactor ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:float
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:LoadDistributionFactor.qDistFactor ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:float
                                               ] ;
                           rdfs:comment """This class models the load distribution factors. This class should be used in one of two ways:

Use it along with the AggregatedPnode and the IndividualPnode to show the distriubtion of each individual party

OR

Use it with Mkt_EnergyConsumer to represent the current MW/Mvar distribution within it's parnet load group.""" .


###  http://www.iec.ch/TC57/CIM#LoadDynamics
cim:LoadDynamics rdf:type owl:Class ;
                 rdfs:subClassOf cim:IdentifiedObject ;
                 rdfs:comment """Load whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>

A standard feature of dynamic load behaviour modelling is the ability to associate the same behaviour to multiple energy consumers by means of a single aggregate load definition.  Aggregate loads are used to represent all or part of the real and reactive load from one or more loads in the static (power flow) data. This load is usually the aggregation of many individual load devices and the load model is approximate representation of the aggregate response of the load devices to system disturbances. The load model is always applied to individual bus loads (energy consumers) but a single set of load model parameters can used for all loads in the grouping.""" .


###  http://www.iec.ch/TC57/CIM#LoadFollowingCapacityType
cim:LoadFollowingCapacityType rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Class ;
                                                    owl:oneOf ( cim:DOWN
                                                                cim:UP
                                                              )
                                                  ] .


###  http://www.iec.ch/TC57/CIM#LoadFollowingInst
cim:LoadFollowingInst rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:LoadFollowingInst.endTime ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:dateTime
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:LoadFollowingInst.loadFollowingMW ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:float
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:LoadFollowingInst.mssInstructionID ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:LoadFollowingInst.startTime ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:dateTime
                                          ] ;
                      rdfs:comment "Metered SubSystem Load Following Instruction" .


###  http://www.iec.ch/TC57/CIM#LoadFollowingOperatorInput
cim:LoadFollowingOperatorInput rdf:type owl:Class ;
                               owl:equivalentClass [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:LoadFollowingOperatorInput.updateType ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass cim:MQSCHGType
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:LoadFollowingOperatorInput.dataEntryTimeStamp ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:dateTime
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:LoadFollowingOperatorInput.tempLoadFollowingDownManualCap ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:float
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:LoadFollowingOperatorInput.tempLoadFollowingUpManualCap ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:float
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:LoadFollowingOperatorInput.updateTimeStamp ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:dateTime
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:LoadFollowingOperatorInput.updateUser ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:string
                                                   ] ;
                               rdfs:comment "Model of load following capabilities that are entered by operators on a temporary basis.  Related to Registered Resources in Metered Subsystems" .


###  http://www.iec.ch/TC57/CIM#LoadForecastType
cim:LoadForecastType rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:oneOf ( cim:LFZ
                                                       cim:LZMS
                                                     )
                                         ] .


###  http://www.iec.ch/TC57/CIM#LoadGenericNonLinear
cim:LoadGenericNonLinear rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:LoadGenericNonLinear.genericNonLinearLoadModelType ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:GenericNonLinearLoadModelKind
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:LoadGenericNonLinear.tp ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:Seconds
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:LoadGenericNonLinear.tq ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:Seconds
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:LoadGenericNonLinear.bs ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:LoadGenericNonLinear.bt ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:LoadGenericNonLinear.ls ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:LoadGenericNonLinear.lt ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:LoadGenericNonLinear.pt ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:LoadGenericNonLinear.qt ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ;
                         rdfs:subClassOf cim:LoadDynamics ;
                         rdfs:comment "These load models (known also as generic non-linear dynamic (GNLD) load models) can be used in mid-term and long-term voltage stability simulations (i.e., to study voltage collapse), as they can replace a more detailed representation of aggregate load, including induction motors, thermostatically controlled and static loads." .


###  http://www.iec.ch/TC57/CIM#LoadGroup
cim:LoadGroup rdf:type owl:Class ;
              rdfs:subClassOf cim:IdentifiedObject ;
              rdfs:comment "The class is the third level in a hierarchical structure for grouping of loads for the purpose of load flow load scaling." .


###  http://www.iec.ch/TC57/CIM#LoadMotor
cim:LoadMotor rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:LoadMotor.h ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:Seconds
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:LoadMotor.lp ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:PU
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:LoadMotor.lpp ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:PU
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:LoadMotor.ls ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:PU
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:LoadMotor.ra ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:PU
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:LoadMotor.tbkr ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:Seconds
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:LoadMotor.tpo ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:Seconds
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:LoadMotor.tppo ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:Seconds
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:LoadMotor.tv ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:Seconds
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:LoadMotor.vt ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:PU
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:LoadMotor.d ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:float
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:LoadMotor.lfac ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:float
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:LoadMotor.pfrac ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:float
                                  ] ;
              rdfs:subClassOf cim:IdentifiedObject ;
              rdfs:comment """Aggregate induction motor load. This model  is used to represent a fraction of an ordinary load as \"induction motor load\".  It allows load that is treated as ordinary constant power in power flow analysis to be represented by an induction motor in dynamic simulation.  If <b>Lpp</b> = 0. or <b>Lpp</b> = <b>Lp</b>, or <b>Tppo</b> = 0.,  only one cage is represented. Magnetic saturation is not modelled. Either a \"one-cage\" or \"two-cage\" model of the induction machine can be modelled. Magnetic saturation is not modelled.

This model is intended for representation of aggregations of many motors dispersed through a load represented at a high voltage bus but where there is no information on the characteristics of individual motors.

This model treats a fraction of the constant power part of a load as a motor. During initialisation, the initial power drawn by the motor is set equal to <b>Pfrac</b> times the constant <b>P</b> part of the static load.  The remainder of the load is left as static load.

The reactive power demand of the motor is calculated during initialisation as a function of voltage at the load bus. This reactive power demand may be less than or greater than the constant <b>Q</b> component of the load.  If the motor's reactive demand is greater than the constant <b>Q</b> component of the load, the model inserts a shunt capacitor at the terminal of the motor to bring its reactive demand down to equal the constant <b>Q</b> reactive load.  
If a motor model and a static load model are both present for a load, the motor <b>Pfrac</b> is assumed to be subtracted from the power flow constant <b>P</b> load before the static load model is applied.  The remainder of the load, if any, is then represented by the static load model.""" .


###  http://www.iec.ch/TC57/CIM#LoadRatio
cim:LoadRatio rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:LoadRatio.share ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:PerCent
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:LoadRatio.intervalEndTime ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:dateTime
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:LoadRatio.intervalStartTime ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:dateTime
                                  ] ;
              rdfs:comment "Representing the ratio of the load share for the associated SC." .


###  http://www.iec.ch/TC57/CIM#LoadReductionPriceCurve
cim:LoadReductionPriceCurve rdf:type owl:Class ;
                            rdfs:subClassOf cim:Curve ;
                            rdfs:comment "This is the price sensitivity that bidder expresses for allowing market load interruption.  Relationship between price (Y1-axis) vs. MW (X-axis)." .


###  http://www.iec.ch/TC57/CIM#LoadReductionTimeCurve
cim:LoadReductionTimeCurve rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:LoadReductionTimeCurve.loadReductionTimeCurveType ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ;
                           rdfs:subClassOf cim:Curve ;
                           rdfs:comment "This is the cureve that describes the load reduction time. Relationship between time (Y1-axis) vs. MW (X-axis)." .


###  http://www.iec.ch/TC57/CIM#LoadResponseCharacteristic
cim:LoadResponseCharacteristic rdf:type owl:Class ;
                               owl:equivalentClass [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:LoadResponseCharacteristic.exponentModel ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:boolean
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:LoadResponseCharacteristic.pConstantCurrent ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:float
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:LoadResponseCharacteristic.pConstantImpedance ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:float
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:LoadResponseCharacteristic.pConstantPower ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:float
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:LoadResponseCharacteristic.pFrequencyExponent ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:float
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:LoadResponseCharacteristic.pVoltageExponent ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:float
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:LoadResponseCharacteristic.qConstantCurrent ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:float
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:LoadResponseCharacteristic.qConstantImpedance ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:float
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:LoadResponseCharacteristic.qConstantPower ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:float
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:LoadResponseCharacteristic.qFrequencyExponent ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:float
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:LoadResponseCharacteristic.qVoltageExponent ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:float
                                                   ] ;
                               rdfs:subClassOf cim:IdentifiedObject ;
                               rdfs:comment """Models the characteristic response of the load demand due to changes in system conditions such as voltage and frequency. This is not related to demand response.

If LoadResponseCharacteristic.exponentModel is True, the voltage exponents are specified and used as to calculate:

Active power component = Pnominal * (Voltage/cim:BaseVoltage.nominalVoltage) ** cim:LoadResponseCharacteristic.pVoltageExponent

Reactive power component = Qnominal * (Voltage/cim:BaseVoltage.nominalVoltage)** cim:LoadResponseCharacteristic.qVoltageExponent

Where  * means \"multiply\" and ** is \"raised to power of\".""" .


###  http://www.iec.ch/TC57/CIM#LoadStatic
cim:LoadStatic rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:LoadStatic.staticLoadModelType ;

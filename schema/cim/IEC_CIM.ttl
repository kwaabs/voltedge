                                        owl:onProperty cim:BranchEndFlow.shortTermRating ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ;
                  rdfs:comment "Dynamic flows and ratings associated with a branch end." .


###  http://www.iec.ch/TC57/CIM#BranchGroup
cim:BranchGroup rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:BranchGroup.maximumActivePower ;

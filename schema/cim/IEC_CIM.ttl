                      rdfs:comment "Describes the role a dataset plays in a model operation.   The role is applicable only in the context of a single operation." .


###  http://www.iec.ch/TC57/CIM#ModelOperationArgDescription
cim:ModelOperationArgDescription rdf:type owl:Class ;
                                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                                       owl:onProperty cim:ModelOperationArgDescription.multiplicityMaximum ;
                                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                       owl:onDataRange xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty cim:ModelOperationArgDescription.multiplicityMinimum ;
                                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                       owl:onDataRange xsd:nonNegativeInteger
                                                     ] ;
                                 rdfs:subClassOf cim:IdentifiedObject ;
                                 rdfs:comment "The type of custom operation dataset role for an operation description." .


###  http://www.iec.ch/TC57/CIM#ModelOperationDescription
cim:ModelOperationDescription rdf:type owl:Class ;
                              rdfs:subClassOf cim:IdentifiedObject ;
                              rdfs:comment "The type of model operation.   This class is referenced by model operations and defines the kind of operation." .


###  http://www.iec.ch/TC57/CIM#ModelOperationSequence
cim:ModelOperationSequence rdf:type owl:Class ;
                           rdfs:subClassOf cim:IdentifiedObject ;
                           rdfs:comment "A concrete sequence of operations.    For example, this may be used to describe a specific audit trail, a script or other specific set of actions on specific datasets." .


###  http://www.iec.ch/TC57/CIM#ModelPartVersion
cim:ModelPartVersion rdf:type owl:Class ;
                     rdfs:comment "Versioned instance of a model part." .


###  http://www.iec.ch/TC57/CIM#ModelSpecification
cim:ModelSpecification rdf:type owl:Class ;
                       rdfs:subClassOf cim:IdentifiedObject ;
                       rdfs:comment "The type of model.  For example,  state estimator, planning, planning dynamics, short circuit, or real-time dynamics etc.     The model must conform to a profile." .


###  http://www.iec.ch/TC57/CIM#Money
cim:Money rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Money.multiplier ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:UnitMultiplier
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Money.unit ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:Currency
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Money.value ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:Decimal
                              ] ;
          rdfs:comment "Amount of money." .


###  http://www.iec.ch/TC57/CIM#MonthDay
cim:MonthDay rdf:type owl:Class ;
             rdfs:comment "MonthDay format as \"--mm-dd\", which conforms with XSD data type gMonthDay." .


###  http://www.iec.ch/TC57/CIM#MonthDayInterval
cim:MonthDayInterval rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:MonthDayInterval.end ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:MonthDay
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:MonthDayInterval.start ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:MonthDay
                                         ] ;
                     rdfs:comment "Interval between two times specified as mont and date." .


###  http://www.iec.ch/TC57/CIM#MutualCoupling
cim:MutualCoupling rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:MutualCoupling.b0ch ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Susceptance
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:MutualCoupling.distance11 ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Length
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:MutualCoupling.distance12 ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Length
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:MutualCoupling.distance21 ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Length
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:MutualCoupling.distance22 ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Length
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:MutualCoupling.g0ch ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Conductance
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:MutualCoupling.r0 ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Resistance
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:MutualCoupling.x0 ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Reactance
                                       ] ;
                   rdfs:subClassOf cim:IdentifiedObject ;
                   rdfs:comment "This class represents the zero sequence line mutual coupling." .


###  http://www.iec.ch/TC57/CIM#Name
cim:Name rdf:type owl:Class ;
         owl:equivalentClass [ rdf:type owl:Restriction ;
                               owl:onProperty cim:Name.name ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:string
                             ] ;
         rdfs:comment "The Name class provides the means to define any number of human readable  names for an object. A name is <b>not</b> to be used for defining inter-object relationships. For inter-object relationships instead use the object identification 'mRID'." .


###  http://www.iec.ch/TC57/CIM#NameType
cim:NameType rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:NameType.description ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:NameType.name ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ;
             rdfs:comment """Type of name. Possible values for attribute 'name' are implementation dependent but standard profiles may specify types. An enterprise may have multiple IT systems each having its own local name for the same object, e.g. a planning system may have different names from an EMS. An object may also have different names within the same IT system, e.g. localName as defined in CIM version 14. The definition from CIM14 is:
The localName is a human readable name of the object. It is a free text name local to a node in a naming hierarchy similar to a file directory structure. A power system related naming hierarchy may be: Substation, VoltageLevel, Equipment etc. Children of the same parent in such a hierarchy have names that typically are unique among them.""" .


###  http://www.iec.ch/TC57/CIM#NameTypeAuthority
cim:NameTypeAuthority rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:NameTypeAuthority.description ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:NameTypeAuthority.name ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ;
                      rdfs:comment "Authority responsible for creation and management of names of a given type; typically an organization or an enterprise system." .


###  http://www.iec.ch/TC57/CIM#NoLoadTest
cim:NoLoadTest rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:NoLoadTest.energisedEndVoltage ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:Voltage
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:NoLoadTest.excitingCurrent ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:PerCent
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:NoLoadTest.excitingCurrentZero ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:PerCent
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:NoLoadTest.loss ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:KiloActivePower
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:NoLoadTest.lossZero ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:KiloActivePower
                                   ] ;
               rdfs:subClassOf cim:TransformerTest ;
               rdfs:comment "No-load test results determine core admittance parameters. They include exciting current and core loss measurements from applying voltage to one winding. The excitation may be positive sequence or zero sequence. The test may be repeated at different voltages to measure saturation." .


###  http://www.iec.ch/TC57/CIM#NodeConstraintTerm
cim:NodeConstraintTerm rdf:type owl:Class ;
                       rdfs:subClassOf cim:ConstraintTerm ;
                       rdfs:comment "To be used only to constrain a quantity that cannot be associated with a terminal. For example, a registered generating unit that is not electrically connected to the network." .


###  http://www.iec.ch/TC57/CIM#NonConformLoad
cim:NonConformLoad rdf:type owl:Class ;
                   rdfs:subClassOf cim:EnergyConsumer ;
                   rdfs:comment "NonConformLoad represent loads that do not follow a daily load change pattern and changes are not correlated with the daily load change pattern." .


###  http://www.iec.ch/TC57/CIM#NonConformLoadGroup
cim:NonConformLoadGroup rdf:type owl:Class ;
                        rdfs:subClassOf cim:LoadGroup ;
                        rdfs:comment "Loads that do not follow a daily and seasonal load variation pattern." .


###  http://www.iec.ch/TC57/CIM#NonConformLoadSchedule
cim:NonConformLoadSchedule rdf:type owl:Class ;
                           rdfs:subClassOf cim:SeasonDayTypeSchedule ;
                           rdfs:comment "An active power (Y1-axis) and reactive power (Y2-axis) schedule (curves) versus time (X-axis) for non-conforming loads, e.g., large industrial load or power station service (where modeled)." .


###  http://www.iec.ch/TC57/CIM#NonStandardItem
cim:NonStandardItem rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:NonStandardItem.amount ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Money
                                        ] ;
                    rdfs:subClassOf cim:WorkDocument ;
                    rdfs:comment "This document provides information for non-standard items like customer contributions (e.g., customer digs trench), vouchers (e.g., credit), and contractor bids." .


###  http://www.iec.ch/TC57/CIM#NonlinearShuntCompensator
cim:NonlinearShuntCompensator rdf:type owl:Class ;
                              rdfs:subClassOf cim:ShuntCompensator ;
                              rdfs:comment "A non linear shunt compensator has bank or section admittance values that differs." .


###  http://www.iec.ch/TC57/CIM#NonlinearShuntCompensatorPhase
cim:NonlinearShuntCompensatorPhase rdf:type owl:Class ;
                                   rdfs:subClassOf cim:ShuntCompensatorPhase ;
                                   rdfs:comment "A per phase non linear shunt compensator has bank or section admittance values that differs." .


###  http://www.iec.ch/TC57/CIM#NonlinearShuntCompensatorPhasePoint
cim:NonlinearShuntCompensatorPhasePoint rdf:type owl:Class ;
                                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                                              owl:onProperty cim:NonlinearShuntCompensatorPhasePoint.b ;
                                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onClass cim:Susceptance
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty cim:NonlinearShuntCompensatorPhasePoint.g ;
                                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onClass cim:Conductance
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty cim:NonlinearShuntCompensatorPhasePoint.sectionNumber ;
                                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onDataRange xsd:nonNegativeInteger
                                                            ] ;
                                        rdfs:comment "A per phase non linear shunt compensator bank or section admittance value." .


###  http://www.iec.ch/TC57/CIM#NonlinearShuntCompensatorPoint
cim:NonlinearShuntCompensatorPoint rdf:type owl:Class ;
                                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                                         owl:onProperty cim:NonlinearShuntCompensatorPoint.b ;
                                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass cim:Susceptance
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty cim:NonlinearShuntCompensatorPoint.b0 ;
                                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass cim:Susceptance
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty cim:NonlinearShuntCompensatorPoint.g ;
                                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass cim:Conductance
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty cim:NonlinearShuntCompensatorPoint.g0 ;
                                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass cim:Conductance
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty cim:NonlinearShuntCompensatorPoint.sectionNumber ;
                                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onDataRange xsd:nonNegativeInteger
                                                       ] ;
                                   rdfs:comment "A non linear shunt compensator bank or section admittance value." .


###  http://www.iec.ch/TC57/CIM#NotificationTimeCurve
cim:NotificationTimeCurve rdf:type owl:Class ;
                          rdfs:subClassOf cim:Curve ;
                          rdfs:comment "Notification time curve as a function of down time.  Relationship between crew notification time (Y1-axis) and unit startup time (Y2-axis) vs. unit elapsed down time (X-axis)." .


###  http://www.iec.ch/TC57/CIM#NotificationTriggerKind
cim:NotificationTriggerKind rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Class ;
                                                  owl:oneOf ( cim:etrChange
                                                              cim:informDispatched
                                                              cim:initialEtr
                                                              cim:powerOut
                                                              cim:powerRestored
                                                            )
                                                ] .


###  http://www.iec.ch/TC57/CIM#NuclearGeneratingUnit
cim:NuclearGeneratingUnit rdf:type owl:Class ;
                          rdfs:subClassOf cim:GeneratingUnit ;
                          rdfs:comment "A nuclear generating unit." .



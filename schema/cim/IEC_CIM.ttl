###  http://www.iec.ch/TC57/CIM#GovCT1.db
cim:GovCT1.db rdf:type owl:ObjectProperty ;
              rdfs:domain cim:GovCT1 ;
              rdfs:range cim:PU ;
              rdfs:comment "Speed governor dead band in per unit speed (db).  In the majority of applications, it is recommended that this value be set to zero.  Typical Value = 0." .


###  http://www.iec.ch/TC57/CIM#GovCT1.dm
cim:GovCT1.dm rdf:type owl:ObjectProperty ;
              rdfs:domain cim:GovCT1 ;
              rdfs:range cim:PU ;
              rdfs:comment "Speed sensitivity coefficient (Dm).  Dm can represent either the variation of the engine power with the shaft speed or the variation of maximum power capability with shaft speed.  If it is positive it describes the falling slope of the engine speed verses power characteristic as speed increases. A slightly falling characteristic is typical for reciprocating engines and some aero-derivative turbines.  If it is negative the engine power is assumed to be unaffected by the shaft speed, but the maximum permissible fuel flow is taken to fall with falling shaft speed. This is characteristic of single-shaft industrial turbines due to exhaust temperature limits.  Typical Value = 0." .


###  http://www.iec.ch/TC57/CIM#GovCT1.ka
cim:GovCT1.ka rdf:type owl:ObjectProperty ;
              rdfs:domain cim:GovCT1 ;
              rdfs:range cim:PU ;
              rdfs:comment "Acceleration limiter gain (Ka).  Typical Value = 10." .


###  http://www.iec.ch/TC57/CIM#GovCT1.kdgov
cim:GovCT1.kdgov rdf:type owl:ObjectProperty ;
                 rdfs:domain cim:GovCT1 ;
                 rdfs:range cim:PU ;
                 rdfs:comment "Governor derivative gain (Kdgov).  Typical Value = 0." .


###  http://www.iec.ch/TC57/CIM#GovCT1.kigov
cim:GovCT1.kigov rdf:type owl:ObjectProperty ;
                 rdfs:domain cim:GovCT1 ;
                 rdfs:range cim:PU ;
                 rdfs:comment "Governor integral gain (Kigov).  Typical Value = 2." .


###  http://www.iec.ch/TC57/CIM#GovCT1.kiload
cim:GovCT1.kiload rdf:type owl:ObjectProperty ;
                  rdfs:domain cim:GovCT1 ;
                  rdfs:range cim:PU ;
                  rdfs:comment "Load limiter integral gain for PI controller (Kiload).  Typical Value = 0.67." .


###  http://www.iec.ch/TC57/CIM#GovCT1.kimw
cim:GovCT1.kimw rdf:type owl:ObjectProperty ;
                rdfs:domain cim:GovCT1 ;
                rdfs:range cim:PU ;
                rdfs:comment "Power controller (reset) gain (Kimw).  The default value of 0.01 corresponds to a reset time of 100 seconds.  A value of 0.001 corresponds to a relatively slow acting load controller.  Typical Value = 0.01." .


###  http://www.iec.ch/TC57/CIM#GovCT1.kpgov
cim:GovCT1.kpgov rdf:type owl:ObjectProperty ;
                 rdfs:domain cim:GovCT1 ;
                 rdfs:range cim:PU ;
                 rdfs:comment "Governor proportional gain (Kpgov).  Typical Value = 10." .


###  http://www.iec.ch/TC57/CIM#GovCT1.kpload
cim:GovCT1.kpload rdf:type owl:ObjectProperty ;
                  rdfs:domain cim:GovCT1 ;
                  rdfs:range cim:PU ;
                  rdfs:comment "Load limiter proportional gain for PI controller (Kpload).  Typical Value = 2." .


###  http://www.iec.ch/TC57/CIM#GovCT1.kturb
cim:GovCT1.kturb rdf:type owl:ObjectProperty ;
                 rdfs:domain cim:GovCT1 ;
                 rdfs:range cim:PU ;
                 rdfs:comment "Turbine gain (Kturb) (&gt;0).  Typical Value = 1.5." .


###  http://www.iec.ch/TC57/CIM#GovCT1.ldref
cim:GovCT1.ldref rdf:type owl:ObjectProperty ;
                 rdfs:domain cim:GovCT1 ;
                 rdfs:range cim:PU ;
                 rdfs:comment "Load limiter reference value (Ldref).  Typical Value = 1." .


###  http://www.iec.ch/TC57/CIM#GovCT1.maxerr
cim:GovCT1.maxerr rdf:type owl:ObjectProperty ;
                  rdfs:domain cim:GovCT1 ;
                  rdfs:range cim:PU ;
                  rdfs:comment "Maximum value for speed error signal (maxerr).  Typical Value = 0.05." .


###  http://www.iec.ch/TC57/CIM#GovCT1.minerr
cim:GovCT1.minerr rdf:type owl:ObjectProperty ;
                  rdfs:domain cim:GovCT1 ;
                  rdfs:range cim:PU ;
                  rdfs:comment "Minimum value for speed error signal (minerr).  Typical Value = -0.05." .


###  http://www.iec.ch/TC57/CIM#GovCT1.mwbase
cim:GovCT1.mwbase rdf:type owl:ObjectProperty ;
                  rdfs:domain cim:GovCT1 ;
                  rdfs:range cim:ActivePower ;
                  rdfs:comment "Base for power values (MWbase) (&gt; 0).  Unit = MW." .


###  http://www.iec.ch/TC57/CIM#GovCT1.r
cim:GovCT1.r rdf:type owl:ObjectProperty ;
             rdfs:domain cim:GovCT1 ;
             rdfs:range cim:PU ;
             rdfs:comment "Permanent droop (R).  Typical Value = 0.04." .


###  http://www.iec.ch/TC57/CIM#GovCT1.rdown
cim:GovCT1.rdown rdf:type owl:ObjectProperty ;
                 rdfs:domain cim:GovCT1 ;
                 rdfs:range cim:PU ;
                 rdfs:comment "Maximum rate of load limit decrease (Rdown).  Typical Value = -99." .


###  http://www.iec.ch/TC57/CIM#GovCT1.rselect
cim:GovCT1.rselect rdf:type owl:ObjectProperty ;
                   rdfs:domain cim:GovCT1 ;
                   rdfs:range cim:DroopSignalFeedbackKind ;

                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onDataRange xsd:string
                                                 ] ;
                             rdfs:subClassOf cim:WorkIdentifiedObject ;
                             rdfs:comment "Certain skills are required and must be certified in order for a person (typically a member of a crew) to be qualified to work on types of equipment." .


###  http://www.iec.ch/TC57/CIM#Quality61850
cim:Quality61850 rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Quality61850.source ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Source
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Quality61850.validity ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Validity
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Quality61850.badReference ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:boolean
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Quality61850.estimatorReplaced ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:boolean
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Quality61850.failure ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:boolean
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Quality61850.oldData ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:boolean
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Quality61850.operatorBlocked ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:boolean
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Quality61850.oscillatory ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:boolean
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Quality61850.outOfRange ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:boolean
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Quality61850.overFlow ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:boolean
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Quality61850.suspect ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:boolean
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:Quality61850.test ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:boolean
                                     ] ;
                 rdfs:comment "Quality flags in this class are as defined in IEC 61850, except for estimatorReplaced, which has been included in this class for convenience." .


###  http://www.iec.ch/TC57/CIM#Quantity
cim:Quantity rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Quantity.quantity ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:Decimal
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Quantity.quality ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Quantity.type ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ;
             rdfs:comment """Description of quantities needed in the data exchange. 
The type of the quantity is described either by the role of the association or the type attribute.
The quality attribute provides the information about the quality of the quantity (measured, estimated, etc.).""" .


###  http://www.iec.ch/TC57/CIM#RMRDetermination
cim:RMRDetermination rdf:type owl:Class ;

###  http://www.iec.ch/TC57/CIM#PassThroughBill
cim:PassThroughBill rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.adjustedAmount ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Money
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.amount ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Money
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.price ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Money
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.quantity ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:FloatQuantity
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.taxAmount ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Money
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.billEnd ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.billRunType ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.billStart ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.billedTo ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.effectiveDate ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.isDisputed ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:boolean
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.isProfiled ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:boolean
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.paidTo ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.previousEnd ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.previousStart ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.productCode ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.providedBy ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.serviceEnd ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.serviceStart ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.soldTo ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.timeZone ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.tradeDate ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.transactionDate ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:PassThroughBill.transactionType ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ;
                    rdfs:subClassOf cim:Document ;
                    rdfs:comment """Pass Through Bill is used for:
1)Two sided charge transactions with or without ISO involvement (hence the ?pass thru?)
2) Specific direct charges or payments that are calculated outside or provided directly to settlements
3) Specific charge bill determinants that are externally supplied and used in charge calculations""" .


###  http://www.iec.ch/TC57/CIM#PendingCalculation
cim:PendingCalculation rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:PendingCalculation.multiplyBeforeAdd ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:boolean
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:PendingCalculation.offset ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:nonNegativeInteger
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:PendingCalculation.scalarDenominator ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:nonNegativeInteger
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:PendingCalculation.scalarFloat ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:float
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:PendingCalculation.scalarNumerator ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:nonNegativeInteger
                                           ] ;
                       rdfs:comment "When present, a scalar conversion that needs to be applied to every IntervalReading.value contained in IntervalBlock. This conversion results in a new associated ReadingType, reflecting the true dimensions of IntervalReading values after the conversion." .


###  http://www.iec.ch/TC57/CIM#PenstockLossCurve
cim:PenstockLossCurve rdf:type owl:Class ;
                      rdfs:subClassOf cim:Curve ;
                      rdfs:comment "Relationship between penstock head loss (in meters) and  total discharge through the penstock (in cubic meters per second). One or more turbines may be connected to the same penstock." .


###  http://www.iec.ch/TC57/CIM#PerCent
cim:PerCent rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:PerCent.multiplier ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:UnitMultiplier
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:PerCent.unit ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:UnitSymbol
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:PerCent.value ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:float
                                ] ;
            rdfs:comment "Percentage on a defined base.   For example, specify as 100 to indicate at the defined base." .


###  http://www.iec.ch/TC57/CIM#PerLengthDCLineParameter
cim:PerLengthDCLineParameter rdf:type owl:Class ;
                             owl:equivalentClass [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:PerLengthDCLineParameter.capacitance ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:CapacitancePerLength
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:PerLengthDCLineParameter.inductance ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:InductancePerLength
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:PerLengthDCLineParameter.resistance ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:ResistancePerLength
                                                 ] ;
                             rdfs:subClassOf cim:PerLengthLineParameter .


###  http://www.iec.ch/TC57/CIM#PerLengthImpedance
cim:PerLengthImpedance rdf:type owl:Class ;
                       rdfs:subClassOf cim:PerLengthLineParameter ;
                       rdfs:comment "Common type for per-length impedance electrical catalogues." .


###  http://www.iec.ch/TC57/CIM#PerLengthLineParameter
cim:PerLengthLineParameter rdf:type owl:Class ;
                           rdfs:subClassOf cim:IdentifiedObject ;
                           rdfs:comment "Common type for per-length electrical catalogues describing line parameters." .


###  http://www.iec.ch/TC57/CIM#PerLengthPhaseImpedance
cim:PerLengthPhaseImpedance rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:PerLengthPhaseImpedance.conductorCount ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:nonNegativeInteger
                                                ] ;
                            rdfs:subClassOf cim:PerLengthImpedance ;
                            rdfs:comment "Impedance and admittance parameters per unit length for n-wire unbalanced lines, in matrix form." .


###  http://www.iec.ch/TC57/CIM#PerLengthSequenceImpedance
cim:PerLengthSequenceImpedance rdf:type owl:Class ;
                               owl:equivalentClass [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:PerLengthSequenceImpedance.b0ch ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass cim:SusceptancePerLength
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:PerLengthSequenceImpedance.bch ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass cim:SusceptancePerLength
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:PerLengthSequenceImpedance.g0ch ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass cim:ConductancePerLength
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:PerLengthSequenceImpedance.gch ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass cim:ConductancePerLength
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:PerLengthSequenceImpedance.r ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass cim:ResistancePerLength
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:PerLengthSequenceImpedance.r0 ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass cim:ResistancePerLength
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:PerLengthSequenceImpedance.x ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass cim:ReactancePerLength
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:PerLengthSequenceImpedance.x0 ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass cim:ReactancePerLength
                                                   ] ;
                               rdfs:subClassOf cim:PerLengthImpedance ;
                               rdfs:comment "Sequence impedance and admittance parameters per unit length, for transposed lines of 1, 2, or 3 phases. For 1-phase lines, define x=x0=xself. For 2-phase lines, define x=xs-xm and x0=xs+xm." .


###  http://www.iec.ch/TC57/CIM#Period
cim:Period rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Period.resolution ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:Duration
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Period.timeInterval ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:DateTimeInterval
                               ] ;
           rdfs:comment "An identification of a time interval that may have a given resolution." .


###  http://www.iec.ch/TC57/CIM#Person
cim:Person rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Person.electronicAddress ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:ElectronicAddress
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Person.landlinePhone ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:TelephoneNumber
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Person.mobilePhone ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:TelephoneNumber
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Person.firstName ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Person.lastName ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Person.mName ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Person.prefix ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Person.specialNeed ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Person.suffix ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ;
           rdfs:subClassOf cim:IdentifiedObject ;
           rdfs:comment "General purpose information for name and other information to contact people." .


###  http://www.iec.ch/TC57/CIM#PersonOrganisationRole
cim:PersonOrganisationRole rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:PersonOrganisationRole.clientID ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:string
                                               ] ;
                           rdfs:subClassOf cim:OrganisationRole ;
                           rdfs:comment "Role an organisation plays with respect to persons." .


###  http://www.iec.ch/TC57/CIM#PersonPropertyRole
cim:PersonPropertyRole rdf:type owl:Class ;
                       rdfs:subClassOf cim:Role ;
                       rdfs:comment "The role of a person relative to a given piece of property. Examples of roles include: owner, renter, contractor, etc." .


###  http://www.iec.ch/TC57/CIM#PersonRole
cim:PersonRole rdf:type owl:Class ;
               rdfs:subClassOf cim:IdentifiedObject .


###  http://www.iec.ch/TC57/CIM#PetersenCoil
cim:PetersenCoil rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:PetersenCoil.mode ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:PetersenCoilModeKind
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:PetersenCoil.nominalU ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Voltage
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:PetersenCoil.offsetCurrent ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:CurrentFlow
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:PetersenCoil.positionCurrent ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:CurrentFlow
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:PetersenCoil.xGroundMax ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Reactance
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:PetersenCoil.xGroundMin ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Reactance
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:PetersenCoil.xGroundNominal ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Reactance
                                     ] ;
                 rdfs:subClassOf cim:EarthFaultCompensator ;
                 rdfs:comment "A tunable impedance device normally used to offset line charging during single line faults in an ungrounded section of network." .


###  http://www.iec.ch/TC57/CIM#PetersenCoilModeKind
cim:PetersenCoilModeKind rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Class ;
                                               owl:oneOf ( cim:automaticPositioning
                                                           cim:fixed
                                                           cim:manual
                                                         )
                                             ] .


###  http://www.iec.ch/TC57/CIM#PhaseCode
cim:PhaseCode rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Class ;
                                    owl:oneOf ( cim:A
                                                cim:AB
                                                cim:ABC
                                                cim:ABCN
                                                cim:ABN
                                                cim:AC
                                                cim:ACN
                                                cim:AN
                                                cim:B
                                                cim:BC
                                                cim:BCN
                                                cim:BN
                                                cim:C
                                                cim:CN
                                                cim:N
                                                cim:X
                                                cim:XN
                                                cim:XY
                                                cim:XYN
                                                cim:none
                                                cim:s1
                                                cim:s12
                                                cim:s12N
                                                cim:s1N
                                                cim:s2
                                                cim:s2N
                                              )
                                  ] .


###  http://www.iec.ch/TC57/CIM#PhaseConnectedFaultKind
cim:PhaseConnectedFaultKind rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Class ;
                                                  owl:oneOf ( cim:lineToGround
                                                              cim:lineToLine
                                                              cim:lineToLineToGround
                                                            )
                                                ] .


###  http://www.iec.ch/TC57/CIM#PhaseImpedanceData
cim:PhaseImpedanceData rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:PhaseImpedanceData.b ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:SusceptancePerLength
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:PhaseImpedanceData.r ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:ResistancePerLength
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:PhaseImpedanceData.x ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:ReactancePerLength
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:PhaseImpedanceData.sequenceNumber ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:nonNegativeInteger
                                           ] ;
                       rdfs:comment "Triplet of resistance, reactance, and susceptance matrix element values." .


###  http://www.iec.ch/TC57/CIM#PhaseShuntConnectionKind
cim:PhaseShuntConnectionKind rdf:type owl:Class ;
                             owl:equivalentClass [ rdf:type owl:Class ;
                                                   owl:oneOf ( cim:D
                                                               cim:G
                                                               cim:I
                                                               cim:Y
                                                               cim:Yn
                                                             )
                                                 ] .


###  http://www.iec.ch/TC57/CIM#PhaseTapChanger
cim:PhaseTapChanger rdf:type owl:Class ;
                    rdfs:subClassOf cim:TapChanger ;
                    rdfs:comment "A transformer phase shifting tap model that controls the phase angle difference across the power transformer and potentially the active power flow through the power transformer.  This phase tap model may also impact the voltage magnitude." .


###  http://www.iec.ch/TC57/CIM#PhaseTapChangerAsymmetrical
cim:PhaseTapChangerAsymmetrical rdf:type owl:Class ;
                                owl:equivalentClass [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:PhaseTapChangerAsymmetrical.windingConnectionAngle ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onClass cim:AngleDegrees
                                                    ] ;
                                rdfs:subClassOf cim:PhaseTapChangerNonLinear ;
                                rdfs:comment "Describes the tap model for an asymmetrical phase shifting transformer in which the difference voltage vector adds to the primary side voltage. The angle between the primary side voltage and the difference voltage is named the winding connection angle. The phase shift depends on both the difference voltage magnitude and the winding connection angle." .


###  http://www.iec.ch/TC57/CIM#PhaseTapChangerLinear
cim:PhaseTapChangerLinear rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:PhaseTapChangerLinear.stepPhaseShiftIncrement ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:AngleDegrees
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:PhaseTapChangerLinear.xMax ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:Reactance
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:PhaseTapChangerLinear.xMin ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:Reactance
                                              ] ;
                          rdfs:subClassOf cim:PhaseTapChanger ;
                          rdfs:comment """Describes a tap changer with a linear relation between the tap step and the phase angle difference across the transformer. This is a mathematical model that is an approximation of a real phase tap changer.
The phase angle is computed as stepPhaseShitfIncrement times the tap position.
The secondary side voltage magnitude is the same as at the primary side.""" .


###  http://www.iec.ch/TC57/CIM#PhaseTapChangerNonLinear
cim:PhaseTapChangerNonLinear rdf:type owl:Class ;
                             owl:equivalentClass [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:PhaseTapChangerNonLinear.voltageStepIncrement ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:PerCent
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:PhaseTapChangerNonLinear.xMax ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:Reactance
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:PhaseTapChangerNonLinear.xMin ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:Reactance
                                                 ] ;
                             rdfs:subClassOf cim:PhaseTapChanger ;
                             rdfs:comment "The non-linear phase tap changer describes the non-linear behavior of a phase tap changer. This is a base class for the symmetrical and asymmetrical phase tap changer models. The details of these models can be found in the IEC 61970-301 document." .


###  http://www.iec.ch/TC57/CIM#PhaseTapChangerSymmetrical
cim:PhaseTapChangerSymmetrical rdf:type owl:Class ;
                               rdfs:subClassOf cim:PhaseTapChangerNonLinear ;
                               rdfs:comment "Describes a symmetrical phase shifting transformer tap model in which the secondary side voltage magnitude is the same as at the primary side. The difference voltage magnitude is the base in an equal-sided triangle where the sides corresponds to the primary and secondary voltages. The phase angle difference corresponds to the top angle and can be expressed as twice the arctangent of half the total difference voltage." .


###  http://www.iec.ch/TC57/CIM#PhaseTapChangerTable
cim:PhaseTapChangerTable rdf:type owl:Class ;
                         rdfs:subClassOf cim:IdentifiedObject ;
                         rdfs:comment "Describes a tabular curve for how the phase angle difference and impedance varies with the tap step." .


###  http://www.iec.ch/TC57/CIM#PhaseTapChangerTablePoint
cim:PhaseTapChangerTablePoint rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Restriction ;
                                                    owl:onProperty cim:PhaseTapChangerTablePoint.angle ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onClass cim:AngleDegrees
                                                  ] ;
                              rdfs:subClassOf cim:TapChangerTablePoint ;
                              rdfs:comment "Describes each tap step in the phase tap changer tabular curve." .


###  http://www.iec.ch/TC57/CIM#PhaseTapChangerTabular
cim:PhaseTapChangerTabular rdf:type owl:Class ;
                           rdfs:subClassOf cim:PhaseTapChanger .


###  http://www.iec.ch/TC57/CIM#PinBranchGroup
cim:PinBranchGroup rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:PinBranchGroup.kind ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:PinBranchGroupKind
                                       ] ;
                   rdfs:subClassOf cim:GateInputPin ;
                   rdfs:comment "Value associated with branch group is used as compare." .


###  http://www.iec.ch/TC57/CIM#PinBranchGroupKind
cim:PinBranchGroupKind rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Class ;
                                             owl:oneOf ( cim:activePower
                                                         cim:reactivePower
                                                       )
                                           ] .


###  http://www.iec.ch/TC57/CIM#PinEquipment
cim:PinEquipment rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:PinEquipment.kind ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:PinEquipmentKind
                                     ] ;
                 rdfs:subClassOf cim:GateInputPin ;
                 rdfs:comment "Value associated with Equipment is used as compare." .


###  http://www.iec.ch/TC57/CIM#PinEquipmentKind
cim:PinEquipmentKind rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:oneOf ( cim:activePowerLimit
                                                       cim:apparentPowerLimit
                                                       cim:connected
                                                       cim:currentLimit
                                                       cim:inService
                                                       cim:ratedCurrent
                                                       cim:voltageLimit
                                                     )
                                         ] .


###  http://www.iec.ch/TC57/CIM#PinGate
cim:PinGate rdf:type owl:Class ;
            rdfs:subClassOf cim:GateInputPin ;
            rdfs:comment "An output from one gate represent an input to another gate." .


###  http://www.iec.ch/TC57/CIM#PinMeasurement
cim:PinMeasurement rdf:type owl:Class ;
                   rdfs:subClassOf cim:GateInputPin ;
                   rdfs:comment "Gate input pin that is associated with a Measurement or a calculation of Measurement." .


###  http://www.iec.ch/TC57/CIM#PinTerminal
cim:PinTerminal rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:PinTerminal.kind ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:PinTerminalKind
                                    ] ;
                rdfs:subClassOf cim:GateInputPin ;
                rdfs:comment "Value associated with Terminal is used as compare." .


###  http://www.iec.ch/TC57/CIM#PinTerminalKind
cim:PinTerminalKind rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:oneOf ( cim:activePower
                                                      cim:apparentPower
                                                      cim:reactivePower
                                                      cim:voltage
                                                    )
                                        ] .


###  http://www.iec.ch/TC57/CIM#PlannedMarket
cim:PlannedMarket rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:PlannedMarket.marketType ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:MarketType
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:PlannedMarket.marketEndTime ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTime
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:PlannedMarket.marketStartTime ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTime
                                      ] ;
                  rdfs:comment "Represent a planned market. For example an planned DA/HA/RT market." .


###  http://www.iec.ch/TC57/CIM#PlannedMarketEvent
cim:PlannedMarketEvent rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:PlannedMarketEvent.eventType ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:PlannedMarketEvent.plannedTime ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:nonNegativeInteger
                                           ] ;
                       rdfs:subClassOf cim:IdentifiedObject ;
                       rdfs:comment "This class represents planned events. Used to model the various planned events in a market (closing time, clearing time, etc)." .


###  http://www.iec.ch/TC57/CIM#Plant
cim:Plant rdf:type owl:Class ;
          rdfs:subClassOf cim:EquipmentContainer ;
          rdfs:comment "A Plant is a collection of equipment for purposes of generation." .


###  http://www.iec.ch/TC57/CIM#Pnode
cim:Pnode rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Pnode.endEffectiveDate ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:dateTime
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Pnode.isPublic ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:boolean
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Pnode.startEffectiveDate ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:dateTime
                              ] ;
          rdfs:subClassOf cim:IdentifiedObject ;
          rdfs:comment "A pricing node is directly associated with a connectivity node.  It is a pricing location for which market participants submit their bids, offers, buy/sell CRRs, and settle." .


###  http://www.iec.ch/TC57/CIM#PnodeClearing
cim:PnodeClearing rdf:type owl:Class ;
                  rdfs:subClassOf cim:MarketFactors ;
                  rdfs:comment "Pricing node clearing results posted for a given settlement period." .


###  http://www.iec.ch/TC57/CIM#PnodeDistributionFactor
cim:PnodeDistributionFactor rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:PnodeDistributionFactor.offPeak ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass cim:YesNo
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:PnodeDistributionFactor.onPeak ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass cim:YesNo
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:PnodeDistributionFactor.factor ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:float
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:PnodeDistributionFactor.podLossFactor ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:float
                                                ] ;
                            rdfs:comment "This class allows SC to input different distribution factors for pricing node" .


###  http://www.iec.ch/TC57/CIM#PnodeResults
cim:PnodeResults rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:PnodeResults.updateType ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:MQSCHGType
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:PnodeResults.congestLMP ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:float
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:PnodeResults.costLMP ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:float
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:PnodeResults.lossLMP ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:float
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:PnodeResults.marginalClearingPrice ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:float
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:PnodeResults.scheduledMW ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:float
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:PnodeResults.updateTimeStamp ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:dateTime
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:PnodeResults.updateUser ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ;
                 rdfs:comment "Provides the total price, the cost component, the loss component, and the congestion component for Pnodes for the forward and real time markets. There are several prices produced based on the run type (MPM, RUC, Pricing, or Scheduling/Dispatch)." .


###  http://www.iec.ch/TC57/CIM#Point
cim:Point rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Point.quantity ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:Decimal
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Point.secondaryQuantity ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:Decimal
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Point.position ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:nonNegativeInteger
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Point.quality ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:string
                              ] ;
          rdfs:comment "An identification of a set of values beeing adressed within a specific interval of time." .


###  http://www.iec.ch/TC57/CIM#PointOfSale
cim:PointOfSale rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:PointOfSale.location ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ;
                rdfs:subClassOf cim:IdentifiedObject ;
                rdfs:comment "Logical point where transactions take place with operational interaction between cashier and the payment system; in certain cases the point of sale interacts directly with the end customer, in which case the cashier might not be a real person: for example a self-service kiosk or over the internet." .


###  http://www.iec.ch/TC57/CIM#Pole
cim:Pole rdf:type owl:Class ;
         owl:equivalentClass [ rdf:type owl:Restriction ;
                               owl:onProperty cim:Pole.baseKind ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass cim:PoleBaseKind
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty cim:Pole.diameter ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass cim:Length
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty cim:Pole.length ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass cim:Length
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty cim:Pole.preservativeKind ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass cim:PolePreservativeKind
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty cim:Pole.treatmentKind ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onClass cim:PoleTreatmentKind
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty cim:Pole.breastBlock ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:boolean
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty cim:Pole.classification ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty cim:Pole.construction ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty cim:Pole.jpaReference ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty cim:Pole.speciesType ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty cim:Pole.treatedDateTime ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:dateTime
                             ] ;
         rdfs:subClassOf cim:Structure ;
         rdfs:comment "Pole asset." .


###  http://www.iec.ch/TC57/CIM#PoleBaseKind
cim:PoleBaseKind rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:oneOf ( cim:asphalt
                                                   cim:cement
                                                   cim:dirt
                                                   cim:other
                                                   cim:unknown
                                                 )
                                     ] .


###  http://www.iec.ch/TC57/CIM#PolePreservativeKind
cim:PolePreservativeKind rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Class ;
                                               owl:oneOf ( cim:cellon
                                                           cim:chemonite
                                                           cim:creosote
                                                           cim:naphthena
                                                           cim:other
                                                           cim:penta
                                                           cim:unknown
                                                         )
                                             ] .


###  http://www.iec.ch/TC57/CIM#PoleTreatmentKind
cim:PoleTreatmentKind rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Class ;
                                            owl:oneOf ( cim:butt
                                                        cim:full
                                                        cim:grayStain
                                                        cim:greenStain
                                                        cim:natural
                                                        cim:other
                                                        cim:penta
                                                        cim:unknown
                                                      )
                                          ] .


###  http://www.iec.ch/TC57/CIM#PositionPoint
cim:PositionPoint rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:PositionPoint.groupNumber ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:PositionPoint.sequenceNumber ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:PositionPoint.xPosition ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:PositionPoint.yPosition ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:PositionPoint.zPosition ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ;
                  rdfs:comment "Set of spatial coordinates that determine a point, defined in the coordinate system specified in 'Location.CoordinateSystem'. Use a single position point instance to desribe a point-oriented location. Use a sequence of position points to describe a line-oriented object (physical location of non-point oriented objects like cables or lines), or area of an object (like a substation or a geographical zone - in this case, have first and last position point with the same values)." .


###  http://www.iec.ch/TC57/CIM#PostLineSensor
cim:PostLineSensor rdf:type owl:Class ;
                   rdfs:subClassOf cim:Sensor ;
                   rdfs:comment "A sensor used mainly in overhead distribution networks as the source of both current and voltage measurements." .


###  http://www.iec.ch/TC57/CIM#PotentialTransformer
cim:PotentialTransformer rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:PotentialTransformer.type ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:PotentialTransformerKind
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:PotentialTransformer.accuracyClass ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:PotentialTransformer.nominalRatio ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:PotentialTransformer.ptClass ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:string
                                             ] ;
                         rdfs:subClassOf cim:Sensor ;
                         rdfs:comment "Instrument transformer (also known as Voltage Transformer) used to measure electrical qualities of the circuit that is being protected and/or monitored. Typically used as voltage transducer for the purpose of metering, protection, or sometimes auxiliary substation supply. A typical secondary voltage rating would be 120V." .


###  http://www.iec.ch/TC57/CIM#PotentialTransformerInfo
cim:PotentialTransformerInfo rdf:type owl:Class ;
                             owl:equivalentClass [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:PotentialTransformerInfo.nominalRatio ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:Ratio
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:PotentialTransformerInfo.primaryRatio ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:Ratio
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:PotentialTransformerInfo.ratedVoltage ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:Voltage
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:PotentialTransformerInfo.secondaryRatio ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:Ratio
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:PotentialTransformerInfo.tertiaryRatio ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:Ratio
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:PotentialTransformerInfo.accuracyClass ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onDataRange xsd:string
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:PotentialTransformerInfo.ptClass ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onDataRange xsd:string
                                                 ] ;
                             rdfs:subClassOf cim:AssetInfo ;
                             rdfs:comment "Properties of potential transformer asset." .


###  http://www.iec.ch/TC57/CIM#PotentialTransformerKind
cim:PotentialTransformerKind rdf:type owl:Class ;
                             owl:equivalentClass [ rdf:type owl:Class ;
                                                   owl:oneOf ( cim:capacitiveCoupling
                                                               cim:inductive
                                                             )
                                                 ] .


###  http://www.iec.ch/TC57/CIM#PowerCutZone
cim:PowerCutZone rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:PowerCutZone.cutLevel1 ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:PerCent
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:PowerCutZone.cutLevel2 ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:PerCent
                                     ] ;
                 rdfs:subClassOf cim:PowerSystemResource ;
                 rdfs:comment "An area or zone of the power system which is used for load shedding purposes." .


###  http://www.iec.ch/TC57/CIM#PowerQualityPricing
cim:PowerQualityPricing rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:PowerQualityPricing.emergencyHighVoltLimit ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Voltage
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:PowerQualityPricing.emergencyLowVoltLimit ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Voltage
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:PowerQualityPricing.normalHighVoltLimit ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Voltage
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:PowerQualityPricing.normalLowVoltLimit ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Voltage
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:PowerQualityPricing.valueUninterruptedServiceEnergy ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:CostPerEnergyUnit
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:PowerQualityPricing.powerFactorMin ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:PowerQualityPricing.valueUninterruptedServiceP ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:PowerQualityPricing.voltImbalanceViolCost ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:PowerQualityPricing.voltLimitViolCost ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ;
                        rdfs:subClassOf cim:Document ;
                        rdfs:comment "Pricing can be based on power quality." .


###  http://www.iec.ch/TC57/CIM#PowerSystemProject
cim:PowerSystemProject rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:PowerSystemProject.actualLifecycle ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:PowerSystemProjectLifecycle
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:PowerSystemProject.plannedLifecycle ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:PowerSystemProjectLifecycle
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:PowerSystemProject.comment ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:PowerSystemProject.priority ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:nonNegativeInteger
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:PowerSystemProject.type ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:PowerSystemProject.version ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:nonNegativeInteger
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:PowerSystemProject.versionUUID ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ;
                       rdfs:subClassOf cim:IdentifiedObject ;
                       rdfs:comment "Meta-data for the change set that describe the status and the planned implementation of the changes into the as-build model. A Power System Project can consist of other Power System Projects" .


###  http://www.iec.ch/TC57/CIM#PowerSystemProjectLifecycle
cim:PowerSystemProjectLifecycle rdf:type owl:Class ;
                                owl:equivalentClass [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:PowerSystemProjectLifecycle.cancelled ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:date
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:PowerSystemProjectLifecycle.commissioned ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:date
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:PowerSystemProjectLifecycle.committed ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:date
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:PowerSystemProjectLifecycle.inBuild ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:date
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:PowerSystemProjectLifecycle.inPlan ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:date
                                                    ] ;
                                rdfs:comment "Represent the base lifecycle of a functional model change that could be a construction of new elements." .


###  http://www.iec.ch/TC57/CIM#PowerSystemResource
cim:PowerSystemResource rdf:type owl:Class ;
                        rdfs:subClassOf cim:IdentifiedObject ;
                        rdfs:comment "A power system resource can be an item of equipment such as a switch, an equipment container containing many individual items of equipment such as a substation, or an organisational entity such as sub-control area. Power system resources can have measurements associated." .


###  http://www.iec.ch/TC57/CIM#PowerSystemStabilizerDynamics
cim:PowerSystemStabilizerDynamics rdf:type owl:Class ;
                                  rdfs:subClassOf cim:DynamicsFunctionBlock ;
                                  rdfs:comment "Power system stabilizer function block whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>" .


###  http://www.iec.ch/TC57/CIM#PowerSystemStabilizerUserDefined
cim:PowerSystemStabilizerUserDefined rdf:type owl:Class ;
                                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                                           owl:onProperty cim:PowerSystemStabilizerUserDefined.proprietary ;
                                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                           owl:onDataRange xsd:boolean
                                                         ] ;
                                     rdfs:subClassOf cim:PowerSystemStabilizerDynamics ;
                                     rdfs:comment "<font color=\"#0f0f0f\">Power system stabilizer</font> function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" .


###  http://www.iec.ch/TC57/CIM#PowerTransformer
cim:PowerTransformer rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:PowerTransformer.beforeShCircuitHighestOperatingCurrent ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:CurrentFlow
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:PowerTransformer.beforeShCircuitHighestOperatingVoltage ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Voltage
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:PowerTransformer.beforeShortCircuitAnglePf ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:AngleDegrees
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:PowerTransformer.highSideMinOperatingU ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Voltage
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:PowerTransformer.isPartOfGeneratorUnit ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:boolean
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:PowerTransformer.operationalValuesConsidered ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:boolean
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:PowerTransformer.vectorGroup ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:string
                                         ] ;
                     rdfs:subClassOf cim:ConductingEquipment ;
                     rdfs:comment """An electrical device consisting of  two or more coupled windings, with or without a magnetic core, for introducing mutual coupling between electric circuits. Transformers can be used to control voltage and phase shift (active power flow).
A power transformer may be composed of separate transformer tanks that need not be identical.
A power transformer can be modeled with or without tanks and is intended for use in both balanced and unbalanced representations.   A power transformer typically has two terminals, but may have one (grounding), three or more terminals.
The inherited association ConductingEquipment.BaseVoltage should not be used.  The association from TransformerEnd to BaseVoltage should be used instead.""" .


###  http://www.iec.ch/TC57/CIM#PowerTransformerEnd
cim:PowerTransformerEnd rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:PowerTransformerEnd.b ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Susceptance
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:PowerTransformerEnd.b0 ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Susceptance
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:PowerTransformerEnd.connectionKind ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:WindingConnection
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:PowerTransformerEnd.g ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Conductance
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:PowerTransformerEnd.g0 ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Conductance
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:PowerTransformerEnd.r ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Resistance
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:PowerTransformerEnd.r0 ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Resistance
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:PowerTransformerEnd.ratedS ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:ApparentPower
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:PowerTransformerEnd.ratedU ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Voltage
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:PowerTransformerEnd.x ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Reactance
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:PowerTransformerEnd.x0 ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Reactance
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:PowerTransformerEnd.phaseAngleClock ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:nonNegativeInteger
                                            ] ;
                        rdfs:subClassOf cim:TransformerEnd ;
                        rdfs:comment """A PowerTransformerEnd is associated with each Terminal of a PowerTransformer.
The impedance values r, r0, x, and x0 of a PowerTransformerEnd represents a star equivalent as follows
1) for a two Terminal PowerTransformer the high voltage PowerTransformerEnd has non zero values on r, r0, x, and x0 while the low voltage PowerTransformerEnd has zero values for r, r0, x, and x0.
2) for a three Terminal PowerTransformer the three PowerTransformerEnds represents a star equivalent with each leg in the star represented by r, r0, x, and x0 values.
3) for a PowerTransformer with more than three Terminals the PowerTransformerEnd impedance values cannot be used. Instead use the TransformerMeshImpedance or split the transformer into multiple PowerTransformers.""" .


###  http://www.iec.ch/TC57/CIM#PowerTransformerInfo
cim:PowerTransformerInfo rdf:type owl:Class ;
                         rdfs:subClassOf cim:AssetInfo ;
                         rdfs:comment "Set of power transformer data, from an equipment library." .



                                                owl:onClass cim:YesNo
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ResourceCertification.certifiedNonspinDAM ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:YesNo
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ResourceCertification.certifiedNonspinRTM ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:YesNo
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ResourceCertification.certifiedPIRP ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:YesNo
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ResourceCertification.certifiedRTM ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:YesNo
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ResourceCertification.certifiedRUC ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:YesNo
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ResourceCertification.certifiedRegulation ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:YesNo
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ResourceCertification.certifiedReplaceAS ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:YesNo
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ResourceCertification.certifiedSpin ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:YesNo
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ResourceCertification.certifiedNonspinDAMMw ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:float
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ResourceCertification.certifiedNonspinRTMMw ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:float
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ResourceCertification.certifiedRegulationMw ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:float
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ResourceCertification.certifiedSpinMw ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:float
                                              ] ;
                          rdfs:comment "This class represent the resource certification for a specific product type. For example, a resource is certified for Non-Spinning reserve for RTM." .


###  http://www.iec.ch/TC57/CIM#ResourceCertificationCategory
cim:ResourceCertificationCategory rdf:type owl:Class ;

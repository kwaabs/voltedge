###  http://www.iec.ch/TC57/CIM#Shift
cim:Shift rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Shift.activityInterval ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:DateTimeInterval
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Shift.receiptsGrandTotalBankable ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:Money
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Shift.receiptsGrandTotalNonBankable ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:Money
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Shift.receiptsGrandTotalRounding ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:Money
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Shift.transactionsGrandTotal ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:Money
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Shift.transactionsGrandTotalRounding ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:Money
                              ] ;
          rdfs:subClassOf cim:IdentifiedObject ;
          rdfs:comment """Generally referring to a period of operation or work performed. Whether the shift is open/closed can be derived from attributes 'activityInterval.start' and 'activityInterval.end'.
The grand total for receipts (i.e., cumulative total of all actual receipted amounts during this shift; bankable + non-bankable; excludes rounding error totals) can be derived from receipt:
=sum('Receipt.receiptAmount'); includes bankable and non-bankable receipts.
It also has to be reconciled against:
=sum('receiptsGrandTotalBankable' + 'receiptsGrandTotalNonBankable')
and against receipt summary:
=sum('ReceiptSummary.receiptsTotal').
The attributes with \"GrandTotal\" defined in this class may need to be used when the source data is periodically flushed from the system and then these cannot be derived.""" .


###  http://www.iec.ch/TC57/CIM#ShiftPattern
cim:ShiftPattern rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:ShiftPattern.status ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Status
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:ShiftPattern.validityInterval ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:DateTimeInterval
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:ShiftPattern.assignmentType ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:ShiftPattern.cycleCount ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:nonNegativeInteger
                                     ] ;
                 rdfs:subClassOf cim:WorkIdentifiedObject ;
                 rdfs:comment "The patterns of shifts worked by people or crews." .



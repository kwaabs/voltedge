cim:CRRMarket rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:CRRMarket.labelID ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:string
                                  ] ;
              rdfs:subClassOf cim:Market ;
              rdfs:comment "Model that describes the Congestion Revenue Rights Auction Market" .


###  http://www.iec.ch/TC57/CIM#CRROrgRole
cim:CRROrgRole rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;

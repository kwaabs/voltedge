###  http://www.iec.ch/TC57/CIM#PumpingCostSchedule
cim:PumpingCostSchedule rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:PumpingCostSchedule.value ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ;
                        rdfs:subClassOf cim:BidHourlyProductSchedule ;
                        rdfs:comment """The operating cost of a Pump Storage Hydro Unit operating as a hydro pump.

This schedule is assocated with the hourly parameters in a resource bid associated with a specific product within the bid.""" .


###  http://www.iec.ch/TC57/CIM#PumpingLevelSchedule
cim:PumpingLevelSchedule rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:PumpingLevelSchedule.value ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ;
                         rdfs:subClassOf cim:BidHourlyProductSchedule ;
                         rdfs:comment """The fixed operating level of a Pump Storage Hydro Unit operating as a hydro pump. Associated with the energy market product type.

This schedule is assocated with the hourly parameters in a resource bid associated with a specific product within the bid.""" .


###  http://www.iec.ch/TC57/CIM#PumpingShutDownCostSchedule
cim:PumpingShutDownCostSchedule rdf:type owl:Class ;
                                owl:equivalentClass [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:PumpingShutDownCostSchedule.value ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:float
                                                    ] ;
                                rdfs:subClassOf cim:BidHourlyProductSchedule ;
                                rdfs:comment """The cost to shutdown a Pump Storage Hydro Unit (in pump mode) or a pump.

This schedule is assocated with the hourly parameters in a resource bid associated with a specific product within the bid.""" .



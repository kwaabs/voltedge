                                                      cim:svc
                                                      cim:tcpar
                                                      cim:tcsc
                                                      cim:tcvl
                                                      cim:tsbr
                                                      cim:tssc
                                                      cim:upfc
                                                    )
                                        ] .


###  http://www.iec.ch/TC57/CIM#FTR
cim:FTR rdf:type owl:Class ;
        owl:equivalentClass [ rdf:type owl:Restriction ;
                              owl:onProperty cim:FTR.baseEnergy ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass cim:ActivePower
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty cim:FTR.action ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onDataRange xsd:string
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty cim:FTR.class ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onDataRange xsd:string
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty cim:FTR.ftrType ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onDataRange xsd:string
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty cim:FTR.optimized ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onDataRange xsd:string
                            ] ;
        rdfs:subClassOf cim:Agreement ;
        rdfs:comment "Financial Transmission Rights (FTR) regarding transmission capacity at a flowgate." .


###  http://www.iec.ch/TC57/CIM#Facility
cim:Facility rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Facility.kind ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ;
             rdfs:subClassOf cim:AssetContainer ;
             rdfs:comment "A facility may contain buildings, storage facilities, switching facilities, power generation, manufacturing facilities, maintenance facilities, etc." .


###  http://www.iec.ch/TC57/CIM#FailureEvent
cim:FailureEvent rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:FailureEvent.failureIsolationMethod ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:FailureIsolationMethodKind
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:FailureEvent.corporateCode ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:FailureEvent.faultLocatingMethod ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:FailureEvent.location ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ;
                 rdfs:subClassOf cim:ActivityRecord ;
                 rdfs:comment "An event where an asset has failed to perform its functions within specified parameters." .


###  http://www.iec.ch/TC57/CIM#FailureIsolationMethodKind
cim:FailureIsolationMethodKind rdf:type owl:Class ;
                               owl:equivalentClass [ rdf:type owl:Class ;
                                                     owl:oneOf ( cim:breakerOperation
                                                                 cim:burnedInTheClear
                                                                 cim:fuse
                                                                 cim:manuallyIsolated
                                                                 cim:other
                                                               )
                                                   ] .


###  http://www.iec.ch/TC57/CIM#Fault
cim:Fault rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Fault.impedance ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:FaultImpedance
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Fault.kind ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:PhaseConnectedFaultKind
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Fault.phases ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:PhaseCode
                              ] ;
          rdfs:subClassOf cim:IdentifiedObject ;
          rdfs:comment "Abnormal condition causing current flow through conducting equipment, such as caused by equipment failure or short circuits from objects not typically modeled (for example, a tree falling on a line)." .


###  http://www.iec.ch/TC57/CIM#FaultCauseType
cim:FaultCauseType rdf:type owl:Class ;
                   rdfs:subClassOf cim:IdentifiedObject ;
                   rdfs:comment "Type of cause of the fault." .


###  http://www.iec.ch/TC57/CIM#FaultImpedance
cim:FaultImpedance rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:FaultImpedance.rGround ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Resistance
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:FaultImpedance.rLineToLine ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Resistance
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:FaultImpedance.xGround ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Reactance
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:FaultImpedance.xLineToLine ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Reactance
                                       ] ;
                   rdfs:comment "Impedance description for the fault." .


###  http://www.iec.ch/TC57/CIM#FaultIndicator
cim:FaultIndicator rdf:type owl:Class ;
                   rdfs:subClassOf cim:AuxiliaryEquipment ;
                   rdfs:comment "A FaultIndicator is typically only an indicator (which may or may not be remotely monitored), and not a piece of equipment that actually initiates a protection event. It is used for FLISR (Fault Location, Isolation and Restoration) purposes, assisting with the dispatch of crews to \"most likely\" part of the network (i.e. assists with determining circuit section where the fault most likely happened)." .


###  http://www.iec.ch/TC57/CIM#FaultIndicatorInfo
cim:FaultIndicatorInfo rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:FaultIndicatorInfo.resetKind ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:FaultIndicatorResetKind
                                           ] ;
                       rdfs:subClassOf cim:AssetInfo ;
                       rdfs:comment "Parameters of fault indicator asset." .


###  http://www.iec.ch/TC57/CIM#FaultIndicatorResetKind
cim:FaultIndicatorResetKind rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Class ;
                                                  owl:oneOf ( cim:automatic
                                                              cim:manual
                                                              cim:other
                                                              cim:remote
                                                            )
                                                ] .


###  http://www.iec.ch/TC57/CIM#FieldSafetySupervisor
cim:FieldSafetySupervisor rdf:type owl:Class ;
                          rdfs:subClassOf cim:CrewMember ;
                          rdfs:comment "Crew member on work site responsible for all local safety measures for the work crew doing maintenance, construction and repair in a substation or on a power line/cable." .


###  http://www.iec.ch/TC57/CIM#FinancialInfo
cim:FinancialInfo rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:FinancialInfo.actualPurchaseCost ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Money
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:FinancialInfo.financialValue ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Money
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:FinancialInfo.quantity ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:IntegerQuantity
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:FinancialInfo.account ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:FinancialInfo.costDescription ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:FinancialInfo.costType ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:FinancialInfo.plantTransferDateTime ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTime
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:FinancialInfo.purchaseDateTime ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTime
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:FinancialInfo.purchaseOrderNumber ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:FinancialInfo.valueDateTime ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTime
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:FinancialInfo.warrantyEndDateTime ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTime
                                      ] ;
                  rdfs:subClassOf cim:IdentifiedObject ;
                  rdfs:comment "Various current financial properties associated with a particular asset. Historical properties may be determined by ActivityRecords associated with the asset." .


###  http://www.iec.ch/TC57/CIM#FiveMinAuxiliaryData
cim:FiveMinAuxiliaryData rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:FiveMinAuxiliaryData.intervalStartTime ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:dateTime
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:FiveMinAuxiliaryData.updateTimeStamp ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:dateTime
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:FiveMinAuxiliaryData.updateUser ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:string
                                             ] ;
                         rdfs:comment "Models 5-Minutes Auxillary Data" .


###  http://www.iec.ch/TC57/CIM#FlagTypeRMR
cim:FlagTypeRMR rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Class ;
                                      owl:oneOf ( cim:N
                                                  <http://www.iec.ch/TC57/CIM#1>
                                                  <http://www.iec.ch/TC57/CIM#2>
                                                )
                                    ] .


###  http://www.iec.ch/TC57/CIM#FloatQuantity
cim:FloatQuantity rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:FloatQuantity.multiplier ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:UnitMultiplier
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:FloatQuantity.unit ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:UnitSymbol
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:FloatQuantity.value ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ;
                  rdfs:comment "Quantity with float value and associated unit information." .


###  http://www.iec.ch/TC57/CIM#FlowDirection
cim:FlowDirection rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:FlowDirection.direction ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ;
                  rdfs:comment "The coded identification of the direction of energy flow." .


###  http://www.iec.ch/TC57/CIM#FlowDirectionKind
cim:FlowDirectionKind rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Class ;
                                            owl:oneOf ( cim:forward
                                                        cim:lagging
                                                        cim:leading
                                                        cim:net
                                                        cim:none
                                                        cim:q1minusQ4
                                                        cim:q1plusQ2
                                                        cim:q1plusQ3
                                                        cim:q1plusQ4
                                                        cim:q2minusQ3
                                                        cim:q2plusQ3
                                                        cim:q2plusQ4
                                                        cim:q3minusQ2
                                                        cim:q3plusQ4
                                                        cim:quadrant1
                                                        cim:quadrant2
                                                        cim:quadrant3
                                                        cim:quadrant4
                                                        cim:reverse
                                                        cim:total
                                                        cim:totalByPhase
                                                      )
                                          ] .


###  http://www.iec.ch/TC57/CIM#FlowDirectionType
cim:FlowDirectionType rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Class ;
                                            owl:oneOf ( cim:Forward
                                                        cim:Reverse
                                                      )
                                          ] .


###  http://www.iec.ch/TC57/CIM#FlowSensor
cim:FlowSensor rdf:type owl:Class ;
               rdfs:subClassOf cim:ConductingEquipment ;
               rdfs:comment "Represents a two terminal and power conducting device of negligible impedance that senses flow through the device." .


###  http://www.iec.ch/TC57/CIM#Flowgate
cim:Flowgate rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Flowgate.direction ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:InterTieDirection
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Flowgate.exportMWRating ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:ActivePower
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Flowgate.importMWRating ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:ActivePower
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Flowgate.endEffectiveDate ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:dateTime
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:Flowgate.startEffectiveDate ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:dateTime
                                 ] ;
             rdfs:subClassOf cim:PowerSystemResource ;
             rdfs:comment "A flowgate, is single or group of transmission elements intended to model MW flow impact relating to transmission limitations and transmission service usage." .


###  http://www.iec.ch/TC57/CIM#FlowgatePartner
cim:FlowgatePartner rdf:type owl:Class ;
                    rdfs:subClassOf cim:IdentifiedObject ;
                    rdfs:comment "Flowgate defined partner" .


###  http://www.iec.ch/TC57/CIM#FlowgateRelief
cim:FlowgateRelief rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:FlowgateRelief.effectiveDate ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:dateTime
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:FlowgateRelief.idcTargetMktFlow ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:nonNegativeInteger
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:FlowgateRelief.terminateDate ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:dateTime
                                       ] ;
                   rdfs:comment "IDC (Interchange Distribution Calulator) sends data for a TLR (Transmission Loading Relief)." .


###  http://www.iec.ch/TC57/CIM#FlowgateValue
cim:FlowgateValue rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:FlowgateValue.flowDirectionFlag ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:FlowDirectionType
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:FlowgateValue.economicDispatchLimit ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:FlowgateValue.effectiveDate ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTime
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:FlowgateValue.firmNetworkLimit ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:FlowgateValue.mktFlow ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:FlowgateValue.netFirmNetworkLimit ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ;
                  rdfs:comment "Day Ahead,  Network Native Load, Economic Dispatch, values used for calculation of Network Native Load (NNL) Determinator process." .


###  http://www.iec.ch/TC57/CIM#ForbiddenRegion
cim:ForbiddenRegion rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ForbiddenRegion.crossTime ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:nonNegativeInteger
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ForbiddenRegion.crossingCost ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:float
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ForbiddenRegion.highMW ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:float
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ForbiddenRegion.lowMW ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:float
                                        ] ;
                    rdfs:subClassOf cim:IdentifiedObject ;
                    rdfs:comment "Forbbiden region is operating ranges where the units are unable to maintain steady operation without causing equipment damage.  The four attributes that define a forbidden region are the low MW, the High MW, the crossing time, and the crossing cost." .


###  http://www.iec.ch/TC57/CIM#FormerReference
cim:FormerReference rdf:type owl:Class ;
                    rdfs:subClassOf cim:IdentifiedObject ;
                    rdfs:comment "Used to indicate former references to the same piece of equipment. The ID, name, and effectivity dates are utilized." .



                                owl:onDataRange xsd:string
                              ] ;
          rdfs:subClassOf cim:IdentifiedObject ;
          rdfs:comment "Tangible resource of the utility, including power system equipment, various end devices, cabinets, buildings, etc. For electrical network equipment, the role of the asset is defined through PowerSystemResource and its subclasses, defined mainly in the Wires model (refer to IEC61970-301 and model package IEC61970::Wires). Asset description places emphasis on the physical characteristics of the equipment fulfilling that role." .


###  http://www.iec.ch/TC57/CIM#AssetContainer
cim:AssetContainer rdf:type owl:Class ;
                   rdfs:subClassOf cim:Asset ;
                   rdfs:comment "Asset that is aggregation of other assets such as conductors, transformers, switchgear, land, fences, buildings, equipment, vehicles, etc." .


###  http://www.iec.ch/TC57/CIM#AssetFunction
cim:AssetFunction rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:AssetFunction.configID ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:AssetFunction.firmwareID ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:AssetFunction.hardwareID ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:AssetFunction.password ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:AssetFunction.programID ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ;
                  rdfs:subClassOf cim:IdentifiedObject ;
                  rdfs:comment "Function performed by an asset." .


###  http://www.iec.ch/TC57/CIM#AssetInfo
cim:AssetInfo rdf:type owl:Class ;
              rdfs:subClassOf cim:IdentifiedObject ;
              rdfs:comment """Set of attributes of an asset, representing typical datasheet information of a physical device that can be instantiated and shared in different data exchange contexts:
- as attributes of an asset instance (installed or in stock)
- as attributes of an asset model (product by a manufacturer)
- as attributes of a type asset (generic type of an asset as used in designs/extension planning).""" .


###  http://www.iec.ch/TC57/CIM#AssetLocationHazard
cim:AssetLocationHazard rdf:type owl:Class ;
                        rdfs:subClassOf cim:Hazard ;
                        rdfs:comment "Potential hazard related to the location of an asset. Examples are trees growing under overhead power lines, a park being located by a substation (i.e., children climb fence to recover a ball), a lake near an overhead distribution line (fishing pole/line contacting power lines), dangerous neighbour, etc." .


###  http://www.iec.ch/TC57/CIM#AssetModel
cim:AssetModel rdf:type owl:Class ;
               rdfs:subClassOf cim:IdentifiedObject ;
               rdfs:comment "Model of an asset, either a product of a specific manufacturer or a generic asset model or material item. Datasheet characteristics are available through the associated AssetInfo subclass and can be shared with asset or power system resource instances." .


###  http://www.iec.ch/TC57/CIM#AssetModelCatalogue
cim:AssetModelCatalogue rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:AssetModelCatalogue.status ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Status
                                            ] ;
                        rdfs:subClassOf cim:IdentifiedObject ;
                        rdfs:comment "Catalogue of available types of products and materials that are used to build or install, maintain or operate an Asset. Each catalogue item is for a specific product (AssetModel) available from a specific supplier." .


###  http://www.iec.ch/TC57/CIM#AssetModelCatalogueItem
cim:AssetModelCatalogueItem rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:AssetModelCatalogueItem.unitCost ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass cim:Money
                                                ] ;
                            rdfs:subClassOf cim:Document ;
                            rdfs:comment "Provides pricing and other relevant information about a specific manufacturer's product (i.e., AssetModel), and its price from a given supplier. A single AssetModel may be availble from multiple suppliers. Note that manufacturer and supplier are both types of organisation, which the association is inherited from Document." .


###  http://www.iec.ch/TC57/CIM#AssetModelUsageKind
cim:AssetModelUsageKind rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Class ;
                                              owl:oneOf ( cim:customerSubstation
                                                          cim:distributionOverhead
                                                          cim:distributionUnderground
                                                          cim:other
                                                          cim:streetlight
                                                          cim:substation
                                                          cim:transmission
                                                          cim:unknown
                                                        )
                                            ] .


###  http://www.iec.ch/TC57/CIM#AssetOrganisationRole
cim:AssetOrganisationRole rdf:type owl:Class ;
                          rdfs:subClassOf cim:OrganisationRole ;
                          rdfs:comment "Role an organisation plays with respect to asset." .


###  http://www.iec.ch/TC57/CIM#AssetOwner
cim:AssetOwner rdf:type owl:Class ;
               rdfs:subClassOf cim:AssetOrganisationRole ;
               rdfs:comment "Owner of the asset." .


###  http://www.iec.ch/TC57/CIM#AssetPropertyCurve
cim:AssetPropertyCurve rdf:type owl:Class ;
                       rdfs:subClassOf cim:Curve ;
                       rdfs:comment "An Asset Property that is described through curves rather than as a data point. The relationship is to be defined between an independent variable (X-axis) and one or two dependent variables (Y1-axis and Y2-axis)." .


###  http://www.iec.ch/TC57/CIM#AssetUser
cim:AssetUser rdf:type owl:Class ;
              rdfs:subClassOf cim:AssetOrganisationRole ;
              rdfs:comment "Organisation that is a user of the asset." .


###  http://www.iec.ch/TC57/CIM#Assignment
cim:Assignment rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:Assignment.effectivePeriod ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:DateTimeInterval
                                   ] ;
               rdfs:subClassOf cim:WorkDocument ;
               rdfs:comment "An assignment is given to an ErpPerson, Crew, Organisation, Equipment Item, Tool, etc. and may be used to perform Work, WorkTasks, Procedures, etc. TimeSchedules may be set up directly for Assignments or indirectly via the associated WorkTask. Note that these associations are all inherited through the recursive relationship on Document." .


###  http://www.iec.ch/TC57/CIM#AsynchronousMachine
cim:AsynchronousMachine rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:AsynchronousMachine.asynchronousMachineType ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:AsynchronousMachineKind
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:AsynchronousMachine.efficiency ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:PerCent
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:AsynchronousMachine.nominalFrequency ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Frequency
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:AsynchronousMachine.nominalSpeed ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:RotationSpeed
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:AsynchronousMachine.ratedMechanicalPower ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:ActivePower
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:AsynchronousMachine.rr1 ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Resistance
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:AsynchronousMachine.rr2 ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Resistance
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:AsynchronousMachine.tpo ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Seconds
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:AsynchronousMachine.tppo ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Seconds
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:AsynchronousMachine.xlr1 ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Reactance
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:AsynchronousMachine.xlr2 ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Reactance
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:AsynchronousMachine.xm ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Reactance
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:AsynchronousMachine.xp ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Reactance
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:AsynchronousMachine.xpp ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Reactance
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:AsynchronousMachine.xs ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Reactance
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:AsynchronousMachine.converterFedDrive ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:AsynchronousMachine.iaIrRatio ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:AsynchronousMachine.polePairNumber ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:nonNegativeInteger
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:AsynchronousMachine.reversible ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:AsynchronousMachine.rxLockedRotorRatio ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ;
                        rdfs:subClassOf cim:RotatingMachine ;
                        rdfs:comment "A rotating machine whose shaft rotates asynchronously with the electrical field.  Also known as an induction machine with no external connection to the rotor windings, e.g squirrel-cage induction machine." .


###  http://www.iec.ch/TC57/CIM#AsynchronousMachineDynamics
cim:AsynchronousMachineDynamics rdf:type owl:Class ;
                                rdfs:subClassOf cim:RotatingMachineDynamics ;
                                rdfs:comment """Asynchronous machine whose behaviour is described by reference to a standard model expressed in either time constant reactance form or equivalent circuit form <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>

<b>Parameter Notes:</b>
<ol>
 <li>Asynchronous machine parameters such as <b>Xl, Xs</b> etc. are actually used as inductances (L) in the model, but are commonly referred to as reactances since, at nominal frequency, the per unit values are the same. However, some references use the symbol L instead of X. </li>
</ol>""" .


###  http://www.iec.ch/TC57/CIM#AsynchronousMachineEquivalentCircuit
cim:AsynchronousMachineEquivalentCircuit rdf:type owl:Class ;
                                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                                               owl:onProperty cim:AsynchronousMachineEquivalentCircuit.rr1 ;
                                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                               owl:onClass cim:PU
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty cim:AsynchronousMachineEquivalentCircuit.rr2 ;
                                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                               owl:onClass cim:PU
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty cim:AsynchronousMachineEquivalentCircuit.xlr1 ;
                                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                               owl:onClass cim:PU
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty cim:AsynchronousMachineEquivalentCircuit.xlr2 ;
                                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                               owl:onClass cim:PU
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty cim:AsynchronousMachineEquivalentCircuit.xm ;
                                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                               owl:onClass cim:PU
                                                             ] ;
                                         rdfs:subClassOf cim:AsynchronousMachineDynamics ;
                                         rdfs:comment """The electrical equations of all variations of the asynchronous model are based on the AsynchronousEquivalentCircuit diagram for the direct and quadrature axes, with two equivalent rotor windings in each axis.  

<b>Equations for conversion between Equivalent Circuit and Time Constant Reactance forms:</b>
<b>Xs</b> = <b>Xm</b> + <b>Xl</b>
<b>X'</b> = <b>Xl</b> + <b>Xm</b> * <b>Xlr1</b> / (<b>Xm</b> + <b>Xlr1</b>)
<b>X''</b> = <b>Xl</b> + <b>Xm</b> * <b>Xlr1</b>* <b>Xlr2</b> / (<b>Xm</b> * <b>Xlr1</b> + <b>Xm</b> * <b>Xlr2</b> + <b>Xlr1</b> * <b>Xlr2</b>)
<b>T'o</b> = (<b>Xm</b> + <b>Xlr1</b>) / (<b>omega</b><b><sub>0</sub></b> * <b>Rr1</b>)
<b>T''o</b> = (<b>Xm</b> * <b>Xlr1</b> + <b>Xm</b> * <b>Xlr2</b> + <b>Xlr1</b> * <b>Xlr2</b>) / (<b>omega</b><b><sub>0</sub></b> * <b>Rr2</b> * (<b>Xm </b>+ <b>Xlr1</b>)
<b>
</b>Same equations using CIM attributes from AsynchronousMachineTimeConstantReactance class on left of = sign and AsynchronousMachineEquivalentCircuit class on right (except as noted):
xs = xm + RotatingMachineDynamics.statorLeakageReactance
xp = RotatingMachineDynamics.statorLeakageReactance + xm * xlr1 / (xm + xlr1)
xpp = RotatingMachineDynamics.statorLeakageReactance + xm * xlr1* xlr2 / (xm * xlr1 + xm * xlr2 + xlr1 * xlr2)
tpo = (xm + xlr1) / (2*pi*nominal frequency * rr1)
tppo = (xm * xlr1 + xm * xlr2 + xlr1 * xlr2) / (2*pi*nominal frequency * rr2 * (xm + xlr1).""" .


###  http://www.iec.ch/TC57/CIM#AsynchronousMachineKind
cim:AsynchronousMachineKind rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Class ;
                                                  owl:oneOf ( cim:generator
                                                              cim:motor
                                                            )
                                                ] .


###  http://www.iec.ch/TC57/CIM#AsynchronousMachineTimeConstantReactance
cim:AsynchronousMachineTimeConstantReactance rdf:type owl:Class ;
                                             owl:equivalentClass [ rdf:type owl:Restriction ;
                                                                   owl:onProperty cim:AsynchronousMachineTimeConstantReactance.tpo ;
                                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                   owl:onClass cim:Seconds
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty cim:AsynchronousMachineTimeConstantReactance.tppo ;
                                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                   owl:onClass cim:Seconds
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty cim:AsynchronousMachineTimeConstantReactance.xp ;
                                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                   owl:onClass cim:PU
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty cim:AsynchronousMachineTimeConstantReactance.xpp ;
                                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                   owl:onClass cim:PU
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty cim:AsynchronousMachineTimeConstantReactance.xs ;
                                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                   owl:onClass cim:PU
                                                                 ] ;
                                             rdfs:subClassOf cim:AsynchronousMachineDynamics ;
                                             rdfs:comment """<b>Parameter Notes:</b>
<ol>
 <li>If <b>X''</b> = <b>X'</b>, a single cage (one equivalent rotor winding per axis) is modelled.</li>
 <li>The p in the attribute names is a substitution for a prime in the usual parameter notation, e.g. tpo refers to T'o.</li>
</ol>

The parameters used for models expressed in time constant reactance form include:
<ul>
 <li>RotatingMachine.ratedS (MVAbase)</li>
 <li>RotatingMachineDynamics.damping (D)</li>
 <li>RotatingMachineDynamics.inertia (H)</li>
 <li>RotatingMachineDynamics.saturationFactor (S1)</li>
 <li>RotatingMachineDynamics.saturationFactor120 (S12)</li>
 <li>RotatingMachineDynamics.statorLeakageReactance (Xl)</li>
 <li>RotatingMachineDynamics.statorResistance (Rs)</li>
 <li>.xs (Xs)</li>
 <li>.xp (X')</li>
 <li>.xpp (X'')</li>
 <li>.tpo (T'o)</li>
 <li>.tppo (T''o).</li>
</ul>""" .


###  http://www.iec.ch/TC57/CIM#AsynchronousMachineUserDefined
cim:AsynchronousMachineUserDefined rdf:type owl:Class ;
                                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                                         owl:onProperty cim:AsynchronousMachineUserDefined.proprietary ;
                                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onDataRange xsd:boolean
                                                       ] ;
                                   rdfs:subClassOf cim:AsynchronousMachineDynamics ;
                                   rdfs:comment "Asynchronous machine whose dynamic behaviour is described by a user-defined model." .


###  http://www.iec.ch/TC57/CIM#AttributeInstanceComponent
cim:AttributeInstanceComponent rdf:type owl:Class ;
                               owl:equivalentClass [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:AttributeInstanceComponent.attribute ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:string
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:AttributeInstanceComponent.attributeValue ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:string
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:AttributeInstanceComponent.position ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:nonNegativeInteger
                                                   ] ;
                               rdfs:comment "A class used to provide information about an attribute." .


###  http://www.iec.ch/TC57/CIM#AttributeProperty
cim:AttributeProperty rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:AttributeProperty.propertyName ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:AttributeProperty.propertyValue ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:AttributeProperty.sequence ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ;
                      rdfs:comment "Property for a particular attribute that contains name and value" .


###  http://www.iec.ch/TC57/CIM#Auction
cim:Auction rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Auction.allocationMode ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Auction.cancelled ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Auction.category ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Auction.paymentTerms ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Auction.rights ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Auction.type ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:string
                                ] ;
            rdfs:subClassOf cim:IdentifiedObject ;
            rdfs:comment "A class providing the identification and type of an auction." .


###  http://www.iec.ch/TC57/CIM#Author
cim:Author rdf:type owl:Class ;
           rdfs:subClassOf cim:DocumentPersonRole ;
           rdfs:comment "Person who created document or activity record." .


###  http://www.iec.ch/TC57/CIM#AutomaticDispInstTypeCommitment
cim:AutomaticDispInstTypeCommitment rdf:type owl:Class ;
                                    owl:equivalentClass [ rdf:type owl:Class ;
                                                          owl:oneOf ( cim:SHUT_DOWN
                                                                      cim:START_UP
                                                                    )
                                                        ] .


###  http://www.iec.ch/TC57/CIM#AutomaticDispatchMode
cim:AutomaticDispatchMode rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Class ;
                                                owl:oneOf ( cim:CONTINGENCY
                                                            cim:INTERVAL
                                                            cim:MANUAL
                                                          )
                                              ] .


###  http://www.iec.ch/TC57/CIM#AuxiliaryAccount
cim:AuxiliaryAccount rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:AuxiliaryAccount.balance ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Money
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:AuxiliaryAccount.due ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Due
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:AuxiliaryAccount.lastCredit ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:AccountMovement
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:AuxiliaryAccount.lastDebit ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:AccountMovement
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:AuxiliaryAccount.principleAmount ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Money
                                         ] ;
                     rdfs:subClassOf cim:Document ;
                     rdfs:comment "Variable and dynamic part of auxiliary agreement, generally representing the current state of the account related to the outstanding balance defined in auxiliary agreement." .


###  http://www.iec.ch/TC57/CIM#AuxiliaryAgreement
cim:AuxiliaryAgreement rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:AuxiliaryAgreement.arrearsInterest ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:PerCent
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:AuxiliaryAgreement.fixedAmount ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Money
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:AuxiliaryAgreement.minAmount ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Money
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:AuxiliaryAgreement.vendPortion ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:PerCent
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:AuxiliaryAgreement.vendPortionArrear ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:PerCent
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:AuxiliaryAgreement.auxCycle ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:AuxiliaryAgreement.auxPriorityCode ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:AuxiliaryAgreement.payCycle ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:AuxiliaryAgreement.subType ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ;
                       rdfs:subClassOf cim:Agreement ;
                       rdfs:comment """An ad-hoc auxiliary account agreement associated with a customer agreement, not part of the customer's account, but typically subject to formal agreement between customer and supplier (utility). Typically this is used to collect revenue owed by the customer for other services or arrears accrued with the utility for other services. It is typically linked to a prepaid token purchase transaction, thus forcing the customer to make a payment towards settlement of the auxiliary account balance whenever the customer needs to purchase a prepaid token for electricity.
The present status of the auxiliary agreement can be defined in the context of the utility's business rules, for example: enabled, disabled, pending, over recovered, under recovered, written off, etc.""" .


###  http://www.iec.ch/TC57/CIM#AuxiliaryCost
cim:AuxiliaryCost rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:AuxiliaryCost.marketType ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:MarketType
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:AuxiliaryCost.intervalStartTime ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTime
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:AuxiliaryCost.updateTimeStamp ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTime
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:AuxiliaryCost.updateUser ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ;
                  rdfs:comment "Models Market clearing results for Auxillary costs" .


###  http://www.iec.ch/TC57/CIM#AuxiliaryEquipment
cim:AuxiliaryEquipment rdf:type owl:Class ;
                       rdfs:subClassOf cim:Equipment ;
                       rdfs:comment """AuxiliaryEquipment describe equipment that is not performing any primary functions but support for the equipment performing the primary function.
AuxiliaryEquipment is attached to primary eqipment via an association with Terminal.""" .


###  http://www.iec.ch/TC57/CIM#AuxiliaryObject
cim:AuxiliaryObject rdf:type owl:Class ;
                    rdfs:comment "Models Auxillary Values" .



###  http://www.iec.ch/TC57/CIM#Breaker
cim:Breaker rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Breaker.inTransitTime ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:Seconds
                                ] ;
            rdfs:subClassOf cim:ProtectedSwitch ;
            rdfs:comment "A mechanical switching device capable of making, carrying, and breaking currents under normal circuit conditions and also making, carrying for a specified time, and breaking currents under specified abnormal circuit conditions e.g.  those of short circuit." .


###  http://www.iec.ch/TC57/CIM#BreakerConfiguration
cim:BreakerConfiguration rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Class ;
                                               owl:oneOf ( cim:breakerAndAHalf
                                                           cim:doubleBreaker
                                                           cim:noBreaker
                                                           cim:singleBreaker
                                                         )
                                             ] .


###  http://www.iec.ch/TC57/CIM#BreakerInfo
cim:BreakerInfo rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:BreakerInfo.phaseTrip ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:CurrentFlow
                                    ] ;
                rdfs:subClassOf cim:OldSwitchInfo ;
                rdfs:comment "Properties of breaker assets." .


###  http://www.iec.ch/TC57/CIM#BusNameMarker
cim:BusNameMarker rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:BusNameMarker.priority ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ;
                  rdfs:subClassOf cim:IdentifiedObject ;
                  rdfs:comment "Used to apply user standard names to topology buses. Typically used for \"bus/branch\" case generation. Associated with one or more terminals that are normally connected with the bus name.    The associated terminals are normally connected by non-retained switches. For a ring bus station configuration, all busbar terminals in the ring are typically associated.   For a breaker and a half scheme, both busbars would normally be associated.  For a ring bus, all busbars would normally be associated.  For a \"straight\" busbar configuration, normally only the main terminal at the busbar would be associated." .


###  http://www.iec.ch/TC57/CIM#BusbarConfiguration
cim:BusbarConfiguration rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Class ;
                                              owl:oneOf ( cim:doubleBus
                                                          cim:mainWithTransfer
                                                          cim:ringBus
                                                          cim:singleBus
                                                        )
                                            ] .


###  http://www.iec.ch/TC57/CIM#BusbarSection
cim:BusbarSection rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:BusbarSection.ipMax ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:CurrentFlow
                                      ] ;
                  rdfs:subClassOf cim:Connector ;
                  rdfs:comment """A conductor, or group of conductors, with negligible impedance, that serve to connect other conducting equipment within a single substation. 
Voltage measurements are typically obtained from VoltageTransformers that are connected to busbar sections. A bus bar section may have many physical terminals but for analysis is modelled with exactly one logical terminal.""" .


###  http://www.iec.ch/TC57/CIM#BusbarSectionInfo
cim:BusbarSectionInfo rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:BusbarSectionInfo.ratedCurrent ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:CurrentFlow
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:BusbarSectionInfo.ratedVoltage ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Voltage
                                          ] ;
                      rdfs:subClassOf cim:AssetInfo ;
                      rdfs:comment "Busbar section data." .


###  http://www.iec.ch/TC57/CIM#Bushing
cim:Bushing rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Bushing.c1Capacitance ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:Capacitance
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Bushing.c2Capacitance ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:Capacitance
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Bushing.insulationKind ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:BushingInsulationKind
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Bushing.c1PowerFactor ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:float
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Bushing.c2PowerFactor ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:float
                                ] ;
            rdfs:subClassOf cim:Asset ;
            rdfs:comment "Bushing asset." .


###  http://www.iec.ch/TC57/CIM#BushingInsulationKind
cim:BushingInsulationKind rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Class ;
                                                owl:oneOf ( cim:compound
                                                            cim:other
                                                            cim:paperoil
                                                            cim:solidPorcelain
                                                          )
                                              ] .


###  http://www.iec.ch/TC57/CIM#BushingInsulationPF
cim:BushingInsulationPF rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:BushingInsulationPF.status ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Status
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:BushingInsulationPF.testKind ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:BushingInsulationPfTestKind
                                            ] ;
                        rdfs:subClassOf cim:IdentifiedObject ;
                        rdfs:comment """Bushing insulation power factor condition as a result of a test.
Typical status values are: Acceptable, Minor Deterioration or Moisture Absorption, Major Deterioration or Moisture Absorption, Failed.""" .


###  http://www.iec.ch/TC57/CIM#BushingInsulationPfTestKind
cim:BushingInsulationPfTestKind rdf:type owl:Class ;
                                owl:equivalentClass [ rdf:type owl:Class ;
                                                      owl:oneOf ( cim:c1
                                                                  cim:c2
                                                                )
                                                    ] .


###  http://www.iec.ch/TC57/CIM#BusinessCase
cim:BusinessCase rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:BusinessCase.corporateCode ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ;
                 rdfs:subClassOf cim:WorkDocument ;
                 rdfs:comment "Business justification for capital expenditures, usually addressing operations and maintenance costs as well." .


###  http://www.iec.ch/TC57/CIM#BusinessPlan
cim:BusinessPlan rdf:type owl:Class ;
                 rdfs:subClassOf cim:Document ;
                 rdfs:comment "A BusinessPlan is an organized sequence of predetermined actions required to complete a future organizational objective. It is a type of document that typically references a schedule, physical and/or logical resources (assets and/or PowerSystemResources), locations, etc." .


###  http://www.iec.ch/TC57/CIM#BusinessRole
cim:BusinessRole rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:BusinessRole.status ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Status
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:BusinessRole.type ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:string
                                     ] ;
                 rdfs:subClassOf cim:OrganisationRole ;
                 rdfs:comment "A business role that this organisation plays. A single organisation typically performs many functions, each one described as a role." .


###  http://www.iec.ch/TC57/CIM#CAESPlant
cim:CAESPlant rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:CAESPlant.energyStorageCapacity ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:RealEnergy
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:CAESPlant.ratedCapacityP ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:ActivePower
                                  ] ;

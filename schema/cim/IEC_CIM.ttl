###  http://www.iec.ch/TC57/CIM#WirePosition
cim:WirePosition rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:WirePosition.xCoord ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Displacement
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:WirePosition.yCoord ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Displacement
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:WirePosition.sequenceNumber ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:nonNegativeInteger
                                     ] ;
                 rdfs:subClassOf cim:IdentifiedObject ;
                 rdfs:comment "Identification, spacing and configuration of the wires of a conductor with respect to a structure." .


###  http://www.iec.ch/TC57/CIM#WireSpacing
cim:WireSpacing rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:WireSpacing.phaseWireSpacing ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:Length
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:WireSpacing.usage ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:WireUsageKind
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:WireSpacing.isCable ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:boolean
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:WireSpacing.phaseWireCount ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:nonNegativeInteger
                                    ] ;
                rdfs:subClassOf cim:IdentifiedObject ;
                rdfs:comment "Wire spacing data that associates multiple wire positions with the line segment, and allows to calculate line segment impedances. Number of phases can be derived from the number of associated wire positions whose phase is not neutral." .



                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:MarketRegionResults.dispatchCtMW ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:MarketRegionResults.dispatchHydroMW ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:MarketRegionResults.dispatchRate ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:MarketRegionResults.dispatchSteamMW ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:MarketRegionResults.imbalanceEnergyBias ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:MarketRegionResults.maxSufficiencyIndex ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:MarketRegionResults.minSufficiencyIndex ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:MarketRegionResults.reqMaxMW ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:float
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:MarketRegionResults.reqMinMW ;

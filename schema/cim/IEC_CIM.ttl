###  http://www.iec.ch/TC57/CIM#CurrentRelay
cim:CurrentRelay rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:CurrentRelay.currentLimit1 ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:CurrentFlow
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:CurrentRelay.currentLimit2 ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:CurrentFlow
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:CurrentRelay.currentLimit3 ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:CurrentFlow
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:CurrentRelay.timeDelay1 ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Seconds
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:CurrentRelay.timeDelay2 ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;

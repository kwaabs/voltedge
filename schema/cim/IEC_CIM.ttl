                                                   owl:onDataRange xsd:boolean
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:ExternalNetworkInjection.maxR0ToX0Ratio ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onDataRange xsd:float
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:ExternalNetworkInjection.maxR1ToX1Ratio ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onDataRange xsd:float
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:ExternalNetworkInjection.maxZ0ToZ1Ratio ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onDataRange xsd:float
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:ExternalNetworkInjection.minR0ToX0Ratio ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onDataRange xsd:float
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:ExternalNetworkInjection.minR1ToX1Ratio ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onDataRange xsd:float
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:ExternalNetworkInjection.minZ0ToZ1Ratio ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onDataRange xsd:float
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:ExternalNetworkInjection.referencePriority ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onDataRange xsd:nonNegativeInteger
                                                 ] ;
                             rdfs:subClassOf cim:RegulatingCondEq ;
                             rdfs:comment "This class represents external network and it is used for IEC 60909 calculations." .


###  http://www.iec.ch/TC57/CIM#FACTSDevice
cim:FACTSDevice rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:FACTSDevice.kind ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:FACTSDeviceKind
                                    ] ;
                rdfs:subClassOf cim:Asset ;
                rdfs:comment "FACTS device asset." .



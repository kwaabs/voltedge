###  http://www.iec.ch/TC57/CIM#ResourceBid
cim:ResourceBid rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ResourceBid.contingencyAvailFlag ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:YesNo
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ResourceBid.createdISO ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:YesNo
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ResourceBid.aggregationFlag ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ResourceBid.bidStatus ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ResourceBid.commodityType ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ResourceBid.energyMaxDay ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:float
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ResourceBid.energyMinDay ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:float
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ResourceBid.marketSepFlag ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ResourceBid.minDispatchTime ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ResourceBid.resourceLoadingType ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ResourceBid.shutDownsMaxDay ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ResourceBid.shutDownsMaxWeek ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ResourceBid.startUpsMaxDay ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ResourceBid.startUpsMaxWeek ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ResourceBid.virtual ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:boolean
                                    ] ;
                rdfs:subClassOf cim:Bid ;
                rdfs:comment "Energy bid for generation, load, or virtual type for the whole of the market-trading period (i.e., one day in day ahead market or one hour in the real time market)" .


###  http://www.iec.ch/TC57/CIM#ResourceCapacity
cim:ResourceCapacity rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ResourceCapacity.capacityType ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:ResourceCapacityType
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ResourceCapacity.defaultCapacity ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:ActivePower
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ResourceCapacity.maximumCapacity ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:ActivePower
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ResourceCapacity.minimumCapacity ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:ActivePower
                                         ] ;
                     rdfs:comment """This class model the various capacities of a resource. A resource may have numbers of capacities related to operating, ancillary services, energy trade and so forth. The types are but not limited to:
Ancillary Service
Regulation Up
Regulation Dn
Spinning Reserve
Non-Spinning Reserve
Operating Reserve
RUC
Energy Trade""" .


###  http://www.iec.ch/TC57/CIM#ResourceCapacityType
cim:ResourceCapacityType rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Class ;
                                               owl:oneOf ( cim:FO
                                                           cim:MO
                                                           cim:NR
                                                           cim:RA
                                                           cim:RD
                                                           cim:RMR
                                                           cim:RU
                                                           cim:SR
                                                         )
                                             ] .


###  http://www.iec.ch/TC57/CIM#ResourceCertification

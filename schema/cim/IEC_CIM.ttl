cim:Substation rdf:type owl:Class ;
               rdfs:subClassOf cim:EquipmentContainer ;
               rdfs:comment "A collection of equipment for purposes other than generation or utilization, through which electric energy in bulk is passed for the purposes of switching or modifying its characteristics." .


###  http://www.iec.ch/TC57/CIM#SubstitutionResourceList
cim:SubstitutionResourceList rdf:type owl:Class ;
                             owl:equivalentClass [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:SubstitutionResourceList.precedence ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onDataRange xsd:nonNegativeInteger
                                                 ] ;
                             rdfs:comment "List of resources that can be substituted for within the bounds of a Contract definition. This class has a precedence and a resource." .


###  http://www.iec.ch/TC57/CIM#Supercritical
cim:Supercritical rdf:type owl:Class ;
                  rdfs:subClassOf cim:FossilSteamSupply ;
                  rdfs:comment "Once-through supercritical boiler." .


###  http://www.iec.ch/TC57/CIM#SupplierKind
cim:SupplierKind rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:oneOf ( cim:other
                                                   cim:retailer
                                                   cim:utility
                                                 )
                                     ] .


###  http://www.iec.ch/TC57/CIM#SurgeArrester
cim:SurgeArrester rdf:type owl:Class ;
                  rdfs:subClassOf cim:AuxiliaryEquipment ;
                  rdfs:comment "Shunt device, installed on the network, usually in the proximity of electrical equipment in order to protect the said equipment against transient voltage transients caused by lightning or switching activity." .


###  http://www.iec.ch/TC57/CIM#SurgeArresterInfo
cim:SurgeArresterInfo rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:SurgeArresterInfo.continuousOperatingVoltage ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Voltage
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:SurgeArresterInfo.lightningImpulseDischargeVoltage ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Voltage
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:SurgeArresterInfo.nominalDischargeCurrent ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:CurrentFlow
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:SurgeArresterInfo.pressureReliefClass ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:CurrentFlow
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:SurgeArresterInfo.ratedVoltage ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Voltage
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:SurgeArresterInfo.steepFrontDischargeVoltage ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Voltage
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:SurgeArresterInfo.switchingImpulseDischargeVoltage ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Voltage
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:SurgeArresterInfo.isPolymer ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:boolean
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:SurgeArresterInfo.lineDischargeClass ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:nonNegativeInteger
                                          ] ;
                      rdfs:subClassOf cim:AssetInfo ;
                      rdfs:comment "Properties of surge arrester." .


###  http://www.iec.ch/TC57/CIM#Susceptance
cim:Susceptance rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Susceptance.multiplier ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:UnitMultiplier
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Susceptance.unit ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:UnitSymbol
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Susceptance.value ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:float
                                    ] ;
                rdfs:comment "Imaginary part of admittance." .


###  http://www.iec.ch/TC57/CIM#SusceptancePerLength
cim:SusceptancePerLength rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:SusceptancePerLength.multiplier ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:UnitMultiplier
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:SusceptancePerLength.unit ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:UnitSymbol
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:SusceptancePerLength.value ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ;
                         rdfs:comment "Imaginary part of admittance per unit of length." .


###  http://www.iec.ch/TC57/CIM#SvInjection
cim:SvInjection rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:SvInjection.pInjection ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:ActivePower
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:SvInjection.phase ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:SinglePhaseKind
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:SvInjection.qInjection ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:ReactivePower
                                    ] ;
                rdfs:subClassOf cim:StateVariable ;
                rdfs:comment "The SvInjection is reporting the calculated bus injection minus the sum of the terminal flows. The terminal flow is positive out from the bus (load sign convention) and bus injection has positive flow into the bus. SvInjection may have the remainder after state estimation or slack after power flow calculation." .


###  http://www.iec.ch/TC57/CIM#SvPowerFlow
cim:SvPowerFlow rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:SvPowerFlow.p ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:ActivePower
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:SvPowerFlow.phase ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:SinglePhaseKind
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:SvPowerFlow.q ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:ReactivePower
                                    ] ;
                rdfs:subClassOf cim:StateVariable ;
                rdfs:comment "State variable for power flow. Load convention is used for flow direction. This means flow out from the TopologicalNode into the equipment is positive." .


###  http://www.iec.ch/TC57/CIM#SvShuntCompensatorSections
cim:SvShuntCompensatorSections rdf:type owl:Class ;
                               owl:equivalentClass [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:SvShuntCompensatorSections.sections ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:float
                                                   ] ;
                               rdfs:subClassOf cim:StateVariable ;
                               rdfs:comment "State variable for the number of sections in service for a shunt compensator." .


###  http://www.iec.ch/TC57/CIM#SvStatus
cim:SvStatus rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:SvStatus.phase ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:SinglePhaseKind
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:SvStatus.inService ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:boolean
                                 ] ;
             rdfs:subClassOf cim:StateVariable ;
             rdfs:comment "State variable for status." .


###  http://www.iec.ch/TC57/CIM#SvTapStep
cim:SvTapStep rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:SvTapStep.position ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:float
                                  ] ;
              rdfs:subClassOf cim:StateVariable ;
              rdfs:comment "State variable for transformer tap step.     This class is to be used for taps of LTC (load tap changing) transformers, not fixed tap transformers." .


###  http://www.iec.ch/TC57/CIM#SvVoltage
cim:SvVoltage rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:SvVoltage.angle ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:AngleDegrees
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:SvVoltage.phase ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:SinglePhaseKind
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:SvVoltage.v ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:Voltage
                                  ] ;
              rdfs:subClassOf cim:StateVariable ;
              rdfs:comment "State variable for voltage." .


###  http://www.iec.ch/TC57/CIM#Switch
cim:Switch rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Switch.ratedCurrent ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:CurrentFlow
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Switch.normalOpen ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:boolean
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Switch.open ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:boolean
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Switch.retained ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:boolean
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Switch.switchOnCount ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:nonNegativeInteger
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Switch.switchOnDate ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:dateTime
                               ] ;
           rdfs:subClassOf cim:ConductingEquipment ;
           rdfs:comment "A generic device designed to close, or open, or both, one or more electric circuits.  All switches are two terminal devices including grounding switches." .


###  http://www.iec.ch/TC57/CIM#SwitchAction
cim:SwitchAction rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:SwitchAction.kind ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:SwitchActionKind
                                     ] ;
                 rdfs:subClassOf cim:SwitchingStep ;
                 rdfs:comment "Action on switch as a switching step." .


###  http://www.iec.ch/TC57/CIM#SwitchActionKind
cim:SwitchActionKind rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:oneOf ( cim:close
                                                       cim:disableReclosing
                                                       cim:enableReclosing
                                                       cim:open
                                                     )
                                         ] .


###  http://www.iec.ch/TC57/CIM#SwitchInfo
cim:SwitchInfo rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:SwitchInfo.breakingCapacity ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:CurrentFlow
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:SwitchInfo.ratedCurrent ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:CurrentFlow
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:SwitchInfo.ratedVoltage ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:Voltage
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:SwitchInfo.isSinglePhase ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:boolean
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:SwitchInfo.isUnganged ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:boolean
                                   ] ;
               rdfs:subClassOf cim:AssetInfo ;
               rdfs:comment "Switch data." .


###  http://www.iec.ch/TC57/CIM#SwitchPhase
cim:SwitchPhase rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:SwitchPhase.phaseSide1 ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:SinglePhaseKind
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:SwitchPhase.phaseSide2 ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:SinglePhaseKind
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:SwitchPhase.closed ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:boolean
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:SwitchPhase.normalOpen ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:boolean
                                    ] ;
                rdfs:subClassOf cim:PowerSystemResource ;
                rdfs:comment "Single phase of a multi-phase switch when its attributes might be different per phase." .


###  http://www.iec.ch/TC57/CIM#SwitchSchedule
cim:SwitchSchedule rdf:type owl:Class ;
                   rdfs:subClassOf cim:SeasonDayTypeSchedule ;
                   rdfs:comment "A schedule of switch positions.  If RegularTimePoint.value1 is 0, the switch is open.  If 1, the switch is closed." .


###  http://www.iec.ch/TC57/CIM#SwitchStatus
cim:SwitchStatus rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:SwitchStatus.switchStatus ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:SwitchStatusType
                                     ] ;
                 rdfs:comment "Optimal Power Flow or State Estimator Circuit Breaker Status." .


###  http://www.iec.ch/TC57/CIM#SwitchStatusType
cim:SwitchStatusType rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:oneOf ( cim:Closed
                                                       cim:Open
                                                     )
                                         ] .


###  http://www.iec.ch/TC57/CIM#SwitchingPlan
cim:SwitchingPlan rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:SwitchingPlan.purpose ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:SwitchingPlan.rank ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ;
                  rdfs:subClassOf cim:SwitchingStepGroup ;
                  rdfs:comment """A sequence of grouped or atomic steps intended to:
- de-energise equipment or part of the network for safe work, and/or
- bring back in service previously de-energised equipment or part of the network.""" .


###  http://www.iec.ch/TC57/CIM#SwitchingStep
cim:SwitchingStep rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:SwitchingStep.description ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:SwitchingStep.executedDateTime ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTime
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:SwitchingStep.isFreeSequence ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:boolean
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:SwitchingStep.issuedDateTime ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTime
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:SwitchingStep.plannedDateTime ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTime
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:SwitchingStep.sequenceNumber ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ;
                  rdfs:comment "Atomic switching step; can be part of a switching step group, or part of a switching plan." .


###  http://www.iec.ch/TC57/CIM#SwitchingStepGroup
cim:SwitchingStepGroup rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SwitchingStepGroup.isFreeSequence ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:boolean
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SwitchingStepGroup.sequenceNumber ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:nonNegativeInteger
                                           ] ;
                       rdfs:subClassOf cim:Document ;
                       rdfs:comment "A logical step, grouping atomic switching steps that are important to distinguish when they may change topology (e.g. placing a jumper between two cuts)." .


###  http://www.iec.ch/TC57/CIM#SynchrocheckRelay
cim:SynchrocheckRelay rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:SynchrocheckRelay.maxAngleDiff ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:AngleRadians
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:SynchrocheckRelay.maxFreqDiff ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Frequency
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:SynchrocheckRelay.maxVoltDiff ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Voltage
                                          ] ;
                      rdfs:subClassOf cim:ProtectionEquipment ;
                      rdfs:comment "A device that operates when two AC circuits are within the desired limits of frequency, phase angle, and voltage, to permit or to cause the paralleling of these two circuits. Used to prevent the paralleling of non-synchronous topological islands." .


###  http://www.iec.ch/TC57/CIM#SynchronousMachine
cim:SynchronousMachine rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.aVRToManualLag ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Seconds
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.aVRToManualLead ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Seconds
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.baseQ ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:ReactivePower
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.condenserP ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:ActivePower
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.coolantType ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:CoolantType
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.earthingStarPointR ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Resistance
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.earthingStarPointX ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Reactance
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.ikk ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:CurrentFlow
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.manualToAVR ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Seconds
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.maxQ ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:ReactivePower
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.maxU ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Voltage
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.minQ ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:ReactivePower
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.minU ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Voltage
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.operatingMode ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:SynchronousMachineOperatingMode
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.qPercent ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:PerCent
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.r ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Resistance
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.r0 ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Resistance
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.r2 ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Resistance
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.satDirectSubtransX ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:PU
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.satDirectSyncX ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:PU
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.satDirectTransX ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:PU
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.shortCircuitRotorType ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:ShortCircuitRotorKind
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.type ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:SynchronousMachineKind
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.voltageRegulationRange ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:PerCent
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.x0 ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Reactance
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.x2 ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Reactance
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.coolantCondition ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:float
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.earthing ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:boolean
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.mu ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:float
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:SynchronousMachine.referencePriority ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:nonNegativeInteger
                                           ] ;
                       rdfs:subClassOf cim:RotatingMachine ;
                       rdfs:comment "An electromechanical device that operates with shaft rotating synchronously with the network. It is a single machine operating either as a generator or synchronous condenser or pump." .


###  http://www.iec.ch/TC57/CIM#SynchronousMachineDetailed
cim:SynchronousMachineDetailed rdf:type owl:Class ;
                               owl:equivalentClass [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:SynchronousMachineDetailed.ifdBaseType ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass cim:IfdBaseKind
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:SynchronousMachineDetailed.ifdBaseValue ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass cim:CurrentFlow
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:SynchronousMachineDetailed.efdBaseRatio ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:float
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:SynchronousMachineDetailed.saturationFactor120QAxis ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:float
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:SynchronousMachineDetailed.saturationFactorQAxis ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:float
                                                   ] ;
                               rdfs:subClassOf cim:SynchronousMachineDynamics ;
                               rdfs:comment """All synchronous machine detailed types use a subset of the same data parameters and input/output variables.  
The several variations differ in the following ways:
<ul>
 <li>The number of  equivalent windings that are included</li>
 <li>The way in which saturation is incorporated into the model.</li>
 <li>Whether or not subtransient saliency (<b>X''q</b> not = <b>X''d</b>) is represented.</li>
</ul>
<b>Note:</b> It is not necessary for each simulation tool to have separate models for each of the model types.  The same model can often be used for several types by alternative logic within the model.  Also, differences in saturation representation may not result in significant model performance differences so model substitutions are often acceptable.""" .


###  http://www.iec.ch/TC57/CIM#SynchronousMachineDynamics
cim:SynchronousMachineDynamics rdf:type owl:Class ;
                               rdfs:subClassOf cim:RotatingMachineDynamics ;
                               rdfs:comment """Synchronous machine whose behaviour is described by reference to a standard model expressed in one of the following forms:
<ul>
 <li>simplified (or classical), where a group of generators or motors is not modelled in detail</li>
</ul>
<ul>
 <li>detailed, in equivalent circuit form</li>
 <li>detailed, in time constant reactance form</li>
</ul>
<font color=\"#0f0f0f\">or by definition of a user-defined model.</font>
<font color=\"#0f0f0f\">
</font><font color=\"#0f0f0f\"><b>Note:</b>  It is a common practice to represent small generators by a negative load rather than by a dynamic generator model when performing dynamics simulations. In this case a SynchronousMachine in the static model is not represented by anything in the dynamics model, instead it is treated as ordinary load.</font>
<font color=\"#0f0f0f\">
</font><font color=\"#0f0f0f\"><b>Parameter Notes:</b></font>
<ol>
 <li><font color=\"#0f0f0f\">Synchronous machine parameters such as <b>Xl, Xd</b>,<b> Xp</b> etc. are actually used as inductances (L) in the models,</font> but are commonly referred to as reactances since, at nominal frequency, the per unit values are the same. However, some references use the symbol L instead of X. </li>
</ol>""" .


###  http://www.iec.ch/TC57/CIM#SynchronousMachineEquivalentCircuit
cim:SynchronousMachineEquivalentCircuit rdf:type owl:Class ;
                                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                                              owl:onProperty cim:SynchronousMachineEquivalentCircuit.r1d ;
                                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onClass cim:PU
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty cim:SynchronousMachineEquivalentCircuit.r1q ;
                                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onClass cim:PU
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty cim:SynchronousMachineEquivalentCircuit.r2q ;
                                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onClass cim:PU
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty cim:SynchronousMachineEquivalentCircuit.rfd ;
                                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onClass cim:PU
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty cim:SynchronousMachineEquivalentCircuit.x1d ;
                                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onClass cim:PU
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty cim:SynchronousMachineEquivalentCircuit.x1q ;
                                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onClass cim:PU
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty cim:SynchronousMachineEquivalentCircuit.x2q ;
                                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onClass cim:PU
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty cim:SynchronousMachineEquivalentCircuit.xad ;
                                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onClass cim:PU
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty cim:SynchronousMachineEquivalentCircuit.xaq ;
                                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onClass cim:PU
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty cim:SynchronousMachineEquivalentCircuit.xf1d ;
                                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onClass cim:PU
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty cim:SynchronousMachineEquivalentCircuit.xfd ;
                                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onClass cim:PU
                                                            ] ;
                                        rdfs:subClassOf cim:SynchronousMachineDetailed ;
                                        rdfs:comment """The electrical equations for all variations of the synchronous models are based on the SynchronousEquivalentCircuit diagram for the direct and quadrature axes.

<b>Equations for conversion between Equivalent Circuit and Time Constant Reactance forms:</b>
<b>Xd</b> = <b>Xad</b> + <b>Xl</b>
<b>Xd</b> = <b>Xl</b> + <b>Xad</b> * <b>Xfd</b> / (<b>Xad</b> + <b>Xfd</b>)
<b>Xd</b> = <b>Xl</b> + <b>Xad</b> * <b>Xfd </b>* <b>X1d</b> / (<b>Xad</b> * <b>Xfd</b> + <b>Xad</b> * <b>X1d</b> + <b>Xfd</b> * <b>X1d</b>)
<b>Xq</b> = <b>Xaq</b> + <b>Xl</b>
<b>Xq</b> = <b>Xl</b> + <b>Xaq</b> * <b>X1q</b> / (<b>Xaq</b>+ <b>X1q</b>)
<b>Xq</b> = <b>Xl</b> + <b>Xaq</b> *<b> X1q</b>* <b>X2q</b> / (<b>Xaq</b> * <b>X1q</b> + <b>Xaq</b> * <b>X2q</b> + <b>X1q</b> * <b>X2q</b>)
<b>Tdo</b> = (<b>Xad</b> + <b>Xfd</b>) / (<b>omega</b><b><sub>0</sub></b> * <b>Rfd</b>)
<b>Tdo</b> = (<b>Xad</b> * <b>Xfd</b> + <b>Xad</b> * <b>X1d</b> + <b>Xfd</b> * <b>X1d</b>) / (<b>omega</b><b><sub>0</sub></b> * <b>R1d</b> * (<b>Xad</b> + <b>Xfd</b>)
<b>Tqo</b> = (<b>Xaq</b> + <b>X1q</b>) / (<b>omega</b><b><sub>0</sub></b> * <b>R1q</b>)
<b>Tqo</b> = (<b>Xaq</b> * <b>X1q</b> + <b>Xaq</b> * <b>X2q</b> + <b>X1q</b> * <b>X2q</b>)/ (<b>omega</b><b><sub>0</sub></b> * <b>R2q</b> * (<b>Xaq</b> + <b>X1q</b>)
<b>
</b>Same equations using CIM attributes from SynchronousMachineTimeConstantReactance class on left of = sign and SynchronousMachineEquivalentCircuit class on right (except as noted):
xDirectSync = xad + RotatingMachineDynamics.statorLeakageReactance
xDirectTrans = RotatingMachineDynamics.statorLeakageReactance + xad * xfd / (xad + xfd)
xDirectSubtrans = RotatingMachineDynamics.statorLeakageReactance + xad * xfd * x1d / (xad * xfd + xad * x1d + xfd * x1d)
xQuadSync = xaq + RotatingMachineDynamics.statorLeakageReactance
xQuadTrans = RotatingMachineDynamics.statorLeakageReactance + xaq * x1q / (xaq+ x1q)
xQuadSubtrans = RotatingMachineDynamics.statorLeakageReactance + xaq * x1q* x2q / (xaq * x1q + xaq * x2q + x1q * x2q) 
tpdo = (xad + xfd) / (2*pi*nominal frequency * rfd)
tppdo = (xad * xfd + xad * x1d + xfd * x1d) / (2*pi*nominal frequency * r1d * (xad + xfd)
tpqo = (xaq + x1q) / (2*pi*nominal frequency * r1q)
tppqo = (xaq * x1q + xaq * x2q + x1q * x2q)/ (2*pi*nominal frequency * r2q * (xaq + x1q).

Are only valid for a simplified model where \"Canay\" reactance is zero.""" .


###  http://www.iec.ch/TC57/CIM#SynchronousMachineKind
cim:SynchronousMachineKind rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Class ;
                                                 owl:oneOf ( cim:condenser
                                                             cim:generator
                                                             cim:generatorOrCondenser
                                                             cim:generatorOrCondenserOrMotor
                                                             cim:generatorOrMotor
                                                             cim:motor
                                                             cim:motorOrCondenser
                                                           )
                                               ] .


###  http://www.iec.ch/TC57/CIM#SynchronousMachineModelKind
cim:SynchronousMachineModelKind rdf:type owl:Class ;
                                owl:equivalentClass [ rdf:type owl:Class ;
                                                      owl:oneOf ( cim:subtransient
                                                                  cim:subtransientSimplified
                                                                  cim:subtransientSimplifiedDirectAxis
                                                                  cim:subtransientTypeF
                                                                  cim:subtransientTypeJ
                                                                )
                                                    ] .


###  http://www.iec.ch/TC57/CIM#SynchronousMachineOperatingMode
cim:SynchronousMachineOperatingMode rdf:type owl:Class ;
                                    owl:equivalentClass [ rdf:type owl:Class ;
                                                          owl:oneOf ( cim:condenser
                                                                      cim:generator
                                                                      cim:motor
                                                                    )
                                                        ] .


###  http://www.iec.ch/TC57/CIM#SynchronousMachineSimplified
cim:SynchronousMachineSimplified rdf:type owl:Class ;
                                 rdfs:subClassOf cim:SynchronousMachineDynamics ;
                                 rdfs:comment """The simplified model represents a synchronous generator as a constant internal voltage behind an impedance (<b>Rs</b> + <b>jXp</b>) as shown in the Simplified diagram.

Since internal voltage is held constant, there is no <b>Efd</b> input and any excitation system model will be ignored.  There is also no <b>Ifd</b> output.

This model should not be used for representing a real generator except, perhaps, small generators whose response is insignificant.  

The parameters used for the Simplified model include:
<ul>
 <li>RotatingMachineDynamics.damping (D)</li>
 <li>RotatingMachineDynamics.inertia (H)</li>
 <li>RotatingMachineDynamics.statorLeakageReactance (used to exchange jXp for SynchronousMachineSimplified)</li>
 <li>RotatingMachineDynamics.statorResistance (Rs).</li>
</ul>""" .


###  http://www.iec.ch/TC57/CIM#SynchronousMachineTimeConstantReactance
cim:SynchronousMachineTimeConstantReactance rdf:type owl:Class ;
                                            owl:equivalentClass [ rdf:type owl:Restriction ;
                                                                  owl:onProperty cim:SynchronousMachineTimeConstantReactance.modelType ;
                                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                  owl:onClass cim:SynchronousMachineModelKind
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty cim:SynchronousMachineTimeConstantReactance.rotorType ;
                                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                  owl:onClass cim:RotorKind
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty cim:SynchronousMachineTimeConstantReactance.tc ;
                                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                  owl:onClass cim:Seconds
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty cim:SynchronousMachineTimeConstantReactance.tpdo ;
                                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                  owl:onClass cim:Seconds
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty cim:SynchronousMachineTimeConstantReactance.tppdo ;
                                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                  owl:onClass cim:Seconds
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty cim:SynchronousMachineTimeConstantReactance.tppqo ;
                                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                  owl:onClass cim:Seconds
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty cim:SynchronousMachineTimeConstantReactance.tpqo ;
                                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                  owl:onClass cim:Seconds
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty cim:SynchronousMachineTimeConstantReactance.xDirectSubtrans ;
                                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                  owl:onClass cim:PU
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty cim:SynchronousMachineTimeConstantReactance.xDirectSync ;
                                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                  owl:onClass cim:PU
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty cim:SynchronousMachineTimeConstantReactance.xDirectTrans ;
                                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                  owl:onClass cim:PU
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty cim:SynchronousMachineTimeConstantReactance.xQuadSubtrans ;
                                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                  owl:onClass cim:PU
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty cim:SynchronousMachineTimeConstantReactance.xQuadSync ;
                                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                  owl:onClass cim:PU
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty cim:SynchronousMachineTimeConstantReactance.xQuadTrans ;
                                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                  owl:onClass cim:PU
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty cim:SynchronousMachineTimeConstantReactance.ks ;
                                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                  owl:onDataRange xsd:float
                                                                ] ;
                                            rdfs:subClassOf cim:SynchronousMachineDetailed ;
                                            rdfs:comment """Synchronous machine detailed modelling types are defined by the combination of the attributes SynchronousMachineTimeConstantReactance.modelType and SynchronousMachineTimeConstantReactance.rotorType.  
<b>
</b><b>Parameter notes:</b>
<ol>
 <li>The p in the time-related attribute names is a substitution for a prime in the usual parameter notation, e.g. tpdo refers to <b>T'do</b>.</li>
</ol>
<b>
</b>The parameters used for models expressed in time constant reactance form include:
<ul>
 <li>RotatingMachine.ratedS (MVAbase)</li>
 <li>RotatingMachineDynamics.damping (D)</li>
 <li>RotatingMachineDynamics.inertia (H)</li>
 <li>RotatingMachineDynamics.saturationFactor (S1)</li>
 <li>RotatingMachineDynamics.saturationFactor120 (S12)</li>
 <li>RotatingMachineDynamics.statorLeakageReactance (Xl)</li>
 <li>RotatingMachineDynamics.statorResistance (Rs)</li>
 <li>SynchronousMachineTimeConstantReactance.ks (Ks)</li>
 <li>SynchronousMachineDetailed.saturationFactorQAxis (S1q)</li>
 <li>SynchronousMachineDetailed.saturationFactor120QAxis (S12q)</li>
 <li>SynchronousMachineDetailed.efdBaseRatio</li>
 <li>SynchronousMachineDetailed.ifdBaseType</li>
 <li>SynchronousMachineDetailed.ifdBaseValue, if present</li>
 <li>.xDirectSync (Xd)</li>
 <li>.xDirectTrans (X'd)</li>
 <li>.xDirectSubtrans (X''d)</li>
 <li>.xQuadSync (Xq)</li>
 <li>.xQuadTrans (X'q)</li>
 <li>.xQuadSubtrans (X''q)</li>
 <li>.tpdo (T'do)</li>
 <li>.tppdo (T''do)</li>
 <li>.tpqo (T'qo)</li>
 <li>.tppqo (T''qo)</li>
 <li>.tc.</li>
</ul>""" .


###  http://www.iec.ch/TC57/CIM#SynchronousMachineUserDefined
cim:SynchronousMachineUserDefined rdf:type owl:Class ;
                                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                                        owl:onProperty cim:SynchronousMachineUserDefined.proprietary ;
                                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                        owl:onDataRange xsd:boolean
                                                      ] ;
                                  rdfs:subClassOf cim:SynchronousMachineDynamics ;
                                  rdfs:comment "Synchronous machine whose dynamic behaviour is described by a user-defined model." .


###  http://www.iec.ch/TC57/CIM#Synchronous_Generator
cim:Synchronous_Generator rdf:type owl:Class .


###  http://www.iec.ch/TC57/CIM#Synchronous_Machine
cim:Synchronous_Machine rdf:type owl:Class .


###  http://www.iec.ch/TC57/CIM#SysLoadDistributionFactor
cim:SysLoadDistributionFactor rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Restriction ;
                                                    owl:onProperty cim:SysLoadDistributionFactor.factor ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onDataRange xsd:float
                                                  ] ;
                              rdfs:comment "This class models the system distribution factors. This class needs to be used along with the HostControlArea and the ConnectivityNode to show the distribution of each individual party." .


###  http://www.iec.ch/TC57/CIM#SystemType
cim:SystemType rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:oneOf ( cim:OASIS
                                               )
                                   ] .


###  http://www.iec.ch/TC57/CIM#TACArea
cim:TACArea rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:TACArea.endEffectiveDate ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:dateTime
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:TACArea.startEffectiveDate ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:dateTime
                                ] ;
            rdfs:subClassOf cim:IdentifiedObject ;
            rdfs:comment "Transmission Access Charge Area. Charges assessed, on behalf of the Participating Transmission Owner, to parties who require access to the controlled grid." .


###  http://www.iec.ch/TC57/CIM#TASE2BilateralTable
cim:TASE2BilateralTable rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:TASE2BilateralTable.bilateralTableID ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:string
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:TASE2BilateralTable.calling ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:TASE2BilateralTable.nameOfICC ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:string
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:TASE2BilateralTable.tase2version ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:string
                                            ] ;
                        rdfs:subClassOf cim:IdentifiedObject ;
                        rdfs:comment "This class describe the sending (providing) side in a bilateral ICCP data exchange. Hence the ICCP bilateral (table) descriptions are created by exchanging ICCPProvider data between the parties." .


###  http://www.iec.ch/TC57/CIM#TCPAcessPoint
cim:TCPAcessPoint rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:TCPAcessPoint.keepAliveTime ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:TCPAcessPoint.port ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ;
                  rdfs:subClassOf cim:IPAccessPoint .


###  http://www.iec.ch/TC57/CIM#TREntitlement
cim:TREntitlement rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:TREntitlement.entitlement ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:TREntitlement.startOperatingDate ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTime
                                      ] ;
                  rdfs:comment """A Transmission Right(TR) can be a chain of TR's or on individual. 

When a transmission right is not a chain, this is formally the ETC/TOR Entitlement for each ETC/TOR contract with the inclusion of CVR(Converted Rights) as an ETC. This is the sum of all entitlements on all related transmission interfaces for the same TR.

When TR is a chain, its entitlement is the minimum of all entitlements for the individual TRs in the chain.""" .


###  http://www.iec.ch/TC57/CIM#TRType
cim:TRType rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Class ;
                                 owl:oneOf ( cim:CHAIN
                                             cim:INDIVIDUAL
                                           )
                               ] .


###  http://www.iec.ch/TC57/CIM#TagAction
cim:TagAction rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:TagAction.kind ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:TagActionKind
                                  ] ;
              rdfs:subClassOf cim:SwitchingStep ;
              rdfs:comment "Action on operation tag as a switching step." .


###  http://www.iec.ch/TC57/CIM#TagActionKind
cim:TagActionKind rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:oneOf ( cim:place
                                                    cim:remove
                                                    cim:verify
                                                  )
                                      ] .


###  http://www.iec.ch/TC57/CIM#TailbayLossCurve
cim:TailbayLossCurve rdf:type owl:Class ;
                     rdfs:subClassOf cim:Curve ;
                     rdfs:comment "Relationship between tailbay head loss hight (y-axis) and the total discharge into the power station's tailbay volume per time unit (x-axis) . There could be more than one curve depending on the level of the tailbay reservoir or river level." .


###  http://www.iec.ch/TC57/CIM#TapChanger
cim:TapChanger rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TapChanger.initialDelay ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:Seconds
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TapChanger.neutralU ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;

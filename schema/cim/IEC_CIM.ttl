###  http://www.iec.ch/TC57/CIM#WireInfo
cim:WireInfo rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:WireInfo.coreRadius ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:Length
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:WireInfo.gmr ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:Length
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:WireInfo.insulationMaterial ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:WireInsulationKind
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:WireInfo.insulationThickness ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:Length
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:WireInfo.material ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:WireMaterialKind
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:WireInfo.rAC25 ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:ResistancePerLength
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:WireInfo.rAC50 ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:ResistancePerLength
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:WireInfo.rAC75 ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:ResistancePerLength
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:WireInfo.rDC20 ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:ResistancePerLength
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:WireInfo.radius ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:Length
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:WireInfo.ratedCurrent ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:CurrentFlow
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:WireInfo.coreStrandCount ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:nonNegativeInteger
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:WireInfo.insulated ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:boolean
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:WireInfo.sizeDescription ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:string
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:WireInfo.strandCount ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:nonNegativeInteger
                                 ] ;
             rdfs:subClassOf cim:AssetInfo ;
             rdfs:comment "Wire data that can be specified per line segment phase, or for the line segment as a whole in case its phases all have the same wire characteristics." .


###  http://www.iec.ch/TC57/CIM#WireInsulationKind
cim:WireInsulationKind rdf:type owl:Class ;

                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:ExternalNetworkInjection.minQ ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:ReactivePower
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:ExternalNetworkInjection.p ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:ActivePower
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:ExternalNetworkInjection.q ;
                                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass cim:ReactivePower
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty cim:ExternalNetworkInjection.voltageFactor ;

                                      ] .


###  http://www.iec.ch/TC57/CIM#ExpectedEnergy
cim:ExpectedEnergy rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ExpectedEnergy.intervalStartTime ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:dateTime
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ExpectedEnergy.updateTimeStamp ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:dateTime
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ExpectedEnergy.updateUser ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ;
                   rdfs:comment "Model Expected Energy  from Market Clearing, interval based" .


###  http://www.iec.ch/TC57/CIM#ExpectedEnergyValues
cim:ExpectedEnergyValues rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;

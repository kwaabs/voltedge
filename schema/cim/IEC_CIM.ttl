                                      owl:onProperty cim:ExcIEEEST4B.vrmax ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:PU
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ExcIEEEST4B.vrmin ;

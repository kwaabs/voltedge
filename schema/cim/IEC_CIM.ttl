                       rdfs:domain cim:LoadBid ;
                       rdfs:range xsd:dateTime ;
                       rdfs:comment "The date represents the NextMarketDate for which the load response bids apply to." .


###  http://www.iec.ch/TC57/CIM#LoadBid.meteredValue
cim:LoadBid.meteredValue rdf:type owl:DatatypeProperty ;
                         rdfs:domain cim:LoadBid ;
                         rdfs:range xsd:boolean ;
                         rdfs:comment """Flag indicated that the load reduction is metered. (See above)
If priceSetting and meteredValue both equal 1, then the facility is eligible to set LMP in the real time market.""" .


###  http://www.iec.ch/TC57/CIM#LoadBid.minLoadReductionInterval
cim:LoadBid.minLoadReductionInterval rdf:type owl:DatatypeProperty ;
                                     rdfs:domain cim:LoadBid ;
                                     rdfs:range xsd:float ;
                                     rdfs:comment "Shortest period load reduction shall be maintained before load can be restored to normal levels." .


###  http://www.iec.ch/TC57/CIM#LoadBid.minTimeBetLoadRed
cim:LoadBid.minTimeBetLoadRed rdf:type owl:DatatypeProperty ;
                              rdfs:domain cim:LoadBid ;
                              rdfs:range xsd:float ;
                              rdfs:comment "Shortest time that load shall be left at normal levels before a new load reduction." .


###  http://www.iec.ch/TC57/CIM#LoadBid.priceSetting
cim:LoadBid.priceSetting rdf:type owl:DatatypeProperty ;
                         rdfs:domain cim:LoadBid ;
                         rdfs:range xsd:boolean ;
                         rdfs:comment "Flag to indicate that the facility can set LMP Works in tandem with Metered Value.  Greater chance of this being dynamic than the Metered Value, however, it is requested that Price Setting and Metered Value stay at the same source.  Currently no customers have implemented the metering capability, but if this option is implemented, then Price Setting could become dynamic.  However, Metered Value will remain static." .


###  http://www.iec.ch/TC57/CIM#LoadBid.reqNoticeTime
cim:LoadBid.reqNoticeTime rdf:type owl:DatatypeProperty ;
                          rdfs:domain cim:LoadBid ;
                          rdfs:range xsd:float ;
                          rdfs:comment "Time period that is required from an order to reduce a load to the time that it takes to get to the minimum load reduction." .



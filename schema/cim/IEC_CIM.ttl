                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TapChanger.controlEnabled ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:boolean
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TapChanger.highStep ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:nonNegativeInteger
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TapChanger.lowStep ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:nonNegativeInteger
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TapChanger.ltcFlag ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:boolean
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TapChanger.neutralStep ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:nonNegativeInteger
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TapChanger.normalStep ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:nonNegativeInteger
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:TapChanger.step ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ;
               rdfs:subClassOf cim:PowerSystemResource ;
               rdfs:comment "Mechanism for changing transformer winding tap positions." .


###  http://www.iec.ch/TC57/CIM#TapChangerControl
cim:TapChangerControl rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:TapChangerControl.limitVoltage ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Voltage
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:TapChangerControl.lineDropR ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Resistance
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:TapChangerControl.lineDropX ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Reactance
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:TapChangerControl.reverseLineDropR ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Resistance
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:TapChangerControl.reverseLineDropX ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Reactance
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:TapChangerControl.lineDropCompensation ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:boolean
                                          ] ;
                      rdfs:subClassOf cim:RegulatingControl ;
                      rdfs:comment "Describes behavior specific to tap changers, e.g. how the voltage at the end of a line varies with the load level and compensation of the voltage drop by tap adjustment." .


###  http://www.iec.ch/TC57/CIM#TapChangerDynamicData
cim:TapChangerDynamicData rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Restriction ;

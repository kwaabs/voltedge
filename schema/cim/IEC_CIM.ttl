###  http://www.iec.ch/TC57/CIM#LossSensitivity.lossFactor
cim:LossSensitivity.lossFactor rdf:type owl:DatatypeProperty ;
                               rdfs:domain cim:LossSensitivity ;
                               rdfs:range xsd:float ;
                               rdfs:comment """Loss penalty factor.
Defined as: 1 / ( 1 - Incremental Transmission Loss); with the Incremental Transmission Loss expressed as a plus or minus value. The typical range of penalty factors is (0,9 to 1,1).""" .



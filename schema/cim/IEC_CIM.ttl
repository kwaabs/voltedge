###  http://www.iec.ch/TC57/CIM#AccountingUnit
cim:AccountingUnit rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:AccountingUnit.energyUnit ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:RealEnergy
                                       ] ,

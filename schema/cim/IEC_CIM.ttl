                            rdfs:comment "Wind Type 3 or Type 4 function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" .


###  http://www.iec.ch/TC57/CIM#WindingConnection
cim:WindingConnection rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Class ;
                                            owl:oneOf ( cim:A
                                                        cim:D
                                                        cim:I
                                                        cim:Y
                                                        cim:Yn
                                                        cim:Z
                                                        cim:Zn
                                                      )
                                          ] .


###  http://www.iec.ch/TC57/CIM#WindingInsulation
cim:WindingInsulation rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:WindingInsulation.leakageReactance ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Reactance
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:WindingInsulation.status ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Status
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:WindingInsulation.insulationPFStatus ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:WindingInsulation.insulationResistance ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ;
                      rdfs:subClassOf cim:IdentifiedObject ;
                      rdfs:comment "Winding insulation condition as a result of a test." .


###  http://www.iec.ch/TC57/CIM#WindingInsulationKind
cim:WindingInsulationKind rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Class ;

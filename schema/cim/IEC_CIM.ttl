###  http://www.iec.ch/TC57/CIM#ShortCircuitTest
cim:ShortCircuitTest rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ShortCircuitTest.current ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:CurrentFlow
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ShortCircuitTest.leakageImpedance ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Impedance
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ShortCircuitTest.leakageImpedanceZero ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Impedance
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ShortCircuitTest.loss ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:KiloActivePower
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ShortCircuitTest.lossZero ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:KiloActivePower
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ShortCircuitTest.power ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:ApparentPower
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ShortCircuitTest.voltage ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:PerCent
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ShortCircuitTest.energisedEndStep ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:nonNegativeInteger
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ShortCircuitTest.groundedEndStep ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:nonNegativeInteger
                                         ] ;
                     rdfs:subClassOf cim:TransformerTest ;
                     rdfs:comment "Short-circuit test results determine mesh impedance parameters. They include load losses and leakage impedances. For three-phase windings, the excitation can be a positive sequence (the default) or a zero sequence. There shall be at least one grounded winding." .


###  http://www.iec.ch/TC57/CIM#ShuntCompensator
cim:ShuntCompensator rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ShuntCompensator.aVRDelay ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Seconds
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ShuntCompensator.nomU ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:Voltage
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ShuntCompensator.phaseConnection ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:PhaseShuntConnectionKind
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ShuntCompensator.voltageSensitivity ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onClass cim:VoltagePerReactivePower
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ShuntCompensator.grounded ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:boolean
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ShuntCompensator.maximumSections ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:nonNegativeInteger
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ShuntCompensator.normalSections ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:nonNegativeInteger
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ShuntCompensator.sections ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:float
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ShuntCompensator.switchOnCount ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:nonNegativeInteger
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty cim:ShuntCompensator.switchOnDate ;
                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                           owl:onDataRange xsd:dateTime
                                         ] ;
                     rdfs:subClassOf cim:RegulatingCondEq ;
                     rdfs:comment "A shunt capacitor or reactor or switchable bank of shunt capacitors or reactors. A section of a shunt compensator is an individual capacitor or reactor.  A negative value for reactivePerSection indicates that the compensator is a reactor. ShuntCompensator is a single terminal device.  Ground is implied." .


###  http://www.iec.ch/TC57/CIM#ShuntCompensatorControl
cim:ShuntCompensatorControl rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ShuntCompensatorControl.cellSize ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass cim:ReactivePower
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ShuntCompensatorControl.controlKind ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass cim:ShuntImpedanceControlKind
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ShuntCompensatorControl.highVoltageOverride ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass cim:PU
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ShuntCompensatorControl.localControlKind ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass cim:ShuntImpedanceLocalControlKind
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ShuntCompensatorControl.lowVoltageOverride ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass cim:PU
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ShuntCompensatorControl.regBranchKind ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass cim:RegulationBranchKind
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ShuntCompensatorControl.sensingPhaseCode ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass cim:PhaseCode
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ShuntCompensatorControl.switchOperationCycle ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass cim:Hours
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ShuntCompensatorControl.branchDirect ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ShuntCompensatorControl.localOffLevel ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:string
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ShuntCompensatorControl.localOnLevel ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:string
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ShuntCompensatorControl.localOverride ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:boolean
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ShuntCompensatorControl.maxSwitchOperationCount ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ShuntCompensatorControl.normalOpen ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:boolean
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ShuntCompensatorControl.regBranch ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:string
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ShuntCompensatorControl.regBranchEnd ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:nonNegativeInteger
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ShuntCompensatorControl.vRegLineLine ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:boolean
                                                ] ;
                            rdfs:subClassOf cim:RegulatingControl ;
                            rdfs:comment "Distribution capacitor bank control settings." .


###  http://www.iec.ch/TC57/CIM#ShuntCompensatorDynamicData
cim:ShuntCompensatorDynamicData rdf:type owl:Class ;
                                owl:equivalentClass [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:ShuntCompensatorDynamicData.connectionStatus ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:nonNegativeInteger
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:ShuntCompensatorDynamicData.desiredVoltage ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:float
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:ShuntCompensatorDynamicData.mVARInjection ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:float
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:ShuntCompensatorDynamicData.stepPosition ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:nonNegativeInteger
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty cim:ShuntCompensatorDynamicData.voltageRegulationStatus ;
                                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                      owl:onDataRange xsd:boolean
                                                    ] ;
                                rdfs:comment "Optimal Power Flow or State Estimator Filter Bank Data for OTS. This is used for RealTime, Study and Maintenance Users" .


###  http://www.iec.ch/TC57/CIM#ShuntCompensatorInfo
cim:ShuntCompensatorInfo rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:ShuntCompensatorInfo.maxPowerLoss ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:ApparentPower
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:ShuntCompensatorInfo.ratedCurrent ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:CurrentFlow
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:ShuntCompensatorInfo.ratedReactivePower ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:ReactivePower
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:ShuntCompensatorInfo.ratedVoltage ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:Voltage
                                             ] ;
                         rdfs:subClassOf cim:AssetInfo ;
                         rdfs:comment "Properties of shunt capacitor, shunt reactor or switchable bank of shunt capacitor or reactor assets." .


###  http://www.iec.ch/TC57/CIM#ShuntCompensatorPhase
cim:ShuntCompensatorPhase rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ShuntCompensatorPhase.phase ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass cim:SinglePhaseKind
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ShuntCompensatorPhase.maximumSections ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:nonNegativeInteger
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty cim:ShuntCompensatorPhase.normalSections ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onDataRange xsd:nonNegativeInteger
                                              ] ;
                          rdfs:subClassOf cim:PowerSystemResource ;
                          rdfs:comment "Single phase of a multi-phase shunt compensator when its attributes might be different per phase." .


###  http://www.iec.ch/TC57/CIM#ShuntImpedanceControlKind
cim:ShuntImpedanceControlKind rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Class ;
                                                    owl:oneOf ( cim:fixed
                                                                cim:localOnly
                                                                cim:remoteOnly
                                                                cim:remoteWithLocalOverride
                                                              )
                                                  ] .


###  http://www.iec.ch/TC57/CIM#ShuntImpedanceLocalControlKind
cim:ShuntImpedanceLocalControlKind rdf:type owl:Class ;
                                   owl:equivalentClass [ rdf:type owl:Class ;
                                                         owl:oneOf ( cim:current
                                                                     cim:none
                                                                     cim:powerFactor
                                                                     cim:reactivePower
                                                                     cim:temperature
                                                                     cim:time
                                                                     cim:voltage
                                                                   )
                                                       ] .


###  http://www.iec.ch/TC57/CIM#ShutdownCurve
cim:ShutdownCurve rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ShutdownCurve.shutdownCost ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:Money
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ShutdownCurve.shutdownDate ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTime
                                      ] ;
                  rdfs:subClassOf cim:Curve ;
                  rdfs:comment "Relationship between the rate in gross active power/minute (Y-axis) at which a unit should be shutdown and its present gross MW output (X-axis)." .


###  http://www.iec.ch/TC57/CIM#SimpleEndDeviceFunction
cim:SimpleEndDeviceFunction rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:SimpleEndDeviceFunction.kind ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass cim:EndDeviceFunctionKind
                                                ] ;
                            rdfs:subClassOf cim:EndDeviceFunction ;
                            rdfs:comment "Simple end device function distinguished by 'kind'. Use this class for instances that cannot be represented by another end device function specialisations." .


###  http://www.iec.ch/TC57/CIM#SinglePhaseKind
cim:SinglePhaseKind rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:oneOf ( cim:A
                                                      cim:B
                                                      cim:C
                                                      cim:N
                                                      cim:s1
                                                      cim:s2
                                                    )
                                        ] .


###  http://www.iec.ch/TC57/CIM#Skill
cim:Skill rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Skill.certificationPeriod ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:DateTimeInterval
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Skill.level ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:SkillLevelKind
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Skill.effectiveDateTime ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:dateTime
                              ] ;
          rdfs:subClassOf cim:Document ;
          rdfs:comment "Proficiency level of a craft, which is required to operate or maintain a particular type of asset and/or perform certain types of work." .


###  http://www.iec.ch/TC57/CIM#SkillLevelKind
cim:SkillLevelKind rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Class ;
                                         owl:oneOf ( cim:apprentice
                                                     cim:master
                                                     cim:other
                                                     cim:standard
                                                   )
                                       ] .


###  http://www.iec.ch/TC57/CIM#SolarGeneratingUnit
cim:SolarGeneratingUnit rdf:type owl:Class ;
                        rdfs:subClassOf cim:GeneratingUnit ;
                        rdfs:comment "A solar thermal generating unit." .


###  http://www.iec.ch/TC57/CIM#Source
cim:Source rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Class ;
                                 owl:oneOf ( cim:DEFAULTED
                                             cim:PROCESS
                                             cim:SUBSTITUTED
                                           )
                               ] .


###  http://www.iec.ch/TC57/CIM#SourceSinkFlag
cim:SourceSinkFlag rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Class ;
                                         owl:oneOf ( cim:CSNK
                                                     cim:CSRC
                                                   )
                                       ] .


###  http://www.iec.ch/TC57/CIM#SourceSinkType
cim:SourceSinkType rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Class ;
                                         owl:oneOf ( cim:Neither
                                                     cim:Sink
                                                     cim:Source
                                                   )
                                       ] .


###  http://www.iec.ch/TC57/CIM#Specification
cim:Specification rdf:type owl:Class ;
                  rdfs:subClassOf cim:Document ;
                  rdfs:comment "Specification can be used for various purposes relative to an asset, a logical device (PowerSystemResource), location, etc. Examples include documents supplied by manufacturers such as asset installation instructions, asset maintenance instructions, etc." .


###  http://www.iec.ch/TC57/CIM#Specification_Layer
cim:Specification_Layer rdf:type owl:Class .


###  http://www.iec.ch/TC57/CIM#Speed
cim:Speed rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Speed.multiplier ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:UnitMultiplier
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Speed.unit ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:UnitSymbol
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Speed.value ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:float
                              ] ;
          rdfs:comment "Distance per unit of time." .


###  http://www.iec.ch/TC57/CIM#SpinningEventNameType
cim:SpinningEventNameType rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Class ;
                                                owl:oneOf ( cim:EASTERN
                                                            cim:PJM
                                                            cim:RFC-SR
                                                            cim:SOUTH-S
                                                          )
                                              ] .


###  http://www.iec.ch/TC57/CIM#SpinningEventType
cim:SpinningEventType rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Class ;
                                            owl:oneOf ( cim:AA
                                                        cim:CA
                                                        cim:RZ
                                                      )
                                          ] .


###  http://www.iec.ch/TC57/CIM#Stage
cim:Stage rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Stage.priority ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:nonNegativeInteger
                              ] ;
          rdfs:subClassOf cim:IdentifiedObject ;
          rdfs:comment "Stage of a remedial action scheme." .


###  http://www.iec.ch/TC57/CIM#StageTrigger
cim:StageTrigger rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:StageTrigger.armed ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:boolean
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:StageTrigger.normalArmed ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:boolean
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:StageTrigger.priority ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:nonNegativeInteger
                                     ] ;
                 rdfs:subClassOf cim:IdentifiedObject ;
                 rdfs:comment "Condition that is triggered either by TriggerCondition of by gate condition within a stage and has remedial action-s." .


###  http://www.iec.ch/TC57/CIM#StandardIndustryCode
cim:StandardIndustryCode rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:StandardIndustryCode.code ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:string
                                             ] ;
                         rdfs:subClassOf cim:Document ;
                         rdfs:comment """The Standard Industrial Classification (SIC) are the codes that identify the type of products/service an industry is involved in, and used for statutory reporting purposes. For example, in the USA these codes are located by the federal government, and then published in a book entitled \"The Standard Industrial Classification Manual\". The codes are arranged in a hierarchical structure.
Note that Residential Service Agreements are not classified according to the SIC codes.""" .


###  http://www.iec.ch/TC57/CIM#StartIgnFuelCurve
cim:StartIgnFuelCurve rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:StartIgnFuelCurve.ignitionFuelType ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:FuelType
                                          ] ;
                      rdfs:subClassOf cim:Curve ;
                      rdfs:comment "The quantity of ignition fuel (Y-axis) used to restart and repay the auxiliary power consumed versus the number of hours (X-axis) the unit was off line." .


###  http://www.iec.ch/TC57/CIM#StartMainFuelCurve
cim:StartMainFuelCurve rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:StartMainFuelCurve.mainFuelType ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:FuelType
                                           ] ;
                       rdfs:subClassOf cim:Curve ;
                       rdfs:comment "The quantity of main fuel (Y-axis) used to restart and repay the auxiliary power consumed versus the number of hours (X-axis) the unit was off line." .


###  http://www.iec.ch/TC57/CIM#StartRampCurve
cim:StartRampCurve rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:StartRampCurve.hotStandbyRamp ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:ActivePowerChangeRate
                                       ] ;
                   rdfs:subClassOf cim:Curve ;
                   rdfs:comment "Rate in gross active power/minute (Y-axis) at which a unit can be loaded versus the number of hours (X-axis) the unit was off line." .


###  http://www.iec.ch/TC57/CIM#StartUpCostCurve
cim:StartUpCostCurve rdf:type owl:Class ;
                     rdfs:subClassOf cim:Curve ;
                     rdfs:comment "Startup costs and time as a function of down time.  Relationship between unit startup cost (Y1-axis) vs. unit elapsed down time (X-axis)." .


###  http://www.iec.ch/TC57/CIM#StartUpEnergyCurve
cim:StartUpEnergyCurve rdf:type owl:Class ;
                       rdfs:subClassOf cim:Curve ;
                       rdfs:comment "The energy consumption of a generating resource to complete a start-up from the StartUpEnergyCurve. Definition of the StartUpEnergyCurve includes, xvalue as the cooling time and y1value as the MW value." .


###  http://www.iec.ch/TC57/CIM#StartUpFuelCurve
cim:StartUpFuelCurve rdf:type owl:Class ;
                     rdfs:subClassOf cim:Curve ;
                     rdfs:comment "The fuel consumption of a Generating Resource to complete a Start-Up.(x=cooling time) Form Startup Fuel Curve. xAxisData -&gt; cooling time, y1AxisData -&gt; MBtu" .


###  http://www.iec.ch/TC57/CIM#StartUpTimeCurve
cim:StartUpTimeCurve rdf:type owl:Class ;
                     rdfs:subClassOf cim:Curve ;
                     rdfs:comment "Startup time curve as a function of down time, where time is specified in minutes.  Relationship between unit startup time (Y1-axis) vs. unit elapsed down time (X-axis)." .


###  http://www.iec.ch/TC57/CIM#StartupModel
cim:StartupModel rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:StartupModel.fixedMaintCost ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:CostRate
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:StartupModel.hotStandbyHeat ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:HeatRate
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:StartupModel.incrementalMaintCost ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:CostPerEnergyUnit
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:StartupModel.minimumDownTime ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Hours
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:StartupModel.minimumRunTime ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Hours
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:StartupModel.riskFactorCost ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Money
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:StartupModel.startupCost ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Money
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:StartupModel.stbyAuxP ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:ActivePower
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:StartupModel.startupDate ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:dateTime
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:StartupModel.startupPriority ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:nonNegativeInteger
                                     ] ;
                 rdfs:subClassOf cim:IdentifiedObject ;
                 rdfs:comment "Unit start up characteristics depending on how long the unit has been off line." .


###  http://www.iec.ch/TC57/CIM#StateVariable
cim:StateVariable rdf:type owl:Class ;
                  rdfs:comment "An abstract class for state variables." .


###  http://www.iec.ch/TC57/CIM#StaticLoadModelKind
cim:StaticLoadModelKind rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Class ;
                                              owl:oneOf ( cim:constantZ
                                                          cim:exponential
                                                          cim:zIP1
                                                          cim:zIP2
                                                        )
                                            ] .


###  http://www.iec.ch/TC57/CIM#StaticVarCompensator
cim:StaticVarCompensator rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:StaticVarCompensator.capacitiveRating ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:Reactance
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:StaticVarCompensator.inductiveRating ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:Reactance
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:StaticVarCompensator.q ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:ReactivePower
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:StaticVarCompensator.sVCControlMode ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:SVCControlMode
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:StaticVarCompensator.slope ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:VoltagePerReactivePower
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:StaticVarCompensator.voltageSetPoint ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:Voltage
                                             ] ;
                         rdfs:subClassOf cim:RegulatingCondEq ;
                         rdfs:comment """A facility for providing variable and controllable shunt reactive power. The SVC typically consists of a stepdown transformer, filter, thyristor-controlled reactor, and thyristor-switched capacitor arms.

The SVC may operate in fixed MVar output mode or in voltage control mode. When in voltage control mode, the output of the SVC will be proportional to the deviation of voltage at the controlled bus from the voltage setpoint.  The SVC characteristic slope defines the proportion.  If the voltage at the controlled bus is equal to the voltage setpoint, the SVC MVar output is zero.""" .


###  http://www.iec.ch/TC57/CIM#StationSupply
cim:StationSupply rdf:type owl:Class ;
                  rdfs:subClassOf cim:EnergyConsumer ;
                  rdfs:comment "Station supply with load derived from the station output." .



###  http://www.iec.ch/TC57/CIM#GenericConstraints
cim:GenericConstraints rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:GenericConstraints.intervalEndTime ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:dateTime
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:GenericConstraints.intervalStartTime ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:dateTime
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:GenericConstraints.maxLimit ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:float
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:GenericConstraints.minLimit ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:float
                                           ] ;
                       rdfs:subClassOf cim:IdentifiedObject ;
                       rdfs:comment """Generic constraints can represent secure areas, voltage profile, transient stability and voltage collapse limits.

The generic constraints can be one of the following forms:
a) Thermal MW limit constraints type
b) Group line flow constraint type""" .



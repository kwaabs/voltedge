###  http://www.iec.ch/TC57/CIM#Card
cim:Card rdf:type owl:Class ;
         owl:equivalentClass [ rdf:type owl:Restriction ;
                               owl:onProperty cim:Card.accountHolderName ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty cim:Card.cvNumber ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:string
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty cim:Card.expiryDate ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:date
                             ] ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty cim:Card.pan ;
                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                               owl:onDataRange xsd:string
                             ] ;
         rdfs:comment "Documentation of the tender when it is a type of card (credit, debit, etc)." .


###  http://www.iec.ch/TC57/CIM#Cashier
cim:Cashier rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Cashier.electronicAddress ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:ElectronicAddress
                                ] ;
            rdfs:subClassOf cim:IdentifiedObject ;
            rdfs:comment "The operator of the point of sale for the duration of CashierShift. Cashier is under the exclusive management control of Vendor." .


###  http://www.iec.ch/TC57/CIM#CashierShift
cim:CashierShift rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:CashierShift.cashFloat ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Money
                                     ] ;
                 rdfs:subClassOf cim:Shift ;
                 rdfs:comment "The operating shift for a cashier, during which the cashier may transact against the cashier shift, subject to vendor shift being open." .


###  http://www.iec.ch/TC57/CIM#Channel
cim:Channel rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Channel.isVirtual ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:boolean
                                ] ;
            rdfs:subClassOf cim:IdentifiedObject ;
            rdfs:comment "A single path for the collection or reporting of register values over a period of time. For example, a register which measures forward energy can have two channels, one providing bulk quantity readings and the other providing interval readings of a fixed interval size." .


###  http://www.iec.ch/TC57/CIM#Charge
cim:Charge rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Charge.fixedPortion ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:AccountingUnit
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Charge.kind ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:ChargeKind
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Charge.variablePortion ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:PerCent
                               ] ;
           rdfs:subClassOf cim:IdentifiedObject ;
           rdfs:comment "A charge element associated with other entities such as tariff structures, auxiliary agreements or other charge elements. The total charge amount applicable to this instance of charge is the sum of fixed and variable portion." .


###  http://www.iec.ch/TC57/CIM#ChargeComponent
cim:ChargeComponent rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ChargeComponent.deleteStatus ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ChargeComponent.effectiveDate ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ChargeComponent.equation ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ChargeComponent.message ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ChargeComponent.roundOff ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ChargeComponent.sum ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ChargeComponent.terminationDate ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ChargeComponent.type ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ;
                    rdfs:subClassOf cim:IdentifiedObject ;
                    rdfs:comment "A Charge Component is a list of configurable charge quality items to feed into settlement calculation and/or bill determinants." .


###  http://www.iec.ch/TC57/CIM#ChargeGroup
cim:ChargeGroup rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ChargeGroup.effectiveDate ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:dateTime
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ChargeGroup.marketCode ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ChargeGroup.terminationDate ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:dateTime
                                    ] ;
                rdfs:subClassOf cim:IdentifiedObject ;
                rdfs:comment "Charge Group is the grouping of Charge Types for settlement invoicing purpose.  Examples such as Ancillary Services, Interests, etc." .


###  http://www.iec.ch/TC57/CIM#ChargeKind
cim:ChargeKind rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:oneOf ( cim:auxiliaryCharge
                                                 cim:consumptionCharge
                                                 cim:demandCharge
                                                 cim:other
                                                 cim:taxCharge
                                               )
                                   ] .


###  http://www.iec.ch/TC57/CIM#ChargeProfile
cim:ChargeProfile rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ChargeProfile.frequency ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ChargeProfile.numberInterval ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ChargeProfile.type ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ChargeProfile.unitOfMeasure ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ;
                  rdfs:subClassOf cim:Profile ;
                  rdfs:comment "A type of profile for financial charges" .


###  http://www.iec.ch/TC57/CIM#ChargeProfileData
cim:ChargeProfileData rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ChargeProfileData.sequence ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:nonNegativeInteger
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ChargeProfileData.timeStamp ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:dateTime
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ChargeProfileData.value ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:float
                                          ] ;
                      rdfs:comment "Model of various charges associated with an energy profile to support billing and settlement" .


###  http://www.iec.ch/TC57/CIM#ChargeType
cim:ChargeType rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:ChargeType.chargeOrder ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:ChargeType.chargeVersion ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:ChargeType.effectiveDate ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:dateTime
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:ChargeType.factor ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:ChargeType.frequencyType ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:ChargeType.terminationDate ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:dateTime
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:ChargeType.totalInterval ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ;
               rdfs:subClassOf cim:Document ;
               rdfs:comment "Charge Type is the basic level configuration for settlement to process specific charges for invoicing purpose. Examples such as: Day Ahead Spinning Reserve Default Invoice Interest Charge, etc." .


###  http://www.iec.ch/TC57/CIM#CheckOutType
cim:CheckOutType rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:oneOf ( cim:AFTER_THE_FACT
                                                   cim:PRE_HOUR
                                                   cim:PRE_SCHEDULE
                                                 )
                                     ] .


###  http://www.iec.ch/TC57/CIM#Cheque
cim:Cheque rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Cheque.bankAccountDetail ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:BankAccountDetail
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Cheque.kind ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:ChequeKind
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Cheque.chequeNumber ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Cheque.date ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:date
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Cheque.micrNumber ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ;
           rdfs:comment "The actual tender when it is a type of cheque." .


###  http://www.iec.ch/TC57/CIM#ChequeKind
cim:ChequeKind rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:oneOf ( cim:bankOrder
                                                 cim:other
                                                 cim:postalOrder
                                               )
                                   ] .


###  http://www.iec.ch/TC57/CIM#Clamp
cim:Clamp rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Restriction ;
                                owl:onProperty cim:Clamp.lengthFromTerminal1 ;
                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass cim:Length
                              ] ;
          rdfs:subClassOf cim:ConductingEquipment ;
          rdfs:comment """A Clamp is a galvanic connection at a line segment where other equipment is connected. A Clamp does not cut the line segment. 
A Clamp is ConductingEquipment and has one Terminal with an associated ConnectivityNode. Any other ConductingEquipment can be connected to the Clamp ConnectivityNode.""" .


###  http://www.iec.ch/TC57/CIM#Classification
cim:Classification rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:Classification.multiplier ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:UnitMultiplier
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:Classification.unit ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:UnitSymbol
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:Classification.value ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:nonNegativeInteger
                                       ] ;
                   rdfs:comment "Classification of level.  Specify as 1..n, with 1 being the most detailed, highest priority, etc as described on the attribue using this data type." .


###  http://www.iec.ch/TC57/CIM#CleanTradeProductType
cim:CleanTradeProductType rdf:type owl:Class ;
                          owl:equivalentClass [ rdf:type owl:Class ;
                                                owl:oneOf ( cim:APN
                                                            cim:CPT
                                                            cim:NRT
                                                            cim:PHY
                                                            cim:RDT
                                                            cim:RUT
                                                            cim:SRT
                                                          )
                                              ] .


###  http://www.iec.ch/TC57/CIM#ClearanceAction
cim:ClearanceAction rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ClearanceAction.kind ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:ClearanceActionKind
                                        ] ;
                    rdfs:subClassOf cim:SwitchingStep ;
                    rdfs:comment "Action on clearance document as a switching step." .


###  http://www.iec.ch/TC57/CIM#ClearanceActionKind
cim:ClearanceActionKind rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Class ;
                                              owl:oneOf ( cim:issue
                                                          cim:release
                                                          cim:update
                                                        )
                                            ] .


###  http://www.iec.ch/TC57/CIM#ClearanceDocument
cim:ClearanceDocument rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ClearanceDocument.mustBeDeenergised ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:boolean
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ClearanceDocument.mustBeGrounded ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:boolean
                                          ] ;
                      rdfs:subClassOf cim:SafetyDocument ;
                      rdfs:comment "Safety document used to authorise work on conducting equipment in the field. Tagged equipment is not allowed to be operated." .


###  http://www.iec.ch/TC57/CIM#CnodeDistributionFactor
cim:CnodeDistributionFactor rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:CnodeDistributionFactor.factor ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:float
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:CnodeDistributionFactor.podLossFactor ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:float
                                                ] ;
                            rdfs:subClassOf cim:IdentifiedObject ;
                            rdfs:comment "Participation factors per Cnode.  Used to calculate \"participation\" of Cnode in an AggregateNode. Each Cnode associated to an AggregateNode would be assigned a participation factor for its participation within the AggregateNode." .


###  http://www.iec.ch/TC57/CIM#CogenerationPlant
cim:CogenerationPlant rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:CogenerationPlant.ratedP ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:ActivePower
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:CogenerationPlant.cogenHPSendoutRating ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:float
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:CogenerationPlant.cogenHPSteamRating ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:float
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:CogenerationPlant.cogenLPSendoutRating ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:float
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:CogenerationPlant.cogenLPSteamRating ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:float
                                          ] ;
                      rdfs:subClassOf cim:PowerSystemResource ;
                      rdfs:comment "A set of thermal generating units for the production of electrical energy and process steam (usually from the output of the steam turbines). The steam sendout is typically used for industrial purposes or for municipal heating and cooling." .


###  http://www.iec.ch/TC57/CIM#ComDirectionKind
cim:ComDirectionKind rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:oneOf ( cim:biDirectional
                                                       cim:fromDevice
                                                       cim:toDevice
                                                     )
                                         ] .


###  http://www.iec.ch/TC57/CIM#ComFunction
cim:ComFunction rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ComFunction.direction ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:ComDirectionKind
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ComFunction.technology ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:ComTechnologyKind
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ComFunction.amrAddress ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ComFunction.amrRouter ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ;
                rdfs:subClassOf cim:EndDeviceFunction ;
                rdfs:comment "Communication function of communication equipment or a device such as a meter." .


###  http://www.iec.ch/TC57/CIM#ComMedia
cim:ComMedia rdf:type owl:Class ;
             rdfs:subClassOf cim:Asset ;
             rdfs:comment "Communication media such as fibre optic cable, power-line, telephone, etc." .


###  http://www.iec.ch/TC57/CIM#ComModule
cim:ComModule rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:ComModule.timeZoneOffset ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:Minutes
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:ComModule.amrSystem ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:ComModule.supportsAutonomousDst ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:boolean
                                  ] ;
              rdfs:subClassOf cim:Asset ;
              rdfs:comment "An asset having communications capabilities that can be paired with a meter or other end device to provide the device with communication ability, through associated communication function. An end device that has communications capabilities through embedded hardware can use that function directly (without the communication module), or combine embedded communication function with additional communication functions provided through an external communication module (e.g. zigbee)." .


###  http://www.iec.ch/TC57/CIM#ComTechnologyKind
cim:ComTechnologyKind rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Class ;
                                            owl:oneOf ( cim:cellular
                                                        cim:ethernet
                                                        cim:homePlug
                                                        cim:pager
                                                        cim:phone
                                                        cim:plc
                                                        cim:rf
                                                        cim:rfMesh
                                                        cim:zigbee
                                                      )
                                          ] .


###  http://www.iec.ch/TC57/CIM#CombinedCycleConfiguration
cim:CombinedCycleConfiguration rdf:type owl:Class ;
                               owl:equivalentClass [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:CombinedCycleConfiguration.ShutdownFlag ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:boolean
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:CombinedCycleConfiguration.StartupFlag ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:boolean
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:CombinedCycleConfiguration.primaryConfiguration ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:boolean
                                                   ] ;
                               rdfs:subClassOf cim:RegisteredGenerator ;
                               rdfs:comment """Configuration options for combined cycle units.
For example, a Combined Cycle with (CT1, CT2, ST1) will have (CT1, ST1) and (CT2, ST1) configurations as part of(1CT + 1STlogicalconfiguration).""" .


###  http://www.iec.ch/TC57/CIM#CombinedCycleConfigurationMember
cim:CombinedCycleConfigurationMember rdf:type owl:Class ;
                                     owl:equivalentClass [ rdf:type owl:Restriction ;
                                                           owl:onProperty cim:CombinedCycleConfigurationMember.primary ;
                                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                           owl:onDataRange xsd:boolean
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty cim:CombinedCycleConfigurationMember.steam ;
                                                           owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                           owl:onDataRange xsd:boolean
                                                         ] ;
                                     rdfs:subClassOf cim:IdentifiedObject ;
                                     rdfs:comment "Configuration Member of CCP Configuration." .


###  http://www.iec.ch/TC57/CIM#CombinedCycleLogicalConfiguration
cim:CombinedCycleLogicalConfiguration rdf:type owl:Class ;
                                      rdfs:subClassOf cim:IdentifiedObject ;
                                      rdfs:comment """Logical Configuration of a Combined Cycle plant.

Operating Combined Cycle Plant (CCP) configurations are represented as Logical CCP Resources. Logical representation shall be used for Market applications to optimize and control Market Operations. Logical representation is also necessary for controlling the number of CCP configurations and to temper performance issues that may otherwise occur. 

For example,(2CT configuration),(1CT + 1ST configuration) are examples of logical configuration, without specifying the specific CT and ST participating in the configuration.""" .


###  http://www.iec.ch/TC57/CIM#CombinedCyclePlant
cim:CombinedCyclePlant rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:CombinedCyclePlant.combCyclePlantRating ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:ActivePower
                                           ] ;
                       rdfs:subClassOf cim:PowerSystemResource ;
                       rdfs:comment "A set of combustion turbines and steam turbines where the exhaust heat from the combustion turbines is recovered to make steam for the steam turbines, resulting in greater overall plant efficiency." .


###  http://www.iec.ch/TC57/CIM#CombinedCycleTransitionState
cim:CombinedCycleTransitionState rdf:type owl:Class ;
                                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                                       owl:onProperty cim:CombinedCycleTransitionState.upTransition ;
                                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                       owl:onDataRange xsd:boolean
                                                     ] ;
                                 rdfs:comment "Defines the available from and to Transition States for the Combine Cycle Configurations." .


###  http://www.iec.ch/TC57/CIM#CombustionTurbine
cim:CombustionTurbine rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:CombustionTurbine.ambientTemp ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Temperature
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:CombustionTurbine.auxPowerVersusFrequency ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:PU
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:CombustionTurbine.auxPowerVersusVoltage ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:PU
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:CombustionTurbine.capabilityVersusFrequency ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:PU
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:CombustionTurbine.powerVariationByTemp ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:PU
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:CombustionTurbine.referenceTemp ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Temperature
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:CombustionTurbine.timeConstant ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Seconds
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:CombustionTurbine.heatRecoveryFlag ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:boolean
                                          ] ;
                      rdfs:subClassOf cim:PrimeMover ;
                      rdfs:comment "A prime mover that is typically fueled by gas or light oil." .


###  http://www.iec.ch/TC57/CIM#Command
cim:Command rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Command.normalValue ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:nonNegativeInteger
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Command.value ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:nonNegativeInteger
                                ] ;
            rdfs:subClassOf cim:Control ;
            rdfs:comment "A Command is a discrete control used for supervisory control." .


###  http://www.iec.ch/TC57/CIM#CommitmentClearing
cim:CommitmentClearing rdf:type owl:Class ;
                       rdfs:subClassOf cim:MarketFactors ;
                       rdfs:comment "Models results of market clearing which call for commitment of units." .


###  http://www.iec.ch/TC57/CIM#CommitmentType
cim:CommitmentType rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Class ;
                                         owl:oneOf ( cim:ISO
                                                     cim:SELF
                                                     cim:UC
                                                   )
                                       ] .


###  http://www.iec.ch/TC57/CIM#Commitments
cim:Commitments rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Commitments.commitmentType ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:CommitmentType
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Commitments.instructionType ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:AutomaticDispInstTypeCommitment
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Commitments.updateType ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:MQSCHGType
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Commitments.instructionCost ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:float
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Commitments.intervalEndTime ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:dateTime
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Commitments.intervalStartTime ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:dateTime
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Commitments.minStatusChangeTime ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Commitments.noLoadCost ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:float
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Commitments.updateTimeStamp ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:dateTime
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Commitments.updateUser ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ;
                rdfs:comment "Provides the necessary information (on a resource basis) to capture the Startup/Shutdown commitment results. This information is relevant to all markets." .


###  http://www.iec.ch/TC57/CIM#CommodityKind
cim:CommodityKind rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:oneOf ( cim:air
                                                    cim:carbon
                                                    cim:ch4
                                                    cim:co2
                                                    cim:communication
                                                    cim:coolingFluid
                                                    cim:electricityPrimaryMetered
                                                    cim:electricitySecondaryMetered
                                                    cim:hch
                                                    cim:heatingFluid
                                                    cim:insulativeGas
                                                    cim:insulativeOil
                                                    cim:internet
                                                    cim:naturalGas
                                                    cim:none
                                                    cim:nonpotableWater
                                                    cim:nox
                                                    cim:pfc
                                                    cim:potableWater
                                                    cim:propane
                                                    cim:refuse
                                                    cim:sf6
                                                    cim:so2
                                                    cim:steam
                                                    cim:tvLicence
                                                    cim:wasteWater
                                                  )
                                      ] .


###  http://www.iec.ch/TC57/CIM#CommunicationLink
cim:CommunicationLink rdf:type owl:Class ;
                      rdfs:subClassOf cim:PowerSystemResource ;
                      rdfs:comment "The connection to remote units is through one or more communication links. Reduntant links may exist. The CommunicationLink class inherit PowerSystemResource. The intention is to allow CommunicationLinks to have Measurements. These Measurements can be used to model link status as operational, out of service, unit failure etc." .


###  http://www.iec.ch/TC57/CIM#CompatibleUnit
cim:CompatibleUnit rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:CompatibleUnit.estCost ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Money
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:CompatibleUnit.quantity ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ;
                   rdfs:subClassOf cim:WorkDocument ;
                   rdfs:comment "A pre-planned job model containing labor, material, and accounting requirements for standardized job planning." .


###  http://www.iec.ch/TC57/CIM#ComplianceEvent
cim:ComplianceEvent rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ComplianceEvent.deadline ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ;
                    rdfs:subClassOf cim:ActivityRecord ;
                    rdfs:comment """Compliance events are used for reporting regulatory or contract compliance issues and/or variances. These might be created as a consequence of local business processes and associated rules. It is anticipated that this class will be customised extensively to meet local implementation needs.
Use inherited 'type' to indicate that, for example, expected performance will not be met or reported as mandated.""" .


###  http://www.iec.ch/TC57/CIM#CompositeSwitch
cim:CompositeSwitch rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:CompositeSwitch.compositeSwitchType ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ;
                    rdfs:subClassOf cim:Equipment ;
                    rdfs:comment """A model of a set of individual Switches normally enclosed within the same cabinet and possibly with interlocks that restrict the combination of switch positions. These are typically found in medium voltage distribution networks. 
A CompositeSwitch could represent a Ring-Main-Unit (RMU), or pad-mounted switchgear, with primitive internal devices such as an internal bus-bar plus 3 or 4 internal switches each of which may individually be open or closed. A CompositeSwitch and a set of contained Switches can also be used to represent a multi-position switch e.g. a switch that can connect a circuit to Ground, Open or Busbar.""" .


###  http://www.iec.ch/TC57/CIM#CompositeSwitchInfo
cim:CompositeSwitchInfo rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:CompositeSwitchInfo.interruptingRating ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:CurrentFlow
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:CompositeSwitchInfo.kind ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:CompositeSwitchKind
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:CompositeSwitchInfo.phaseCode ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:PhaseCode
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:CompositeSwitchInfo.ratedVoltage ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass cim:Voltage
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:CompositeSwitchInfo.ganged ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:CompositeSwitchInfo.initOpMode ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:string
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:CompositeSwitchInfo.phaseCount ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:nonNegativeInteger
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:CompositeSwitchInfo.remote ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:CompositeSwitchInfo.switchStateCount ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:nonNegativeInteger
                                            ] ;
                        rdfs:subClassOf cim:AssetInfo ;
                        rdfs:comment "Properties of a composite switch." .


###  http://www.iec.ch/TC57/CIM#CompositeSwitchKind
cim:CompositeSwitchKind rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Class ;
                                              owl:oneOf ( cim:escoThrowOver
                                                          cim:gral
                                                          cim:other
                                                          cim:ral
                                                          cim:regulatorBypass
                                                          cim:throwOver
                                                          cim:ugMultiSwitch
                                                        )
                                            ] .


###  http://www.iec.ch/TC57/CIM#ConcentricNeutralCableInfo
cim:ConcentricNeutralCableInfo rdf:type owl:Class ;
                               owl:equivalentClass [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:ConcentricNeutralCableInfo.diameterOverNeutral ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass cim:Length
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:ConcentricNeutralCableInfo.neutralStrandGmr ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass cim:Length
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:ConcentricNeutralCableInfo.neutralStrandRDC20 ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass cim:ResistancePerLength
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:ConcentricNeutralCableInfo.neutralStrandRadius ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass cim:Length
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:ConcentricNeutralCableInfo.neutralStrandCount ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:nonNegativeInteger
                                                   ] ;
                               rdfs:subClassOf cim:CableInfo ;
                               rdfs:comment "Concentric neutral cable data." .


###  http://www.iec.ch/TC57/CIM#ConditionFactor
cim:ConditionFactor rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ConditionFactor.kind ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:ConditionFactorKind
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ConditionFactor.status ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass cim:Status
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ConditionFactor.cfValue ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ;
                    rdfs:subClassOf cim:WorkIdentifiedObject ;
                    rdfs:comment "This is to specify the various condition factors for a design that may alter the cost estimate or the allocation." .


###  http://www.iec.ch/TC57/CIM#ConditionFactorKind
cim:ConditionFactorKind rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Class ;
                                              owl:oneOf ( cim:accountAllocation
                                                          cim:labor
                                                          cim:material
                                                          cim:other
                                                          cim:travel
                                                        )
                                            ] .


###  http://www.iec.ch/TC57/CIM#Conductance
cim:Conductance rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Conductance.multiplier ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:UnitMultiplier
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Conductance.unit ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:UnitSymbol
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Conductance.value ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:float
                                    ] ;
                rdfs:comment "Factor by which voltage must be multiplied to give corresponding power lost from a circuit. Real part of admittance." .


###  http://www.iec.ch/TC57/CIM#ConductancePerLength
cim:ConductancePerLength rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:ConductancePerLength.multiplier ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:UnitMultiplier
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:ConductancePerLength.unit ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:UnitSymbol
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:ConductancePerLength.value ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ;
                         rdfs:comment "Real part of admittance per unit of length." .


###  http://www.iec.ch/TC57/CIM#ConductingEquipment
cim:ConductingEquipment rdf:type owl:Class ;
                        rdfs:subClassOf cim:Equipment ;
                        rdfs:comment "The parts of the AC power system that are designed to carry current or that are conductively connected through terminals." .


###  http://www.iec.ch/TC57/CIM#Conductor
cim:Conductor rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Restriction ;
                                    owl:onProperty cim:Conductor.length ;
                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass cim:Length
                                  ] ;
              rdfs:subClassOf cim:ConductingEquipment ;
              rdfs:comment "Combination of conducting material with consistent electrical characteristics, building a single electrical system, used to carry current between points in the power system." .


###  http://www.iec.ch/TC57/CIM#ConfigurationEvent
cim:ConfigurationEvent rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ConfigurationEvent.effectiveDateTime ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:dateTime
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ConfigurationEvent.modifiedBy ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ConfigurationEvent.remark ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ;
                       rdfs:subClassOf cim:ActivityRecord ;
                       rdfs:comment "Used to report details on creation, change or deletion of an entity or its configuration." .


###  http://www.iec.ch/TC57/CIM#ConformLoad
cim:ConformLoad rdf:type owl:Class ;
                rdfs:subClassOf cim:EnergyConsumer ;
                rdfs:comment "ConformLoad represent loads that follow a daily load change pattern where the pattern can be used to scale the load with a system load." .


###  http://www.iec.ch/TC57/CIM#ConformLoadGroup
cim:ConformLoadGroup rdf:type owl:Class ;
                     rdfs:subClassOf cim:LoadGroup ;
                     rdfs:comment "A group of loads conforming to an allocation pattern." .


###  http://www.iec.ch/TC57/CIM#ConformLoadSchedule
cim:ConformLoadSchedule rdf:type owl:Class ;
                        rdfs:subClassOf cim:SeasonDayTypeSchedule ;
                        rdfs:comment "A curve of load  versus time (X-axis) showing the active power values (Y1-axis) and reactive power (Y2-axis) for each unit of the period covered. This curve represents a typical pattern of load over the time period for a given day type and season." .


###  http://www.iec.ch/TC57/CIM#CongestionArea
cim:CongestionArea rdf:type owl:Class ;
                   rdfs:subClassOf cim:AggregatedPnode ;
                   rdfs:comment "Designated Congestion Area Definition (DCA)" .


###  http://www.iec.ch/TC57/CIM#ConnectDisconnectFunction
cim:ConnectDisconnectFunction rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Restriction ;
                                                    owl:onProperty cim:ConnectDisconnectFunction.rcdInfo ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onClass cim:RemoteConnectDisconnectInfo
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty cim:ConnectDisconnectFunction.eventCount ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onDataRange xsd:nonNegativeInteger
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty cim:ConnectDisconnectFunction.isConnected ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onDataRange xsd:boolean
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty cim:ConnectDisconnectFunction.isDelayedDiscon ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onDataRange xsd:boolean
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty cim:ConnectDisconnectFunction.isLocalAutoDisconOp ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onDataRange xsd:boolean
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty cim:ConnectDisconnectFunction.isLocalAutoReconOp ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onDataRange xsd:boolean
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty cim:ConnectDisconnectFunction.isRemoteAutoDisconOp ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onDataRange xsd:boolean
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty cim:ConnectDisconnectFunction.isRemoteAutoReconOp ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onDataRange xsd:boolean
                                                  ] ;
                              rdfs:subClassOf cim:EndDeviceFunction ;
                              rdfs:comment "A function that will disconnect and reconnect the customer's load under defined conditions." .


###  http://www.iec.ch/TC57/CIM#ConnectivityNode
cim:ConnectivityNode rdf:type owl:Class ;
                     rdfs:subClassOf cim:IdentifiedObject ;
                     rdfs:comment "Connectivity nodes are points where terminals of AC conducting equipment are connected together with zero impedance." .


###  http://www.iec.ch/TC57/CIM#ConnectivityNodeContainer
cim:ConnectivityNodeContainer rdf:type owl:Class ;
                              rdfs:subClassOf cim:PowerSystemResource ;
                              rdfs:comment "A base class for all objects that may contain connectivity nodes or topological nodes." .


###  http://www.iec.ch/TC57/CIM#Connector
cim:Connector rdf:type owl:Class ;
              rdfs:subClassOf cim:ConductingEquipment ;
              rdfs:comment "A conductor, or group of conductors, with negligible impedance, that serve to connect other conducting equipment within a single substation and are modelled with a single logical terminal." .


###  http://www.iec.ch/TC57/CIM#ConstraintClearing
cim:ConstraintClearing rdf:type owl:Class ;
                       rdfs:subClassOf cim:MarketFactors ;
                       rdfs:comment "Groups all items associated with Binding Constraints and Constraint Violations per interval and market." .


###  http://www.iec.ch/TC57/CIM#ConstraintDuration
cim:ConstraintDuration rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ConstraintDuration.duration ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:Duration
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:ConstraintDuration.type ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ;
                       rdfs:comment "Duration constraint to activate, to put in operation, to deactivate, ... a given event." .


###  http://www.iec.ch/TC57/CIM#ConstraintLimitType
cim:ConstraintLimitType rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Class ;
                                              owl:oneOf ( cim:MAXIMUM
                                                          cim:MINIMUM
                                                        )
                                            ] .


###  http://www.iec.ch/TC57/CIM#ConstraintRampType
cim:ConstraintRampType rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Class ;
                                             owl:oneOf ( cim:SLOW
                                                       )
                                           ] .


###  http://www.iec.ch/TC57/CIM#ConstraintResults
cim:ConstraintResults rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ConstraintResults.competitivePathConstraint ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:YesNo
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ConstraintResults.constraintType ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:ResultsConstraintType
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ConstraintResults.limitFlag ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:ConstraintLimitType
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ConstraintResults.optimizationFlag ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:YesNo
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ConstraintResults.updateType ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:MQSCHGType
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ConstraintResults.BGLimit ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:float
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ConstraintResults.BGTRResCap ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:float
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ConstraintResults.baseFlow ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:float
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ConstraintResults.bindingLimit ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:float
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ConstraintResults.clearedValue ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:float
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ConstraintResults.overloadMW ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:float
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ConstraintResults.percentMW ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:float
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ConstraintResults.shadowPrice ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:float
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ConstraintResults.updateTimeStamp ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:dateTime
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:ConstraintResults.updateUser ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ;
                      rdfs:subClassOf cim:IdentifiedObject ;
                      rdfs:comment "Provides the Market results for the constraint processing for either the DAM or RTM. The data includes the constraint type (binding or violated), the solved value for the constraint, and the associated shadow price." .


###  http://www.iec.ch/TC57/CIM#ConstraintTerm
cim:ConstraintTerm rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ConstraintTerm.factor ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ConstraintTerm.function ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ;
                   rdfs:subClassOf cim:IdentifiedObject ;
                   rdfs:comment "A constraint term is one element of a linear constraint." .


###  http://www.iec.ch/TC57/CIM#ConsumptionTariffInterval
cim:ConsumptionTariffInterval rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Restriction ;
                                                    owl:onProperty cim:ConsumptionTariffInterval.sequenceNumber ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onDataRange xsd:nonNegativeInteger
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty cim:ConsumptionTariffInterval.startValue ;
                                                    owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onDataRange xsd:float
                                                  ] ;
                              rdfs:comment "One of a sequence of intervals defined in terms of consumption quantity of a service such as electricity, water, gas, etc. It is typically used in association with TariffProfile to define the steps or blocks in a step tariff structure, where startValue simultaneously defines the entry value of this step and the closing value of the previous step. Where consumption is &gt;= startValue it falls within this interval and where consumption is &lt; startValue it falls within the previous interval." .


###  http://www.iec.ch/TC57/CIM#Contingency
cim:Contingency rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:Contingency.mustStudy ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:boolean
                                    ] ;
                rdfs:subClassOf cim:IdentifiedObject .


###  http://www.iec.ch/TC57/CIM#ContingencyConstraintLimit
cim:ContingencyConstraintLimit rdf:type owl:Class ;
                               rdfs:subClassOf cim:Curve ;
                               rdfs:comment "Possibly time-varying max MW or MVA and optionally Min MW limit or MVA limit (Y1 and Y2, respectively) assigned to a constraint for a specific contingency. Use CurveSchedule XAxisUnits to specify MW or MVA." .


###  http://www.iec.ch/TC57/CIM#ContingencyElement
cim:ContingencyElement rdf:type owl:Class ;
                       rdfs:subClassOf cim:IdentifiedObject ;
                       rdfs:comment "An element of a system event to be studied by contingency analysis, representing a change in status of a single piece of equipment." .


###  http://www.iec.ch/TC57/CIM#ContingencyEquipment
cim:ContingencyEquipment rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:ContingencyEquipment.contingentStatus ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:ContingencyEquipmentStatusKind
                                             ] ;
                         rdfs:subClassOf cim:ContingencyElement ;
                         rdfs:comment "A equipment to which the in service status is to change such as a power transformer or AC line segment." .


###  http://www.iec.ch/TC57/CIM#ContingencyEquipmentStatusKind
cim:ContingencyEquipmentStatusKind rdf:type owl:Class ;
                                   owl:equivalentClass [ rdf:type owl:Class ;
                                                         owl:oneOf ( cim:inService
                                                                     cim:outOfService
                                                                   )
                                                       ] .


###  http://www.iec.ch/TC57/CIM#ContractDistributionFactor
cim:ContractDistributionFactor rdf:type owl:Class ;
                               owl:equivalentClass [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:ContractDistributionFactor.sinkFlag ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass cim:YesNo
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:ContractDistributionFactor.sourceFlag ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass cim:YesNo
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:ContractDistributionFactor.factor ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:float
                                                   ] ;
                               rdfs:comment "Distribution amoung resources at the sink point or source point" .


###  http://www.iec.ch/TC57/CIM#ContractRight
cim:ContractRight rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.TRType ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:TRType
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.contractPrice ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:CostPerEnergyUnit
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.contractType ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:ContractType
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.financialLocation ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:YesNo
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.financialRightsDAM ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:YesNo
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.financialRightsRTM ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:YesNo
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.latestSchedMktType ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:MarketType
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.physicalRightsDAM ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:YesNo
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.physicalRightsRTM ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:YesNo
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.chainOrder ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.contractMW ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.contractPriority ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.contractStatus ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.endEffectiveDate ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTime
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.fuelAdder ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.latestSchedMinutes ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.maxNetDependableCapacity ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.maximumScheduleQuantity ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.maximumServiceHours ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.maximumStartups ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.minimumLoad ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.minimumScheduleQuantity ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:float
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.startEffectiveDate ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:dateTime
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:ContractRight.startupLeadTime ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ;
                  rdfs:subClassOf cim:IdentifiedObject ;
                  rdfs:comment "Provides definition of Transmission Ownership Right and Existing Transmission Contract identifiers for use by SCUC. RMR contract hosting: Startup lead time, Contract Service Limits, Max Service Hours, Max MWhs, Max Start-ups, Ramp Rate, Max Net Dependable Capacity, Min Capacity and Unit Substitution for DAM/RTM to retrieve;" .


###  http://www.iec.ch/TC57/CIM#ContractType
cim:ContractType rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:oneOf ( cim:CVR
                                                   cim:ETC
                                                   cim:O
                                                   cim:RMR
                                                   cim:RMT
                                                   cim:TE
                                                   cim:TI
                                                   cim:TOR
                                                 )
                                     ] .


###  http://www.iec.ch/TC57/CIM#ContractorItem
cim:ContractorItem rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ContractorItem.bidAmount ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Money
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ContractorItem.cost ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Money
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ContractorItem.status ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Status
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ContractorItem.activityCode ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:string
                                       ] ;
                   rdfs:subClassOf cim:WorkIdentifiedObject ;
                   rdfs:comment "Contractor information for work task." .


###  http://www.iec.ch/TC57/CIM#Control
cim:Control rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Control.unitMultiplier ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:UnitMultiplier
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Control.unitSymbol ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:UnitSymbol
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Control.controlType ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Control.operationInProgress ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:boolean
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Control.timeStamp ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:dateTime
                                ] ;
            rdfs:subClassOf cim:IdentifiedObject ;
            rdfs:comment "Control is used for supervisory/device control. It represents control outputs that are used to change the state in a process, e.g. close or open breaker, a set point value or a raise lower command." .


###  http://www.iec.ch/TC57/CIM#ControlArea
cim:ControlArea rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ControlArea.netInterchange ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:ActivePower
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ControlArea.pTolerance ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:ActivePower
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ControlArea.type ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:ControlAreaTypeKind
                                    ] ;
                rdfs:subClassOf cim:PowerSystemResource ;
                rdfs:comment "A control area is a grouping of generating units and/or loads and a cutset of tie lines (as terminals) which may be used for a variety of purposes including automatic generation control, powerflow solution area interchange control specification, and input to load forecasting.   Note that any number of overlapping control area specifications can be superimposed on the physical model." .


###  http://www.iec.ch/TC57/CIM#ControlAreaDesignation
cim:ControlAreaDesignation rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:ControlAreaDesignation.attained ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:YesNo
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty cim:ControlAreaDesignation.native ;
                                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass cim:YesNo
                                               ] ;
                           rdfs:comment "Indicates Control Area associated with self-schedule." .


###  http://www.iec.ch/TC57/CIM#ControlAreaGeneratingUnit
cim:ControlAreaGeneratingUnit rdf:type owl:Class ;
                              rdfs:subClassOf cim:IdentifiedObject ;
                              rdfs:comment "A control area generating unit. This class is needed so that alternate control area definitions may include the same generating unit.   Note only one instance within a control area should reference a specific generating unit." .


###  http://www.iec.ch/TC57/CIM#ControlAreaOperator
cim:ControlAreaOperator rdf:type owl:Class ;
                        rdfs:subClassOf cim:Organisation .


###  http://www.iec.ch/TC57/CIM#ControlAreaSolutionData
cim:ControlAreaSolutionData rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ControlAreaSolutionData.solvedInterchange ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:float
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:ControlAreaSolutionData.solvedLosses ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:float
                                                ] ;
                            rdfs:comment "State Estimator Solution Pool Interchange and Losses" .


###  http://www.iec.ch/TC57/CIM#ControlAreaTypeKind
cim:ControlAreaTypeKind rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Class ;
                                              owl:oneOf ( cim:AGC
                                                          cim:Forecast
                                                          cim:Interchange
                                                        )
                                            ] .


###  http://www.iec.ch/TC57/CIM#ControlledAppliance
cim:ControlledAppliance rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:ControlledAppliance.isElectricVehicle ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:ControlledAppliance.isExteriorLighting ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:ControlledAppliance.isGenerationSystem ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:ControlledAppliance.isHvacCompressorOrFurnace ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:ControlledAppliance.isInteriorLighting ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:ControlledAppliance.isIrrigationPump ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:ControlledAppliance.isManagedCommercialIndustrialLoad ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:ControlledAppliance.isPoolPumpSpaJacuzzi ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:ControlledAppliance.isSimpleMiscLoad ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:ControlledAppliance.isSmartAppliance ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:ControlledAppliance.isStripAndBaseboardHeater ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty cim:ControlledAppliance.isWaterHeater ;
                                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ;
                        rdfs:comment "Appliance controlled with a PAN device control." .


###  http://www.iec.ch/TC57/CIM#CoolantType
cim:CoolantType rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Class ;
                                      owl:oneOf ( cim:air
                                                  cim:hydrogenGas
                                                  cim:water
                                                )
                                    ] .


###  http://www.iec.ch/TC57/CIM#CoolingKind
cim:CoolingKind rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Class ;
                                      owl:oneOf ( cim:forcedAir
                                                  cim:forcedOilAndAir
                                                  cim:other
                                                  cim:selfCooling
                                                )
                                    ] .


###  http://www.iec.ch/TC57/CIM#CoolingPowerRating
cim:CoolingPowerRating rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:CoolingPowerRating.coolingKind ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:CoolingKind
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:CoolingPowerRating.powerRating ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass cim:ApparentPower
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:CoolingPowerRating.stage ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:nonNegativeInteger
                                           ] ;
                       rdfs:subClassOf cim:IdentifiedObject ;
                       rdfs:comment """There are often stages of power which are associated with stages of cooling. For instance, a transformer may be rated 121kV on the primary, 15kV on the secondary and 4kV on the tertiary winding. These are voltage ratings and the power ratings are generally the same for all three windings and independent of the voltage ratings, there are instances where the tertiary may have a lower power rating.
For example, for three stages, the power rating may be 15/20/25 MVA and the cooling is OA/FA/FOA. The 15 MVA rating goes with the OA cooling (Oil and Air cooling). This is called the self cooled rating as there are no external cooling enhancements. The 20 MVA rating goes with the FA cooling (Forced Air cooling), this means that when the fans are running and thus enhancing the cooling characteristics, the transformer can operate at a power level of 20 MVA. The 25 MVA rating goes with the FOA cooling (Forced Oil and Air cooling), this means that when the fans and pumps are running and thus enhancing the cooling characteristics even more than before, the transformer can operate at a power level of 25 MVA. This 15/20/25 MVA does not state how the power is split between the various windings. It may be 25 MVA input on the primary, 25 MVA output on the secondary and 0 MVA output on the tertiary. It may also operate at 25 MVA input on the primary, 17 MVA output on the secondary and 8 MVA output on the tertiary.""" .



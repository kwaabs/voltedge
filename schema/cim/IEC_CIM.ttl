                                        rdfs:range xsd:float ;
                                        rdfs:comment "Var controller dead band (<i>V</i><i><sub>VARC_BW</sub></i>).  Typical Value = 0.02." .


###  http://www.iec.ch/TC57/CIM#PFVArType2Common1.j
cim:PFVArType2Common1.j rdf:type owl:DatatypeProperty ;
                        rdfs:domain cim:PFVArType2Common1 ;
                        rdfs:range xsd:boolean ;
                        rdfs:comment """Selector (J).
true = control mode for reactive power
false = control mode for power factor.""" .


###  http://www.iec.ch/TC57/CIM#PFVArType2IEEEPFController.exlon
cim:PFVArType2IEEEPFController.exlon rdf:type owl:DatatypeProperty ;
                                     rdfs:domain cim:PFVArType2IEEEPFController ;
                                     rdfs:range xsd:boolean ;
                                     rdfs:comment """Overexcitation or under excitation flag (<i>EXLON</i>)
true = 1 (not in the overexcitation or underexcitation state, integral action is active)
false = 0 (in the overexcitation or underexcitation state, so integral action is disabled to allow the limiter to play its role).""" .


###  http://www.iec.ch/TC57/CIM#PFVArType2IEEEPFController.vs
cim:PFVArType2IEEEPFController.vs rdf:type owl:DatatypeProperty ;
                                  rdfs:domain cim:PFVArType2IEEEPFController ;
                                  rdfs:range xsd:float ;
                                  rdfs:comment "Generator sensing voltage (<i>V</i><i><sub>S</sub></i>)." .


###  http://www.iec.ch/TC57/CIM#PFVArType2IEEEVArController.exlon
cim:PFVArType2IEEEVArController.exlon rdf:type owl:DatatypeProperty ;
                                      rdfs:domain cim:PFVArType2IEEEVArController ;
                                      rdfs:range xsd:boolean ;
                                      rdfs:comment """Overexcitation or under excitation flag (<i>EXLON</i>)
true = 1 (not in the overexcitation or underexcitation state, integral action is active)
false = 0 (in the overexcitation or underexcitation state, so integral action is disabled to allow the limiter to play its role).""" .



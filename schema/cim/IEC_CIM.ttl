cim:MarketLedgerEntry rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:MarketLedgerEntry.accountKind ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:MktAccountKind
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:MarketLedgerEntry.amount ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Money
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:MarketLedgerEntry.status ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onClass cim:Status
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:MarketLedgerEntry.accountID ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:string
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:MarketLedgerEntry.postedDateTime ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:dateTime
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty cim:MarketLedgerEntry.transactionDateTime ;
                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                            owl:onDataRange xsd:dateTime
                                          ] ;
                      rdfs:comment "Details of an individual entry in a ledger, which was posted from a journal on the posted date." .



                               rdfs:domain cim:TransformerObservation ;
                               rdfs:range xsd:string ;
                               rdfs:comment "Dissolved Gas Analysis. Typical values are: Acceptable, Overheating, Corona, Sparking, Arcing." .


###  http://www.iec.ch/TC57/CIM#TransformerObservation.freqResp
cim:TransformerObservation.freqResp rdf:type owl:DatatypeProperty ;
                                    rdfs:domain cim:TransformerObservation ;
                                    rdfs:range xsd:string ;
                                    rdfs:comment "Frequency Response Analysis. Typical values are: acceptable, slight movement, significant movement, failed, near failure. A graphic of the response diagram, which is a type of document, may be associated with this analysis through the recursive document relationship of the ProcedureDataSet." .


###  http://www.iec.ch/TC57/CIM#TransformerObservation.furfuralDP
cim:TransformerObservation.furfuralDP rdf:type owl:DatatypeProperty ;

                                      owl:onProperty cim:ExcIEEEST2A.vrmax ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:PU
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:ExcIEEEST2A.vrmin ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;

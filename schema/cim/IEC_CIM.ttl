                                          owl:onProperty cim:MarketStatement.referenceNumber ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:MarketStatement.start ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:dateTime
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:MarketStatement.tradeDate ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;

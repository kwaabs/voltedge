              rdfs:comment "Compressed air energy storage plant." .


###  http://www.iec.ch/TC57/CIM#CIMDataObject
cim:CIMDataObject rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:CIMDataObject.proxy ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:boolean
                                      ] ;
                  rdfs:subClassOf cim:IdentifiedObject ;
                  rdfs:comment "A description of a version of instance data." .


###  http://www.iec.ch/TC57/CIM#CRR
cim:CRR rdf:type owl:Class ;
        owl:equivalentClass [ rdf:type owl:Restriction ;
                              owl:onProperty cim:CRR.cRRcategory ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass cim:CRRCategoryType
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty cim:CRR.cRRtype ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass cim:CRRSegmentType
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty cim:CRR.hedgeType ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass cim:CRRHedgeType
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty cim:CRR.timeOfUse ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass cim:TimeOfUse
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty cim:CRR.tradeSliceID ;
                              owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onDataRange xsd:string
                            ] ;
        rdfs:subClassOf cim:Document ;
        rdfs:comment """Congestion Revenue Rights (CRR) class that is inherited from a Document class.

A CRR is a financial concept that is used to hedge congestion charges.

The CRR is usually settled based on the Locational Marginal Prices (LMPs) that are calculated in the day-ahead market. These LMPs are determined by the Day-ahead resource schedules/bids. CRRs will not hedge against marginal losses. If the congestion component of LMP at the sink is greater than at the source, then the CRR owner is entitled to receive a portion of congestion revenues. If the congestion component at the sink is less than at the source, then an obligation-type CRR owner will be charged, but an option-type CRR owner will not.""" .


###  http://www.iec.ch/TC57/CIM#CRRCategoryType
cim:CRRCategoryType rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:oneOf ( cim:NSR
                                                      cim:PTP
                                                    )
                                        ] .


###  http://www.iec.ch/TC57/CIM#CRRHedgeType
cim:CRRHedgeType rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:oneOf ( cim:OBLIGATION
                                                   cim:OPTION
                                                 )
                                     ] .



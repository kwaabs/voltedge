                                     owl:onProperty cim:UsagePoint.outageRegion ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:UsagePoint.readCycle ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:UsagePoint.readRoute ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:UsagePoint.serviceDeliveryRemark ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:UsagePoint.servicePriority ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:string
                                   ] ;
               rdfs:subClassOf cim:IdentifiedObject ;
               rdfs:comment "Logical or physical point in the network to which readings or events may be attributed. Used at the place where a physical or virtual meter may be located; however, it is not required that a meter be present." .


###  http://www.iec.ch/TC57/CIM#UsagePointConnectedKind
cim:UsagePointConnectedKind rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Class ;
                                                  owl:oneOf ( cim:connected
                                                              cim:logicallyDisconnected
                                                              cim:physicallyDisconnected
                                                            )
                                                ] .


###  http://www.iec.ch/TC57/CIM#UsagePointGroup
cim:UsagePointGroup rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:UsagePointGroup.type ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ;
                    rdfs:subClassOf cim:IdentifiedObject ;
                    rdfs:comment "Abstraction for management of group communications within a two-way AMR system or the data for a group of related usage points. Commands can be issued to all of the usage points that belong to a usage point group using a defined group address and the underlying AMR communication infrastructure." .


###  http://www.iec.ch/TC57/CIM#UsagePointLocation
cim:UsagePointLocation rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:UsagePointLocation.accessMethod ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:UsagePointLocation.remark ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty cim:UsagePointLocation.siteAccessProblem ;
                                             owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onDataRange xsd:string
                                           ] ;
                       rdfs:subClassOf cim:Location ;
                       rdfs:comment "Location of an individual usage point." .


###  http://www.iec.ch/TC57/CIM#UserAttribute
cim:UserAttribute rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:UserAttribute.value ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass cim:StringQuantity
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:UserAttribute.name ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty cim:UserAttribute.sequenceNumber ;
                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onDataRange xsd:nonNegativeInteger
                                      ] ;
                  rdfs:comment "Generic name-value pair class, with optional sequence number and units for value; can be used to model parts of information exchange when concrete types are not known in advance." .


###  http://www.iec.ch/TC57/CIM#VAdjIEEE
cim:VAdjIEEE rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:VAdjIEEE.taoff ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:Seconds
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:VAdjIEEE.taon ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:Seconds
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:VAdjIEEE.vadjmax ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:PU
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:VAdjIEEE.vadjmin ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass cim:PU
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:VAdjIEEE.adjslew ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:float
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty cim:VAdjIEEE.vadjf ;
                                   owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onDataRange xsd:float
                                 ] ;
             rdfs:subClassOf cim:VoltageAdjusterDynamics ;
             rdfs:comment """The class represents IEEE Voltage Adjuster which is used to represent the voltage adjuster in either a power factor or var control system.

Reference: IEEE Standard 421.5-2005 Section 11.1.""" .


###  http://www.iec.ch/TC57/CIM#VCompIEEEType1
cim:VCompIEEEType1 rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:VCompIEEEType1.rc ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:PU
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:VCompIEEEType1.tr ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Seconds
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:VCompIEEEType1.xc ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:PU
                                       ] ;
                   rdfs:subClassOf cim:VoltageCompensatorDynamics ;
                   rdfs:comment """<font color=\"#0f0f0f\">The class represents the terminal voltage transducer and the load compensator as defined in the IEEE Std 421.5-2005, Section 4. This model is common to all excitation system models described in the IEEE Standard. </font>

Reference: IEEE Standard 421.5-2005 Section 4.""" .


###  http://www.iec.ch/TC57/CIM#VCompIEEEType2
cim:VCompIEEEType2 rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:VCompIEEEType2.tr ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:Seconds
                                       ] ;
                   rdfs:subClassOf cim:VoltageCompensatorDynamics ;
                   rdfs:comment """<font color=\"#0f0f0f\">The class represents the terminal voltage transducer and the load compensator as defined in the IEEE Std 421.5-2005, Section 4. This model is designed to cover the following types of compensation: </font>
<ul>
 <li><font color=\"#0f0f0f\">reactive droop</font></li>
 <li><font color=\"#0f0f0f\">transformer-drop or line-drop compensation</font></li>
 <li><font color=\"#0f0f0f\">reactive differential compensation known also as cross-current compensation.</font></li>
</ul>
<font color=\"#0f0f0f\">
</font><font color=\"#0f0f0f\">Reference: IEEE Standard 421.5-2005, Section 4.</font>""" .


###  http://www.iec.ch/TC57/CIM#Validity
cim:Validity rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Class ;
                                   owl:oneOf ( cim:GOOD
                                               cim:INVALID
                                               cim:QUESTIONABLE
                                             )
                                 ] .


###  http://www.iec.ch/TC57/CIM#ValueAliasSet
cim:ValueAliasSet rdf:type owl:Class ;
                  rdfs:subClassOf cim:IdentifiedObject ;
                  rdfs:comment "Describes the translation of a set of values into a name and is intendend to facilitate cusom translations. Each ValueAliasSet has a name, description etc. A specific Measurement may represent a discrete state like Open, Closed, Intermediate etc. This requires a translation from the MeasurementValue.value number to a string, e.g. 0-&gt;\"Invalid\", 1-&gt;\"Open\", 2-&gt;\"Closed\", 3-&gt;\"Intermediate\". Each ValueToAlias member in ValueAliasSet.Value describe a mapping for one particular value to a name." .


###  http://www.iec.ch/TC57/CIM#ValueToAlias
cim:ValueToAlias rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:ValueToAlias.value ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:nonNegativeInteger
                                     ] ;
                 rdfs:subClassOf cim:IdentifiedObject ;
                 rdfs:comment "Describes the translation of one particular value into a name, e.g. 1 as \"Open\"." .


###  http://www.iec.ch/TC57/CIM#Vehicle
cim:Vehicle rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Vehicle.odometerReading ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:Length
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Vehicle.usageKind ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:VehicleUsageKind
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Vehicle.odometerReadDateTime ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:dateTime
                                ] ;
            rdfs:subClassOf cim:WorkAsset ;
            rdfs:comment "Vehicle asset." .


###  http://www.iec.ch/TC57/CIM#VehicleUsageKind
cim:VehicleUsageKind rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:oneOf ( cim:contractor
                                                       cim:crew
                                                       cim:other
                                                       cim:user
                                                     )
                                         ] .


###  http://www.iec.ch/TC57/CIM#Vendor
cim:Vendor rdf:type owl:Class ;
           rdfs:subClassOf cim:IdentifiedObject ;
           rdfs:comment "The entity that owns the point of sale and contracts with the cashier to receipt payments and vend tokens using the payment system. The vendor has a private contract with and is managed by the merchant which is a type of organisation. The vendor is accountable to the merchant for revenue collected, and the merchant is in turn accountable to the supplier." .


###  http://www.iec.ch/TC57/CIM#VendorShift
cim:VendorShift rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:VendorShift.merchantDebitAmount ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:Money
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:VendorShift.posted ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:boolean
                                    ] ;
                rdfs:subClassOf cim:Shift ;
                rdfs:comment "The operating shift for a vendor during which the vendor may transact against the merchant's account. It aggregates transactions and receipts during the shift and periodically debits a merchant account. The totals in vendor shift should always be the sum of totals aggregated in all cashier shifts that were open under the particular vendor shift." .


###  http://www.iec.ch/TC57/CIM#ViolationLimit
cim:ViolationLimit rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:ViolationLimit.enforced ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:boolean
                                       ] ;
                   rdfs:subClassOf cim:Limit ;
                   rdfs:comment "A type of limit that indicates if it is enforced and, through association, the organisation responsible for setting the limit." .


###  http://www.iec.ch/TC57/CIM#VisibilityLayer
cim:VisibilityLayer rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:VisibilityLayer.drawingOrder ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:nonNegativeInteger
                                        ] ;
                    rdfs:subClassOf cim:IdentifiedObject ;
                    rdfs:comment """Layers are typically used for grouping diagram objects according to themes and scales. Themes are used to display or hide certain information (e.g., lakes, borders), while scales are used for hiding or displaying information depending on the current zoom level (hide text when it is too small to be read, or when it exceeds the screen size). This is also called de-cluttering.

CIM based graphics exchange will support an m:n relationship between diagram objects and layers. It will be the task of the importing system to convert an m:n case into an appropriate 1:n representation if the importing system does not support m:n.""" .


###  http://www.iec.ch/TC57/CIM#Voltage
cim:Voltage rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Voltage.multiplier ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:UnitMultiplier
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Voltage.unit ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass cim:UnitSymbol
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty cim:Voltage.value ;
                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:float
                                ] ;
            rdfs:comment "Electrical voltage, can be both AC and DC." .


###  http://www.iec.ch/TC57/CIM#VoltageAdjusterDynamics
cim:VoltageAdjusterDynamics rdf:type owl:Class ;
                            rdfs:subClassOf cim:DynamicsFunctionBlock ;
                            rdfs:comment "Voltage adjuster function block whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>" .


###  http://www.iec.ch/TC57/CIM#VoltageAdjusterUserDefined
cim:VoltageAdjusterUserDefined rdf:type owl:Class ;
                               owl:equivalentClass [ rdf:type owl:Restriction ;
                                                     owl:onProperty cim:VoltageAdjusterUserDefined.proprietary ;
                                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:boolean
                                                   ] ;
                               rdfs:subClassOf cim:VoltageAdjusterDynamics ;
                               rdfs:comment "<font color=\"#0f0f0f\">Voltage adjuster</font> function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" .


###  http://www.iec.ch/TC57/CIM#VoltageCompensatorDynamics
cim:VoltageCompensatorDynamics rdf:type owl:Class ;
                               rdfs:subClassOf cim:DynamicsFunctionBlock ;
                               rdfs:comment "Voltage compensator function block whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>" .


###  http://www.iec.ch/TC57/CIM#VoltageCompensatorUserDefined
cim:VoltageCompensatorUserDefined rdf:type owl:Class ;
                                  owl:equivalentClass [ rdf:type owl:Restriction ;
                                                        owl:onProperty cim:VoltageCompensatorUserDefined.proprietary ;
                                                        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                        owl:onDataRange xsd:boolean
                                                      ] ;
                                  rdfs:subClassOf cim:VoltageCompensatorDynamics ;
                                  rdfs:comment "Voltage compensator function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" .


###  http://www.iec.ch/TC57/CIM#VoltageControlZone
cim:VoltageControlZone rdf:type owl:Class ;
                       rdfs:subClassOf cim:PowerSystemResource ;
                       rdfs:comment "An area of the power system network which is defined for secondary voltage control purposes. A voltage control zone consists of a collection of substations with a designated bus bar section whose voltage will be controlled." .


###  http://www.iec.ch/TC57/CIM#VoltageLevel
cim:VoltageLevel rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:VoltageLevel.highVoltageLimit ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Voltage
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:VoltageLevel.lowVoltageLimit ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Voltage
                                     ] ;
                 rdfs:subClassOf cim:EquipmentContainer ;
                 rdfs:comment "A collection of equipment at one common system voltage forming a switchgear. The equipment typically consist of breakers, busbars, instrumentation, control, regulation and protection devices as well as assemblies of all these." .


###  http://www.iec.ch/TC57/CIM#VoltageLimit
cim:VoltageLimit rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:VoltageLimit.value ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass cim:Voltage
                                     ] ;
                 rdfs:subClassOf cim:OperationalLimit ;
                 rdfs:comment "Operational limit applied to voltage." .


###  http://www.iec.ch/TC57/CIM#VoltagePerReactivePower
cim:VoltagePerReactivePower rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:VoltagePerReactivePower.multiplier ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass cim:UnitMultiplier
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:VoltagePerReactivePower.unit ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onClass cim:UnitSymbol
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty cim:VoltagePerReactivePower.value ;
                                                  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                  owl:onDataRange xsd:float
                                                ] ;
                            rdfs:comment "Voltage variation with reactive power." .


###  http://www.iec.ch/TC57/CIM#Volume
cim:Volume rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Volume.multiplier ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:UnitMultiplier
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Volume.unit ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass cim:UnitSymbol
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty cim:Volume.value ;
                                 owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:float
                               ] ;
           rdfs:comment "Volume." .


###  http://www.iec.ch/TC57/CIM#VolumeFlowRate
cim:VolumeFlowRate rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:VolumeFlowRate.multiplier ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:UnitMultiplier
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:VolumeFlowRate.unit ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass cim:UnitSymbol
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty cim:VolumeFlowRate.value ;
                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:float
                                       ] ;
                   rdfs:comment "Volume per time." .


###  http://www.iec.ch/TC57/CIM#VsCapabilityCurve
cim:VsCapabilityCurve rdf:type owl:Class ;
                      rdfs:subClassOf cim:Curve ;
                      rdfs:comment "The P-Q capability curve for a voltage source converter, with P on x-axis and Qmin and Qmax on y1-axis and y2-axis." .


###  http://www.iec.ch/TC57/CIM#VsConverter
cim:VsConverter rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:VsConverter.delta ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:AngleDegrees
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:VsConverter.droop ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:PU
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:VsConverter.droopCompensation ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:Resistance
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:VsConverter.maxValveCurrent ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:CurrentFlow
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:VsConverter.pPccControl ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:VsPpccControlKind
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:VsConverter.qPccControl ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:VsQpccControlKind
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:VsConverter.qShare ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:PerCent
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:VsConverter.targetQpcc ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:ReactivePower
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:VsConverter.targetUpcc ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:Voltage
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:VsConverter.uf ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass cim:Voltage
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:VsConverter.maxModulationIndex ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:float
                                    ] ;
                rdfs:subClassOf cim:ACDCConverter ;
                rdfs:comment "DC side of the voltage source converter (VSC)." .


###  http://www.iec.ch/TC57/CIM#VsPpccControlKind
cim:VsPpccControlKind rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Class ;
                                            owl:oneOf ( cim:pPcc
                                                        cim:pPccAndUdcDroop
                                                        cim:pPccAndUdcDroopPilot
                                                        cim:pPccAndUdcDroopWithCompensation
                                                        cim:udc
                                                      )
                                          ] .


###  http://www.iec.ch/TC57/CIM#VsQpccControlKind
cim:VsQpccControlKind rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Class ;
                                            owl:oneOf ( cim:powerFactorPcc
                                                        cim:reactivePcc
                                                        cim:voltagePcc
                                                      )
                                          ] .


###  http://www.iec.ch/TC57/CIM#WaterLevel
cim:WaterLevel rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:WaterLevel.multiplier ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:UnitMultiplier
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:WaterLevel.unit ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:UnitSymbol
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:WaterLevel.value ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:float
                                   ] ;
               rdfs:comment "Reservoir water level referred to a given datum such as mean sea level." .


###  http://www.iec.ch/TC57/CIM#WaveTrap
cim:WaveTrap rdf:type owl:Class ;
             rdfs:subClassOf cim:AuxiliaryEquipment ;
             rdfs:comment "Line traps are devices that impede high frequency power line carrier signals yet present a negligible impedance at the main power frequency." .



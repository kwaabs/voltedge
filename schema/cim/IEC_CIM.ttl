###  http://www.iec.ch/TC57/CIM#AreaLoadBid
cim:AreaLoadBid rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Restriction ;
                                      owl:onProperty cim:AreaLoadBid.demandBidMW ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:float
                                    ] ;
                rdfs:subClassOf cim:Bid ;
                rdfs:comment "AreaLoadBid is not submitted by a market participant into the Markets. Instead, it is simply an aggregation of all LoadBids contained wtihin a specific SubControlArea. This entity should inherit from Bid for representation of the timeframe (startTime, stopTime) and the market type." .



cim:Quality61850.overFlow rdf:type owl:DatatypeProperty ;
                          rdfs:domain cim:Quality61850 ;
                          rdfs:range xsd:boolean ;
                          rdfs:comment "Measurement value is beyond the capability of being  represented properly. For example, a counter value overflows from maximum count back to a value of zero." .


###  http://www.iec.ch/TC57/CIM#Quality61850.suspect
cim:Quality61850.suspect rdf:type owl:DatatypeProperty ;
                         rdfs:domain cim:Quality61850 ;
                         rdfs:range xsd:boolean ;
                         rdfs:comment "A correlation function has detected that the value is not consitent with other values. Typically set by a network State Estimator." .



                                     owl:onProperty cim:FossilFuel.fuelSulfur ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:PU
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:FossilFuel.highBreakpointP ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onClass cim:ActivePower
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty cim:FossilFuel.lowBreakpointP ;
                                     owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;

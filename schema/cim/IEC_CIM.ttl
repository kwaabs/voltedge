                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty cim:ServiceLocation.siteAccessProblem ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onDataRange xsd:string
                                        ] ;
                    rdfs:subClassOf cim:WorkLocation ;
                    rdfs:comment "A real estate location, commonly referred to as premises." .



cim:GovGAST1.t5 rdf:type owl:ObjectProperty ;
                rdfs:domain cim:GovGAST1 ;
                rdfs:range cim:Seconds ;
                rdfs:comment "Governor lag time constant (T5).  Typical Value = 0." .



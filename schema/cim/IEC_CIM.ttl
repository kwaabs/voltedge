                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:SteamTurbine.shaft1PowerLP1 ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:float
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:SteamTurbine.shaft1PowerLP2 ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:float
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:SteamTurbine.shaft2PowerHP ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:float
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty cim:SteamTurbine.shaft2PowerIP ;
                                       owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;

                               owl:equivalentClass [ rdf:type owl:Class ;
                                                     owl:oneOf ( cim:ignoreUELsignal
                                                                 cim:inputAddedToErrorSignal
                                                                 cim:inputHVgateErrorSignal
                                                                 cim:inputHVgateVoltageOutput
                                                               )
                                                   ] .



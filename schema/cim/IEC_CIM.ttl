###  http://www.iec.ch/TC57/CIM#UnderexcitationLimiterDynamics
cim:UnderexcitationLimiterDynamics rdf:type owl:Class ;
                                   rdfs:subClassOf cim:DynamicsFunctionBlock ;
                                   rdfs:comment "Underexcitation limiter function block whose behaviour is described by reference to a standard model <font color=\"#0f0f0f\">or by definition of a user-defined model.</font>" .


###  http://www.iec.ch/TC57/CIM#UnderexcitationLimiterUserDefined
cim:UnderexcitationLimiterUserDefined rdf:type owl:Class ;
                                      owl:equivalentClass [ rdf:type owl:Restriction ;
                                                            owl:onProperty cim:UnderexcitationLimiterUserDefined.proprietary ;
                                                            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                            owl:onDataRange xsd:boolean
                                                          ] ;
                                      rdfs:subClassOf cim:UnderexcitationLimiterDynamics ;
                                      rdfs:comment "Underexcitation limiter function block whose dynamic behaviour is described by <font color=\"#0f0f0f\">a user-defined model.</font>" .


###  http://www.iec.ch/TC57/CIM#UndergroundStructure
cim:UndergroundStructure rdf:type owl:Class ;
                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:UndergroundStructure.kind ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass cim:UndergroundStructureKind
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:UndergroundStructure.hasVentilation ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:boolean
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:UndergroundStructure.material ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty cim:UndergroundStructure.sealingWarrantyExpiresDate ;
                                               owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:date
                                             ] ;
                         rdfs:subClassOf cim:Structure ;
                         rdfs:comment "Underground structure." .


###  http://www.iec.ch/TC57/CIM#UndergroundStructureKind
cim:UndergroundStructureKind rdf:type owl:Class ;
                             owl:equivalentClass [ rdf:type owl:Class ;
                                                   owl:oneOf ( cim:burd
                                                               cim:enclosure
                                                               cim:handhole
                                                               cim:manhole
                                                               cim:pad
                                                               cim:pullbox
                                                               cim:subsurfaceEnclosure
                                                               cim:trench
                                                               cim:tunnel
                                                               cim:vault
                                                             )
                                                 ] .



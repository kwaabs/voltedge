# Copy this file to .env and adjust before running `docker compose up`.
# .env itself is gitignored -- never commit real secrets, including these
# dev-only defaults once they stop being throwaway values.

# --- Postgres (supabase/postgres image) ---------------------------------
POSTGRES_PASSWORD=voltedge_dev
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# --- Martin tileserver ----------------------------------------------------
MARTIN_PORT=3000

# --- RustFS (S3-compatible object storage) --------------------------------
RUSTFS_ACCESS_KEY=voltedge
RUSTFS_SECRET_KEY=voltedge_dev_secret
RUSTFS_S3_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# --- Go API ----------------------------------------------------------------
API_PORT=8080

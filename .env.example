# Copy this file to .env and adjust before running `docker compose up`.
# .env itself is gitignored -- never commit real secrets, including these
# dev-only defaults once they stop being throwaway values.
#
# All published ports are deliberately non-default, in the 3700-3720
# range, to avoid colliding with other local services (a native Postgres
# on 5432, some other tool already on 3000/8080/9000, etc).

# --- Postgres (supabase/postgres image) ---------------------------------
POSTGRES_PASSWORD=voltedge_dev
POSTGRES_DB=postgres
POSTGRES_PORT=3700

# --- Martin tileserver ----------------------------------------------------
MARTIN_PORT=3701

# --- RustFS (S3-compatible object storage) --------------------------------
RUSTFS_ACCESS_KEY=voltedge
RUSTFS_SECRET_KEY=voltedge_dev_secret
RUSTFS_S3_PORT=3702
RUSTFS_CONSOLE_PORT=3703


# Export storage (Phase 17). The API/worker stream export artifacts to RustFS
# and hand out short-lived presigned download URLs.
#
# RUSTFS_ENDPOINT  host:port of the S3 API, WITHOUT a scheme. It must be
#                  reachable both by the API (to upload) AND by the browser
#                  (the presigned download URL redirects there and is signed
#                  for this exact host). In host-run dev that is localhost and
#                  the published S3 port; once the API runs inside compose and
#                  the browser doesn't, this has to be the public-facing host.
# RUSTFS_BUCKET    bucket artifacts land in; auto-created on boot if missing.
# RUSTFS_USE_SSL   1 to talk https to RustFS (leave unset for local http).
# EXPORT_URL_TTL   how long a presigned download URL stays valid (default 15m).
RUSTFS_ENDPOINT=localhost:3702
RUSTFS_BUCKET=voltedge-exports
#RUSTFS_USE_SSL=0
#EXPORT_URL_TTL=15m

# The export worker (Phase 17) is a separate process that drains the job queue
# -- run `task exportworker-dev` (host) or the compose `exportworker` service.
# EXPORT_WORKER_CONCURRENCY  how many exports one worker runs at once (default 2).
# EXPORT_JOB_LEASE           how long a claimed job's lease lasts before another
#                            worker may reclaim it; the worker heartbeats at a
#                            third of this while running (default 60s).
# EXPORT_RETENTION           how long a finished export's row + RustFS artifact
#                            are kept before the worker's sweep reaps them
#                            (default 168h = 7d; set 0 to keep everything).
#                            NOTE: Go durations have no day unit -- use "168h".
# EXPORT_SWEEP_INTERVAL      how often the retention sweep runs (default 1h).
#EXPORT_WORKER_CONCURRENCY=2
#EXPORT_JOB_LEASE=60s
#EXPORT_RETENTION=168h
#EXPORT_SWEEP_INTERVAL=1h

# --- Go API ----------------------------------------------------------------
API_PORT=3704

# --- Auth (Phase 10) -------------------------------------------------------
# Opaque server-side sessions. Cookie names rarely need changing; the
# timeouts and the insecure-cookie escape hatch are the knobs that matter.
#
# SESSION_IDLE_TIMEOUT   sliding window -- a session dies this long after
#                        its last use (default 12h).
# SESSION_ABSOLUTE_MAX   hard ceiling -- a session dies this long after it
#                        was created, no matter how active (default 720h =
#                        30 days).
# AUTH_INSECURE_COOKIES  set to 1 ONLY for local http:// dev. It drops the
#                        Secure flag so cookies survive plain http. Never
#                        set this anywhere reachable over the network.
#SESSION_COOKIE_NAME=ve_session
#CSRF_COOKIE_NAME=ve_csrf
#SESSION_IDLE_TIMEOUT=12h
#SESSION_ABSOLUTE_MAX=720h
AUTH_INSECURE_COOKIES=1

# AUTHADMIN_PASSWORD is read ONLY by the out-of-band `authadmin` CLI (and
# the `task authadmin-*` wrappers), never by the server. It is the password
# for the account you're creating or resetting. Set it just-in-time in your
# shell -- `AUTHADMIN_PASSWORD=... task authadmin-create ...` -- rather than
# leaving it in .env, so a break-glass credential never lingers on disk.
#AUTHADMIN_PASSWORD=

# --- SSO / OIDC (Phase 10 Slice B) -----------------------------------------
# Azure AD and Google single sign-on. A provider is enabled only when its
# vars are set AND discovery succeeds at startup; otherwise it is silently
# absent from the login screen (local-only, or one provider, are all valid).
# SSO never creates accounts -- an admin pre-provisions the user (same email)
# and the first SSO login links the identity. Unknown emails are rejected.
#
# The redirect URL must be registered verbatim with the provider and point
# at this API's callback route:
#   <public-base-url>/api/auth/oidc/azuread/callback
#   <public-base-url>/api/auth/oidc/google/callback
# (locally, e.g. http://localhost:3704/auth/oidc/azuread/callback).
#
# Azure AD -- scoped to a single tenant by OIDC_AZURE_TENANT_ID (the issuer),
# so only that tenant's users can obtain a valid token.
#OIDC_AZURE_TENANT_ID=
#OIDC_AZURE_CLIENT_ID=
#OIDC_AZURE_CLIENT_SECRET=
#OIDC_AZURE_REDIRECT_URL=

# Google -- set OIDC_GOOGLE_ALLOWED_DOMAIN to a Workspace domain to refuse
# any account outside it (checked against the verified `hd`/email domain);
# leave empty to allow any Google account that maps to a provisioned user.
#OIDC_GOOGLE_CLIENT_ID=
#OIDC_GOOGLE_CLIENT_SECRET=
#OIDC_GOOGLE_REDIRECT_URL=
#OIDC_GOOGLE_ALLOWED_DOMAIN=

# --- MCP server (Phase 18) -------------------------------------------------
# The Model Context Protocol server is a separate process that exposes
# read-only data tools to an AI agent -- run `task mcp-dev` (host) or the
# compose `mcpserver` service. It shares DATABASE_URL and the auth trust
# boundary: an agent presents an iam.api_tokens bearer token, minted
# out-of-band with `authadmin mint-token --email <e> --name <label>`, and
# every tool runs under that token's user's RBAC.
#
# MCP_PORT  HTTP listener for POST /mcp (binary default 8090; use a 37xx port
#           locally to stay in VoltEdge's reserved range).
MCP_PORT=3705

# 3706-3720 left open for services added in later phases (e.g. the
# frontend dev server in Phase 3).
